# Normalize line endings in the repository; check out with the platform default.
* text=auto

# Always LF (executed on Linux/macOS, and git hooks run by sh on every OS)
*.sh text eol=lf
eng/git-hooks/* text eol=lf

# Always CRLF (Windows-only tooling)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Source and markup
*.cs text diff=csharp
*.xaml text
*.razor text
*.csproj text
*.props text
*.targets text
*.slnx text
*.slnf text
*.resx text
*.json text
*.md text diff=markdown
*.yml text
*.yaml text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
*.db binary
*.sqlite binary

# Native provenance fingerprints bind the reviewed Windows checkout bytes on every host.
eng/native/sqlcipher/inputs.lock.json text eol=crlf
eng/native/sqlcipher/android.inputs.lock.json text eol=crlf
eng/native/sqlcipher/windows.crypto.profile.json text eol=crlf

# Retain the upstream SDK notice text verbatim, including its original end-of-line spaces.
src/Apps/Zanance/Vafadar.Zanance.App/Resources/Raw/ThirdPartyNotices.txt whitespace=-blank-at-eol

# D-580: exact reviewed replacement/license digests must survive every host checkout.
eng/notifications/AndroidUtils.cs text eol=crlf whitespace=-blank-at-eol
eng/notifications/LICENSE.upstream text eol=lf

# Preserve the reviewed upstream LF patch and its blank context lines.
eng/patches/maui-10.0.120-android-configuration-metrics.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab

# Keep source-producer recipe fingerprints stable across the Windows and Linux build lanes.
eng/maui/** text eol=lf
# The already qualified input profile uses CRLF; retain those recipe bytes on both hosts.
eng/maui/configuration-metrics.inputs.json text eol=crlf

# Written by branding/dastan/scripts/build.mjs with LF on every system; tests compare them byte for byte with
# what the site and the tool of the editors serve, so they are LF in every working copy.
branding/dastan/source/*.svg text eol=lf
branding/dastan/exports/svg/*.svg text eol=lf
branding/dastan/previews/report.json text eol=lf
src/Apps/Dastan/Vafadar.Dastan.Web/wwwroot/favicon.svg text eol=lf
src/Apps/Dastan/Vafadar.Dastan.Studio/wwwroot/favicon.svg text eol=lf
src/Apps/Dastan/Vafadar.Dastan.Web/Site/BrandGeometry.cs text eol=lf
src/Apps/Dastan/Vafadar.Dastan.Studio/Site/BrandGeometry.cs text eol=lf

<Project>

  <!--
    Central Package Management: every NuGet package version used in the repository is declared here once.
    Projects reference packages without a Version attribute. Dependabot keeps these up to date.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <VafadarSecurityRuntimeVersion>10.0.14</VafadarSecurityRuntimeVersion>
    <!-- Servicing builds have a distinct immutable native package; one version never has alternate bytes. -->
    <VafadarWindowsCipherPackageVersion>4.19.0-candidate.7</VafadarWindowsCipherPackageVersion>
    <VafadarWindowsCipherPackageVersion Condition="'$(VafadarWindowsCipherVariant)' == 'servicing'">4.19.0-candidate.8</VafadarWindowsCipherPackageVersion>
    <VafadarWindowsCipherPackageVersion Condition="'$(VafadarWindowsCipherVariant)' == 'hosted20261021'">4.19.0-candidate.9</VafadarWindowsCipherPackageVersion>
  </PropertyGroup>

  <ItemGroup Label="Household standard cryptography">
    <PackageVersion Include="jose-jwt" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup Label="Store purchase verification">
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
  </ItemGroup>

  <ItemGroup Label="MAUI">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.120" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="FluentIcons.Maui" Version="2.1.341" />
    <PackageVersion Include="FluentIcons.Common" Version="2.1.341" />
  </ItemGroup>

  <ItemGroup Label="Android">
    <!-- Keep in line with the AndroidX versions used by .NET MAUI; newer builds pull incompatible AndroidX packages. -->
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.30" />
    <!-- On-device text recognition on Android (Vafadar.Documents.Maui, D-31): ML Kit with the model bundled in the app, no download. -->
    <PackageVersion Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
    <!-- ML Kit brings newer AndroidX libraries; their Kotlin extension packages must match (NU1608). -->
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <!-- Google Drive sign-in on Android (Vafadar.Authentication.Maui, D-35): the Google Identity authorization API. -->
    <PackageVersion Include="Xamarin.GooglePlayServices.Auth" Version="122.0.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
  </ItemGroup>

  <ItemGroup Label="Notifications">
    <PackageVersion Include="Plugin.LocalNotification" Version="14.1.2" />
  </ItemGroup>

  <ItemGroup Label="Syncfusion">
    <PackageVersion Include="Syncfusion.Licensing" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Pdf.Net.Core" Version="35.1.37" />
    <!-- October security fixes for the PDF libraries' cryptography dependencies; do not suppress NuGet audit. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Syncfusion.Maui.Core" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.Calendar" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.Charts" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.Inputs" Version="35.1.37" />
    <PackageVersion Include="Syncfusion.Maui.ProgressBar" Version="35.1.37" />
  </ItemGroup>

  <!-- Managed core packages are shared; native cipher candidate/proof packages remain isolated until adoption. -->
  <ItemGroup Label="SQLite infrastructure and encryption evaluation">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <!-- Maintained managed bridge for our source-built candidate; does not contain a native crypto binary. -->
    <PackageVersion Include="SQLitePCLRaw.provider.sqlcipher" Version="3.0.5" />
    <!-- Official source-built native packages adopted by the Android and Windows protected hosts. -->
    <PackageVersion Include="Vafadar.Native.SqlCipher.Android" Version="4.19.0-candidate.5" />
    <PackageVersion Include="Vafadar.Native.SqlCipher.Windows" Version="$(VafadarWindowsCipherPackageVersion)" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Preserve the currently restored standard engine in explicit non-cipher hosts. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

  <!-- Tests run on Microsoft.Testing.Platform (see global.json), not VSTest. -->
  <ItemGroup Label="Authentication">
    <!-- OneDrive sign-in (Vafadar.Authentication.Maui, D-35); the extensions keep the token cache with DPAPI on Windows. -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup Label="Zanance local backend">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
</Project>

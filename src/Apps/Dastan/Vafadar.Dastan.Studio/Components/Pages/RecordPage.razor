@page "/{Collection}/record/{Group}/{Record}"
@inject EditorialStore Store
@inject Editor Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_history.Count > 0)
{
    var name = _record?.Info.Label ?? Record;
    <PageTitle>@name – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta">
            <a href="@Collection"><bdi dir="ltr">@Collection</bdi></a> –
            <a href="@($"{Collection}/records/{Group}")">@T[$"Group_{Group}"]</a>
        </p>
        <h1><bdi>@name</bdi></h1>
        <p class="lead"><bdi dir="ltr">@Record</bdi></p>
    </header>

    @if (Done is "reviewed" or "changed" or "unchanged" or "removed" or "added" or "merged")
    {
        <p class="done" role="status">@T[$"Done_{Done}"]</p>
    }

    @if (_record is { } record)
    {
        <section aria-labelledby="now">
            <h2 id="now">@T["Record_Now"]</h2>
            <p class="note">
                @string.Format(CultureInfo.CurrentCulture, T["Record_State"], Editor.Number(record.Info.Version), record.Info.UpdatedBy, Editor.Moment(record.Info.UpdatedAt))
                @if (record.Info.ReviewStatus is { } review)
                {
                    <text> – </text><ReviewState Status="@review" />
                }
            </p>
            <JsonView Node="record.Body" />
        </section>

        @if (_sameTheme.Length > 0)
        {
            @* A theme that another collection has too (ADR 0027, step 25.4): both carry the same identifier of the
               same catalogue as exact. The site shows their pictures on one page; each keeps its own name. *@
            <section aria-labelledby="same-theme">
                <h2 id="same-theme">@T["Theme_Same_Title"]</h2>
                <p class="note">@T["Theme_Same_Lead"]</p>
                <ul>
                    @foreach (var (collection, id, label) in _sameTheme)
                    {
                        <li><a href="@($"{collection}/record/entities/{id}")"><bdi>@label</bdi></a> – <bdi dir="ltr">@collection</bdi></li>
                    }
                </ul>
            </section>
        }

        @if (_statements.Count > 0)
        {
            <section aria-labelledby="review">
                <h2 id="review">@T["Review_Title"]</h2>
                <p class="note">@T["Review_Lead"]</p>
                <ActOutcome Problems="_reviewProblems" />
                <Allowed Role="EditorRoles.Reviewer">
<form method="post" @formname="review" @onsubmit="Review" class="act" action="@Here">
                    <AntiforgeryToken />
                <input type="hidden" name="@Seen.Input" value="@_seen" />
                    @if (_statements.Count == 1)
                    {
                        <input type="hidden" name="Reviewing.Statement" value="@_statements[0].Statement" />
                    }
                    else
                    {
                        <p class="field">
                            <label for="review-statement">@T["Review_Statement"]</label>
                            <select id="review-statement" name="Reviewing.Statement">
                                @foreach (var statement in _statements)
                                {
                                    <option value="@statement.Statement" selected="@(statement.Statement == Reviewing?.Statement)">@statement.Label (@statement.Statement)</option>
                                }
                            </select>
                        </p>
                    }
                    <fieldset class="field">
                        <legend>@T["Review_Found"]</legend>
                        @foreach (var choice in new[] { "reviewed", "disputed", "withdrawn" })
                        {
                            <label class="choice"><input type="radio" name="Reviewing.As" value="@choice" checked="@(Reviewing?.As == choice)" required /> @T[$"Review_As_{choice}"]</label>
                        }
                    </fieldset>
                    <p class="field">
                        <label for="review-on">@T["Review_On"]</label>
                        <input id="review-on" type="date" name="Reviewing.On" value="@(Reviewing?.On ?? ActInput.Day(Editor.Today))" required />
                    </p>
                    <p class="field">
                        <label for="review-note">@T["Review_Note"]</label>
                        <textarea id="review-note" name="Reviewing.Note" rows="3" maxlength="2000" dir="auto" aria-describedby="review-note-hint">@Reviewing?.Note</textarea>
                        <span class="hint" id="review-note-hint">@T["Review_NoteHint"]</span>
                    </p>
                    <WhoAndWhy Form="review" Model="Reviewing" By="@(Reviewing?.By ?? Editor.Name)" />
                    <p><button type="submit" class="action">@T["Review_Submit"]</button></p>
                </form>
</Allowed>
            </section>
        }

        <section aria-labelledby="fields">
            <h2 id="fields">@T["Fields_Title"]</h2>
            <p class="note">@T["Fields_Lead"]</p>
            <ActOutcome Problems="_fieldsProblems" />
            <Allowed Role="EditorRoles.Writer">
<form method="post" @formname="fields" @onsubmit="Fill" class="act" action="@Here">
                <AntiforgeryToken />
                <input type="hidden" name="@Seen.Input" value="@_seen" />
                @foreach (var field in RecordForm.Of(Group, _filled ?? record.Body, _form!, _filledTexts ?? _texts, _filledDated ?? _dated))
                {
                    <FieldInput Field="field" />
                }
                <WhoAndWhy Form="fields" Model="Filling" By="@(Filling?.By ?? Editor.Name)" Reason="@(Filling?.Reason ?? string.Empty)" />
                <p><button type="submit" class="action">@T["Change_Submit"]</button></p>
            </form>
</Allowed>
        </section>

        <section aria-labelledby="change">
            <h2 id="change">@T["Change_TextTitle"]</h2>
            <p class="note">@T["Change_Lead"]</p>
            <ActOutcome Problems="_changeProblems" />
            <Allowed Role="EditorRoles.Writer">
<form method="post" @formname="change" @onsubmit="Change" class="act" action="@Here">
                <AntiforgeryToken />
                <input type="hidden" name="@Seen.Input" value="@_seen" />
                <p class="field">
                    <label for="change-json">@T["Change_Json"]</label>
                    <textarea id="change-json" class="code" name="Changing.Json" rows="@Rows(Changing?.Json ?? Written(record.Body))" spellcheck="false" dir="ltr" required>@(Changing?.Json ?? Written(record.Body))</textarea>
                </p>
                <WhoAndWhy Form="change" Model="Changing" By="@(Changing?.By ?? Editor.Name)" Reason="@(Changing?.Reason ?? string.Empty)" />
                <p><button type="submit" class="action">@T["Change_Submit"]</button></p>
            </form>
</Allowed>
        </section>

        @if (Group == "media")
        {
            <section aria-labelledby="files">
                <h2 id="files">@T["Files_Title"]</h2>
                <p class="note">@T["Files_Lead"]</p>
                <ActOutcome Problems="_uploadProblems" />
                <Allowed Role="EditorRoles.Writer">
                    <form method="post" enctype="multipart/form-data" @formname="upload" @onsubmit="Upload" class="act" action="@Here">
                        <AntiforgeryToken />
                        <input type="hidden" name="@Seen.Input" value="@_seen" />
                        <p class="field">
                            <label for="upload-part">@T["Files_Part"]</label>
                            <select id="upload-part" name="part">
                                @foreach (var part in MediaIntake.Parts)
                                {
                                    <option value="@part">@T[$"Files_Part_{part}"]</option>
                                }
                            </select>
                        </p>
                        <p class="field">
                            <label for="upload-language">@T["Files_Language"]</label>
                            <input id="upload-language" name="language" maxlength="40" dir="ltr" />
                        </p>
                        <p class="field">
                            <label for="upload-file">@T["Files_File"]</label>
                            <input id="upload-file" type="file" name="file" required accept=".png,.jpg,.jpeg,.webp,.mp4,.webm,.vtt,.txt" />
                        </p>
                        <WhoAndWhy Form="upload" Model="Uploading" By="@(Uploading?.By ?? Editor.Name)" Reason="@(Uploading?.Reason ?? string.Empty)" />
                        <p><button type="submit" class="action">@T["Files_Submit"]</button></p>
                    </form>
                    @if (Store.FilesFolder is { } samples && MediaForm.FileWithoutSizes(_record!.Body, samples) is not null)
                    {
                        @* An image that was brought in before the tool made sizes (step 18.3.1). *@
                        <h3 id="sizes">@T["Sizes_Title"]</h3>
                        <p class="note">@T["Sizes_Lead"]</p>
                        <ActOutcome Problems="_sizesProblems" />
                        <form method="post" @formname="sizes" @onsubmit="MakeSizes" class="act" action="@Here">
                            <AntiforgeryToken />
                            <input type="hidden" name="@Seen.Input" value="@_seen" />
                            <WhoAndWhy Form="sizes" Model="Sizing" By="@(Sizing?.By ?? Editor.Name)" Reason="@(Sizing?.Reason ?? string.Empty)" />
                            <p><button type="submit" class="action secondary">@T["Sizes_Submit"]</button></p>
                        </form>
                    }
                </Allowed>
            </section>
        }

        @if (Group == "entities" && _form!.Records.TryGetValue("entities", out var others) && others.Count > 1)
        {
            <section aria-labelledby="merge">
                <h2 id="merge">@T["Merge_Title"]</h2>
                <p class="note">@T["Merge_Lead"]</p>
                <ActOutcome Problems="_mergeProblems" />
                <Allowed Role="EditorRoles.Writer">
                    <form method="post" @formname="merge" @onsubmit="Merge" class="act" action="@Here">
                        <AntiforgeryToken />
                        <input type="hidden" name="@Seen.Input" value="@_seen" />
                        <p class="field">
                            <label for="merge-into">@T["Merge_Into"]</label>
                            <select id="merge-into" name="Merging.Into" required>
                                <option value="">–</option>
                                @foreach (var other in others.Where(other => other.Value != Record))
                                {
                                    <option value="@other.Value" selected="@(other.Value == Merging?.Into)">@other.Label</option>
                                }
                            </select>
                        </p>
                        <WhoAndWhy Form="merge" Model="Merging" By="@(Merging?.By ?? Editor.Name)" Reason="@(Merging?.Reason ?? string.Empty)" />
                        <p><button type="submit" class="action danger">@T["Merge_Submit"]</button></p>
                    </form>
                </Allowed>
            </section>
        }

        <section aria-labelledby="remove">
            <h2 id="remove">@T["Remove_Title"]</h2>
            <p class="note">@T["Remove_Lead"]</p>
            <ActOutcome Problems="_removeProblems" />
            <Allowed Role="EditorRoles.Writer">
<form method="post" @formname="remove" @onsubmit="Remove" class="act" action="@Here">
                <AntiforgeryToken />
                <input type="hidden" name="@Seen.Input" value="@_seen" />
                <WhoAndWhy Form="remove" Model="Removing" By="@(Removing?.By ?? Editor.Name)" Reason="@(Removing?.Reason ?? string.Empty)" />
                <p><button type="submit" class="action danger">@T["Remove_Submit"]</button></p>
            </form>
</Allowed>
        </section>
    }
    else
    {
        @* The record was taken out; its history is still here. *@
        <p class="note" role="status">@T["Record_Gone"]</p>
    }

    <section aria-labelledby="history">
        <h2 id="history">@T["Record_History"]</h2>
        <ol class="changes" role="list">
            @foreach (var change in _history)
            {
                <li><ChangeView Change="change" /></li>
            }
        </ol>
    </section>
}

@code {
    private static readonly System.Text.Json.JsonSerializerOptions Indented = new() { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private RecordView? _record;
    private List<RecordChange> _history = [];
    private System.Collections.Immutable.ImmutableArray<(string Collection, string RecordId, string Label)> _sameTheme = [];
    private List<StatementState> _statements = [];
    private List<string>? _reviewProblems;
    private List<string>? _changeProblems;
    private List<string>? _fieldsProblems;
    private FormContext? _form;
    private JsonObject? _filled;
    private IReadOnlyList<(string Language, JsonObject Texts)> _texts = [];
    private IReadOnlyList<(string Language, JsonObject Texts)>? _filledTexts;
    private IReadOnlyList<(string Language, JsonObject Texts)> _dated = [];
    private IReadOnlyList<(string Language, JsonObject Texts)>? _filledDated;
    private string _seen = string.Empty;
    private List<string>? _removeProblems;
    private List<string>? _mergeProblems;
    private List<string>? _uploadProblems;
    private List<string>? _sizesProblems;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets the identifier of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the group of the record in the address.</summary>
    [Parameter]
    public string Group { get; set; } = string.Empty;

    /// <summary>Gets or sets the identifier of the record in the address.</summary>
    [Parameter]
    public string Record { get; set; } = string.Empty;

    /// <summary>Gets or sets what was just done, when the editor was sent back here after an act.</summary>
    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    /// <summary>Gets or sets what the form of a review was filled with.</summary>
    [SupplyParameterFromForm(FormName = "review")]
    public ReviewInput? Reviewing { get; set; }

    /// <summary>Gets or sets who filled in the fields of the record, and why.</summary>
    [SupplyParameterFromForm(FormName = "fields")]
    public FieldsInput? Filling { get; set; }

    /// <summary>Gets or sets what the form of a change was filled with.</summary>
    [SupplyParameterFromForm(FormName = "change")]
    public ChangeInput? Changing { get; set; }

    /// <summary>Gets or sets who brings a file in, and why.</summary>
    [SupplyParameterFromForm(FormName = "upload")]
    public FieldsInput? Uploading { get; set; }

    /// <summary>Gets or sets who makes the smaller sizes of an image, and why.</summary>
    [SupplyParameterFromForm(FormName = "sizes")]
    public FieldsInput? Sizing { get; set; }

    /// <summary>Gets or sets what the form that says the entity is the same as another one was filled with.</summary>
    [SupplyParameterFromForm(FormName = "merge")]
    public MergeInput? Merging { get; set; }

    /// <summary>Gets or sets what the form for taking the record out was filled with.</summary>
    [SupplyParameterFromForm(FormName = "remove")]
    public RemoveInput? Removing { get; set; }

    // The address of the page, to which its forms are sent and to which an act leads back.
    private string Here => $"{Collection}/record/{Group}/{Record}";

    protected override void OnInitialized()
    {
        // The newest change first. A record that never was in the store has no history and no page.
        _history = [.. Store.History(Collection, Group, Record).Reverse()];
        if (_history.Count == 0)
        {
            Navigation.NotFound();
            return;
        }

        _record = Store.Record(Collection, Group, Record);
        _sameTheme = Group == "entities" ? Store.SameThemeElsewhere(Collection, Record) : [];
        _form = _record is null ? null : FormContext.Of(Store, Collection);
        _texts = _record is null ? [] : Store.Texts(Collection, Group, Record);
        _dated = _record is null || Group != "entities" ? [] : Store.DatedTexts(Collection, Record);
        _seen = Seen.Of([_record?.Body.ToJsonString(), .. _texts.Select(text => text.Texts.ToJsonString()), .. _dated.Select(text => text.Texts.ToJsonString())]);

        // The statements of the record: itself when it is a relation or an event, its dated statements when it is an entity.
        _statements = [.. Store.Statements(Collection).Where(statement => statement.Group == Group && statement.Record == Record)];
    }

    private void Review()
    {
        var input = Reviewing ?? new ReviewInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var day = ActInput.Day(input.On);
        if (day is null)
        {
            problems.Add(T["Act_NeedsDay"]);
        }

        var known = Enum.TryParse<ReviewAct>(input.As, ignoreCase: true, out var act) && input.As!.All(char.IsLetter);
        if (!known)
        {
            problems.Add(T["Review_NeedsChoice"]);
        }

        if (!_statements.Any(statement => statement.Statement == input.Statement))
        {
            problems.Add(T["Review_NeedsStatement"]);
        }

        if (problems.Count == 0)
        {
            var result = Store.Review(Collection, input.Statement!, act, by!, day!.Value, input.Note, Read);
            if (Finished(result, by!, result.Changed == 0 ? "unchanged" : "reviewed"))
            {
                return;
            }

            problems.AddRange(result.Problems);
        }

        _reviewProblems = problems;
    }

    private void Fill()
    {
        if (_record is null)
        {
            return;
        }

        var input = Filling ?? new FieldsInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        var record = RecordForm.Read(Group, _record.Body, Context.Request.Form, _form!, problems);
        var texts = RecordForm.ReadTexts(Group, _record.Body, Context.Request.Form, _texts);
        var dated = Group == "entities" ? RecordForm.ReadDated(_record.Body, Context.Request.Form, _dated) : null;
        if (problems.Count == 0)
        {
            // The record and its texts in the other languages in one act: they are tried together.
            var result = Store.Put(Collection, Group, record, by!, reason!, texts, dated, Read);
            if (Finished(result, by!, result.Changed == 0 ? "unchanged" : "changed"))
            {
                return;
            }

            problems.AddRange(result.Problems);
        }

        // The form again, with what was filled in.
        _filled = RecordForm.Shown(_record.Body, record);
        _filledTexts = [.. _texts.Select(text => (text.Language, texts.GetValueOrDefault(text.Language) ?? text.Texts))];
        _filledDated = dated is null ? null : [.. _dated.Select(text => (text.Language, dated.GetValueOrDefault(text.Language) ?? text.Texts))];
        _fieldsProblems = problems;
    }

    private void Change()
    {
        var input = Changing ?? new ChangeInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        JsonObject? record = null;
        try
        {
            record = JsonNode.Parse(input.Json ?? string.Empty) as JsonObject;
            if (record is null)
            {
                problems.Add(string.Format(CultureInfo.CurrentCulture, T["Change_NotJson"], T["Change_NotAnObject"]));
            }
            else if ((record["id"] as JsonValue)?.TryGetValue<string>(out var id) != true || id != Record)
            {
                problems.Add(string.Format(CultureInfo.CurrentCulture, T["Change_OtherId"], Record));
            }
        }
        catch (System.Text.Json.JsonException refused)
        {
            problems.Add(string.Format(CultureInfo.CurrentCulture, T["Change_NotJson"], refused.Message));
        }

        if (problems.Count == 0)
        {
            var result = Store.Put(Collection, Group, record!, by!, reason!, read: Read);
            if (Finished(result, by!, result.Changed == 0 ? "unchanged" : "changed"))
            {
                return;
            }

            problems.AddRange(result.Problems);
        }

        _changeProblems = problems;
    }

    private void Upload()
    {
        var input = Uploading ?? new FieldsInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        var sent = Context.Request.Form.Files["file"];
        if (sent is null || sent.Length == 0)
        {
            problems.Add(T["Files_NeedsFile"]);
        }

        if (Store.FilesFolder is not { } folder)
        {
            problems.Add(T["Files_NoFolder"]);
        }
        else if (problems.Count == 0)
        {
            var part = Context.Request.Form["part"].ToString();
            var language = ActInput.Text(Context.Request.Form["language"]);
            using var content = sent!.OpenReadStream();
            var (file, refused) = MediaIntake.Take(folder, Record, part, language, content, MediaForm.Sizes);
            if (file is null)
            {
                problems.Add(refused!);
            }
            else
            {
                var record = MediaForm.With(_record!.Body, part, language, file);
                ActResult result;
                try
                {
                    result = record is null
                        ? new ActResult([T["Files_OtherKind"]])
                        : Store.Put(Collection, Group, record, by!, reason!, read: Read);
                }
                catch
                {
                    // The store failed instead of refusing: the file is named by no record and does not stay.
                    MediaIntake.Discard(file);
                    throw;
                }

                if (Finished(result, by!, "changed"))
                {
                    return;
                }

                // The record was not kept: the file that was brought in for it is not kept either.
                MediaIntake.Discard(file);
                problems.AddRange(result.Problems);
            }
        }

        _uploadProblems = problems;
    }

    // Makes the smaller sizes of an image that is there, and names them in its record – an act of an editor
    // like every change. A record that is refused takes the sizes that were made for it with it.
    private void MakeSizes()
    {
        var input = Sizing ?? new FieldsInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        if (problems.Count == 0)
        {
            var sizes = Store.FilesFolder is { } folder && MediaForm.FileWithoutSizes(_record!.Body, folder) is { } file
                ? MediaIntake.SizesOf(file, MediaForm.Sizes)
                : [];
            if (sizes.Count == 0)
            {
                problems.Add(T["Sizes_None"]);
            }
            else
            {
                var result = Store.Put(Collection, Group, MediaForm.WithSizes(_record!.Body, sizes), by!, reason!, read: Read);
                if (Finished(result, by!, "changed"))
                {
                    return;
                }

                foreach (var size in sizes)
                {
                    File.Delete(size.Path);
                }

                problems.AddRange(result.Problems);
            }
        }

        _sizesProblems = problems;
    }

    private void Merge()
    {
        var input = Merging ?? new MergeInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        var into = ActInput.Text(input.Into);
        if (into is null)
        {
            problems.Add(T["Merge_NeedsOther"]);
        }

        if (problems.Count == 0)
        {
            var result = Store.MergeEntities(Collection, into!, Record, by!, reason!);
            if (result.Done)
            {
                // The way leads to the entity that stays; this one keeps its page with its history.
                EditorName.Keep(Context, by!);
                Navigation.NavigateTo($"{Collection}/record/entities/{into}?done=merged");
                return;
            }

            problems.AddRange(result.Problems);
        }

        _mergeProblems = problems;
    }

    private void Remove()
    {
        var input = Removing ?? new RemoveInput();
        var problems = new List<string>();
        Fresh(problems);
        var by = Name(input.By, problems);
        var reason = Reason(input.Reason, problems);
        if (problems.Count == 0)
        {
            var result = Store.Remove(Collection, Record, by!, reason!, Group, Read);
            if (Finished(result, by!, "removed"))
            {
                return;
            }

            problems.AddRange(result.Problems);
        }

        _removeProblems = problems;
    }

    // The record as this request read it: the store refuses an act when somebody changed the record between
    // the look of this request and its own step.
    private ReadRecord? Read => _record is null ? null : new ReadRecord(Group, Record, _record.Info.Version);

    // A form that was opened before somebody else changed what it shows is not kept over that change.
    private void Fresh(List<string> problems)
    {
        if (!Seen.Holds(Context, _seen))
        {
            problems.Add(T["Act_Stale"]);
        }
    }

    private string? Name(string? given, List<string> problems)
    {
        var name = Editor.By(given);
        if (name is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        return name;
    }

    private string? Reason(string? given, List<string> problems)
    {
        var reason = ActInput.Text(given);
        if (reason is null)
        {
            problems.Add(T["Act_NeedsReason"]);
        }

        return reason;
    }

    // An act that was done leads back to the page, which then shows the record as it is now and says what was
    // done; loading the page again does not do the act again.
    private bool Finished(ActResult result, string by, string done)
    {
        if (!result.Done)
        {
            return false;
        }

        EditorName.Keep(Context, by);
        Navigation.NavigateTo($"{Here}?done={done}");
        return true;
    }

    private static string Written(JsonObject record) => record.ToJsonString(Indented);

    private static int Rows(string text) => Math.Clamp(text.Count(character => character == '\n') + 2, 8, 40);
}

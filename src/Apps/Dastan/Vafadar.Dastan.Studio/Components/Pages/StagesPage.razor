@page "/{Collection}/stages"
@using System.Collections.Immutable
@inject EditorialStore Store
@inject Editor Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@* The reading stages of a collection (step 12.5): their names in the language of the file and in the other
   languages, one form. A stage is added in the last row; the last stage is taken out by emptying its name. *@
@if (_stages.Count > 0)
{
    <PageTitle>@T["Stages_Title"] – @Collection – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@Collection"><bdi dir="ltr">@Collection</bdi></a></p>
        <h1>@T["Stages_Title"]</h1>
        <p class="lead">@T["Stages_Lead"]</p>
    </header>

    @if (Done is "changed" or "unchanged")
    {
        <p class="done" role="status">@T[$"Done_{Done}"]</p>
    }

    <ActOutcome Problems="_problems" />
    <form method="post" @formname="stages" @onsubmit="Keep" class="act" action="@Here">
        <AntiforgeryToken />
        @for (var level = 0; level <= _stages.Count; level++)
        {
            var index = level;
            <fieldset class="rows">
                <legend>@(index < _stages.Count ? string.Format(CultureInfo.CurrentCulture, T["Stages_Level"], Editor.Number(index)) : T["Stages_Add"])</legend>
                <p class="field">
                    <label for="@($"stage-{index}")"><code>label</code></label>
                    <input id="@($"stage-{index}")" name="@($"s[{index}]")" value="@Label(index)" maxlength="300" dir="auto" />
                </p>
                @foreach (var (language, labels) in _texts)
                {
                    <p class="field translated">
                        <label for="@($"stage-{index}-{language}")"><code>label</code><span class="language"> – <bdi dir="ltr">@language</bdi></span></label>
                        <input id="@($"stage-{index}-{language}")" name="@($"t.{language}[{index}]")" value="@Text(language, labels, index)" maxlength="300" dir="auto" lang="@language" />
                    </p>
                }
            </fieldset>
        }
        <WhoAndWhy Form="stages" Model="Keeping" By="@(Keeping?.By ?? Editor.Name)" Reason="@(Keeping?.Reason ?? string.Empty)" />
        <p><button type="submit" class="action">@T["Change_Submit"]</button></p>
    </form>
}

@code {
    private IReadOnlyList<(int Level, string Label)> _stages = [];
    private IReadOnlyList<(string Language, ImmutableArray<string?> Labels)> _texts = [];
    private List<string>? _problems;
    private bool _sent;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets the identifier of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets what was just done, when the editor was sent back here after an act.</summary>
    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    /// <summary>Gets or sets who changes the stages, and why.</summary>
    [SupplyParameterFromForm(FormName = "stages")]
    public FieldsInput? Keeping { get; set; }

    private string Here => $"{Collection}/stages";

    protected override void OnInitialized()
    {
        _stages = Store.Stages(Collection);
        if (_stages.Count == 0)
        {
            Navigation.NotFound();
            return;
        }

        _texts = Store.StageTexts(Collection);
    }

    // What an input starts with: what was sent when the form comes back refused, else what the store holds.
    private string Label(int level) =>
        _sent ? Sent($"s[{level}]") : level < _stages.Count ? _stages[level].Label : string.Empty;

    private string Text(string language, ImmutableArray<string?> labels, int level) =>
        _sent ? Sent($"t.{language}[{level}]") : level < labels.Length ? labels[level] ?? string.Empty : string.Empty;

    private string Sent(string name) => Context.Request.Form[name].ToString().Trim();

    private void Keep()
    {
        _sent = true;
        var input = Keeping ?? new FieldsInput();
        var problems = new List<string>();
        var by = Editor.By(input.By);
        if (by is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        var reason = ActInput.Text(input.Reason);
        if (reason is null)
        {
            problems.Add(T["Act_NeedsReason"]);
        }

        // The names as they were sent; empty names at the end are stages that are not there.
        var labels = Enumerable.Range(0, _stages.Count + 1).Select(level => Sent($"s[{level}]")).ToList();
        while (labels.Count > 0 && labels[^1].Length == 0)
        {
            labels.RemoveAt(labels.Count - 1);
        }

        if (labels.Count == 0 || labels.Any(label => label.Length == 0))
        {
            problems.Add(T["Stages_NeedsNames"]);
        }

        if (problems.Count == 0)
        {
            var texts = _texts.ToDictionary(
                text => text.Language,
                text => (IReadOnlyList<string?>)[.. Enumerable.Range(0, labels.Count).Select(level => (string?)Sent($"t.{text.Language}[{level}]"))],
                StringComparer.Ordinal);
            var result = Store.PutStages(Collection, labels, texts, by!, reason!);
            if (result.Done)
            {
                EditorName.Keep(Context, by!);
                Navigation.NavigateTo($"{Here}?done={(result.Changed == 0 ? "unchanged" : "changed")}");
                return;
            }

            problems.AddRange(result.Problems);
        }

        _problems = problems;
    }
}

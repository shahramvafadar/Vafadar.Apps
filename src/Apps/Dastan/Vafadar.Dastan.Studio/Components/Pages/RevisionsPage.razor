@page "/{Collection}/revisions"
@inject EditorialStore Store
@inject Editor Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_known)
{
    <PageTitle>@T["Revisions_Title"] – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@Collection"><bdi dir="ltr">@Collection</bdi></a></p>
        <h1>@T["Revisions_Title"]</h1>
        <p class="lead">@T["Revisions_Lead"]</p>
    </header>

    @if (Done == "published")
    {
        <p class="done" role="status">@T["Done_published"]</p>
    }

    @if (_revisions.Count == 0)
    {
        <p class="note" role="status">@T["Revisions_None"]</p>
    }
    else
    {
        <div class="table-frame" tabindex="0" role="region" aria-label="@T["Revisions_Title"]">
            <table class="list">
                <thead>
                    <tr>
                        <th scope="col">@T["Col_Number"]</th>
                        <th scope="col">@T["Col_Published"]</th>
                        <th scope="col">@T["Col_By"]</th>
                        <th scope="col">@T["Col_Note"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var revision in _revisions)
                    {
                        <tr>
                            <th scope="row">@Editor.Number(revision.Number)</th>
                            <td><bdi dir="ltr">@revision.PublishedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</bdi></td>
                            <td><bdi>@revision.By</bdi></td>
                            <td><bdi>@revision.Note</bdi></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    var next = (_revisions.Count == 0 ? 0 : _revisions[0].Number) + 1;
    <section aria-labelledby="publish">
        <h2 id="publish">@T["Publish_Title"]</h2>
        <p class="note">@string.Format(CultureInfo.CurrentCulture, T["Publish_Lead"], Editor.Number(next))</p>
        <ActOutcome Problems="_problems" />
        <form method="post" @formname="publish" @onsubmit="Publish" class="act" action="@($"{Collection}/revisions")">
            <AntiforgeryToken />
            <p class="field">
                <label for="publish-on">@T["Publish_On"]</label>
                <input id="publish-on" type="date" name="Publishing.On" value="@(Publishing?.On ?? ActInput.Day(Editor.Today))" required />
            </p>
            <p class="field">
                <label for="publish-note">@T["Publish_Note"]</label>
                <input id="publish-note" name="Publishing.Note" value="@Publishing?.Note" maxlength="500" dir="auto" />
            </p>
            <WhoAndWhy Form="publish" Model="Publishing" By="@(Publishing?.By ?? Editor.Name)" />
            <p><button type="submit" class="action">@string.Format(CultureInfo.CurrentCulture, T["Publish_Submit"], Editor.Number(next))</button></p>
        </form>
    </section>
}

@code {
    private bool _known;
    private List<RevisionInfo> _revisions = [];
    private List<string>? _problems;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets what was just done, when the editor was sent back here after publishing.</summary>
    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    /// <summary>Gets or sets what the form of a publication was filled with.</summary>
    [SupplyParameterFromForm(FormName = "publish")]
    public PublishInput? Publishing { get; set; }

    /// <summary>Gets or sets the identifier of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        _known = Store.Collections.Contains(Collection);
        if (!_known)
        {
            Navigation.NotFound();
            return;
        }

        // The newest revision first.
        _revisions = [.. Store.Revisions(Collection).Reverse()];
    }

    private void Publish()
    {
        var input = Publishing ?? new PublishInput();
        var problems = new List<string>();
        var by = ActInput.Text(input.By);
        var day = ActInput.Day(input.On);
        if (by is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        if (day is null)
        {
            problems.Add(T["Act_NeedsDay"]);
        }

        if (problems.Count == 0)
        {
            var result = Store.Publish(Collection, day!.Value, by!, input.Note);
            if (result.Revision is not null)
            {
                EditorName.Keep(Context, by!);
                Navigation.NavigateTo($"{Collection}/revisions?done=published");
                return;
            }

            problems.AddRange(result.Problems);
        }

        _problems = problems;
    }
}

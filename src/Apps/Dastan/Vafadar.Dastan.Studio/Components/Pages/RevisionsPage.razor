@page "/{Collection}/revisions"
@inject EditorialStore Store
@inject Editor Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_known)
{
    <PageTitle>@T["Revisions_Title"] – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@Collection"><bdi dir="ltr">@Collection</bdi></a></p>
        <h1>@T["Revisions_Title"]</h1>
        <p class="lead">@T["Revisions_Lead"]</p>
    </header>

    @if (Done is "published" or "released" or "withdrawn")
    {
        <p class="done" role="status">@T[$"Done_{Done}"]</p>
    }

    @if (_revisions.Count == 0)
    {
        <p class="note" role="status">@T["Revisions_None"]</p>
    }
    else
    {
        <div class="table-frame" tabindex="0" role="region" aria-label="@T["Revisions_Title"]">
            <table class="list">
                <thead>
                    <tr>
                        <th scope="col">@T["Col_Number"]</th>
                        <th scope="col">@T["Col_Published"]</th>
                        <th scope="col">@T["Col_By"]</th>
                        <th scope="col">@T["Col_Note"]</th>
                        <th scope="col">@T["Col_OnSite"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var revision in _revisions)
                    {
                        <tr>
                            <th scope="row">@Editor.Number(revision.Number)</th>
                            <td><bdi dir="ltr">@revision.PublishedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</bdi></td>
                            <td><bdi>@revision.By</bdi></td>
                            <td><bdi>@revision.Note</bdi></td>
                            <td>@if (revision.Number == _released) { <strong>@T["Release_Mark"]</strong> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_revisions.Count > 0)
    {
        <section aria-labelledby="release">
            <h2 id="release">@T["Release_Title"]</h2>
            <p class="note">@T["Release_Lead"]</p>
            <p role="status"><strong>@(_released is { } shown ? string.Format(CultureInfo.CurrentCulture, T["Release_Shown"], Editor.Number(shown)) : T["Release_None"])</strong></p>
            <ActOutcome Problems="_releaseProblems" />
            <Allowed Role="EditorRoles.Publisher">
<form method="post" @formname="release" @onsubmit="Release" class="act" action="@($"{Collection}/revisions")">
                <AntiforgeryToken />
                <p class="field">
                    <label for="release-number">@T["Release_Number"]</label>
                    <select id="release-number" name="Releasing.Number" required>
                        @foreach (var revision in _revisions)
                        {
                            <option value="@revision.Number.ToString(CultureInfo.InvariantCulture)" selected="@(revision.Number == (_released ?? _revisions[0].Number))">@string.Format(CultureInfo.CurrentCulture, T["Release_Option"], Editor.Number(revision.Number), Isolated(revision.PublishedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)))</option>
                        }
                    </select>
                </p>
                <WhoAndWhy Form="release" Model="Releasing" By="@(Releasing?.By ?? Editor.Name)" />
                <p><button type="submit" class="action">@T["Release_Submit"]</button></p>
            </form>
                @if (_released is not null)
                {
<form method="post" @formname="withdraw" @onsubmit="Withdraw" class="act" action="@($"{Collection}/revisions")">
                    <AntiforgeryToken />
                    <WhoAndWhy Form="withdraw" Model="Withdrawing" By="@(Withdrawing?.By ?? Editor.Name)" />
                    <p><button type="submit" class="action">@T["Withdraw_Submit"]</button></p>
                </form>
                }
</Allowed>
        </section>
    }

    var next = (_revisions.Count == 0 ? 0 : _revisions[0].Number) + 1;
    <section aria-labelledby="publish">
        <h2 id="publish">@T["Publish_Title"]</h2>
        <p class="note">@string.Format(CultureInfo.CurrentCulture, T["Publish_Lead"], Editor.Number(next))</p>
        @if (_notes.Length > 0)
        {
            @* What the profiles lack (ADR 0017): said before a revision is made, and stopping none. *@
            <details id="profile-notes">
                <summary>@string.Format(CultureInfo.CurrentCulture, T["Publish_Notes"], Editor.Number(_notes.Length))</summary>
                <p class="note">@T["Publish_Notes_Lead"]</p>
                <ul role="list">
                    @foreach (var note in _notes)
                    {
                        <li>
                            <a href="@($"{Collection}/record/entities/{note.Entity}#profile-facts")"><bdi>@note.Label</bdi></a>
                            <span class="meta">
                                – @if (note.NoPicture) { @T["Publish_Notes_NoPicture"] }
                                @if (note.NoPicture && !note.Missing.IsEmpty) { <text>; </text> }
                                @if (!note.Missing.IsEmpty) { @string.Format(CultureInfo.CurrentCulture, T["Publish_Notes_Missing"], string.Join(", ", note.Missing)) }
                            </span>
                        </li>
                    }
                </ul>
            </details>
        }
        <ActOutcome Problems="_problems" />
        <Allowed Role="EditorRoles.Publisher">
<form method="post" @formname="publish" @onsubmit="Publish" class="act" action="@($"{Collection}/revisions")">
            <AntiforgeryToken />
            <p class="field">
                <label for="publish-on">@T["Publish_On"]</label>
                <input id="publish-on" type="date" name="Publishing.On" value="@(Publishing?.On ?? ActInput.Day(Editor.Today))" required />
            </p>
            <p class="field">
                <label for="publish-note">@T["Publish_Note"]</label>
                <input id="publish-note" name="Publishing.Note" value="@Publishing?.Note" maxlength="500" dir="auto" />
            </p>
            <WhoAndWhy Form="publish" Model="Publishing" By="@(Publishing?.By ?? Editor.Name)" />
            <p><button type="submit" class="action">@string.Format(CultureInfo.CurrentCulture, T["Publish_Submit"], Editor.Number(next))</button></p>
        </form>
</Allowed>
    </section>
}

@code {
    private bool _known;
    private List<RevisionInfo> _revisions = [];
    private List<string>? _problems;
    private List<string>? _releaseProblems;
    private System.Collections.Immutable.ImmutableArray<ProfileNote> _notes = [];
    private int? _released;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets what was just done, when the editor was sent back here after publishing.</summary>
    [SupplyParameterFromQuery]
    public string? Done { get; set; }

    /// <summary>Gets or sets what the form of a publication was filled with.</summary>
    [SupplyParameterFromForm(FormName = "publish")]
    public PublishInput? Publishing { get; set; }

    /// <summary>Gets or sets what the form that releases a revision was filled with.</summary>
    [SupplyParameterFromForm(FormName = "release")]
    public ReleaseInput? Releasing { get; set; }

    /// <summary>Gets or sets what the form that withdraws the collection from the site was filled with.</summary>
    [SupplyParameterFromForm(FormName = "withdraw")]
    public ReleaseInput? Withdrawing { get; set; }

    /// <summary>Gets or sets the identifier of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        _known = Store.Collections.Contains(Collection);
        if (!_known)
        {
            Navigation.NotFound();
            return;
        }

        // The newest revision first.
        _revisions = [.. Store.Revisions(Collection).Reverse()];
        _released = Store.Released(Collection);
        _notes = Store.ProfileNotes(Collection);
    }

    // A day inside the text of an option, which can hold no element: kept in its own order, left to right,
    // by the marks of Unicode, so that a page that reads right to left does not turn its parts around.
    private static string Isolated(string leftToRight) => $"⁦{leftToRight}⁩";

    private void Release()
    {
        var input = Releasing ?? new ReleaseInput();
        var problems = new List<string>();
        var by = Editor.By(input.By);
        if (by is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        if (!int.TryParse(input.Number, NumberStyles.None, CultureInfo.InvariantCulture, out var number) || _revisions.All(revision => revision.Number != number))
        {
            problems.Add(T["Release_NeedsNumber"]);
        }

        Said(problems, by, store => store.Release(Collection, number, by!), "released");
    }

    private void Withdraw()
    {
        var problems = new List<string>();
        var by = Editor.By((Withdrawing ?? new ReleaseInput()).By);
        if (by is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        Said(problems, by, store => store.Withdraw(Collection, by!), "withdrawn");
    }

    // Says a word about what the site shows; the store may refuse it, and then says why.
    private void Said(List<string> problems, string? by, Func<EditorialStore, string?> say, string done)
    {
        if (problems.Count == 0)
        {
            if (say(Store) is not { } refused)
            {
                EditorName.Keep(Context, by!);
                Navigation.NavigateTo($"{Collection}/revisions?done={done}");
                return;
            }

            problems.Add(refused);
        }

        _releaseProblems = problems;
    }

    private void Publish()
    {
        var input = Publishing ?? new PublishInput();
        var problems = new List<string>();
        var by = Editor.By(input.By);
        var day = ActInput.Day(input.On);
        if (by is null)
        {
            problems.Add(T["Act_NeedsName"]);
        }

        if (day is null)
        {
            problems.Add(T["Act_NeedsDay"]);
        }

        if (problems.Count == 0)
        {
            var result = Store.Publish(Collection, day!.Value, by!, input.Note);
            if (result.Revision is not null)
            {
                EditorName.Keep(Context, by!);
                Navigation.NavigateTo($"{Collection}/revisions?done=published");
                return;
            }

            problems.AddRange(result.Problems);
        }

        _problems = problems;
    }
}

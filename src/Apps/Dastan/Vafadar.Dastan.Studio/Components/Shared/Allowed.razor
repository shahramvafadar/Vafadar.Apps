@* What only an editor with a role may do (step 13.3): the form for who has the role, a sentence for who has
   not. A form that is not on the page cannot be sent: the tool answers such a request with a refusal. *@
@inject Editor Editor
@inject IStringLocalizer<Ui> T

@if (Editor.May(Role))
{
    @ChildContent
}
else
{
    <p class="note" role="note">@T[$"Role_Needs_{Role}"]</p>
}

@code {
    /// <summary>Gets or sets the role the content needs.</summary>
    [Parameter, EditorRequired]
    public EditorRoles Role { get; set; }

    /// <summary>Gets or sets what the role may do.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;
}

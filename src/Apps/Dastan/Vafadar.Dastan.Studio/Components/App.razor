@inject Editor Editor
<!DOCTYPE html>
<html lang="@Editor.Language.Tag" dir="@Editor.Language.Direction" data-theme="@ThemePreference.Attribute(Editor.Theme)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Addresses in the pages are relative to the language of the page. *@
    <base href="@Base" />
    <link rel="stylesheet" href="@Assets["_content/Vafadar.Web/vafadar.css"]" />
    <link rel="stylesheet" href="@Assets["studio.css"]" />
    @* The tool is for the editors and for nobody who searches. *@
    <meta name="robots" content="noindex, nofollow" />
    <HeadOutlet />
</head>

<body>
    <Routes />
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    private string Base => $"{Context.Request.PathBase}/";
}

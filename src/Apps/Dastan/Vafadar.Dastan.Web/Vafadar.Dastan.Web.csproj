<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>The Dastan website: pages rendered on the server, texts in English and Persian, and the only place that turns a visitor's request into a projection of the collection.</Description>
    <!-- A page answers "not found" by setting the status, not by throwing (static server rendering). -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Dastan.Core\Vafadar.Dastan.Core.csproj" />
    <ProjectReference Include="..\Vafadar.Dastan.Data\Vafadar.Dastan.Data.csproj" />
    <ProjectReference Include="..\Vafadar.Dastan.People\Vafadar.Dastan.People.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Web\Vafadar.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The collection is input of the app, not a web asset: it is copied next to the program (content/), never under
      wwwroot. Only the app reads it; a visitor gets what the projection allows (ADR 0002).
    -->
    <!-- The picture for the preview of a link is drawn by the site (D-056, step 17.4). -->
    <PackageReference Include="SkiaSharp" />
    <!-- The coasts of the earth for the drawing of the places (D-057): Natural Earth, public domain. -->
    <EmbeddedResource Include="Data\coasts.txt" LogicalName="Vafadar.Dastan.Web.Data.coasts.txt" />
    <EmbeddedResource Include="Data\waters.txt" LogicalName="Vafadar.Dastan.Web.Data.waters.txt" />
    <!-- The legal texts of the site (LegalTexts): one file for a page and a language. -->
    <EmbeddedResource Include="Legal\*.txt" LogicalName="Vafadar.Dastan.Web.Legal.%(Filename)%(Extension)" WithCulture="false" />
    <Content Include="..\content\**\*" LinkBase="content" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <InternalsVisibleTo Include="Vafadar.Dastan.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Signing in through Google or Microsoft (step 16.8, D-048): the handlers of the framework. Nothing of them is used until the owner enters a client of each. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
  </ItemGroup>

  <!--
    The layer of TypeScript (ADR 0019): the sources in Scripts/ are checked by the compiler of TypeScript and
    made into the scripts of the site by a bundler – both with the versions the lock file names. The tools are
    fetched into obj/ and the scripts are made there, beside the other files of a build; nothing that is made
    is in the repository. The site serves them as its own files, under wwwroot. A build that got the scripts
    from elsewhere (the image of the container makes them in a stage of its own and puts them into wwwroot)
    says BuildDastanScripts=false.
  -->
  <PropertyGroup>
    <BuildDastanScripts Condition="'$(BuildDastanScripts)' == ''">true</BuildDastanScripts>
    <DastanScripts>$(MSBuildProjectDirectory)/Scripts</DastanScripts>
    <DastanScriptTools>$(MSBuildProjectDirectory)/obj/scripts</DastanScriptTools>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sources of the scripts are no pages of the site: nothing of the folder is published. -->
    <Content Remove="Scripts/**" />
    <None Remove="Scripts/**" />
    <DastanScriptSource Include="Scripts/src/**/*.ts;Scripts/build.mjs;Scripts/tsconfig.json;Scripts/package-lock.json" />
  </ItemGroup>

  <Target Name="RestoreDastanScripts" Condition="'$(BuildDastanScripts)' == 'true'" Inputs="Scripts/package.json;Scripts/package-lock.json;Scripts/.npmrc" Outputs="$(DastanScriptTools)/node_modules/.package-lock.json">
    <Copy SourceFiles="Scripts/package.json;Scripts/package-lock.json;Scripts/.npmrc" DestinationFolder="$(DastanScriptTools)" />
    <Exec Command="npm ci" WorkingDirectory="$(DastanScriptTools)" />
  </Target>

  <Target Name="BuildDastanScripts" DependsOnTargets="RestoreDastanScripts" Condition="'$(BuildDastanScripts)' == 'true'" Inputs="@(DastanScriptSource)" Outputs="$(DastanScriptTools)/built.stamp">
    <Copy SourceFiles="Scripts/build.mjs" DestinationFolder="$(DastanScriptTools)" />
    <Exec Command="node node_modules/typescript/bin/tsc --noEmit -p &quot;$(DastanScripts)/tsconfig.json&quot;" WorkingDirectory="$(DastanScriptTools)" />
    <Exec Command="node build.mjs &quot;$(DastanScripts)/src&quot; &quot;$(DastanScriptTools)/out&quot;" WorkingDirectory="$(DastanScriptTools)" />
    <Touch Files="$(DastanScriptTools)/built.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    What was made is named as files of the site, the way the SDK names a file it made itself: obj/scripts/out/app.js
    is served as wwwroot/app.js would be, under a name that changes with its content, while the site is developed
    and when it is published.
  -->
  <Target Name="IncludeDastanScripts" DependsOnTargets="BuildDastanScripts;ResolveStaticWebAssetsConfiguration" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(BuildDastanScripts)' == 'true'">
    <ItemGroup>
      <DastanScriptMade Include="obj/scripts/out/*.js" />
    </ItemGroup>
    <Error Condition="'@(DastanScriptMade)' == ''" Text="The scripts of the site were not made (see Scripts/build.mjs)." />
    <DefineStaticWebAssets
      CandidateAssets="@(DastanScriptMade)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="obj/scripts/out/**"
      SourceType="Computed"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'scripts', 'out'))"
      BasePath="$(StaticWebAssetBasePath)"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DastanScriptAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_DastanScriptAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

</Project>

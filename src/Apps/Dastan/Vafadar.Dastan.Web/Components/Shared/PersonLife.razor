@using Vafadar.Dastan.People
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T

@* When a person of a family tree was born and died, as the head of the record says it (D-086): two facts, each
   on one line. What is not known is said to be not known; somebody who lives has no time of death. *@
<dl class="facts profile-facts compact">
    <dt>@T["Fact_born"]</dt>
    @Time(Person.Born)
    <dt>@T["Fact_died"]</dt>
    @if (Person.Deceased)
    {
        @Time(Person.Died)
    }
    else
    {
        <dd>@T["Fact_died_None"]</dd>
    }
</dl>

@code {
    /// <summary>Gets or sets the person, as who looks may see them.</summary>
    [Parameter, EditorRequired]
    public TreePerson Person { get; set; } = null!;

    private RenderFragment Time(Vafadar.Temporal.TemporalExpression? time) => __builder =>
    {
        if (time is null or Vafadar.Temporal.UnknownTime)
        {
            <dd class="unknown">@T["Profile_Unknown"]</dd>
        }
        else
        {
            <dd><bdi>@TimeText.Of(time, Visitor, T)</bdi></dd>
        }
    };
}

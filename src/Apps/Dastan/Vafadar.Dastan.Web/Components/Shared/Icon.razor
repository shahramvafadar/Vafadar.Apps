@* A small drawing beside words (step 20.5). The drawings are Dastan's own – lines on a grid of 24, drawn for
   this site and recorded in docs/adr/0024-parts.md – so no page asks another site for one and no licence of
   somebody else applies. A drawing is decoration: the words beside it say what it stands for, and where a
   control shows the drawing alone the control carries the words for a screen reader. *@
<svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "discover":
            @* A compass. *@
            <circle cx="12" cy="12" r="8.5" />
            <path d="M15.500 8.500 13.400 13.400 8.500 15.500 10.600 10.600z" />
            break;
        case "world":
            @* Somebody among those they know. *@
            <circle cx="12" cy="7" r="2.600" />
            <circle cx="5.500" cy="16.500" r="2.200" />
            <circle cx="18.500" cy="16.500" r="2.200" />
            <path d="M10.700 9.300 6.800 14.700M13.300 9.300 17.200 14.700M7.700 16.500h8.600" />
            break;
        case "compare":
            @* Three lanes of different lengths and one line across them: what was at the same time. *@
            <path d="M3 7h10M7 12h14M3 17h8M15 3.500v17" />
            break;
        case "saved":
            @* A marker in a book. *@
            <path d="M7 4h10v16.500l-5-4-5 4z" />
            break;
        case "search":
            <circle cx="10.500" cy="10.500" r="6" />
            <path d="M15 15l5 5" />
            break;
        case "account":
            <circle cx="12" cy="8.500" r="3.500" />
            <path d="M5 20c0-3.900 3.100-6 7-6s7 2.100 7 6" />
            break;
        case "settings":
            @* Three sliders. *@
            <path d="M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1" />
            <circle cx="15" cy="7" r="2" />
            <circle cx="9" cy="12" r="2" />
            <circle cx="17" cy="17" r="2" />
            break;
        case "connections":
            <circle cx="6" cy="6" r="2.300" />
            <circle cx="18" cy="9" r="2.300" />
            <circle cx="9" cy="18" r="2.300" />
            <path d="M8.200 6.600 15.800 8.400M6.700 8.200 8.300 15.800M16.400 10.800 10.600 16.400" />
            break;
        case "timeline":
            <path d="M3 12h18M7 12V7M12 12v5M17 12V8" />
            <circle cx="7" cy="5.500" r="1.500" />
            <circle cx="12" cy="18.500" r="1.500" />
            <circle cx="17" cy="6.500" r="1.500" />
            break;
        case "pictures":
            <rect x="3.500" y="5" width="17" height="14" rx="2" />
            <circle cx="9" cy="10" r="1.700" />
            <path d="M4 17l5-4.500 3.500 3 3-2.500 4.500 4" />
            break;
        case "overview":
            @* A card: a picture and lines. *@
            <rect x="3.500" y="5" width="17" height="14" rx="2" />
            <circle cx="8.500" cy="10.500" r="2" />
            <path d="M13 9.500h4.500M13 13h4.500M6 16h11.500" />
            break;
        case "family":
            @* Two above, one below. *@
            <circle cx="7" cy="6.500" r="2.300" />
            <circle cx="17" cy="6.500" r="2.300" />
            <circle cx="12" cy="17.500" r="2.300" />
            <path d="M9.300 6.500h5.400M12 6.500v8.700" />
            break;
        case "story":
            @* An open book. *@
            <path d="M12 6.500C10 5 7 4.500 3.500 5v13c3.500-.500 6.500 0 8.500 1.500 2-1.500 5-2 8.500-1.500V5C17 4.500 14 5 12 6.500z" />
            <path d="M12 6.500V19.500" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="8.500" />
            <path d="M3.500 12h17M12 3.500c-5 5-5 12 0 17M12 3.500c5 5 5 12 0 17" />
            break;
        case "waiting":
            @* A clock: something goes on. *@
            <circle cx="12" cy="12" r="8.500" />
            <path d="M12 7v5l3.500 2" />
            break;
        case "nothing":
            @* An empty tray. *@
            <path d="M4 13l2.500-7h11L20 13v5.500H4z" />
            <path d="M4 13h4.500l1 2.500h5l1-2.500H20" />
            break;
        case "failed":
            <path d="M12 4 21 19.500H3z" />
            <path d="M12 10v4.500M12 17v.300" />
            break;
        case "war":
            @* Two crossed swords: a war, a battle, a siege, a field of battle (ADR 0029). *@
            <path d="M5 5l11 11M19 5 8 16M14 18l4-4M6 14l4 4M4 20l2-2M20 20l-2-2" />
            break;
        case "flag":
            @* A flag on its pole: a revolt, a conquest. *@
            <path d="M6 21V4M6 4h11l-2.500 3.500L17 11H6" />
            break;
        case "scroll":
            @* A written sheet: a treaty, a history, an inscription, who writes for a state. *@
            <path d="M7 4h11v13a3 3 0 0 1-3 3H6a2 2 0 0 1-2-2v-2h11v2" />
            <path d="M10 8h5M10 11h5" />
            break;
        case "building":
            @* A house under its roof: a founding, a building made. *@
            <path d="M4 20h16M6 20v-9M18 20v-9M3 11l9-6 9 6z" />
            <path d="M10 20v-5h4v5" />
            break;
        case "nature":
            @* A cloud and what falls from it: what nature does. *@
            <path d="M7 15a4 4 0 0 1 .500-8 5 5 0 0 1 9.500 1.500A3.300 3.300 0 0 1 17 15z" />
            <path d="M9 18l-1 2M13 18l-1 2M17 18l-1 2" />
            break;
        case "river":
            @* Three waves: water that runs or rises. *@
            <path d="M3 8c3-2 6 2 9 0s6-2 9 0M3 13c3-2 6 2 9 0s6-2 9 0M3 18c3-2 6 2 9 0s6-2 9 0" />
            break;
        case "faith":
            @* A dome: what belongs to a faith. *@
            <path d="M5 20h14M7 20v-7a5 5 0 0 1 10 0v7M12 4v4M10.500 5.500h3" />
            break;
        case "candle":
            @* A candle: a death. *@
            <path d="M10 9h4v11h-4zM12 9V7" />
            <path d="M12 3.500c1 1.200 1 2.300 0 3-1-.700-1-1.800 0-3z" />
            break;
        case "crown":
            @* A crown: who rules, a king, a capital. *@
            <path d="M4 18h16M4 18 3 8l5 4 4-6 4 6 5-4-1 10" />
            break;
        case "pen":
            @* A pen of a feather: who writes poems and books, and a poem. *@
            <path d="M19 4C13 5 8 10 6 17l-1 3 3-1c7-2 12-7 11-15z" />
            <path d="M6 17l6-6" />
            break;
        case "learning":
            @* A flask: who learns and finds, a discovery. *@
            <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.800 3h10.400a2 2 0 0 0 1.800-3l-5-9V3" />
            <path d="M7.500 15h9" />
            break;
        case "art":
            @* A palette: who makes art. *@
            <path d="M12 4a8 8 0 1 0 0 16c1.500 0 2-1 1.500-2s0-2 1.500-2h2a3 3 0 0 0 3-3c0-5-3.600-9-8-9z" />
            <circle cx="8" cy="10" r="1" />
            <circle cx="12" cy="7.500" r="1" />
            <circle cx="16" cy="10" r="1" />
            break;
        case "hero":
            @* A shield: a hero of a story. *@
            <path d="M12 3l7 3v5c0 4.500-3 8-7 10-4-2-7-5.500-7-10V6z" />
            break;
        case "demon":
            @* A head with horns: a demon of a story. *@
            <circle cx="12" cy="14" r="5.500" />
            <path d="M7.500 10.500 5 4l4.500 4M16.500 10.500 19 4l-4.500 4" />
            break;
        case "divine":
            @* A sun: a being of the other world. *@
            <circle cx="12" cy="12" r="3.500" />
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.600 5.600l2.100 2.100M16.300 16.300l2.100 2.100M5.600 18.400l2.100-2.100M16.300 7.700l2.100-2.100" />
            break;
        case "creature":
            @* A paw: a creature of a story. *@
            <circle cx="7" cy="9" r="1.800" />
            <circle cx="11" cy="6" r="1.800" />
            <circle cx="15.500" cy="7" r="1.800" />
            <circle cx="18" cy="11" r="1.800" />
            <path d="M8 17c0-3 2-5 4.500-5S17 14 17 17c0 2-2 3-4.500 2S8 19 8 17z" />
            break;
        case "city":
            @* Houses of different heights: a city. *@
            <path d="M3 20h18M5 20V10h5v10M10 20V5h6v15M16 20v-8h3v8" />
            break;
        case "mountain":
            @* Two peaks: a mountain. *@
            <path d="M3 19 9.500 8l3.500 6 2.500-4L21 19z" />
            break;
        case "monument":
            @* An obelisk: a monument. *@
            <path d="M10 20 11 6l1-2 1 2 1 14zM7 20h10" />
            break;
        default:
            <circle cx="12" cy="12" r="3" />
            break;
    }
</svg>

@code {
    /// <summary>The drawings there are, by their names.</summary>
    public static readonly string[] Names = ["discover", "compare", "world", "saved", "search", "account", "settings", "connections", "timeline", "pictures", "overview", "family", "story", "globe", "waiting", "nothing", "failed",
        "war", "flag", "scroll", "building", "nature", "river", "faith", "candle", "crown", "pen", "learning", "art", "hero", "demon", "divine", "creature", "city", "mountain", "monument"];

    /// <summary>Gets or sets the name of the drawing.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;
}

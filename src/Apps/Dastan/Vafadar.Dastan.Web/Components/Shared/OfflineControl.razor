@inject Visitor Visitor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@* Keeping pages on the device for a time without a connection is more than the site needs to work, so it is
   done only when the visitor says so, and stopped as easily (§ 25 TDDDG). *@
<section class="card" id="offline" aria-labelledby="offline-title">
    <h2 id="offline-title">@T["Offline_Title"]</h2>
    <p>@T["Offline_Lead"]</p>
    <p class="note" role="status">@T[_on ? "Offline_IsOn" : "Offline_IsOff"]</p>
    <form method="post" action="/preferences/offline" class="save">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@_here" />
        @if (_on)
        {
            <button type="submit" name="answer" value="off">@T["Offline_TurnOff"]</button>
        }
        else
        {
            <button type="submit" name="answer" value="on" class="action secondary">@T["Offline_TurnOn"]</button>
        }
    </form>
</section>

@code {
    private bool _on;
    private string _here = "/";

    protected override void OnInitialized()
    {
        _on = Visitor.KeepsOffline;
        _here = $"/{Visitor.Language.Tag}/{Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]}#offline";
    }
}

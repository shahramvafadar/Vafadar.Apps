@* The places of a collection on a grid of degrees: SVG written by the server (ADR 0008). The drawing is laid
   out the same in every language – east is at the right – and only its texts follow the language of the page.
   A mark carries the number its place has in the list of the page and leads to it; the name is its title. *@
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T

@* A place in the drawing is measured in the font of the drawing; only the letters are smaller, so their size is
   on a span inside the text (as in the chart of time). *@
@* The drawing is measured in the font, and its box of view is the same measure in the units of the drawing (a
   letter of the drawing is 16 of them): so it can grow to fill its stage, letters and marks with it. It is never
   smaller than it was drawn: an empty drawing of the same size holds the place open (the policy of the site
   allows no style written into an element, so the least size cannot stand on the map itself). *@
<div class="places-fit">
<svg class="places-room" width="@Em(Map.Width + (2 * Pad))" height="@Em(Map.Height + (2 * Pad))" aria-hidden="true"></svg>
<svg class="places-map" width="@Em(Map.Width + (2 * Pad))" height="@Em(Map.Height + (2 * Pad))"
     viewBox="0 0 @Number((Map.Width + (2 * Pad)) * Unit) @Number((Map.Height + (2 * Pad)) * Unit)" dir="ltr">
    <rect class="map-ground" x="@Em(Pad)" y="@Em(Pad)" width="@Em(Map.Width)" height="@Em(Map.Height)" />
    @if (!Map.Coasts.IsEmpty || !Map.Waters.IsEmpty)
    {
        @* The coasts lie under the grid, in a drawing of their own whose measure is that of the map: a path
           cannot be measured in the font, the frame around it can. They say nothing a reader has to hear. *@
        <svg class="map-coasts" x="@Em(Pad)" y="@Em(Pad)" width="@Em(Map.Width)" height="@Em(Map.Height)" viewBox="0 0 @Number(Map.Width) @Number(Map.Height)" preserveAspectRatio="none" aria-hidden="true">
            @foreach (var water in Map.Waters)
            {
                <path class="map-water" d="@water" />
            }
            @foreach (var coast in Map.Coasts)
            {
                <path d="@coast" />
            }
        </svg>
    }
    @foreach (var line in Map.Meridians)
    {
        <g>
            <line class="map-grid" x1="@Em(Pad + line.At)" y1="@Em(Pad)" x2="@Em(Pad + line.At)" y2="@Em(Pad + Map.Height)" />
            <text x="@Em(Pad + line.At)" y="@Em(Pad - 0.4)" text-anchor="middle" direction="@Visitor.Language.Direction"><tspan class="map-degrees">@Degrees(line.Degrees, "Position_East", "Position_West")</tspan></text>
        </g>
    }
    @foreach (var line in Map.Parallels)
    {
        <g>
            <line class="map-grid" x1="@Em(Pad)" y1="@Em(Pad + line.At)" x2="@Em(Pad + Map.Width)" y2="@Em(Pad + line.At)" />
            <text x="@Em(Pad - 0.3)" y="@Em(Pad + line.At + 0.25)" text-anchor="@(Visitor.Language.IsRightToLeft ? "start" : "end")" direction="@Visitor.Language.Direction"><tspan class="map-degrees">@Degrees(line.Degrees, "Position_North", "Position_South")</tspan></text>
        </g>
    }
    @foreach (var mark in Map.Marks)
    {
        var name = Visitor.Text(mark.Place.Place.Label).Value;
        <a class="map-mark @(mark.Place.Position.Precision == PositionPrecision.Exact ? null : "map-about")" href="@($"{Here}#place-{mark.Place.Place.Id}")">
            <title>@string.Format(CultureInfo.CurrentCulture, T["Places_Mark"], Visitor.Number(mark.Number), name)</title>
            @* What is pressed is larger than what is seen: 44 pixels across. *@
            <circle class="chart-hit" cx="@Em(Pad + mark.X)" cy="@Em(Pad + mark.Y)" r="1.375rem" />
            <circle cx="@Em(Pad + mark.X)" cy="@Em(Pad + mark.Y)" r="@Em(mark.Place.Position.Precision == PositionPrecision.CentreOfArea ? 1.3 : 0.85)" />
            <text x="@Em(Pad + mark.X)" y="@Em(Pad + mark.Y + 0.27)" text-anchor="middle"><tspan class="map-number">@Visitor.Number(mark.Number)</tspan></text>
        </a>
    }
</svg>
</div>

@code {
    // The room around the drawing for the degrees of its grid.
    private const double Pad = 3.2;

    // A letter of the drawing (1rem) in the units of its box of view.
    private const double Unit = 16;

    /// <summary>Gets or sets the drawing.</summary>
    [Parameter, EditorRequired]
    public PlacesMap Map { get; set; } = null!;

    /// <summary>Gets or sets the address of the page, which the marks lead back into.</summary>
    [Parameter, EditorRequired]
    public string Here { get; set; } = string.Empty;

    private static string Em(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "em";

    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private string Degrees(decimal degrees, string positive, string negative) => degrees == 0
        ? QuantityText.Number(0, Visitor) + "°"
        : string.Format(CultureInfo.CurrentCulture, T["Places_Degrees"], QuantityText.Number(Math.Abs(degrees), Visitor), T[degrees < 0 ? negative : positive]);
}

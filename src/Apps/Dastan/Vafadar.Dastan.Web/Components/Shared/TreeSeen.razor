@using Vafadar.Dastan.People
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T

@* A tree as somebody else sees it (step 19.6, PRIV-015): the drawing and the people with their years and how
   they belong together – to read, with nothing to do. *@
@if (TreeEndpoints.Placement(Tree) is { } placement)
{
    <ChartStage Id="drawing" Class="stage-fitted" Label="@string.Format(CultureInfo.CurrentCulture, T["Tree_Drawing_Label"], Tree.Tree.Name)">
        <TreeDrawing Tree="placement">
            <Box Context="id">
                <span class="graph-entity">
                    <a class="graph-name" href="@($"{Address}#person-{id}")" dir="auto">@Tree.Person(id).Name</a>
                </span>
            </Box>
        </TreeDrawing>
    </ChartStage>
}

<section aria-labelledby="seen-people">
    <h2 id="seen-people">@T["Tree_People_Title"]</h2>
    @if (Tree.People.IsEmpty)
    {
        <p class="note">@T["Tree_People_None"]</p>
    }
    else
    {
        <ul class="tree-people" role="list">
            @foreach (var person in Tree.People)
            {
                <li id="@($"person-{person.Id}")">
                    <p><strong dir="auto">@person.Name</strong> <span class="meta">@TreeEndpoints.Years(person, T, Visitor)</span></p>
                    @if (!person.Parents.IsEmpty)
                    {
                        <p class="meta">@T["Tree_Parents"] @Named(person.Parents)</p>
                    }
                    @if (!person.Partners.IsEmpty)
                    {
                        <p class="meta">@T["Tree_Partners"] @Named(person.Partners)</p>
                    }
                    @if (!person.Children.IsEmpty)
                    {
                        <p class="meta">@T["Tree_Children"] @Named(person.Children)</p>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>Gets or sets the tree, as it is seen.</summary>
    [Parameter, EditorRequired]
    public TreeView Tree { get; set; } = null!;

    /// <summary>Gets or sets the address of the page, with what it was asked with, for the links of the drawing.</summary>
    [Parameter, EditorRequired]
    public string Address { get; set; } = string.Empty;

    private string Named(System.Collections.Immutable.ImmutableArray<string> people) => string.Join(T["Tree_And"], people.Select(person => Tree.Person(person).Name));
}

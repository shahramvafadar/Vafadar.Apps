@* The card of a node (step 19.5, ADR 0017): its picture or the drawing of its kind, its name as the link to
   its page, its kind, and up to three stated facts – what a list, a search result and a graph show of a node.
   It comes from the same projection as the page, so it never shows what the page of this visitor would not. *@
@inject DastanSite Site
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T

<div class="@(Tall ? "node-card tall" : "node-card")">
    @* A node of another collection shows the drawing of its kind: its picture is asked of its own pages. *@
    <ProfilePicture Profile="@(Collection is null || Collection == Site.Collection ? Profile : Profile with { Picture = null })" Small="!Tall" />
    <div class="node-card-words">
        @if (Level == 2)
        {
            <h2><a href="@_address"><Loc Text="Profile.Entity.Label" /></a></h2>
        }
        else
        {
            <h3><a href="@_address"><Loc Text="Profile.Entity.Label" /></a></h3>
        }
        <p class="meta"><TypeName Type="Profile.Entity.Type" /> <KindNames Kinds="Profile.Entity.Kinds" /></p>
        @if (Summary)
        {
            <p><Loc Text="Profile.Entity.Summary" /></p>
        }
        @if (!Profile.Card.IsEmpty)
        {
            <ProfileFactList Lines="Profile.Card" Compact="true" />
        }
        @* A look at the whole profile without leaving the list (ADR 0019): offered by the script of the site,
           which fills a panel from the address of the profile. Without the script the name leads to the page. *@
        <p class="peek" data-profile-peek hidden>
            <button type="button" data-profile="@($"{_address}{ProfileDataEndpoints.Ending}")" data-name="@_name">@T["Profile_Peek"]<span class="visually-hidden"> – @_name</span></button>
        </p>
    </div>
</div>

@code {
    private string _address = string.Empty;
    private string _name = string.Empty;

    /// <summary>Gets or sets the profile, as the visitor of this request may see it.</summary>
    [Parameter, EditorRequired]
    public NodeProfile Profile { get; set; } = null!;

    /// <summary>Gets or sets a value indicating whether the summary of the node is shown too – in a list that has the room.</summary>
    [Parameter]
    public bool Summary { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the picture stands above the words, as wide as the card
    /// (step 20.5): a card of a grid that lives from its pictures. Without a picture the drawing of the kind
    /// stands there, on a lower ground – it never pretends to be a picture.
    /// </summary>
    [Parameter]
    public bool Tall { get; set; }

    /// <summary>Gets or sets the level of the heading the name is: 3 in a list under a heading of a section, 2 directly under the title of a page.</summary>
    [Parameter]
    public int Level { get; set; } = 3;

    /// <summary>
    /// Gets or sets the collection the node is of, when it is not the collection of the page – a card of the start
    /// that shows names of several collections (D-096).
    /// </summary>
    [Parameter]
    public string? Collection { get; set; }

    protected override void OnParametersSet() =>
        (_address, _name) = ($"{Collection ?? Site.Collection}/entity/{Profile.Entity.Id}", Visitor.Text(Profile.Entity.Label).Value);
}

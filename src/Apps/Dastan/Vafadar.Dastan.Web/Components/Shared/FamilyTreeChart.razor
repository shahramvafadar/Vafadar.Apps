@* The family of an entity of a collection as a tree. The drawing itself is TreeDrawing, which also draws the
   trees of visitors; this component says what a box holds – the name of the entity, leading to its page – and
   which lines stand for a disputed relation. *@
@inject DastanSite Site

<TreeDrawing Tree="_placement" Focus="@Focus.Value" GenerationsAcross="GenerationsAcross"
             DisputedParentage="number => Tree.Parentage[number].Relation.Relation.Review == ReviewStatus.Disputed"
             DisputedPartnership="number => Tree.Partnerships[number].Relation.Review == ReviewStatus.Disputed">
    <Box Context="id">
        @{
            var entity = Tree.Node(new EntityId(id)).Entity;
        }
        <span class="graph-entity">
            <a class="graph-name" href="@($"{Site.Collection}/entity/{entity.Id}")"><Loc Text="entity.Label" /></a>
        </span>
    </Box>
</TreeDrawing>

@code {
    private TreePlacement _placement = null!;

    /// <summary>Gets or sets the tree.</summary>
    [Parameter, EditorRequired]
    public FamilyTree Tree { get; set; } = null!;

    /// <summary>Gets or sets the member the page is about.</summary>
    [Parameter, EditorRequired]
    public EntityId Focus { get; set; }

    /// <summary>Gets or sets a value indicating whether generations run across the page instead of down it.</summary>
    [Parameter]
    public bool GenerationsAcross { get; set; }

    protected override void OnParametersSet() => _placement = new TreePlacement(
        [.. Tree.Nodes.Select(node => new PlacedMember(node.Entity.Id.Value, node.Layer, node.Place))],
        [.. Tree.Parentage.Select(route => new PlacedRoute(route.Relation.From.Id.Value, route.Relation.To.Id.Value, route.Port, route.Track))],
        [.. Tree.Partnerships.Select(edge => new TreeShapeLink(edge.From.Id.Value, edge.To.Id.Value))],
        Tree.Layers,
        Tree.Breadth,
        Tree.Lines,
        Tree.Crossings);
}

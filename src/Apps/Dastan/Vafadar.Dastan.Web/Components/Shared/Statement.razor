@* One relation as a sentence: first entity, label, second entity – in the direction the relation states, whoever
   is looked at. The entity of the page is plain text, the other one is the link to follow. *@
@inject DastanSite Site

<span class="statement">
    @End(Relation.From)
    <span class="relation"><Loc Text="Relation.Relation.Label" /></span>
    @End(Relation.To)
</span>

@code {
    /// <summary>Gets or sets the relation with its two entities.</summary>
    [Parameter, EditorRequired]
    public Edge Relation { get; set; } = null!;

    /// <summary>Gets or sets the entity the page is about.</summary>
    [Parameter]
    public EntityId? Self { get; set; }

    private RenderFragment End(Entity entity) => entity.Id == Self
        ? @<strong class="self"><Loc Text="entity.Label" /></strong>
        : @<a href="@($"{Site.Collection}/entity/{entity.Id}")"><Loc Text="entity.Label" /></a>;
}

@* What a place of a page says when it has nothing to show yet (step 20.5, ADR 0024): something goes on,
   nothing is here, or something went wrong. Each is said in words, with a small drawing, and may offer what
   to do next. "Went wrong" is said aloud at once; the two others when a screen reader comes to them. *@
<div class="state state-@Kind" role="@(Kind == "failed" ? "alert" : "status")">
    <Icon Name="@Kind" />
    <div class="state-words">
        <p>@Text</p>
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Gets or sets which state it is: <c>waiting</c>, <c>nothing</c> or <c>failed</c>.</summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = "nothing";

    /// <summary>Gets or sets what is said.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>Gets or sets what the visitor can do next: a link, a button.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

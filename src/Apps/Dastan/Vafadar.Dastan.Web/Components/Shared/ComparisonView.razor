@* A comparison as a chart on its stage and as a table (ADR 0008): the tools that say how the chart is looked at,
   the chart across the page and down it, and the same lanes as a table. A page gives it what it compares, the
   address the choices are written to, and how the visitor asked to look at it. *@
@using Vafadar.Temporal
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T

@* How the chart is looked at lives in the address: every choice is a link, and Back undoes it (ADR 0008). *@
<nav class="chart-tools" aria-label="@T["Chart_Tools"]">
    <p class="chart-tool">
        <span class="chart-tool-name">@T["Chart_View"]</span>
        @Choice(_state with { Direction = ChartDirection.Fit }, T["Chart_View_Fit"])
        @Choice(_state with { Direction = ChartDirection.Across }, T["Chart_View_Across"])
        @Choice(_state with { Direction = ChartDirection.Down }, T["Chart_View_Down"])
    </p>
    <p class="chart-tool">
        <span class="chart-tool-name">@T["Chart_Zoom"]</span>
        @Step(_state.Scale > 0 ? _state with { Scale = _state.Scale - 1 } : null, T["Chart_ZoomOut"])
        @Step(_state.Scale < ChartState.Scales.Length - 1 ? _state with { Scale = _state.Scale + 1 } : null, T["Chart_ZoomIn"])
    </p>
    <p class="chart-tool">
        <span class="chart-tool-name">@T["Chart_Stretch"]</span>
        @Choice(_state with { From = null, To = null }, T["Chart_Own"])
        @if (Everything() is { } everything)
        {
            @Choice(everything, T["Chart_Everything"])
        }
    </p>
</nav>

<p class="meta">@string.Format(CultureInfo.CurrentCulture, T["Chart_Shown"], YearAt(_from), YearAt(_to - 1))</p>

@* The chart is opened and closed at its sides (D-040): the time at the two sides it runs between, the single
   events where their callouts stand, the lanes where the last lane ends. *@
@{
    var label = string.Format(CultureInfo.CurrentCulture, T["Chart_Region"], Visitor.Text(Comparison.Title).Value);
    RenderFragment Earlier(string stage) => Steps(stage, T["Chart_Edge_Earlier"], Stretch(_from + _step, _to), Stretch(_from - _step, _to));
RenderFragment Later(string stage) => Steps(stage, T["Chart_Edge_Later"], Stretch(_from, _to - _step), Stretch(_from, _to + _step));
RenderFragment Events(string stage) => Steps(
    stage,
    T["Chart_Events"],
    _state.Events && _hasEvents ? _state with { Events = false } : null,
    _state.Events ? null : _state with { Events = true });
RenderFragment Lanes(string stage) => Steps(
    stage,
    T["Chart_Edge_Lanes"],
    _shown > 1 ? _state with { Lanes = _shown - 1 } : null,
    _shown < _chart.Lanes.Length ? _state with { Lanes = _shown + 1 == _chart.Lanes.Length ? null : _shown + 1 } : null);
}

@if (_across is not null)
{
    <ChartStage Id="chart-across" Label="@label" FrameDirection="ltr" Left="@Earlier("chart-across")" Right="@Later("chart-across")" Top="@Events("chart-across")" Bottom="@Lanes("chart-across")" Class="@(_down is null ? null : "only-wide")">
        <TimelineChart Drawing="_across" Texts="Words" Here="@_here" LongNames="LongNames" />
    </ChartStage>
}

@if (_down is not null)
{
    <ChartStage Id="chart-down" Label="@label" FrameDirection="ltr" Top="@Earlier("chart-down")" Bottom="@Later("chart-down")" Left="@Lanes("chart-down")" Right="@Events("chart-down")" Class="@(_across is null ? null : "only-narrow")">
        <TimelineChartDown Drawing="_down" Texts="Words" Here="@_here" LongNames="LongNames" />
    </ChartStage>
}

<p class="note">@T["Chart_Legend"] @T["Stage_Lead"]</p>

@if (!_chart.Unplaced.IsEmpty)
{
    <p class="note">
        @T["Chart_Unplaced"]
        @foreach (var item in _chart.Unplaced)
        {
            <a class="chart-unplaced" href="@($"{_here}#item-{item.Key}")"><Loc Text="item.Label" /></a>
        }
    </p>
}

@if (Comparison.Lanes.Any(lane => lane.Periods.Any(period => period.Review == ReviewStatus.Disputed) || lane.Events.Any(single => single.Review == ReviewStatus.Disputed)))
{
    <p class="note">@T["Disputed_Legend"]</p>
}

@* The table says what the chart says, with what a bar has no room for: the same lanes, read from the same model. *@
<section aria-labelledby="as-table">
    <h2 id="as-table">@T["Chart_Table"]</h2>
    @foreach (var lane in Comparison.Lanes)
    {
        <table class="chart-table">
            <caption><Loc Text="lane.Label" /></caption>
            <thead>
                <tr>
                    <th scope="col">@T["Chart_Col_What"]</th>
                    <th scope="col">@T["Chart_Col_When"]</th>
                    <th scope="col">@T["Chart_Col_State"]</th>
                </tr>
            </thead>
            @if (!lane.Periods.IsEmpty)
            {
                <tbody>
                    <tr><th class="chart-group" colspan="3" scope="rowgroup">@T["Chart_Periods"]</th></tr>
                    @foreach (var period in lane.Periods)
                    {
                        <tr id="@($"item-{period.Key}")">
                            @Row(period.Label, period.Summary, period.Time, period.Review, period.Sources)
                        </tr>
                    }
                </tbody>
            }
            @if (!lane.Events.IsEmpty)
            {
                <tbody>
                    <tr><th class="chart-group" colspan="3" scope="rowgroup">@T["Chart_Events"]</th></tr>
                    @foreach (var single in lane.Events)
                    {
                        <tr id="@($"item-{single.Key}")">
                            @Row(single.Label, single.Summary, single.Time, single.Review, single.Sources)
                        </tr>
                    }
                </tbody>
            }
        </table>
    }
</section>

@code {
    private ChartState _state = new();
    private ComparisonChart _chart = null!;
    private TimelineDrawing? _across;
    private TimelineDrawing? _down;
    private Dictionary<string, ComparisonPeriod> _periods = [];
    private decimal _from;
    private decimal _to;
    private decimal _step;
    private int _shown;
    private bool _hasEvents;
    private string _here = string.Empty;

    /// <summary>Gets or sets what is compared.</summary>
    [Parameter, EditorRequired]
    public Comparison Comparison { get; set; } = null!;

    /// <summary>Gets or sets the address of the page without what the visitor chose: the choices are added to it.</summary>
    [Parameter, EditorRequired]
    public string Address { get; set; } = string.Empty;

    /// <summary>Gets or sets how the visitor asked to look at the chart.</summary>
    [Parameter, EditorRequired]
    public ChartState State { get; set; } = new();

    /// <summary>
    /// Gets or sets the address of the page of a source inside the site. Without it a source is linked where it
    /// is, as another site.
    /// </summary>
    [Parameter]
    public Func<Source, string>? SourceAddress { get; set; }

    /// <summary>Gets or sets a value indicating whether the lanes carry long names, such as the names of entities.</summary>
    [Parameter]
    public bool LongNames { get; set; }

    protected override void OnParametersSet()
    {
        _state = State;
        _here = AddressOf(_state);
        _periods = Comparison.Lanes.SelectMany(lane => lane.Periods).ToDictionary(period => period.Key, StringComparer.Ordinal);
        _chart = ComparisonCharts.Of(Comparison, text => Visitor.Text(text).Value, Callout);

        // The stretch the visitor chose, or the one the comparison is about. A year is shown to its end.
        _from = _state.From is { } first ? ChartState.Place(first) : _chart.From;
        _to = _state.To is { } last ? ChartState.Place(last) + 1 : _chart.To;

        // Across the page a callout is as long as its words and stands on a level; down the page its words run
        // across the time, so every callout takes the same room and moves along the time instead.
        var frame = new TimelineFrame { From = _from, To = _to, UnitsPerYear = _state.UnitsPerYear };

        // The time is opened and closed by the distance between two years of the axis.
        _step = TimelineLayout.Step(frame.UnitsPerYear, frame.TickGap);

        // The lanes the visitor left open, counted from the first, with or without their single events. The table
        // of the page keeps all of them.
        _shown = Math.Clamp(_state.Lanes ?? _chart.Lanes.Length, 1, _chart.Lanes.Length);
        _hasEvents = _chart.Lanes.Any(lane => !lane.Marks.IsEmpty);
        var lanes = _chart.Lanes.Take(_shown).Select(lane => _state.Events ? lane : lane with { Marks = [] }).ToList();
        _across = _state.Direction == ChartDirection.Down ? null : TimelineLayout.Of(lanes, frame);
        _down = _state.Direction == ChartDirection.Across ? null : TimelineLayout.Of(lanes, frame with { Stacking = MarkStacking.Push, MarkLength = 6.6 });
    }

    // The words of a callout: the year of the event, when one year is stated for it, and what happened.
    private string Callout(ComparisonEvent single)
    {
        var name = Visitor.Text(single.Label).Value;
        return single.Time is Occurrence { At: CalendarPosition at }
            ? string.Format(CultureInfo.CurrentCulture, T["Chart_Callout"], TimeText.Year(at.Era, at.Year, Visitor, T, at.IsApproximate), name)
            : name;
    }

    // The words of a bar. A year is written on it only when one year is stated; "between two years" is in the table.
    private BarText Words(string key)
    {
        var period = _periods[key];
        return new BarText(
            period.Time.Start is { State: PeriodStartState.Known, Earliest: CalendarPosition start } ? TimeText.Year(start.Era, start.Year, Visitor, T, start.IsApproximate) : null,
            period.Time.End is { State: PeriodEndState.Known, Earliest: CalendarPosition end } ? TimeText.Year(end.Era, end.Year, Visitor, T, end.IsApproximate) : null,
            string.Format(CultureInfo.CurrentCulture, T["Chart_BarTitle"], Visitor.Text(period.Label).Value, TimeText.Of(period.Time, Visitor, T)));
    }

    private string YearAt(decimal place)
    {
        var (era, year) = YearAxis.YearAt(place);
        return TimeText.Year(era, year, Visitor, T);
    }

    private string AddressOf(ChartState state) => $"{Address}{state.Query()}";

    // The chart with another stretch of time; nothing when less than a step would be left of it or when it would
    // leave what an address can name. The stretch the comparison is about is not written into an address.
    private ChartState? Stretch(decimal from, decimal to)
    {
        if (to - from < _step)
        {
            return null;
        }

        if (from == _chart.From && to == _chart.To)
        {
            return _state with { From = null, To = null };
        }

        var changed = _state with { From = ChartState.YearOf(from), To = ChartState.YearOf(to - 1) };
        return ChartState.Place(changed.From!.Value) == from && ChartState.Place(changed.To!.Value) == to - 1 ? changed : null;
    }

    // The steps of a side of the stage.
    // The steps of a side of a stage; they lead back to that stage, so that the chart stays on the screen.
    private RenderFragment Steps(string stage, string name, ChartState? fewer, ChartState? more) =>
        @<EdgeSteps Name="@name" Fewer="@(fewer is null ? null : $"{AddressOf(fewer)}#{stage}")" More="@(more is null ? null : $"{AddressOf(more)}#{stage}")" />;

    // The stretch from the first beginning to the last end of what the comparison holds, when that is more than
    // the stretch it is about.
    private ChartState? Everything()
    {
        var places = _chart.Lanes.SelectMany(lane => lane.Bands.SelectMany(band => new[] { band.From, band.To }).Concat(lane.Marks.Select(mark => mark.At))).ToList();
        return places.Count > 0 && (places.Min() < _chart.From || places.Max() > _chart.To)
            ? _state with { From = ChartState.YearOf(places.Min()), To = ChartState.YearOf(places.Max()) }
            : null;
    }

    // A choice of several: the one that is on says so and leads nowhere else.
    private RenderFragment Choice(ChartState state, string name) => state == _state
        ? @<a class="choice" href="@AddressOf(state)" aria-current="true">@name</a>
        : @<a class="choice" href="@AddressOf(state)">@name</a>;

    // A step that may have reached its end.
    private RenderFragment Step(ChartState? state, string name) => state is null
        ? @<span class="choice" aria-disabled="true"><span aria-hidden="true">@name</span><span class="visually-hidden">@string.Format(CultureInfo.CurrentCulture, T["Stage_NotAvailable"], name)</span></span>
        : @<a class="choice" href="@AddressOf(state)">@name</a>;

    private RenderFragment Row(LocalizedText label, LocalizedText? summary, TemporalExpression time, ReviewStatus review, System.Collections.Immutable.ImmutableArray<SourceId> sources) =>
        @<text>
            <th scope="row">
                <Loc Text="label" />
                @if (summary is not null)
                {
                    <span class="chart-summary"><Loc Text="summary" /></span>
                }
            </th>
            <td>@TimeText.Of(time, Visitor, T)</td>
            <td>
                @if (review == ReviewStatus.Disputed)
                {
                    <DisputedMark Review="review" />
                }

                @T[$"Review_{review}"]
                <span class="chart-summary">
                    @if (sources.IsDefaultOrEmpty)
                    {
                        @T["Chart_NoSource"]
                    }
                    else
                    {
                        foreach (var source in Comparison.Sources.Where(source => sources.Contains(source.Id)))
                        {
                            <a href="@(SourceAddress is null ? source.Url.ToString() : SourceAddress(source))" rel="@(SourceAddress is null ? "noopener noreferrer" : null)"><bdi>@source.Title</bdi></a>
                            @* A blank between two sources: Razor leaves none between two elements. *@
                            <text> </text>
                        }
                    }
                </span>
            </td>
        </text>;
}

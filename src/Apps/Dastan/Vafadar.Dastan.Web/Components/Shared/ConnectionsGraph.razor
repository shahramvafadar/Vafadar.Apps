@* The neighbourhood of an entity as a chart: SVG written by the server (ADR 0005, ADR 0008). The focus stands in
   the middle; what a relation leads from stands above it, what it leads to below it, and names whose relations
   are the same from both sides beside it. The boxes are HTML inside the SVG, so names wrap, links are real links
   and every script is set by the page's own styles. Nothing here needs a script: choosing a name, opening and
   closing a box are links. A chart that is larger than its stage scrolls there. On a page that is read from
   right to left the chart begins at the right. *@
@inject Visitor Visitor
@inject DastanSite Site
@inject IStringLocalizer<Ui> T

<svg class="graph flow" width="@Em(Chart.Width)" height="@Em(Chart.Height)">
    <defs>
        <marker id="graph-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path class="graph-arrow" d="M0 0L10 5L0 10z" />
        </marker>
    </defs>

    @* The lines first, the boxes over them. *@
    @foreach (var line in Chart.Lines)
    {
        <line class="graph-line" x1="@Em(Across(line.X1))" y1="@Em(line.Y1)" x2="@Em(Across(line.X2))" y2="@Em(line.Y2)"
              marker-start="@(line.ArrowAtStart ? "url(#graph-arrow)" : null)" marker-end="@(line.ArrowAtEnd ? "url(#graph-arrow)" : null)" />
    }

    @foreach (var box in Chart.Boxes.Where(box => box.Wing == ChartWing.Above))
    {
        @Box(box)
    }

    <foreignObject x="@Em(Across(Chart.FocusLeft, Chart.FocusWidth))" y="@Em(Chart.FocusTop)" width="@Em(Chart.FocusWidth)" height="@Em(Chart.FocusHeight)">
        <div class="graph-node graph-focus">
            <a class="graph-name" href="@($"{Site.Collection}/entity/{Chart.Focus.Id}")"
               title="@string.Format(CultureInfo.CurrentCulture, T["Graph_ToEntity"], Name(Chart.Focus))"><Loc Text="Chart.Focus.Label" /></a>
        </div>
    </foreignObject>

    @foreach (var box in Chart.Boxes.Where(box => box.Wing != ChartWing.Above))
    {
        @Box(box)
    }
</svg>

@code {
    /// <summary>Gets or sets the chart.</summary>
    [Parameter, EditorRequired]
    public ConnectionsChart Chart { get; set; } = null!;

    /// <summary>Gets or sets the boxes that are open, as the address names them.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<EntityId> Open { get; set; } = [];

    /// <summary>Gets or sets what turns a focus and the boxes that are open into the address of the chart.</summary>
    [Parameter, EditorRequired]
    public Func<EntityId, IEnumerable<EntityId>, string> Address { get; set; } = null!;

    private bool RightToLeft => Visitor.Language.IsRightToLeft;

    // Numbers in markup are written the same in every language of the page.
    private static string Em(double value) => value.ToString("0.###", CultureInfo.InvariantCulture) + "em";

    // A place across the chart as the SVG counts it: from the left.
    private double Across(double position) => RightToLeft ? Chart.Width - position : position;

    private double Across(double start, double width) => RightToLeft ? Chart.Width - start - width : start;

    private string Name(Entity entity) => Visitor.Text(entity.Label).Value;

    private RenderFragment Box(ConnectionBox box) =>
        @<foreignObject x="@Em(Across(box.Left, box.Width))" y="@Em(box.Top)" width="@Em(box.Width)" height="@Em(box.Height)">
            <div class="graph-node @(box.IsReference ? "graph-reference" : null)">
                @foreach (var relation in box.Relations)
                {
                    <span class="graph-relation"><Loc Text="relation.Label" /></span>
                }
                <span class="graph-entity">
                    <a class="graph-name" href="@Address(box.Entity.Id, [])"><Loc Text="box.Entity.Label" /></a>
                    @if (box.IsReference)
                    {
                        <small class="note">(@T["Graph_Reference"])</small>
                    }
                    else if (box.IsExpanded)
                    {
                        <a class="graph-toggle" href="@(Address(Chart.Focus.Id, Open.Where(id => id != box.Entity.Id)) + "#chart")" aria-expanded="true"
                           aria-label="@string.Format(CultureInfo.CurrentCulture, T["Graph_Collapse"], Name(box.Entity))">−</a>
                    }
                    else if (box.CanExpand)
                    {
                        <a class="graph-toggle" href="@(Address(Chart.Focus.Id, Open.Append(box.Entity.Id)) + "#chart")" aria-expanded="false"
                           aria-label="@string.Format(CultureInfo.CurrentCulture, T["Graph_Expand"], Name(box.Entity))">+</a>
                    }
                </span>
            </div>
        </foreignObject>;
}

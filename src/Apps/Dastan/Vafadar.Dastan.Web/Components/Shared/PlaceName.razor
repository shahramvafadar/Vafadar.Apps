@* The name of a place somebody states (step 20.4, ADR 0023). Where the statement points at an entry of a
   collection that is published, the name is what the entry is called today and leads to its page, and the
   words of the statement stand beside it when they differ – what the place was called when it was stated.
   Where it points at none, or at one that is not published at the moment, the words stand alone. *@
@using Vafadar.Dastan.Core
@inject Visitor Visitor
@inject DastanLibrary Library
@inject IStringLocalizer<Ui> T

@if (_place is { } place)
{
    <a href="@($"{place.Reference.Collection}/entity/{place.Reference.Entity}")"><strong><Loc Text="place.Entity.Label" /></strong></a>
    @if (!string.Equals(Visitor.Text(place.Entity.Label).Value.Trim(), Words.Trim(), StringComparison.OrdinalIgnoreCase))
    {
        <span class="meta"> (@T["Place_Stated_As"] <bdi>@Words</bdi>)</span>
    }
}
else
{
    <strong dir="auto">@Words</strong>
}

@code {
    private Institution? _place;

    /// <summary>Gets or sets the words of the statement.</summary>
    [Parameter, EditorRequired]
    public string Words { get; set; } = string.Empty;

    /// <summary>Gets or sets the entry the statement points at, when it points at one.</summary>
    [Parameter]
    public EntityReference? Reference { get; set; }

    protected override void OnParametersSet() => _place = Library.Institutions.Find(Reference);
}

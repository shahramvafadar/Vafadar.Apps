@* The search of a collection: a form that asks for a page, so it works without a script. It looks for names
   in what the visitor has read; on the page of the search it also asks what kind of thing is looked for, at
   which place and in which year – each only when the collection has something to choose from. *@
@inject DastanSite Site
@inject Visitor Visitor
@inject IStringLocalizer<Ui> T
@inject TimeProvider Clock

<form class="search" method="get" action="@($"{Site.Collection}/search")" role="search">
    <label for="search-q">@T["Search_Label"]</label>
    <div class="search-row">
        <input type="search" id="search-q" name="q" value="@Query" maxlength="80" autocomplete="off" enterkeyhint="search" dir="auto" />
        <button type="submit" class="action">@T["Search_Title"]</button>
    </div>
    @if (Filters && Visitor.Projection is { } projection)
    {
        var natures = projection.Entities.Select(entity => entity.Type.Nature).Distinct().Order().ToList();
        var places = projection.Places();
        var kinds = KindFilter.Offered(projection.Entities.Select(entity => entity.Kinds));
        <div class="search-row search-filters">
            @if (natures.Count > 1)
            {
                <p class="field">
                    <label for="search-kind">@T["Search_Kind"]</label>
                    <select id="search-kind" name="kind">
                        <option value="">@T["Search_Any"]</option>
                        @foreach (var nature in natures)
                        {
                            <option value="@nature.ToString().ToLowerInvariant()" selected="@(nature == Filter.Nature)">@T[$"Nature_{nature}"]</option>
                        }
                    </select>
                </p>
            }
            @if (!places.IsEmpty)
            {
                <p class="field">
                    <label for="search-place">@T["Search_Place"]</label>
                    <select id="search-place" name="place">
                        <option value="">@T["Search_Any"]</option>
                        @foreach (var place in places.Mapped.Select(mapped => mapped.Place).Concat(places.Unmapped))
                        {
                            <option value="@place.Id" selected="@(place.Id == Filter.Place)">@Visitor.Text(place.Label).Value</option>
                        }
                    </select>
                </p>
            }
            @if (!kinds.IsEmpty)
            {
                @* The kinds of records (ADR 0029): several may be chosen; a wider kind takes in the kinds below it. *@
                <fieldset class="field kind-fields">
                    <legend>@T["Search_Kinds"]</legend>
                    @foreach (var kind in kinds)
                    {
                        <label class="kind">
                            <input type="checkbox" name="@KindFilter.Parameter" value="@kind.Key" checked="@Filter.Kinds.Contains(kind.Key)" />
                            <Icon Name="@KindNames.IconOf(kind)" /><Loc Text="kind.Label" />
                        </label>
                    }
                </fieldset>
            }
            @if (projection.SaysWhen(Clock.GetUtcNow().Year))
            {
                <p class="field">
                    <label for="search-time">@T["Search_Year"]</label>
                    <input type="text" id="search-time" name="time" value="@Filter.Time?.Written" maxlength="80" autocomplete="off" dir="ltr" aria-describedby="search-time-how" />
                    <span class="meta" id="search-time-how">@T["Search_Year_How"]</span>
                </p>
            }
        </div>
    }
    <p class="note">@T["Search_Hint"]</p>
    @if (Filters)
    {
        <p class="note">@T["Search_HintFilters"]</p>
    }
</form>

@code {
    /// <summary>Gets or sets what the visitor typed before.</summary>
    [Parameter]
    public string Query { get; set; } = string.Empty;

    /// <summary>Gets or sets whether the form asks for more than a name.</summary>
    [Parameter]
    public bool Filters { get; set; }

    /// <summary>Gets or sets what the visitor chose before.</summary>
    [Parameter]
    public SearchFilter Filter { get; set; } = new();
}

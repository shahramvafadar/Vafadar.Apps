@inherits LayoutComponentBase
@inject Visitor Visitor
@inject DastanSite Site
@inject AccountDesk Accounts
@inject NavigationManager Navigation
@inject IOptions<SiteLanguageOptions> Languages
@inject IOptions<DastanOptions> Options
@inject IStringLocalizer<Ui> T

<PageAddress />

<a class="skip-link" href="@($"{Here}#content")">@T["Skip_ToContent"]</a>

@* The frame of the site (step 20.5, ADR 0024): the name; the main ways – Discover, the private space, what
   was kept, the search –; the account; and, away from the ways, the language and the appearance together.
   The ways are one list: beside the name in a wide window, a bar at the foot of a phone. *@
<header class="site-header">
    @* The logo leads to the start. It is named once, by the link; the drawing itself is silent. *@
    <a class="wordmark" href="./" aria-label="@T["Site_Name"]"><Logo /></a>
    <nav class="site-nav" aria-label="@T["Nav_Main"]">
        <a href="./" aria-current="@Current(string.Empty)"><Icon Name="discover" /><span>@T["Nav_Discover"]</span></a>
        @* Seeing things side by side is what the site is for (D-092): it is a main way, next to the start. *@
        <a href="compare" aria-current="@Current("compare")"><Icon Name="compare" /><span>@T["Nav_Compare"]</span></a>
        @if (Accounts.IsOpen)
        {
            @* The private space of who signed in; everybody else is shown what it is and where to sign in.
               Nobody is sent anything: who is asked for a relationship finds the number here. *@
            var waiting = AccountState.Of(Context).Waiting;
            <a href="@(_session is null ? "account" : waiting > 0 ? "account/world#waiting" : "account/world")" aria-current="@Current("account/")">
                <Icon Name="world" /><span>@T["Nav_World"]</span>
                @if (waiting > 0)
                {
                    <span class="count" aria-hidden="true">@Visitor.Number(waiting)</span>
                    <span class="visually-hidden"> – @string.Format(CultureInfo.CurrentCulture, T["People_Waiting_Count"], Visitor.Number(waiting))</span>
                }
            </a>
        }
        @* What was kept has its place whether or not something is in it: an empty place says how to fill it. *@
        <a href="saved" aria-current="@Current("saved")"><Icon Name="saved" /><span>@T["Nav_Saved"]</span></a>
        <a href="search" aria-current="@Current("search")"><Icon Name="search" /><span>@T["Search_Title"]</span></a>
    </nav>
    <div class="site-tools">
        @if (Accounts.IsOpen)
        {
            @* Who signed in is shown their name; everybody else where to sign in. *@
            <a class="account-link" href="account" aria-current="@Current("account")"><Icon Name="account" /><bdi class="name">@(_session?.Name ?? T["Account_Link"].Value)</bdi></a>
        }
        <details class="site-settings">
            <summary><Icon Name="settings" /><span>@T["Nav_Settings"]</span></summary>
            <div class="settings-panel">
                <p class="meta" id="settings-language">@T["Language_Label"]</p>
                <ul class="languages" role="list" aria-labelledby="settings-language">
                    @foreach (var tag in Languages.Value.Languages)
                    {
                        var name = CultureInfo.GetCultureInfo(tag).NativeName;
                        <li>
                            @if (tag == Visitor.Language.Tag)
                            {
                                <span aria-current="true" lang="@tag">@name</span>
                            }
                            else
                            {
                                <a href="@($"/{tag}/{Here}")" lang="@tag" hreflang="@tag">@name</a>
                            }
                        </li>
                    }
                </ul>
                <p class="meta" id="settings-theme">@T["Theme_Label"]</p>
                <form method="post" action="/preferences/theme" class="theme" aria-labelledby="settings-theme">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <button type="submit" name="theme" value="auto" aria-pressed="@Pressed(ThemeChoice.Auto)">@T["Theme_Auto"]</button>
                    <button type="submit" name="theme" value="light" aria-pressed="@Pressed(ThemeChoice.Light)">@T["Theme_Light"]</button>
                    <button type="submit" name="theme" value="dark" aria-pressed="@Pressed(ThemeChoice.Dark)">@T["Theme_Dark"]</button>
                </form>
            </div>
        </details>
    </div>
</header>

@if (Options.Value.Announcement is { Length: > 0 } announcement)
{
    @* What who runs the site has to tell everybody: the site knows no address to write to. *@
    <aside class="announcement" role="status" aria-label="@T["Announcement_Label"]">
        <p dir="auto">@announcement</p>
    </aside>
}
@if (!Visitor.HasSeenStorageNotice)
{
    @* Said once: what the site puts on this device. It asks for nothing – there is nothing to agree to, the
       site stores only what it cannot work without – and it does not stand in the way of the page. *@
    <aside class="storage-notice" aria-label="@T["Storage_Label"]">
        <p>@T["Storage_Text"] <a href="cookies">@T["Storage_More"]</a></p>
        <form method="post" action="/preferences/storage-note">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <button type="submit" class="action secondary">@T["Storage_Read"]</button>
        </form>
    </aside>
}

<main id="content" tabindex="-1">
    @Body
</main>

@* The panel of a profile (ADR 0019): empty and closed in every page; the script of the site opens it where a
   page offers a look at a node and fills it from the address of that profile. A page without the script never
   shows it. *@
<dialog id="profile-panel" class="profile-panel" aria-labelledby="profile-panel-name">
    <div class="profile-panel-head">
        <h2 id="profile-panel-name"></h2>
        <form method="dialog"><button type="submit" class="action secondary">@T["Profile_Panel_Close"]</button></form>
    </div>
    <p class="meta" data-panel-kind></p>
    @* What the panel says while it waits and when it failed is said aloud by the script that shows it: a page
       that never opens the panel announces nothing. *@
    <p class="note" data-panel-wait>@T["Profile_Panel_Wait"]</p>
    <p class="note" data-panel-failed hidden>@T["Profile_Panel_Failed"]</p>
    <div data-panel-body></div>
    <p class="actions"><a class="action" data-panel-open href="">@T["Profile_Panel_Open"]</a></p>
</dialog>

<footer class="site-footer">
    @if (Visitor.Projection is { } projection)
    {
        var stage = projection.Overview().Stages.First(candidate => candidate.Level == projection.Boundary);
        <p>
            @string.Format(CultureInfo.CurrentCulture, T["Reading_Current"], Visitor.Text(stage.Label).Value)
            <a href="@($"{Site.Collection}#reading")">@T["Reading_Change"]</a>
        </p>
        @if (Visitor.Language.Tag == "fa" && Site.Audience == Audience.LocalDemonstration)
        {
            <p class="note">@T["Draft_Notice"]</p>
        }
    }
    @if (Site.Audience == Audience.LocalDemonstration)
    {
        <p class="note">@T["Demo_Notice"]</p>
    }
    else if (Site.Revision is { } revision && Visitor.Projection is not null)
    {
        @* A public page says which revision it shows: a correction is a new revision, not a silent change. *@
        <p class="note">
            @string.Format(CultureInfo.CurrentCulture, T["Published_Notice"], Visitor.Number(revision.Number), Visitor.Day(revision.PublishedOn))
            <a href="@($"{Site.Collection}/revisions")">@T["Revisions_Link"]</a>
        </p>
    }
    @* The legal pages stand at the foot of every page: two steps from anywhere to who runs the site. *@
    <nav class="legal-links" aria-label="@T["Legal_Links"]">
        <ul role="list">
            @foreach (var legal in LegalTexts.Pages)
            {
                <li><a href="@legal">@T[$"Legal_{legal}"]</a></li>
            }
            <li><a href="notice">@T["Notice_Link"]</a></li>
        </ul>
    </nav>
</footer>

@code {
    // The address of this page inside its language ("story-x/entity/y"), for the links to the other languages.
    private string Here => Navigation.ToBaseRelativePath(Navigation.Uri);

    private string ReturnUrl => $"/{Visitor.Language.Tag}/{Here}";

    private string Pressed(ThemeChoice choice) => Visitor.Theme == choice ? "true" : "false";

    private Vafadar.Dastan.People.VisitorSession? _session;

    protected override void OnInitialized() => _session = Accounts.IsOpen ? AccountDesk.Session(Context.User) : null;

    // Which of the main ways the page lies on: the way itself and what is below it. The private space is
    // everything of the account but the page of the account itself, which is the account's.
    private string? Current(string way)
    {
        var here = Here;
        var end = here.IndexOfAny(['?', '#']);
        here = end < 0 ? here : here[..end];
        var on = way switch
        {
            "" => here.Length == 0,
            "account" => here == "account",
            "account/" => here.StartsWith("account/", StringComparison.Ordinal),
            _ => here == way || here.StartsWith(way + "/", StringComparison.Ordinal),
        };
        return on ? "page" : null;
    }

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;
}

@page "/{Collection}"
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_overview is { } overview)
{
    <PageTitle>@Visitor.Text(overview.Subject.Label).Value – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><TypeName Type="overview.Subject.Type" /></p>
        <h1><Loc Text="overview.Subject.Label" /></h1>
        <p class="lead"><Loc Text="overview.Subject.Summary" /></p>
        <p class="meta"><a href="@EvidenceAddress.Of(Site.Collection, overview.Subject.Id, Site.Collection)">@T["Evidence_Title"]</a></p>
    </header>

    @if (overview is { Work: { } work, Edition: { } edition })
    {
        <dl class="facts">
            <dt>@T["Collection_Work"]</dt>
            <dd><a href="@($"{Site.Collection}/entity/{work.Id}")"><Loc Text="work.Label" /></a></dd>
            <dt>@T["Collection_Text"]</dt>
            <dd>
                <Foreign Text="@edition.BaseText" Href="edition.BaseUrl" />
                <p class="note">@T["Collection_SourceNotice"] (@T["External_Note"])</p>
            </dd>
            <dt>@T["Collection_Scope"]</dt>
            <dd><Foreign Text="@edition.Scope" /></dd>
        </dl>
    }

    @if (overview.Stories.Length > 1)
    {
        @* A collection that tells several stories names each; every story has its own steps. *@
        <section aria-labelledby="stories">
            <h2 id="stories">@T["Collection_Stories"]</h2>
            <ul class="cards" role="list">
                @foreach (var told in overview.Stories)
                {
                    <li class="card">
                        <h3><a href="@StoryAddress.Of(Site, Visitor, told.Id)"><Loc Text="told.Label" /></a></h3>
                        <p><Loc Text="told.Summary" /></p>
                    </li>
                }
            </ul>
        </section>
    }

    @if (overview.FirstStep is { } first)
    {
        <section aria-labelledby="begins">
            <h2 id="begins">@T["Collection_Begins"]</h2>
            <article class="card">
                <h3><Loc Text="first.Event.Label" /></h3>
                <p><Loc Text="first.Event.Summary" /></p>
                <p><a class="action" href="@($"{Site.Collection}/story")">@T["Collection_ToStory"]</a></p>
            </article>
        </section>
    }

    @* The gallery is always offered: what it holds depends on the reading position, that it exists does not. *@
    <p class="actions">
        <a class="action secondary" href="@($"{Site.Collection}/gallery")">@T["Gallery_Title"]</a>
        <a class="action secondary" href="@($"{Site.Collection}/timeline")">@T["Timeline_Link"]</a>
    </p>

    <SearchForm />

    <section aria-labelledby="subjects">
        <h2 id="subjects">@T["Collection_Subjects"]</h2>
        <ul class="cards" role="list">
            @foreach (var subject in overview.Subjects)
            {
                <li class="card">
                    <h3><a href="@($"{Site.Collection}/entity/{subject.Id}")"><Loc Text="subject.Label" /></a></h3>
                    <p class="meta"><TypeName Type="subject.Type" /></p>
                    <p><Loc Text="subject.Summary" /></p>
                </li>
            }
        </ul>
    </section>

    <ReadingControl Overview="overview" ReturnUrl="@($"/{Visitor.Language.Tag}/{Site.Collection}#reading")" />
}

@code {
    private CollectionOverview? _overview;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        _overview = Collection == Site.Collection ? Visitor.Projection?.Overview() : null;
        if (_overview is null)
        {
            Navigation.NotFound();
        }
    }
}

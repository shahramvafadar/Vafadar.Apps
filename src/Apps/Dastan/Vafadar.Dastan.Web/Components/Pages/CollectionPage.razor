@page "/{Collection}"
@inject Visitor Visitor
@inject DastanSite Site
@inject DastanLibrary Library
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_overview is { } overview)
{
    <PageTitle>@Visitor.Text(overview.Subject.Label).Value – @T["Site_Name"]</PageTitle>
    <PageDescription Title="@Visitor.Text(overview.Subject.Label).Value" Text="@Visitor.Text(overview.Subject.Summary).Value" />

    <header class="page-header">
        <p class="meta"><TypeName Type="overview.Subject.Type" /></p>
        <h1><Loc Text="overview.Subject.Label" /></h1>
        <p class="lead"><Loc Text="overview.Subject.Summary" /></p>
        <p class="meta"><a href="@EvidenceAddress.Of(Site.Collection, overview.Subject.Id, Site.Collection)">@T["Evidence_Title"]</a></p>
    </header>

    @if (!Library.Comparisons.IsEmpty || _comparable)
    {
        @* What the site is for (D-092): the collection beside others, and its names beside each other. *@
        <section class="side-by-side compact" aria-labelledby="side-by-side">
            <h2 id="side-by-side"><Icon Name="compare" /> @T["Collection_SideBySide"]</h2>
            <p class="actions">
                @foreach (var comparison in Library.Comparisons)
                {
                    <a class="action" href="@($"compare/{comparison.Id}")"><Loc Text="comparison.Title" /></a>
                }
                @if (_comparable)
                {
                    <a class="action secondary" href="@($"compare?collection={Uri.EscapeDataString(Site.Collection)}#choose")">@T["Collection_CompareNames"]</a>
                }
            </p>
        </section>
    }

    @if (overview is { Work: { } work, Edition: { } edition })
    {
        <dl class="facts">
            <dt>@T["Collection_Work"]</dt>
            <dd><a href="@($"{Site.Collection}/entity/{work.Id}")"><Loc Text="work.Label" /></a></dd>
            <dt>@T["Collection_Text"]</dt>
            <dd>
                <Foreign Text="@edition.BaseText" Href="edition.BaseUrl" />
                <p class="note">@T["Collection_SourceNotice"] (@T["External_Note"])</p>
            </dd>
            <dt>@T["Collection_Scope"]</dt>
            <dd><Foreign Text="@edition.Scope" /></dd>
        </dl>
    }

    var elsewhere = Library.SameWorld(Site).Select(other => (Collection: other, Overview: Visitor.Of(other)?.Overview())).Where(entry => entry.Overview is not null).ToList();
    @if (elsewhere.Count > 0)
    {
        @* The same world in another collection of the site (step 14.11): another edition, another telling. *@
        <section aria-labelledby="elsewhere">
            <h2 id="elsewhere">@T["Elsewhere_Title"]</h2>
            <ul class="statements" role="list">
                @foreach (var (other, told) in elsewhere)
                {
                    <li>
                        <a href="@other.Collection"><Loc Text="told!.Subject.Label" /></a>
                        @if (told!.Edition is { } text)
                        {
                            <span class="meta"> – <Foreign Text="@text.BaseText" /></span>
                        }
                        @if (Site.Carried(other, overview.Boundary) is { } carried && carried.CompareTo(told.Boundary) > 0)
                        {
                            @* The editors state which stage there corresponds to the stage read here: the visitor
                               carries the reading position by their own act, and only forward. *@
                            var stage = told.Stages.First(candidate => candidate.Level == carried);
                            <form method="post" action="/preferences/reading" class="save inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="collection" value="@other.Collection" />
                                <input type="hidden" name="level" value="@carried.Value" />
                                <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}/{other.Collection}#reading")" />
                                <button type="submit">@string.Format(CultureInfo.CurrentCulture, T["Elsewhere_Carry"], Visitor.Text(stage.Label).Value)</button>
                            </form>
                        }
                    </li>
                }
            </ul>
            <p class="note">@T[elsewhere.Any(entry => Site.Carried(entry.Collection, overview.Boundary) is not null) ? "Elsewhere_ReadingStated" : "Elsewhere_Reading"]</p>
        </section>
    }

    @if (overview.Stories.Length > 1)
    {
        @* A collection that tells several stories names each; every story has its own steps. *@
        <section aria-labelledby="stories">
            <h2 id="stories">@T["Collection_Stories"]</h2>
            <ul class="cards" role="list">
                @foreach (var told in overview.Stories)
                {
                    <li class="card">
                        <h3><a href="@StoryAddress.Of(Site, Visitor, told.Id)"><Loc Text="told.Label" /></a></h3>
                        <p><Loc Text="told.Summary" /></p>
                    </li>
                }
            </ul>
        </section>
    }

    @if (overview.FirstStep is { } first)
    {
        <section aria-labelledby="begins">
            <h2 id="begins">@T["Collection_Begins"]</h2>
            <article class="card">
                <h3><Loc Text="first.Event.Label" /></h3>
                <p><Loc Text="first.Event.Summary" /></p>
                <p><a class="action" href="@($"{Site.Collection}/story")">@T["Collection_ToStory"]</a></p>
            </article>
        </section>
    }

    @* The gallery is always offered: what it holds depends on the reading position, that it exists does not. *@
    <p class="actions">
        <a class="action secondary" href="@($"{Site.Collection}/gallery")">@T["Gallery_Title"]</a>
        <a class="action secondary" href="@($"{Site.Collection}/timeline")">@T["Timeline_Link"]</a>
        @if (Visitor.Projection!.Years() is not null)
        {
            @* Offered when something the visitor may see states a year. *@
            <a class="action secondary" href="@($"{Site.Collection}/at")">@T["Moment_Link"]</a>
        }
        @if (!Visitor.Projection!.Places().IsEmpty)
        {
            @* Offered when the collection names a real place the visitor may see: a story alone has none. *@
            <a class="action secondary" href="@($"{Site.Collection}/places")">@T["Places_Link"]</a>
        }
    </p>

    <SearchForm />

    @if (!Visitor.Projection!.Threads.IsEmpty)
    {
        @* Ways through the collection the editors laid (step 14.9): each says what it is about before it is followed. *@
        <section aria-labelledby="threads">
            <h2 id="threads">@T["Thread_List"]</h2>
            <ul class="cards" role="list">
                @foreach (var thread in Visitor.Projection!.Threads)
                {
                    <li class="card">
                        <h3><a href="@($"{Site.Collection}/thread/{thread.Thread.Id}")"><Loc Text="thread.Thread.Label" /></a></h3>
                        <p><Loc Text="thread.Thread.Summary" /></p>
                    </li>
                }
            </ul>
        </section>
    }

    <section aria-labelledby="subjects">
        <h2 id="subjects">@T["Collection_Subjects"]</h2>
        <ul class="cards" role="list">
            @foreach (var subject in overview.Subjects)
            {
                @* Each subject as its card (ADR 0017): picture or drawing of its kind, name, kind, and what is known of it. *@
                <li class="card">
                    <NodeCard Profile="Visitor.Projection!.Profile(subject.Id)!" Summary="true" />
                </li>
            }
        </ul>
    </section>

    <ReadingControl Overview="overview" ReturnUrl="@($"/{Visitor.Language.Tag}/{Site.Collection}#reading")" />
}

@code {
    private CollectionOverview? _overview;

    // Whether two names of the collection have a time, so that they can be laid side by side.
    private bool _comparable;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        _overview = Collection == Site.Collection ? Visitor.Projection?.Overview() : null;
        if (_overview is null)
        {
            Navigation.NotFound();
            return;
        }

        _comparable = Visitor.Projection!.Timeline().Subjects.Length + Visitor.Projection!.Entities.Count(TimelineLanes.HasLifespan) >= 2;
    }
}

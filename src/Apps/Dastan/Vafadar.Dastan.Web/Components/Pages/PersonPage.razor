@page "/people/{Id}"
@using Vafadar.Dastan.Core.Personal
@using Vafadar.Dastan.People
@inject Visitor Visitor
@inject AccountDesk Desk
@inject DastanLibrary Library
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@* What a viewer may see of an account (step 16.3): its name and the relationships that both sides let this
   viewer see (PRIV-008). What the viewer may not see is neither shown nor counted nor hinted at (PRIV-012):
   the page of somebody who shows nothing and of somebody who shows nothing to this viewer are the same. *@
@if (_profile is not null)
{
    <PageTitle>@_profile.Person.Name – @T["Site_Name"]</PageTitle>
    <PageAddress None="true" />
    @* The page of a person is for people, not for search engines. *@
    <HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>

    @* The head of the account (D-086): its picture where this viewer may see that photograph, its name, the
       words it wrote about itself where they are for this viewer, and the first places it lets this viewer
       see. An account that says nothing and one that says nothing to this viewer have the same head (PRIV-012). *@
    <PersonHead Flavour="@IdentityMark.Account" Name="@_profile.Person.Name" Picture="_profile.Picture" About="@_profile.About">
        <Facts>
            @if (!_profile.Facts.IsEmpty)
            {
                @* What the account states about itself (step 25.5), as far as this viewer may see each: a year,
                   never an age; a town and a country in its own words; languages; one address of its own. *@
                var facts = _profile.Facts;
                <dl class="facts profile-facts compact account-facts">
                    @if (facts.BornYear is { } year)
                    {
                        <dt>@T["Person_Fact_Born"]</dt>
                        <dd>@Visitor.Number(year)</dd>
                    }
                    @if (facts.Town is not null || facts.Country is not null)
                    {
                        <dt>@T["Person_Fact_Lives"]</dt>
                        <dd dir="auto">@string.Join(T["Explore_Aside_And"], new[] { facts.Town, facts.Country }.Where(part => part is not null))</dd>
                    }
                    @if (!facts.Languages.IsEmpty)
                    {
                        <dt>@T["Person_Fact_Languages"]</dt>
                        <dd>
                            @for (var index = 0; index < facts.Languages.Length; index++)
                            {
                                var tag = facts.Languages[index];
                                @(index == 0 ? string.Empty : T["Explore_Aside_And"].Value)<span lang="@tag" dir="auto">@AccountLanguages.Name(tag)</span>
                            }
                        </dd>
                    }
                    @if (facts.Link is { } link)
                    {
                        @* An address a visitor wrote: followed by nobody for the site, and said to be a visitor's. *@
                        <dt>@T["Person_Fact_Link"]</dt>
                        <dd><a href="@link" rel="nofollow noopener ugc" dir="ltr">@link</a></dd>
                    }
                </dl>
            }
            @if (!_profile.Affiliations.IsEmpty)
            {
                <dl class="facts profile-facts compact">
                    <dt>@T["Person_Head_Places"]</dt>
                    @foreach (var shown in _profile.Affiliations.Take(HeadPlaces))
                    {
                        var when = shown.DatesShown ? AffiliationEndpoints.When(shown.Terms, T, Visitor) : string.Empty;
                        <dd><PlaceName Words="@shown.Terms.Organisation" Reference="shown.Terms.Institution" />@if (when.Length > 0)
                            {
                                <span class="meta"> – @when</span>
                            }
                        </dd>
                    }
                    @if (_profile.Affiliations.Length > HeadPlaces)
                    {
                        <dd><a href="@($"people/{Id}{(_seen is null ? null : $"?as={As}")}#person-affiliations")">@T["Person_Head_More"]</a></dd>
                    }
                </dl>
            }
        </Facts>
        <ChildContent>
            @if (_own && _seen is null)
            {
                <a class="action secondary" href="@($"people/{Id}#describe")">@T["Person_Describe_Link"]</a>
                <a class="action secondary" href="account/people">@T["People_Title"]</a>
            }
        </ChildContent>
    </PersonHead>

    @if (_own && _seen is null)
    {
        <p class="note">@T["Person_Lead_Self"]</p>
    }

    @if (_saidFacts)
    {
        <p class="note" role="status">@T["Person_Said_stated"]</p>
    }

    @if (_said)
    {
        <p class="note" role="status">@T["Person_Said_described-self"]</p>
    }

    @if (_seen is not null)
    {
        @* Looking as somebody else (PRIV-015): what follows is what that viewer is shown, by the same rules. *@
        <p class="note" role="status">
            @(_seen.Kind == "public" ? T["SeeAs_Now_public"] : string.Format(CultureInfo.CurrentCulture, T[$"SeeAs_Now_{_seen.Kind}"], $"⁨{_seen.Name}⁩"))
            @if (_seen.Kind != "public")
            {
                @: @T["SeeAs_OtherSide"]
            }
        </p>
        <p class="actions"><a class="action secondary" href="@($"people/{Id}")">@T["SeeAs_Back"]</a></p>
    }

    <section aria-labelledby="person-relationships">
        <h2 id="person-relationships">@T["Person_Relationships"]</h2>
        @if (_profile.Relationships.IsEmpty)
        {
            <p class="note">@T["Person_None"]</p>
        }
        else
        {
            <ul class="statements" role="list">
                @foreach (var shown in _profile.Relationships)
                {
                    <li><a href="@($"people/{shown.Other.Id}")" dir="auto">@shown.Other.Name</a> <span class="meta">– <RelationshipCalled Kind="@shown.Kind" Terms="shown.Terms" /></span></li>
                }
            </ul>
        }
    </section>

    @if (!_profile.Affiliations.IsEmpty)
    {
        @* Where the person was (PRIV-010): what this viewer may see of it, the dates only where those are for them too. *@
        <section aria-labelledby="person-affiliations">
            <h2 id="person-affiliations">@T["Person_Affiliations"]</h2>
            <ul class="statements" role="list">
                @foreach (var shown in _profile.Affiliations)
                {
                    var when = shown.DatesShown ? AffiliationEndpoints.When(shown.Terms, T, Visitor) : string.Empty;
                    <li><PlaceName Words="@shown.Terms.Organisation" Reference="shown.Terms.Institution" />@if (shown.Terms.Role is { } role)
                        {
                            <span class="meta"> – <bdi>@role</bdi></span>
                        }
                        @if (when.Length > 0)
                        {
                            <span class="meta"> – @when</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (_own && _seen is null && _mine is not null)
    {
        @* What the page says (D-086): a few words with an audience of their own, and a picture – one of the
           account's photographs, seen by who may see that photograph. Only the account writes them. *@
        <section id="describe" aria-labelledby="describe-title">
            <h2 id="describe-title">@T["Person_Self_Title"]</h2>
            <p class="note">@T["Person_Self_Note"]</p>
            @if (_problem is not null)
            {
                <div class="problems" role="alert"><ul>
                    <li>@T[$"Person_Self_Problem_{_problem}"]</li>
                </ul></div>
            }
            <form method="post" action="@($"{PeopleEndpoints.Root}/describe")" class="account">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}{PeopleEndpoints.Person}/{Id}")" />
                <p class="field">
                    <label for="self-about">@T["Person_Self_About"]</label>
                    <textarea id="self-about" name="about" rows="3" maxlength="@PeopleStore.LongestAccountAbout" dir="auto" aria-describedby="self-about-how">@_mine.About</textarea>
                    <span class="meta" id="self-about-how">@T["Person_Self_About_How"]</span>
                </p>
                <p class="field">
                    <label for="self-shown">@T["Person_Self_Shown"]</label>
                    <AudienceChoice Id="self-shown" Name="shown" Shown="_mine.AboutShown" Circle="_mine.AboutCircle" Circles="_circles" />
                </p>
                @if (Desk.PhotoFolder is not null)
                {
                    <p class="field">
                        <label for="self-picture">@T["Person_Picture"]</label>
                        <select id="self-picture" name="picture" aria-describedby="self-picture-note">
                            <option value="">@T["Person_Picture_None"]</option>
                            @foreach (var photo in _ownPhotos)
                            {
                                <option value="@photo.Id" selected="@(_mine.Picture?.Id == photo.Id)">@Titled(photo)</option>
                            }
                        </select>
                    </p>
                    <p class="meta" id="self-picture-note">@T["Person_Self_Picture_Note"] <a href="account/photos">@T["Photos_Title"]</a></p>
                }
                <p><button type="submit" class="action">@T["Person_Self_Save"]</button></p>
            </form>
        </section>
    }

    @if (_own && _seen is null && _stated is not null)
    {
        @* The facts an account states about itself (step 25.5): none is asked for, each has an audience of its
           own, and each begins with nobody else. *@
        <section id="facts" aria-labelledby="facts-title">
            <h2 id="facts-title">@T["Person_Facts_Title"]</h2>
            <p class="note">@T["Person_Facts_Note"]</p>
            @if (_factsProblem is not null)
            {
                <div class="problems" role="alert"><ul>
                    <li>@T[$"Person_Facts_Problem_{_factsProblem}"] @T["Person_Facts_Problem_Rest"]</li>
                </ul></div>
            }
            <form method="post" action="@($"{PeopleEndpoints.Root}/facts")" class="account account-facts-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}{PeopleEndpoints.Person}/{Id}")" />
                <fieldset class="fact-group">
                    <legend>@T["Person_Facts_Group_Born"]</legend>
                    <p class="field">
                        <label for="fact-born">@T["Person_Facts_Born_Label"]</label>
                        <input id="fact-born" name="born" type="text" inputmode="numeric" maxlength="4" autocomplete="bday-year" dir="ltr" value="@_stated.BornYear?.ToString(CultureInfo.InvariantCulture)" aria-describedby="fact-born-how" />
                        <span class="meta" id="fact-born-how">@T["Person_Facts_Born_How"]</span>
                    </p>
                    <p class="field">
                        <label for="fact-born-shown">@T["Person_Facts_Shown"]</label>
                        <AudienceChoice Id="fact-born-shown" Name="bornShown" Shown="_stated.Born.Shown" Circle="_stated.Born.Circle" Circles="_circles" />
                    </p>
                </fieldset>
                <fieldset class="fact-group">
                    <legend>@T["Person_Facts_Group_Lives"]</legend>
                    <p class="field">
                        <label for="fact-town">@T["Person_Facts_Town"]</label>
                        <input id="fact-town" name="town" type="text" maxlength="@PeopleStore.LongestPlaceOfAccount" autocomplete="address-level2" dir="auto" value="@_stated.Town" />
                    </p>
                    <p class="field">
                        <label for="fact-country">@T["Person_Facts_Country"]</label>
                        <input id="fact-country" name="country" type="text" maxlength="@PeopleStore.LongestPlaceOfAccount" autocomplete="country-name" dir="auto" value="@_stated.Country" aria-describedby="fact-lives-how" />
                        <span class="meta" id="fact-lives-how">@T["Person_Facts_Lives_How"]</span>
                    </p>
                    <p class="field">
                        <label for="fact-lives-shown">@T["Person_Facts_Shown"]</label>
                        <AudienceChoice Id="fact-lives-shown" Name="livesShown" Shown="_stated.Lives.Shown" Circle="_stated.Lives.Circle" Circles="_circles" />
                    </p>
                </fieldset>
                <fieldset class="fact-group" aria-describedby="fact-languages-how">
                    <legend>@T["Person_Fact_Languages"]</legend>
                    <p class="meta" id="fact-languages-how">@string.Format(CultureInfo.CurrentCulture, T["Person_Facts_Languages_How"], Visitor.Number(AccountLanguages.Most))</p>
                    <ul class="choices fact-languages" role="list">
                        @foreach (var (tag, name) in AccountLanguages.Known)
                        {
                            <li><label><input type="checkbox" name="languages" value="@tag" checked="@_stated.Languages.Contains(tag)" /> <span lang="@tag" dir="auto">@name</span></label></li>
                        }
                    </ul>
                    <p class="field">
                        <label for="fact-languages-shown">@T["Person_Facts_Shown"]</label>
                        <AudienceChoice Id="fact-languages-shown" Name="languagesShown" Shown="_stated.Speaks.Shown" Circle="_stated.Speaks.Circle" Circles="_circles" />
                    </p>
                </fieldset>
                <fieldset class="fact-group">
                    <legend>@T["Person_Facts_Group_Link"]</legend>
                    <p class="field">
                        <label for="fact-link">@T["Person_Facts_Link_Label"]</label>
                        <input id="fact-link" name="link" type="text" inputmode="url" maxlength="@PeopleStore.LongestLink" autocomplete="url" dir="ltr" placeholder="https://" value="@_stated.Link" aria-describedby="fact-link-how" />
                        <span class="meta" id="fact-link-how">@T["Person_Facts_Link_How"]</span>
                    </p>
                    <p class="field">
                        <label for="fact-link-shown">@T["Person_Facts_Shown"]</label>
                        <AudienceChoice Id="fact-link-shown" Name="linkShown" Shown="_stated.Linked.Shown" Circle="_stated.Linked.Circle" Circles="_circles" />
                    </p>
                </fieldset>
                <p><button type="submit" class="action">@T["Person_Facts_Save"]</button></p>
            </form>
        </section>
    }

    @if (_own)
    {
        <section id="see-as-section" aria-labelledby="see-as-title">
            <h2 id="see-as-title">@T["SeeAs_Title"]</h2>
            <p class="note">@T["SeeAs_Note"]</p>
            <SeeAsForm Address="@($"people/{Id}")" Circles="_circles" Known="_known" Chosen="@(_seen is null ? null : As)" />
        </section>
    }

    @if (_viewer is not null && !_own)
    {
        @* Blocking (PRIV-009): this account cannot ask, tag, invite or find the viewer any more, and is not told. *@
        <section aria-labelledby="person-block">
            <h2 id="person-block">@T[_profile.Blocked ? "Person_Blocked_Title" : "Person_Block_Title"]</h2>
            <p class="note">@T[_profile.Blocked ? "Person_Blocked_Note" : "Person_Block_Note"]</p>
            <form method="post" action="@($"{PeopleEndpoints.Root}/{(_profile.Blocked ? "unblock" : "block")}")" class="save">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}{PeopleEndpoints.Page}")" />
                <input type="hidden" name="account" value="@_profile.Person.Id" />
                <button type="submit">@T[_profile.Blocked ? "Person_Unblock" : "Person_Block"]<span class="visually-hidden"> – @_profile.Person.Name</span></button>
            </form>
        </section>
    }

    @if (_photos.Count > 0)
    {
        @* The life of the person in photographs: their own, and those of others that they approved to be shown in –
           each only when its owner lets this viewer see it (PRIV-013). *@
        <section aria-labelledby="person-photos">
            <h2 id="person-photos">@T["Photos_Title"]</h2>
            @if (_years.Length > 1 || Year is not null)
            {
                @* A gallery by the time a picture was taken (step 16.10): the years among what this viewer may see. *@
                <nav class="years" aria-label="@T["Photos_Years"]">
                    <ul role="list">
                        <li><a href="@($"people/{Id}{(_seen is null ? null : $"?as={As}")}#person-photos")" aria-current="@(Year is null ? "true" : null)">@T["Photos_Years_All"]</a></li>
                        @foreach (var year in _years)
                        {
                            <li><a href="@($"people/{Id}?year={year.ToString(CultureInfo.InvariantCulture)}{(_seen is null ? null : $"&as={As}")}#person-photos")" aria-current="@(Year == year ? "true" : null)">@PhotoYears.Written(year, Visitor.Language.Tag)</a></li>
                        }
                    </ul>
                </nav>
            }
            <ul class="photos" role="list">
                @foreach (var photo in _photos.Where(photo => Year is null || photo.Taken?.Year == Year))
                {
                    <li>
                        <figure>
                            <PhotoImage Photo="photo" />
                            <figcaption>
                                @if (photo.Caption.Length > 0)
                                {
                                    <bdi>@photo.Caption</bdi>
                                }
                                @if (photo.Owner.Id != _profile.Person.Id)
                                {
                                    <span class="meta">– <a href="@($"people/{photo.Owner.Id}")"><bdi>@photo.Owner.Name</bdi></a></span>
                                }
                            </figcaption>
                        </figure>
                        @if (MayObject(photo))
                        {
                            @* Somebody the photograph shows and its owner did not name (D-059): their word holds it back. *@
                            <form method="post" action="@($"{PhotoEndpoints.Root}/object")" class="save">
                                <AntiforgeryToken />
                                <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}{PhotoEndpoints.Page}")" />
                                <input type="hidden" name="photo" value="@photo.Id" />
                                <button type="submit" name="answer" value="object">@T["Photos_Object"]</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (_albums.Count > 0)
    {
        @* The albums of the person, each with the photographs this viewer may see. An album in which they may
           see nothing is not named (PRIV-012). *@
        <section aria-labelledby="person-albums">
            <h2 id="person-albums">@T["Albums_Title"]</h2>
            @foreach (var album in _albums)
            {
                <article class="album" aria-labelledby="@($"album-{album.Number}")">
                    <h3 id="@($"album-{album.Number}")" dir="auto">@album.Name</h3>
                    @if (album.Note.Length > 0)
                    {
                        <p dir="auto">@album.Note</p>
                    }
                    <ul class="photos" role="list">
                        @foreach (var photo in album.Photos)
                        {
                            <li>
                                <figure>
                                    <PhotoImage Photo="photo" />
                                    @if (photo.Caption.Length > 0)
                                    {
                                        <figcaption><bdi>@photo.Caption</bdi></figcaption>
                                    }
                                </figure>
                                @if (MayObject(photo))
                                {
                                    @* Somebody the photograph shows and its owner did not name (D-059): their word holds it back. *@
                                    <form method="post" action="@($"{PhotoEndpoints.Root}/object")" class="save">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="returnUrl" value="@($"/{Visitor.Language.Tag}{PhotoEndpoints.Page}")" />
                                        <input type="hidden" name="photo" value="@photo.Id" />
                                        <button type="submit" name="answer" value="object">@T["Photos_Object"]</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                </article>
            }
        </section>
    }
}

<ReportLink />

@code {
    // How many places the head names; the rest stand in their part of the page.
    private const int HeadPlaces = 3;

    private static readonly string[] Problems = ["long", "picture"];

    // What the account says about itself, as it reads it itself; and its own photographs to choose a picture from.
    private AccountDescription? _mine;
    private IReadOnlyList<PhotoInfo> _ownPhotos = [];
    private bool _said;
    private string? _problem;

    /// <summary>Gets or sets what a form of this page answered with.</summary>
    [SupplyParameterFromQuery]
    private string? Said { get; set; }

    [SupplyParameterFromQuery]
    private string? Form { get; set; }

    [SupplyParameterFromQuery]
    private string? Problem { get; set; }

    private IReadOnlyList<AlbumInfo> _albums = [];
    private int[] _years = [];
    private IReadOnlyList<PhotoInfo> _photos = [];
    private ProfileView? _profile;
    private bool _own;
    private string? _viewer;
    private SeenAs? _seen;
    private IReadOnlyList<CircleInfo> _circles = [];
    private IReadOnlyList<PersonRef> _known = [];

    /// <summary>Gets or sets as whom the account looks at its own page: the public, a circle, an account.</summary>
    [SupplyParameterFromQuery]
    private string? As { get; set; }

    /// <summary>Gets or sets the identifier of the account the page is about.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets the year whose photographs are shown; none: all of them.</summary>
    [SupplyParameterFromQuery]
    private int? Year { get; set; }

    // Who is signed in may say of a photograph of somebody else that everybody sees that it shows them – when it
    // does not name them already.
    private bool MayObject(PhotoInfo photo) =>
        _viewer is not null && photo.Owner.Id != _viewer && photo.Shown == ScopeKind.Public && photo.Tags.All(tag => tag.Person.Id != _viewer);

    private static readonly string[] FactProblems = ["year", "long", "languages", "link"];
    private AccountFacts? _stated;
    private bool _saidFacts;
    private string? _factsProblem;

    protected override void OnInitialized()
    {
        if (Desk.IsOpen && Id.Length <= 40)
        {
            var viewer = AccountDesk.Session(Context.User)?.Id;
            using var store = Desk.Open();
            _profile = store.Profile(viewer, Id);
            if (_profile is not null && Desk.PhotoFolder is not null)
            {
                _photos = store.LifeOf(viewer, Id);
                _albums = store.AlbumsOf(viewer, Id);
                _years = PhotoYears.Of(_photos);
                Year = _years.Contains(Year ?? 0) ? Year : null;
            }
            _own = viewer == Id;
            _viewer = viewer;
            if (_own && _profile is not null)
            {
                _mine = store.Description(Id);
                _ownPhotos = Desk.PhotoFolder is null ? [] : store.Photos(Id);
                _said = Said == "described";
                _stated = store.Facts(Id);
                _saidFacts = Said == "stated";
                _factsProblem = Form == "facts" && FactProblems.Contains(Problem, StringComparer.Ordinal) ? Problem : null;
                _problem = Form == "describe" && Problems.Contains(Problem, StringComparer.Ordinal) ? Problem : null;
                _circles = store.Circles(Id);
                _known = [.. store.Relationships(Id).Where(relationship => relationship.State == RelationshipState.Accepted).Select(relationship => relationship.Other).DistinctBy(person => person.Id)];
                _seen = As is { Length: > 0 and <= 60 } ? store.SeeAs(Id, As) : null;
                if (_seen is not null)
                {
                    // The page is drawn from what that viewer is shown, and nothing on it acts for anybody.
                    (_profile, _photos, _albums, _viewer) = (_seen.Profile, Desk.PhotoFolder is null ? [] : _seen.Photos, Desk.PhotoFolder is null ? [] : _seen.Albums, null);
                    _years = PhotoYears.Of(_photos);
                    Year = _years.Contains(Year ?? 0) ? Year : null;
                }
            }
        }

        if (_profile is null)
        {
            Navigation.NotFound();
        }
    }

    private string Titled(PhotoInfo photo) => photo.Caption.Length > 0
        ? photo.Caption
        : string.Format(CultureInfo.CurrentCulture, T["Person_Picture_Untitled"], TimeText.Of(DateOnly.FromDateTime(photo.SharedAt), Visitor, T));

}

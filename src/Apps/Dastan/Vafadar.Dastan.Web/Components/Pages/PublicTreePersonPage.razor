@page "/trees/{Tree}/person/{Id}"
@using Vafadar.Dastan.People
@inject AccountDesk Desk
@inject Visitor Visitor
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@* A person of a family tree its owner made public (step 19.5, ADR 0017): the profile as everybody may see it.
   The picture is there only when that photograph is public. A tree that is not public and a record it does
   not have answer "not found" alike. *@
@if (_tree is not null && _person is not null)
{
    <PageTitle>@_person.Name – @_tree.Tree.Name – @T["Site_Name"]</PageTitle>
    <PageAddress None="true" />
    <HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>

    <PersonHead Flavour="@IdentityMark.Record" Name="@_person.Name" Picture="_person.Picture">
        <PictureNote>
            @if (_person.Picture is { Caption.Length: > 0 } shown)
            {
                <span dir="auto">@string.Format(CultureInfo.CurrentCulture, T["Person_Picture_Of"], shown.Caption)</span>
            }
            else if (_person.Picture is null)
            {
                @T["Person_NoPicture"]
            }
        </PictureNote>
        <Where>
            <p class="lead">@T["Person_In"] <a href="@($"trees/{_tree.Tree.Id}")" dir="auto">@_tree.Tree.Name</a></p>
        </Where>
        <Facts>
            <PersonLife Person="_person" />
        </Facts>
    </PersonHead>

    <PersonProfile Tree="_tree" Person="_person" Address="@($"trees/{_tree.Tree.Id}")" Headed="true" />
}

<ReportLink />

@code {
    private TreeView? _tree;
    private TreePerson? _person;

    /// <summary>Gets or sets the identifier of the tree.</summary>
    [Parameter]
    public string Tree { get; set; } = string.Empty;

    /// <summary>Gets or sets the identifier of the person.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (Desk.IsOpen && Tree.Length <= 40 && Id.Length <= 40)
        {
            using var store = Desk.Open();
            _tree = store.PublicTree(Tree);
            _person = _tree?.People.FirstOrDefault(person => person.Id == Id);
        }

        if (_person is null)
        {
            Navigation.NotFound();
        }
    }
}

@page "/{Collection}/gallery"
@page "/{Collection}/entity/{Subject}/gallery"
@page "/{Collection}/event/{Step}/gallery"
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T
@inject TimeProvider Clock

@if (_gallery is { } gallery)
{
    <PageTitle>@_title – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@_back">@string.Format(CultureInfo.CurrentCulture, T["Story_Back"], _backName)</a></p>
        <h1>@_title</h1>
        @* The page says why its items are here (document 15): the rule, not a search the visitor cannot see. *@
        <p class="lead">@_lead</p>
    </header>

    @* The gallery of a time (ADR 0021, R-MED-02): what shows a year, a stretch of years or a depth of time. It is
       asked for with a form that asks for a page, by the one reader of a time of the site. *@
    @if (gallery.Rule is GalleryRule.WholeCollection or GalleryRule.ShowsTime)
    {
        <form class="search moment-form" method="get" action="@($"{Site.Collection}/gallery")">
            <div class="search-row">
                <p class="field">
                    <label for="gallery-time">@T["Gallery_Time"]</label>
                    <input type="text" id="gallery-time" name="time" value="@gallery.Time?.Written" maxlength="80" required autocomplete="off" dir="ltr" aria-describedby="gallery-time-how" />
                    <span class="meta" id="gallery-time-how">@T["Search_Year_How"]</span>
                </p>
                <button type="submit" class="action">@T["Moment_Show"]</button>
            </div>
        </form>
        @if (_invalid)
        {
            <p class="note" role="alert">@T["Moment_InvalidTime"]</p>
        }

        @* And back (R-EXP-05): what the collection says held in the time the gallery is of. *@
        @if (gallery.Time is { } carried)
        {
            <p class="actions"><a class="action secondary" href="@($"{Site.Collection}/at?time={Uri.EscapeDataString(carried.Written)}")">@T["Gallery_WhatHeld"]</a></p>
        }
    }

    @if (gallery.IsEmpty)
    {
        @* Nothing to show is said the same way whether nothing exists or nothing has been reached yet. *@
        <p class="note" role="status">
            @T[gallery.Rule == GalleryRule.ShowsTime ? "Gallery_EmptyTime" : "Gallery_Empty"]
            @if (_continues)
            {
                <text> @T["Gallery_EmptyHint"] </text><a href="@($"{Site.Collection}#reading")">@T["Reading_Change"]</a>
            }
        </p>
    }
    else
    {
        @* How the gallery is arranged (MED-003): the order, and images or videos only. The order by time says which
           time it is – when an item was made, never the time of what it shows. *@
        <nav class="chart-tools" aria-label="@T["Gallery_Tools"]">
            <p class="chart-tool">
                <span class="chart-tool-name">@T["Gallery_OrderName"]</span>
                @Choice(_order == GalleryOrder.Editorial, Address(GalleryOrder.Editorial, _kind), T["Gallery_Order_Editorial"])
                @Choice(_order == GalleryOrder.OldestFirst, Address(GalleryOrder.OldestFirst, _kind), T["Gallery_Order_OldestFirst"])
                @Choice(_order == GalleryOrder.NewestFirst, Address(GalleryOrder.NewestFirst, _kind), T["Gallery_Order_NewestFirst"])
            </p>
            @if (_kinds.Count > 1)
            {
                <p class="chart-tool">
                    <span class="chart-tool-name">@T["Gallery_KindName"]</span>
                    @Choice(_kind is null, Address(_order, null), T["Gallery_Kind_All"])
                    @foreach (var kind in _kinds)
                    {
                        @Choice(_kind == kind, Address(_order, kind), T[$"Media_Kind_{kind}"])
                    }
                </p>
            }
        </nav>
        @if (_order != GalleryOrder.Editorial)
        {
            <p class="note">@T["Gallery_OrderMade"]</p>
        }
    }

    @if (!gallery.Items.IsEmpty)
    {
        <p class="note">@string.Format(CultureInfo.CurrentCulture, T["Gallery_Count"], Visitor.Number(gallery.Items.Length))@(_order == GalleryOrder.Editorial ? $" – {T["Gallery_Order"]}" : null)</p>
        <ul class="cards gallery" role="list">
            @foreach (var item in gallery.Items)
            {
                var viewer = $"{Site.Collection}/media/{item.Id}{_context}";
                var picture = Site.ContentFile(item.Kind == MediaKind.Video ? item.Poster : item.File) is null
                    ? null
                    : item.Kind == MediaKind.Video ? MediaAddress.Poster(Site.Collection, item.Id) : MediaAddress.File(Site.Collection, item.Id);
                <li class="card media-card" id="@item.Id">
                    @if (picture is not null)
                    {
                        @* The picture leads where the title leads; for a screen reader and the keyboard the title is the link. *@
                        <a class="thumb" href="@viewer" tabindex="-1" aria-hidden="true"><img src="@picture" srcset="@MediaAddress.SourceSet(Site.Collection, item, file => Site.ContentFile(file) is not null)" sizes="@(item.Sizes.IsEmpty ? null : "(min-width: 40rem) 20rem, 100vw")" alt="" loading="lazy" /></a>
                    }
                    <p class="meta">@T[$"Media_Kind_{item.Kind}"] – @T[$"Media_Representation_{item.Representation}"]</p>
                    <h2><a href="@viewer"><Loc Text="item.Label" /></a></h2>
                    <p><Loc Text="item.Caption" /></p>
                    <p class="meta">@T["Media_Made"]: @TimeText.Of(item.Created, Visitor, T)</p>
                    @if (item.Shows is { } shows)
                    {
                        <p class="meta">
                            @T["Media_ShowsTime"]: @TimeText.Of(shows, Visitor, T)
                            @if (gallery.Possibly.Contains(item.Id))
                            {
                                <span class="possibly">– @T["Gallery_Possibly"]</span>
                            }
                        </p>
                    }
                </li>
            }
        </ul>
    }

    @if (!gallery.MadeThen.IsEmpty)
    {
        @* Made in the time and not showing it: named apart, so that a picture of a later hand is not taken for one of its time and the other way round. *@
        <section aria-labelledby="made-then">
            <h2 id="made-then">@T["Gallery_MadeThen"]</h2>
            <p class="note">@T["Gallery_MadeThenNote"]</p>
            <ul class="statements" role="list">
                @foreach (var item in gallery.MadeThen)
                {
                    <li>
                        <a href="@($"{Site.Collection}/media/{item.Id}")"><Loc Text="item.Label" /></a>
                        <span class="meta">– @T["Media_Made"]: @TimeText.Of(item.Created, Visitor, T)</span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (!gallery.References.IsEmpty)
    {
        @* An image the site may not show is not left out as if it did not exist: its catalogue record stands here,
           with the way to the institution that holds it. Nothing of the image itself is asked for or delivered. *@
        <section aria-labelledby="references">
            <h2 id="references">@T["Reference_Heading"]</h2>
            <p class="note">@T["Reference_Lead"]</p>
            <ul class="cards gallery" role="list">
                @foreach (var item in gallery.References)
                {
                    <li class="card media-card media-reference" id="@item.Id">
                        <p class="meta">@T[$"Media_Kind_{item.Kind}"] – @T[$"Media_Representation_{item.Representation}"]</p>
                        <h3><Loc Text="item.Label" /></h3>
                        <p><Loc Text="item.Caption" /></p>
                        <dl class="facts">
                            @if (item.CatalogueTitle is { } catalogueTitle)
                            {
                                <dt>@T["Media_CatalogueTitle"]</dt>
                                <dd><Foreign Text="@catalogueTitle" /></dd>
                            }

                            <dt>@T["Media_Creator"]</dt>
                            <dd><Foreign Text="@item.Creator" /></dd>
                            <dt>@T["Media_Made"]</dt>
                            <dd>@TimeText.Of(item.Created, Visitor, T)</dd>
                            @if (item.AccessionNumber is { } accession)
                            {
                                <dt>@T["Media_Accession"]</dt>
                                <dd><bdi dir="ltr">@accession</bdi></dd>
                            }

                            @if (item.CreditLine is { } credit)
                            {
                                <dt>@T["Media_Credit"]</dt>
                                <dd><Foreign Text="@credit" /></dd>
                            }

                            <dt>@T["Media_Rights"]</dt>
                            <dd>@T[$"Rights_{item.Rights}"]</dd>
                        </dl>
                        <p>
                            <a class="action secondary" href="@item.CataloguePage" rel="external noopener">@T["Reference_Open"] <bdi dir="ltr">@item.CataloguePage!.Host</bdi><span class="visually-hidden"> – @Visitor.Text(item.Label).Value</span></a>
                            <small class="note">(@T["External_Note"])</small>
                        </p>
                    </li>
                }
            </ul>
        </section>
    }

    @if (gallery.Rule != GalleryRule.WholeCollection)
    {
        <p class="actions"><a class="action secondary" href="@($"{Site.Collection}/gallery")">@T["Gallery_All"]</a></p>
    }
}

@code {
    private GalleryView? _gallery;
    private string _title = string.Empty;
    private string _lead = string.Empty;
    private string _back = string.Empty;
    private string _backName = string.Empty;
    private string _context = string.Empty;
    private bool _continues;
    private string _here = string.Empty;
    private GalleryOrder _order;
    private MediaKind? _kind;
    private IReadOnlyList<MediaKind> _kinds = [];
    private bool _invalid;
    private string _asked = string.Empty;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the order in the address: <c>oldest</c> or <c>newest</c>; anything else is the order of the editors.</summary>
    [SupplyParameterFromQuery(Name = "order")]
    public string? Order { get; set; }

    /// <summary>Gets or sets the kind in the address: <c>image</c> or <c>video</c>; anything else is both.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    /// <summary>Gets or sets a time in the address, as a visitor typed it: the gallery of what shows that time.</summary>
    [SupplyParameterFromQuery(Name = "time")]
    public string? Time { get; set; }

    /// <summary>Gets or sets the identifier of the entity whose media are asked for, if the address names one.</summary>
    [Parameter]
    public string? Subject { get; set; }

    /// <summary>Gets or sets the identifier of the event whose media are asked for, if the address names one.</summary>
    [Parameter]
    public string? Step { get; set; }

    protected override void OnInitialized()
    {
        var projection = Collection == Site.Collection ? Visitor.Projection : null;
        var named = Subject ?? Step;
        if (projection is null || (named is not null && (named.Length == 0 || named.Any(char.IsWhiteSpace))))
        {
            Navigation.NotFound();
            return;
        }

        // An entity or a step the visitor has not read to and one that does not exist are the same page: not found.
        // A time is asked of the whole collection; what is no time is said to be none, and the gallery stays whole.
        var time = named is null && !string.IsNullOrWhiteSpace(Time) ? AskedTime.Read(Time) : null;
        _invalid = named is null && !string.IsNullOrWhiteSpace(Time) && time is null;
        _gallery = Subject is not null ? projection.Gallery(new EntityId(Subject))
            : Step is not null ? projection.Gallery(new EventId(Step))
            : time is not null ? projection.Gallery(time, Clock.GetUtcNow().Year)
            : projection.Gallery();
        if (_gallery is null)
        {
            Navigation.NotFound();
            return;
        }

        // What a gallery has to choose from is asked before anything is left out.
        _kinds = [.. _gallery.Items.Select(item => item.Kind).Concat(_gallery.References.Select(item => item.Kind)).Concat(_gallery.MadeThen.Select(item => item.Kind)).Distinct().Order()];
        _asked = time is null ? string.Empty : "time=" + Uri.EscapeDataString(time.Written);
        _order = Order switch { "oldest" => GalleryOrder.OldestFirst, "newest" => GalleryOrder.NewestFirst, _ => GalleryOrder.Editorial };
        _kind = Kind switch { "image" => MediaKind.Image, "video" => MediaKind.Video, _ => null };
        _here = Subject is not null ? $"{Site.Collection}/entity/{Subject}/gallery" : Step is not null ? $"{Site.Collection}/event/{Step}/gallery" : $"{Site.Collection}/gallery";
        if (!_gallery.IsEmpty)
        {
            _gallery = _gallery.Arranged(_order, _kind);
        }

        var overview = projection.Overview();
        _continues = overview.StoryContinues;
        switch (_gallery)
        {
            case { Entity: { } entity }:
                var name = Visitor.Text(entity.Label).Value;
                _title = string.Format(CultureInfo.CurrentCulture, T["Gallery_TitleEntity"], name);
                _lead = string.Format(CultureInfo.CurrentCulture, T["Gallery_LeadEntity"], name);
                _back = $"{Site.Collection}/entity/{entity.Id}";
                _backName = name;
                _context = $"?entity={Uri.EscapeDataString(entity.Id.Value)}";
                break;

            case { Step: { } step }:
                var label = Visitor.Text(step.Event.Label).Value;
                _title = string.Format(CultureInfo.CurrentCulture, T["Gallery_TitleStep"], label);
                _lead = T["Gallery_LeadStep"];
                _back = StoryAddress.Of(Site, Visitor, step);
                _backName = label;
                _context = $"?event={Uri.EscapeDataString(step.Event.Id.Value)}";
                break;

            case { Time: { } shown }:
                _title = string.Format(CultureInfo.CurrentCulture, T["Gallery_TitleTime"], TimeText.Of(shown, Visitor, T));
                _lead = T["Gallery_LeadTime"];
                _back = Site.Collection;
                _backName = Visitor.Text(overview.Subject.Label).Value;
                break;

            default:
                _title = T["Gallery_Title"];
                _lead = T["Gallery_LeadCollection"];
                _back = Site.Collection;
                _backName = Visitor.Text(overview.Subject.Label).Value;
                break;
        }
    }

    private string Address(GalleryOrder order, MediaKind? kind)
    {
        var asked = new[]
        {
            _asked.Length == 0 ? null : _asked,
            order switch { GalleryOrder.OldestFirst => "order=oldest", GalleryOrder.NewestFirst => "order=newest", _ => null },
            kind is { } one ? $"kind={one.ToString().ToLowerInvariant()}" : null,
        }.Where(part => part is not null).ToList();
        return asked.Count == 0 ? _here : $"{_here}?{string.Join('&', asked)}";
    }

    // A choice of several: the one that is on says so.
    private static RenderFragment Choice(bool on, string address, string name) => on
        ? @<a class="choice" href="@address" aria-current="true">@name</a>
        : @<a class="choice" href="@address">@name</a>;
}

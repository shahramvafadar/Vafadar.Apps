@page "/{Collection}/story"
@page "/{Collection}/story/{Arc}"
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_story is { } story)
{
    var title = Visitor.Text(story.Story.Label).Value;
    <PageTitle>@T["Story_Title"] – @title – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@Site.Collection">@string.Format(CultureInfo.CurrentCulture, T["Story_Back"], title)</a></p>
        <h1>@T["Story_Title"]</h1>
        @* The frame is named: an order of telling, not a calendar and not a duration. *@
        <p class="lead">@T["Story_Frame"]</p>
    </header>

    @if (story.Steps.IsEmpty)
    {
        <p class="note">@T["Story_None"]</p>
    }
    else
    {
        <ol class="steps" role="list">
            @foreach (var step in story.Steps)
            {
                <li class="step" id="@($"step-{step.Number}")">
                    <p class="meta">@string.Format(CultureInfo.CurrentCulture, T["Step_Number"], Visitor.Number(step.Number))</p>
                    <h2><Loc Text="step.Event.Label" /> <DisputedMark Review="step.Event.Review" /></h2>
                    <p><Loc Text="step.Event.Summary" /></p>
                    @if (step.Event.CondensesSeveralScenes)
                    {
                        <p class="note">@T["Story_Condensed"]</p>
                    }
                    <h3 class="visually-hidden">@T["Story_Participants"]</h3>
                    <ul class="participants" role="list">
                        @foreach (var association in step.Event.Associations)
                        {
                            <li>
                                <a href="@($"{Site.Collection}/entity/{association.Entity}")"><Loc Text="Visitor.Projection!.Find(association.Entity)!.Label" /></a>
                                <span class="role"><Loc Text="association.Role" /></span>
                                <span class="presence">@T[$"Presence_{association.Presence}"]</span>
                            </li>
                        }
                    </ul>
                    <p><a class="evidence-link" href="@EvidenceAddress.Of(Site.Collection, step.Event.Id, $"{_base}#step-{step.Number}")">@T["Story_StepEvidence"]<span class="visually-hidden"> – @Visitor.Text(step.Event.Label).Value</span></a></p>
                    @if (!Visitor.Projection!.Gallery(step.Event.Id)!.IsEmpty)
                    {
                        <p><a href="@($"{Site.Collection}/event/{step.Event.Id}/gallery")">@T["Gallery_StepLink"]</a></p>
                    }
                </li>
            }
        </ol>

        <p class="note" role="status">@(story.Continues ? T["Reading_Continues"] : T["Reading_Complete"]) <a href="@($"{Site.Collection}#reading")">@T["Reading_Change"]</a></p>

        @* The chart shows the same steps and the same associations as the list above (ADR 0002): a mark is what
           the event states about the name, and somebody who is only mentioned has the mark for "mentioned". It
           stands in a stage (D-040) and is closed and opened at its sides: the steps where the telling begins and
           ends, the names of the steps above, the rows below. *@
        var earlier = Steps(
            T["Story_Edge_Earlier"],
            _chart.First < _chart.Last ? _state with { From = _chart.First + 1 } : null,
            _chart.First > 1 ? _state with { From = _chart.First == 2 ? null : _chart.First - 1 } : null);
        var later = Steps(
            T["Story_Edge_Later"],
            _chart.Last > _chart.First ? _state with { To = _chart.Last - 1 } : null,
            _chart.Last < _chart.StepCount ? _state with { To = _chart.Last + 1 == _chart.StepCount ? null : _chart.Last + 1 } : null);
        var heads = Steps(
            T["Story_Edge_Heads"],
            _state.Titles ? _state with { Titles = false } : null,
            _state.Titles ? null : _state with { Titles = true });
        var rows = Steps(
            T["Story_Edge_Lanes"],
            _chart.Lanes.Length > 1 ? _state with { Lanes = _chart.Lanes.Length - 1 } : null,
            _chart.Lanes.Length < _chart.LaneCount ? _state with { Lanes = _chart.Lanes.Length + 1 == _chart.LaneCount ? null : _chart.Lanes.Length + 1 } : null);

        <h2>@T["Story_Chart"]</h2>
        @if (story.Steps.Any(step => step.Event.Review == ReviewStatus.Disputed))
        {
            <p class="note">@T["Disputed_Legend"]</p>
        }

        @* The same steps on the timeline of the site (ADR 0021, step 20.10): with the script the chart becomes a view
           that is moved and made larger – on the axis of the order of the telling and on no other. The chart of
           the server stays what a page without the script shows, and what the view can be turned back into; what
           is said about that chart alone – its marks, how much of it is shown – stands with it. *@
        <p class="note">@T["Story_OnTimelineLead"]</p>
        <TimelineLive Timeline="_timeline" Here="@_base">
            <ChartHelp>@T["Story_ChartLead"] @T["Stage_Lead"]</ChartHelp>
            <p class="meta">@string.Format(CultureInfo.CurrentCulture, T["Story_ChartShown"], Visitor.Number(_chart.First), Visitor.Number(_chart.Last), Visitor.Number(_chart.StepCount), Visitor.Number(_chart.Lanes.Length), Visitor.Number(_chart.LaneCount))</p>
            @if (Visitor.Language.IsRightToLeft)
            {
                <ChartStage Id="chart" Label="@string.Format(CultureInfo.CurrentCulture, T["Story_ChartRegion"], title)" Right="earlier" Left="later" Top="heads" Bottom="rows">
                    <StoryLanesChart Chart="_chart" Titles="_state.Titles" Here="@_here" />
                </ChartStage>
            }
            else
            {
                <ChartStage Id="chart" Label="@string.Format(CultureInfo.CurrentCulture, T["Story_ChartRegion"], title)" Left="earlier" Right="later" Top="heads" Bottom="rows">
                    <StoryLanesChart Chart="_chart" Titles="_state.Titles" Here="@_here" />
                </ChartStage>
            }
        </TimelineLive>

        <h3>@T["Story_Legend"]</h3>
        <ul class="legend" role="list">
            @foreach (var presence in _lanes.Lanes.SelectMany(lane => lane.Cells).OfType<EventAssociation>().Select(cell => cell.Presence).Distinct().Order())
            {
                <li><span class="mark" aria-hidden="true">@StoryLanesChart.Mark(presence)</span> @T[$"Presence_{presence}"]</li>
            }
        </ul>

        @* The table says what the chart says, for every step and every name the visitor may see. *@
        <section>
            <h2 id="lanes">@T["Story_Lanes"]</h2>
            <p class="note">@T["Story_LanesLead"]</p>
            <div class="lanes" role="region" aria-labelledby="lanes" tabindex="0">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">@T["Story_Name"]</th>
                            @foreach (var step in _lanes.Steps)
                            {
                                <th scope="col">
                                    <a href="@($"{_base}#step-{step.Number}")" title="@Visitor.Text(step.Event.Label).Value">
                                        <span class="visually-hidden">@string.Format(CultureInfo.CurrentCulture, T["Step_Number"], string.Empty)</span>@Visitor.Number(step.Number)
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lane in _lanes.Lanes)
                        {
                            <tr>
                                <th scope="row"><a href="@($"{Site.Collection}/entity/{lane.Entity.Id}")"><Loc Text="lane.Entity.Label" /></a></th>
                                @foreach (var (cell, at) in lane.Cells.Select((cell, at) => (cell, at)))
                                {
                                    @* A cell that says something is where a mark of the timeline leads to. *@
                                    <td id="@(cell is null ? null : $"item-{TimelineViews.StoryMark(_lanes.Steps[at], lane.Entity.Id)}")">
                                        @if (cell is not null)
                                        {
                                            <span class="mark" aria-hidden="true">@StoryLanesChart.Mark(cell.Presence)</span>
                                            <span class="visually-hidden">@T[$"Presence_{cell.Presence}"]</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    private StoryView? _story;
    private LanesView _lanes = null!;
    private StoryChart _chart = null!;
    private Timeline _timeline = null!;
    private StoryChartState _state = new();
    private string _here = string.Empty;
    private string _base = string.Empty;

    /// <summary>Gets or sets the story, when it is not the one a visitor enters first.</summary>
    [Parameter]
    public string? Arc { get; set; }

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the place of the first step the chart shows, in the address.</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    /// <summary>Gets or sets the place of the last step the chart shows, in the address.</summary>
    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    /// <summary>Gets or sets the number of rows the chart shows, in the address.</summary>
    [SupplyParameterFromQuery(Name = "lanes")]
    public string? Lanes { get; set; }

    /// <summary>Gets or sets whether the steps of the chart carry their names, in the address.</summary>
    [SupplyParameterFromQuery(Name = "heads")]
    public string? Heads { get; set; }

    protected override void OnInitialized()
    {
        _story = Collection == Site.Collection ? Visitor.Projection?.Story(Arc is null ? null : new EntityId(Arc)) : null;
        if (_story is null)
        {
            Navigation.NotFound();
            return;
        }

        _base = StoryAddress.Of(Site, Visitor, _story.Story.Id);
        _lanes = Visitor.Projection!.Lanes(_story.Story.Id)!;
        _timeline = TimelineViews.OfStory(_lanes);

        // The chart is cut out of the lanes the visitor may see; the address only says how much of them. What the
        // chart then shows is written back into the state, so that its links never name a step that is not there.
        var asked = StoryChartState.Read(From, To, Lanes, Heads);
        _chart = StoryCharts.Of(_lanes, asked.From, asked.To, asked.Lanes);
        _state = asked with
        {
            From = _chart.First > 1 ? _chart.First : null,
            To = _chart.Last < _chart.StepCount ? _chart.Last : null,
            Lanes = _chart.Lanes.Length < _chart.LaneCount ? _chart.Lanes.Length : null,
        };
        _here = $"{_base}{_state.Query()}";
    }

    // The steps of a side of the stage.
    private RenderFragment Steps(string name, StoryChartState? fewer, StoryChartState? more) =>
        @<EdgeSteps Name="@name"
                    Fewer="@(fewer is null ? null : $"{_base}{fewer.Query()}#chart")"
                    More="@(more is null ? null : $"{_base}{more.Query()}#chart")" />;
}

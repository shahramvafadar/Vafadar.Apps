@page "/"
@inject Visitor Visitor
@inject DastanSite Site
@inject IStringLocalizer<Ui> T

<PageTitle>@T["Site_Name"] – @T["Site_Tagline"]</PageTitle>
<PageDescription Title="@T["Site_Name"]" Text="@($"{T["Site_Tagline"]} {T["Discover_Lead"]}")" />

<section class="hero">
    <h1>@T["Site_Name"]</h1>
    <p class="tagline">@T["Site_Tagline"]</p>
    <p>@T["Discover_Lead"]</p>
</section>

@if (Visitor.Projection is { } projection)
{
    var overview = projection.Overview();
    <section aria-labelledby="first-story">
        <h2 id="first-story">@T["Discover_First"]</h2>
        <article class="card">
            <h3><a href="@Site.Collection"><Loc Text="overview.Subject.Label" /></a></h3>
            @if (overview.Work is { } work)
            {
                <p class="meta"><Loc Text="work.Label" /></p>
            }
            <p><Loc Text="overview.Subject.Summary" /></p>
            <p><a class="action" href="@Site.Collection">@T["Discover_Open"]</a></p>
        </article>
    </section>

    <SearchForm />
}
else if (Site.Comparisons.IsEmpty)
{
    <p class="note">@T["Discover_Nothing"]</p>
}

@if (!Site.Comparisons.IsEmpty)
{
    <section aria-labelledby="side-by-side">
        <h2 id="side-by-side">@T["Discover_Comparisons"]</h2>
        @foreach (var comparison in Site.Comparisons)
        {
            <article class="card">
                <h3><a href="@($"compare/{comparison.Id}")"><Loc Text="comparison.Title" /></a></h3>
                <p><Loc Text="comparison.Summary" /></p>
                <p><a class="action" href="@($"compare/{comparison.Id}")">@T["Discover_OpenComparison"]</a></p>
            </article>
        }
    </section>
}

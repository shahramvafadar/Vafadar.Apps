}

@code {
    // What the forms may answer with: nothing else of an address is turned into words of the page.
    private IReadOnlyList<RestrictionInfo> _restrictions = [];
    private RestrictionInfo? _closed;
    private bool _termsAsked;

    // A statement of reasons, as the person it concerns reads it: what, why, on which ground, and what to do.
    private RenderFragment Statement(RestrictionInfo restriction) => __builder =>
    {
        <article class="statement" aria-label="@string.Format(CultureInfo.CurrentCulture, T["Restrictions_Number"], Visitor.Number((int)restriction.Number))">
            <h3>@T[$"Restrictions_Kind_{restriction.Kind}"] <span class="meta">– @string.Format(CultureInfo.CurrentCulture, T["Restrictions_Number"], Visitor.Number((int)restriction.Number)), @Visitor.Day(DateOnly.FromDateTime(restriction.At))</span></h3>
            <dl>
                <dt>@T["Restrictions_Effect"]</dt>
                <dd>@T[$"Restrictions_Effect_{restriction.Kind}"]</dd>
                <dt>@T["Restrictions_Reason"]</dt>
                <dd dir="auto">@restriction.Reason</dd>
                <dt>@T["Restrictions_Ground"]</dt>
                <dd dir="auto">@restriction.Ground</dd>
                <dt>@T["Restrictions_Origin"]</dt>
                <dd>@T[restriction.Noticed ? "Restrictions_Origin_Notice" : "Restrictions_Origin_Own"] @T["Restrictions_NoAutomation"]</dd>
                @if (restriction.Kind != RestrictionKind.Account)
                {
                    <dt>@T["Restrictions_Repeat"]</dt>
                    <dd>@T["Restrictions_Repeat_Text"]</dd>
                }
                <dt>@T["Restrictions_Redress"]</dt>
                <dd>@T["Restrictions_Redress_Text"] <a href="imprint">@T["Legal_imprint"]</a></dd>
            </dl>
        </article>
    };

    private static readonly string[] Sayings = ["welcome", "signed-in", "signed-out", "recovered", "reopened", "password", "codes", "closed", "brought", "invited", "revoked", "linked", "unlinked", "terms-agreed", "confirm-sent", "resend-sent", "forgot-sent", "address-sent", "address-changed", "signed-out-everywhere", "invite-sent", "notices-on", "notices-off"];
    private static readonly string[] Forms = ["sign-in", "register", "recover", "reopen", "password", "codes", "close", "invite", "export", "external", "external-waiting", "providers", "forgot", "resend", "address"];
    private static readonly string[] Known = ["later", "name-length", "name-letters", "password-short", "password-long", "password-differs", "taken", "wrong", "wrong-code", "wrong-closed", "wrong-current", "invitations", "external-failed", "login-taken", "last-way-in", "age", "terms", "invitation-needed", "closed-by-operator", "mail", "unconfirmed", "same", "external-no-address", "address-has-account"];

    // The longest mail address there is (RFC 5321); a name is shorter.
    private const int LongestAddress = 254;

    private AccountInfo? _info;
    private System.Collections.Immutable.ImmutableArray<string> _codes = [];
    private string? _said;
    private string? _form;
    private string[] _problems = [];
    private bool _private;
    private bool _invited;
    private bool _deviceHolds;
    private IReadOnlyList<InvitationInfo> _invitations = [];
    private IList<string> _providers = [];
    private string? _arrived;
    private bool _arrivedInvited;
    private bool _arrivedProven;
    private string _arrivedMail = string.Empty;
    private bool _waiting;
    private string _here = AccountDesk.Page;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? Said { get; set; }

    [SupplyParameterFromQuery]
    private string? Form { get; set; }

    [SupplyParameterFromQuery]
    private string? Problem { get; set; }

    [SupplyParameterFromQuery]
    private string? Invitation { get; set; }

    protected override void OnInitialized()
    {
        if (!Desk.IsOpen)
        {
            Navigation.NotFound();
            return;
        }

        _here = $"/{Visitor.Language.Tag}{AccountDesk.Page}";
        _private = AccountDesk.IsPrivate(Context);
        _said = Sayings.Contains(Said, StringComparer.Ordinal) ? Said : null;
        _form = Forms.Contains(Form, StringComparer.Ordinal) ? Form : null;
        _problems = _form is null ? [] : [.. (Problem ?? string.Empty).Split(',').Where(problem => Known.Contains(problem, StringComparer.Ordinal)).Distinct()];
        _providers = External.Value.Providers;
        var device = AccountState.Device(Context, Library);
        _deviceHolds = !device.Positions.IsEmpty || !device.Kept.IsEmpty;
        using (var store = Desk.Open())
        {
            if (Desk.Closed(Context) is { } number && store.Restriction(number) is { Kind: RestrictionKind.Account } statement)
            {
                _closed = statement;
            }

            if (AccountDesk.Session(Context.User) is { } session)
            {
                _info = store.Accounts.Info(session.Id);
                _restrictions = _info is null ? [] : store.Restrictions(session.Id);
                _termsAsked = _info is not null && store.TermsOf(session.Id) != AccountDesk.TermsVersion;
                _invitations = _info is null ? [] : store.Invitations(session.Id);
            }
            else
            {
                _invited = store.IsInvited(Invitation);
                var arrival = Desk.Arrival(Context);
                _arrived = arrival?.Provider;
                _arrivedInvited = arrival is { Invitation: var carried } && store.IsInvited(carried);
                (_arrivedProven, _arrivedMail) = arrival is { } came ? (came.Proven, came.Mail) : (false, string.Empty);
                _waiting = arrival is { } waits && store.Accounts.Waits(waits.Provider, waits.Subject);
            }
        }

        if (_info is not null)
        {
            _codes = Desk.Shown(Context);
        }
    }

    private string Day(DateOnly day)
    {
        var written = day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return Visitor.Language.Tag == "fa" ? Vafadar.Core.Text.Digits.ToPersian(written) : written;
    }

    // The address of the account, written from left to right in a sentence of either direction.
    private RenderFragment Address() => __builder =>
    {
        var words = T["Account_Address_Now"].Value.Split("{0}");
        @words[0]<bdi dir="ltr">@_info!.Address</bdi>@(words.Length > 1 ? words[1] : string.Empty)
    };

    // The name of a provider as people know it; one the page has no word for is called by its own name.
    private string Provider(string provider) => T[$"Account_Provider_{provider}"] is { ResourceNotFound: false } known ? known.Value : provider;

    // What was wrong with a form, said above it.
    private RenderFragment Problems(string form) => __builder =>
    {
        if (_form == form && _problems.Length > 0)
        {
            <div class="problems" role="alert"><ul>
                @foreach (var problem in _problems)
                {
                    <li>@T[$"Account_Problem_{problem}"]</li>
                }
            </ul></div>
        }
    };
}

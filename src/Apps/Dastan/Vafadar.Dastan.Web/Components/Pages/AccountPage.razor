@page "/account"
@using Vafadar.Dastan.People
@inject Visitor Visitor
@inject AccountDesk Desk
@inject DastanLibrary Library
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<ExternalSignInOptions> External
@inject IStringLocalizer<Ui> T

@* The account of a visitor (step 16.1, D-048 to D-050): making one, signing in and out, another password,
   recovery codes, closing. Every form is sent to an address of its own (AccountEndpoints) and comes back here
   with what happened; the page needs no script. A site without a store for accounts has no such page. *@
<PageTitle>@T["Account_Title"] – @T["Site_Name"]</PageTitle>
<PageAddress None="true" />
@* The account of one visitor is no page for a search engine. *@
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>

@if (Desk.IsOpen)
{
    <header class="page-header">
        <h1>@T["Account_Title"]</h1>
        @if (_info is null)
        {
            <p class="lead">@T["Account_Lead"]</p>
        }
        else
        {
            <p class="lead">@string.Format(CultureInfo.CurrentCulture, T["Account_Signed"], _info.Name)</p>
            <p class="actions">
                <a class="action secondary" href="account/people">@T["People_Link"]</a>
                <a class="action secondary" href="account/trees">@T["Trees_Title"]</a>
                @if (Desk.PhotoFolder is not null)
                {
                    <a class="action secondary" href="account/photos">@T["Photos_Title"]</a>
                }
            </p>
        }
    </header>

    @if (_said is not null)
    {
        <p class="note" role="status">@T[$"Account_Said_{_said}"]</p>
    }

    @if (!_private)
    {
        <p class="note" role="alert">@T["Account_NeedsHttps"]</p>
    }
    else if (_info is null)
    {
        @if (_arrived is { } arrived)
        {
            @* Somebody signed in through a provider and has no account yet (step 16.8): they choose its name. *@
            <section id="external" aria-labelledby="external-title">
                <h2 id="external-title">@T["Account_Choose_Title"]</h2>
                <p>@string.Format(CultureInfo.CurrentCulture, T["Account_Choose_Lead"], Provider(arrived))</p>
                @Problems("external")
                @if (Desk.InvitationOnly && !_arrivedInvited)
                {
                    @* A closed trial (D-068): the form would be refused, so the page says why instead of offering it
                       (seen in a browser, step 18.2.1). *@
                    <p class="note">@T["Account_InvitationOnly"]</p>
                }
                else
                {
                <form method="post" action="@($"{AccountDesk.Root}/external-register")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="visually-hidden" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></p>
                    <p class="field">
                        <label for="external-name">@T["Account_Name"]</label>
                        <input id="external-name" name="name" type="text" required minlength="@PeopleStore.ShortestName" maxlength="@PeopleStore.LongestName" autocomplete="username" dir="auto" aria-describedby="external-name-hint" />
                        <span class="meta" id="external-name-hint">@T["Account_Name_Hint"]</span>
                    </p>
                    <p class="tick">
                    <input id="external-age" name="age" type="checkbox" required />
                    <label for="external-age">@T["Account_Age"]</label>
                </p>
                    @* Not the note of the form with a password: this account has none (seen in a browser, step 18.2.2). *@
                    <p class="note">@string.Format(CultureInfo.CurrentCulture, T["Account_Choose_Privacy"], Provider(arrived))</p>
                    @if (_deviceHolds)
                    {
                        <p class="note">@T["Account_Register_Adopts"]</p>
                    }
                    <p><button type="submit" class="action">@T["Account_Choose_Send"]</button></p>
                </form>
                }
            </section>
        }

        <section id="sign-in" aria-labelledby="sign-in-title">
            <h2 id="sign-in-title">@T["Account_SignIn_Title"]</h2>
            @Problems("sign-in")
            <form method="post" action="@($"{AccountDesk.Root}/sign-in")" class="account">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_here" />
                <p class="field">
                    <label for="sign-in-name">@T["Account_Name"]</label>
                    <input id="sign-in-name" name="name" type="text" required maxlength="@PeopleStore.LongestName" autocomplete="username" dir="auto" />
                </p>
                <p class="field">
                    <label for="sign-in-password">@T["Account_Password"]</label>
                    <input id="sign-in-password" name="password" type="password" required autocomplete="current-password" />
                </p>
                <p><button type="submit" class="action">@T["Account_SignIn_Send"]</button></p>
            </form>
            @if (_providers.Count > 0)
            {
                @* Offered only when the owner entered a client of the provider (D-048). *@
                <h3 id="external-sign-in">@T["Account_External_Title"]</h3>
                <p>@T["Account_External_Lead"]</p>
                <div class="actions">
                    @foreach (var provider in _providers)
                    {
                        <form method="post" action="@($"{AccountDesk.Root}/external")" class="save inline">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@_here" />
                            <input type="hidden" name="provider" value="@provider" />
                            @if (_invited)
                            {
                                <input type="hidden" name="invitation" value="@Invitation" />
                            }
                            <button type="submit" class="action secondary">@string.Format(CultureInfo.CurrentCulture, T["Account_External_Send"], Provider(provider))</button>
                        </form>
                    }
                </div>
            }
        </section>

        <section id="register" aria-labelledby="register-title">
            <h2 id="register-title">@T["Account_Register_Title"]</h2>
            @if (Invitation is { Length: > 0 })
            {
                @* An invitation leads here and to nothing else (PRIV-006). One that cannot be used any more stops nobody. *@
                <p class="note" role="status">@T[_invited ? "Account_Invited" : "Account_Invitation_Gone"]</p>
            }
            @Problems("register")
            @if (Desk.InvitationOnly && !_invited)
            {
                @* A closed trial (D-068): who has an account invites others, and nobody else makes one. *@
                <p class="note">@T["Account_InvitationOnly"]</p>
            }
            else
            {
            <form method="post" action="@($"{AccountDesk.Root}/register")" class="account">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_here" />
                @* A field no person sees: a program that fills in everything fills it in. *@
                <p class="visually-hidden" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></p>
                <p class="field">
                    <label for="register-name">@T["Account_Name"]</label>
                    <input id="register-name" name="name" type="text" required minlength="@PeopleStore.ShortestName" maxlength="@PeopleStore.LongestName" autocomplete="username" dir="auto" aria-describedby="register-name-hint" />
                    <span class="meta" id="register-name-hint">@T["Account_Name_Hint"]</span>
                </p>
                <p class="field">
                    <label for="register-password">@T["Account_Password"]</label>
                    <input id="register-password" name="password" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" aria-describedby="register-password-hint" />
                    <span class="meta" id="register-password-hint">@T["Account_Password_Hint"]</span>
                </p>
                <p class="field">
                    <label for="register-again">@T["Account_Password_Again"]</label>
                    <input id="register-again" name="again" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" />
                </p>
                @if (_invited)
                {
                    <input type="hidden" name="invitation" value="@Invitation" />
                }
                <p class="tick">
                    <input id="register-age" name="age" type="checkbox" required />
                    <label for="register-age">@T["Account_Age"]</label>
                </p>
                <p class="note">@T["Account_Register_Privacy"]</p>
                @if (_deviceHolds)
                {
                    <p class="note">@T["Account_Register_Adopts"]</p>
                }
                <p><button type="submit" class="action secondary">@T["Account_Register_Send"]</button></p>
            </form>
            }
        </section>

        <section id="recover" aria-labelledby="recover-title">
            <h2 id="recover-title">@T["Account_Recover_Title"]</h2>
            @Problems("recover")
            <details open="@(_form == "recover")">
                <summary>@T["Account_Recover_Lead"]</summary>
                <form method="post" action="@($"{AccountDesk.Root}/recover")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="field">
                        <label for="recover-name">@T["Account_Name"]</label>
                        <input id="recover-name" name="name" type="text" required maxlength="@PeopleStore.LongestName" autocomplete="username" dir="auto" />
                    </p>
                    <p class="field">
                        <label for="recover-code">@T["Account_Code"]</label>
                        <input id="recover-code" name="code" type="text" required maxlength="40" autocomplete="off" dir="ltr" />
                    </p>
                    <p class="field">
                        <label for="recover-password">@T["Account_NewPassword"]</label>
                        <input id="recover-password" name="password" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" />
                    </p>
                    <p class="field">
                        <label for="recover-again">@T["Account_Password_Again"]</label>
                        <input id="recover-again" name="again" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_Recover_Send"]</button></p>
                </form>
            </details>
        </section>

        <section id="reopen" aria-labelledby="reopen-title">
            <h2 id="reopen-title">@T["Account_Reopen_Title"]</h2>
            @Problems("reopen")
            <details open="@(_form == "reopen")">
                <summary>@T["Account_Reopen_Lead"]</summary>
                <form method="post" action="@($"{AccountDesk.Root}/reopen")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="field">
                        <label for="reopen-name">@T["Account_Name"]</label>
                        <input id="reopen-name" name="name" type="text" required maxlength="@PeopleStore.LongestName" autocomplete="username" dir="auto" />
                    </p>
                    <p class="field">
                        <label for="reopen-password">@T["Account_Password"]</label>
                        <input id="reopen-password" name="password" type="password" required autocomplete="current-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_Reopen_Send"]</button></p>
                </form>
            </details>
        </section>
    }
    else
    {
        @if (!_codes.IsEmpty)
        {
            <section id="codes-shown" aria-labelledby="codes-shown-title" class="codes">
                <h2 id="codes-shown-title">@T["Account_Codes_Title"]</h2>
                <p>@T["Account_Codes_Lead"]</p>
                <ul role="list" dir="ltr">
                    @foreach (var shown in _codes)
                    {
                        <li><code>@shown</code></li>
                    }
                </ul>
            </section>
        }

        <form method="post" action="@($"{AccountDesk.Root}/sign-out")" class="account">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@_here" />
            <p><button type="submit" class="action">@T["Account_SignOut"]</button></p>
        </form>

        <section id="follows" aria-labelledby="follows-title">
            <h2 id="follows-title">@T["Account_Follows_Title"]</h2>
            <p>@T["Account_Follows_Lead"]</p>
            @if (_deviceHolds)
            {
                <form method="post" action="@($"{AccountDesk.Root}/bring")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p>@T["Account_Bring_Lead"]</p>
                    <p class="note">@T["Account_Bring_Note"]</p>
                    <p><button type="submit" class="action secondary">@T["Account_Bring_Send"]</button></p>
                </form>
            }
        </section>

        <section id="invite" aria-labelledby="invite-title">
            <h2 id="invite-title">@T["Account_Invite_Title"]</h2>
            <p>@T["Account_Invite_Lead"]</p>
            @Problems("invite")
            @if (_invitations.Count > 0)
            {
                <ul class="invitations" role="list">
                    @foreach (var invitation in _invitations)
                    {
                        <li>
                            @if (invitation.IsOpen)
                            {
                                // The language is the first part of the path of this request already: the address is built from where the site was reached.
                                var link = $"{Context.Request.Scheme}://{Context.Request.Host}/{Visitor.Language.Tag}{AccountDesk.Page}?invitation={invitation.Code}";
                                <code dir="ltr">@link</code>
                                <span class="meta">@string.Format(CultureInfo.CurrentCulture, T["Account_Invite_Open"], Day(invitation.LastDay))</span>
                                <form method="post" action="@($"{AccountDesk.Root}/revoke")" class="save inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="@_here" />
                                    <input type="hidden" name="code" value="@invitation.Code" />
                                    <button type="submit">@T["Account_Invite_Revoke"]</button>
                                </form>
                            }
                            else
                            {
                                <code dir="ltr">@invitation.Code[..4]…</code>
                                <span class="meta">@T[invitation.RunOut ? "Account_Invite_RunOut" : $"Account_Invite_{invitation.State}"]</span>
                            }
                        </li>
                    }
                </ul>
            }
            <form method="post" action="@($"{AccountDesk.Root}/invite")" class="account">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_here" />
                <p><button type="submit" class="action secondary">@T["Account_Invite_Send"]</button></p>
            </form>
        </section>

        @if (_providers.Count > 0 || !_info.Providers.IsEmpty)
        {
            <section id="providers" aria-labelledby="providers-title">
                <h2 id="providers-title">@T["Account_Providers_Title"]</h2>
                <p>@T[_info.Providers.IsEmpty ? "Account_Providers_None" : "Account_Providers_Lead"]</p>
                @Problems("providers")
                @if (!_info.Providers.IsEmpty)
                {
                    <ul class="invitations" role="list">
                        @foreach (var provider in _info.Providers)
                        {
                            <li>
                                <span>@Provider(provider)</span>
                                <form method="post" action="@($"{AccountDesk.Root}/unlink")" class="save inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="@_here" />
                                    <input type="hidden" name="provider" value="@provider" />
                                    <button type="submit">@string.Format(CultureInfo.CurrentCulture, T["Account_Providers_Remove"], Provider(provider))</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <div class="actions">
                    @foreach (var provider in _providers.Where(provider => !_info.Providers.Contains(provider)))
                    {
                        <form method="post" action="@($"{AccountDesk.Root}/external")" class="save inline">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@_here" />
                            <input type="hidden" name="provider" value="@provider" />
                            <button type="submit" class="action secondary">@string.Format(CultureInfo.CurrentCulture, T["Account_Providers_Add"], Provider(provider))</button>
                        </form>
                    }
                </div>
            </section>
        }

        @if (!_info.HasPassword)
        {
            @* An account made through a provider has no password until its visitor sets one. *@
            <section id="password" aria-labelledby="password-title">
                <h2 id="password-title">@T["Account_SetPassword_Title"]</h2>
                <p>@T["Account_SetPassword_Lead"]</p>
                @Problems("password")
                <form method="post" action="@($"{AccountDesk.Root}/set-password")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="visually-hidden" aria-hidden="true"><input type="text" name="name" value="@_info.Name" autocomplete="username" readonly tabindex="-1" /></p>
                    <p class="field">
                        <label for="password-new">@T["Account_NewPassword"]</label>
                        <input id="password-new" name="password" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" aria-describedby="password-new-hint" />
                        <span class="meta" id="password-new-hint">@T["Account_Password_Hint"]</span>
                    </p>
                    <p class="field">
                        <label for="password-again">@T["Account_Password_Again"]</label>
                        <input id="password-again" name="again" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_SetPassword_Send"]</button></p>
                </form>
            </section>

            <section id="codes" aria-labelledby="codes-title">
                <h2 id="codes-title">@T["Account_NewCodes_Title"]</h2>
                <p>@string.Format(CultureInfo.CurrentCulture, T["Account_CodesLeft"], Visitor.Number(_info.RecoveryCodesLeft))</p>
                <p class="note">@T["Account_NeedsPassword"]</p>
            </section>
            <section id="export" aria-labelledby="export-title">
                <h2 id="export-title">@T["Account_Export_Title"]</h2>
                <p class="note">@T["Account_NeedsPassword"]</p>
            </section>
            <section id="close" aria-labelledby="close-title">
                <h2 id="close-title">@T["Account_Close_Title"]</h2>
                <p class="note">@T["Account_NeedsPassword"]</p>
            </section>
        }
        else
        {
        <section id="password" aria-labelledby="password-title">
            <h2 id="password-title">@T["Account_Password_Title"]</h2>
            @Problems("password")
            <form method="post" action="@($"{AccountDesk.Root}/password")" class="account">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@_here" />
                @* A password manager fills in a form by the name that stands with it. *@
                <p class="visually-hidden" aria-hidden="true"><input type="text" name="name" value="@_info.Name" autocomplete="username" readonly tabindex="-1" /></p>
                <p class="field">
                    <label for="password-current">@T["Account_Current"]</label>
                    <input id="password-current" name="current" type="password" required autocomplete="current-password" />
                </p>
                <p class="field">
                    <label for="password-new">@T["Account_NewPassword"]</label>
                    <input id="password-new" name="password" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" aria-describedby="password-new-hint" />
                    <span class="meta" id="password-new-hint">@T["Account_Password_Hint"]</span>
                </p>
                <p class="field">
                    <label for="password-again">@T["Account_Password_Again"]</label>
                    <input id="password-again" name="again" type="password" required minlength="@PeopleStore.PasswordLength" autocomplete="new-password" />
                </p>
                <p class="note">@T["Account_Password_Note"]</p>
                <p><button type="submit" class="action secondary">@T["Account_Password_Send"]</button></p>
            </form>
        </section>

        <section id="codes" aria-labelledby="codes-title">
            <h2 id="codes-title">@T["Account_NewCodes_Title"]</h2>
            <p>@string.Format(CultureInfo.CurrentCulture, T["Account_CodesLeft"], Visitor.Number(_info.RecoveryCodesLeft))</p>
            @Problems("codes")
            <details open="@(_form == "codes")">
                <summary>@T["Account_NewCodes_Lead"]</summary>
                <form method="post" action="@($"{AccountDesk.Root}/codes")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="field">
                        <label for="codes-current">@T["Account_Current"]</label>
                        <input id="codes-current" name="current" type="password" required autocomplete="current-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_NewCodes_Send"]</button></p>
                </form>
            </details>
        </section>

        <section id="export" aria-labelledby="export-title">
            <h2 id="export-title">@T["Account_Export_Title"]</h2>
            @Problems("export")
            <details open="@(_form == "export")">
                <summary>@T["Account_Export_Lead"]</summary>
                <form method="post" action="@($"{AccountDesk.Root}/export")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="field">
                        <label for="export-current">@T["Account_Current"]</label>
                        <input id="export-current" name="current" type="password" required autocomplete="current-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_Export_Send"]</button></p>
                </form>
            </details>
        </section>

        <section id="close" aria-labelledby="close-title">
            <h2 id="close-title">@T["Account_Close_Title"]</h2>
            @Problems("close")
            <details open="@(_form == "close")">
                <summary>@T["Account_Close_Lead"]</summary>
                <form method="post" action="@($"{AccountDesk.Root}/close")" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@_here" />
                    <p class="field">
                        <label for="close-current">@T["Account_Current"]</label>
                        <input id="close-current" name="current" type="password" required autocomplete="current-password" />
                    </p>
                    <p><button type="submit" class="action secondary">@T["Account_Close_Send"]</button></p>
                </form>
            </details>
        </section>
        }
    }
}

@code {
    // What the forms may answer with: nothing else of an address is turned into words of the page.
    private static readonly string[] Sayings = ["welcome", "signed-in", "signed-out", "recovered", "reopened", "password", "codes", "closed", "brought", "invited", "revoked", "linked", "unlinked"];
    private static readonly string[] Forms = ["sign-in", "register", "recover", "reopen", "password", "codes", "close", "invite", "export", "external", "providers"];
    private static readonly string[] Known = ["later", "name-length", "name-letters", "password-short", "password-long", "password-differs", "taken", "wrong", "wrong-code", "wrong-closed", "wrong-current", "invitations", "external-failed", "login-taken", "last-way-in", "age", "invitation-needed"];

    private VisitorInfo? _info;
    private System.Collections.Immutable.ImmutableArray<string> _codes = [];
    private string? _said;
    private string? _form;
    private string[] _problems = [];
    private bool _private;
    private bool _invited;
    private bool _deviceHolds;
    private IReadOnlyList<InvitationInfo> _invitations = [];
    private IList<string> _providers = [];
    private string? _arrived;
    private bool _arrivedInvited;
    private string _here = AccountDesk.Page;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? Said { get; set; }

    [SupplyParameterFromQuery]
    private string? Form { get; set; }

    [SupplyParameterFromQuery]
    private string? Problem { get; set; }

    [SupplyParameterFromQuery]
    private string? Invitation { get; set; }

    protected override void OnInitialized()
    {
        if (!Desk.IsOpen)
        {
            Navigation.NotFound();
            return;
        }

        _here = $"/{Visitor.Language.Tag}{AccountDesk.Page}";
        _private = AccountDesk.IsPrivate(Context);
        _said = Sayings.Contains(Said, StringComparer.Ordinal) ? Said : null;
        _form = Forms.Contains(Form, StringComparer.Ordinal) ? Form : null;
        _problems = _form is null ? [] : [.. (Problem ?? string.Empty).Split(',').Where(problem => Known.Contains(problem, StringComparer.Ordinal)).Distinct()];
        _providers = External.Value.Providers;
        var device = AccountState.Device(Context, Library);
        _deviceHolds = !device.Positions.IsEmpty || !device.Kept.IsEmpty;
        using (var store = Desk.Open())
        {
            if (AccountDesk.Session(Context.User) is { } session)
            {
                _info = store.Info(session.Id);
                _invitations = _info is null ? [] : store.Invitations(session.Id);
            }
            else
            {
                _invited = store.IsInvited(Invitation);
                var arrival = Desk.Arrival(Context);
                _arrived = arrival?.Provider;
                _arrivedInvited = arrival is { Invitation: var carried } && store.IsInvited(carried);
            }
        }

        if (_info is not null)
        {
            _codes = Desk.Shown(Context);
        }
    }

    private string Day(DateOnly day)
    {
        var written = day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return Visitor.Language.Tag == "fa" ? Vafadar.Core.Text.Digits.ToPersian(written) : written;
    }

    // The name of a provider as people know it; one the page has no word for is called by its own name.
    private string Provider(string provider) => T[$"Account_Provider_{provider}"] is { ResourceNotFound: false } known ? known.Value : provider;

    // What was wrong with a form, said above it.
    private RenderFragment Problems(string form) => __builder =>
    {
        if (_form == form && _problems.Length > 0)
        {
            <ul class="problems" role="alert">
                @foreach (var problem in _problems)
                {
                    <li>@T[$"Account_Problem_{problem}"]</li>
                }
            </ul>
        }
    };
}

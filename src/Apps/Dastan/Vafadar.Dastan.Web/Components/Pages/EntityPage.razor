@page "/{Collection}/entity/{Id}"
@inject Visitor Visitor
@inject DastanSite Site
@inject DastanLibrary Library
@inject AccountDesk Desk
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T
@inject TimeProvider Clock

@if (_entity is { } overview)
{
    var story = Visitor.Projection!.Overview().Subject;
    <PageTitle>@Visitor.Text(overview.Entity.Label).Value – @T["Site_Name"]</PageTitle>
    <PageDescription Title="@Visitor.Text(overview.Entity.Label).Value" Text="@Visitor.Text(overview.Entity.Summary).Value" />

    @* The head (step 20.9): the same for every kind of thing – what it is at the first glance, its picture or the
       drawing of its kind, its name, where it is, a line and the facts of a card – and below it the two things
       a visitor does first: explore its connections, keep it. *@
    <IdentityHead Profile="_profile!" Flavour="@IdentityMark.Of(overview.Entity.Type)">
        <Where>
            @if (overview.Entity.Position is { } position)
            {
                @* Where the place is. The link is a position a device opens with its own map; the page loads no map. *@
                <p class="meta position">
                    @T["Position_Title"]: <a href="@PositionText.Address(position)"><bdi>@PositionText.Of(position, Visitor, T)</bdi></a>
                    @if (position.Precision != PositionPrecision.Exact)
                    {
                        <span>– @T[$"PositionPrecision_{position.Precision}"]</span>
                    }
                </p>
            }
            <p class="meta">
                <a href="@Site.Collection">@string.Format(CultureInfo.CurrentCulture, T["Entity_Collection"], Visitor.Text(story.Label).Value)</a>
            </p>
        </Where>
        <ChildContent>
            <a class="action" href="@($"{Site.Collection}/{_explore.Address(ExplorationView.Connections)}")">@T["Entity_Explore"]</a>
            @if (Exploring.HasTimes(Visitor.Projection, overview.Entity.Id) || TimelineLanes.HasLifespan(overview.Entity))
            {
                @* A name with a time can be laid beside others (D-092, D-093): the comparison begins with this one; more are chosen there. *@
                <a class="action secondary" href="@($"compare?pick={Uri.EscapeDataString($"{Site.Collection}/{overview.Entity.Id}")}#yours")"><Icon Name="compare" /><span>@T["Entity_CompareWith"]</span></a>
            }
            <SaveControl Kind="SavedKind.Entity" Id="@overview.Entity.Id.Value" />
            @if (Desk.IsOpen && Library.Institutions.Find(new EntityReference(Site.Collection, overview.Entity.Id)) is not null)
            {
                @* A place people can have been at: who signed in may ask who states to have been here and lets
                   them know (step 20.4). The page itself names nobody. *@
                <a class="action secondary" rel="nofollow" href="@($"account/affiliations?entity={Uri.EscapeDataString($"{Site.Collection}/{overview.Entity.Id}")}#find")">@T["Entity_WhoWasHere"]</a>
            }
        </ChildContent>
    </IdentityHead>

    <ExploreBar State="_explore" />

    @if (_stated.Years is not null)
    {
        @* The years the visitor chose (D-084, step 25.3): what is stated about the name is shown when it lies in
           them, what states no time is shown apart, and what states another time is counted and said to be
           left out. The head of the page – the name and its facts – is of the name and is never left out. *@
        var leftOut = _stated.LeftOut + _connected.LeftOut;
        <p class="note entity-years" role="status">
            @string.Format(CultureInfo.CurrentCulture, T[_stated.In.IsEmpty && _connected.In.IsEmpty ? "Entity_Years_None" : "Entity_Years"], _years)
            @if (leftOut > 0)
            {
                @(" " + string.Format(CultureInfo.CurrentCulture, T["Entity_Years_LeftOut"], Visitor.Number(leftOut)))
                @(" ")<a href="@($"{Site.Collection}/{_explore.WithYears(null).Address(ExplorationView.Overview)}")">@T["Explore_Years_Clear"]</a>
            }
        </p>
    }

    @if (_hasMedia || !overview.Appearances.IsEmpty)
    {
        @* In story and picture (step 20.9): what shows it and where the telling has to do with it, as cards – a
           few pictures first, then every step of the telling the visitor has read to, in the order of the story. *@
        <section class="in-story" aria-labelledby="in-story">
            <h2 id="in-story">@T["Entity_InStory"]</h2>
            <ul class="cards in-story-cards" role="list">
                @foreach (var item in overview.Media.Take(_pictures))
                {
                    var viewer = $"{Site.Collection}/media/{item.Id}?entity={Uri.EscapeDataString(overview.Entity.Id.Value)}";
                    var picture = Site.ContentFile(item.Kind == MediaKind.Video ? item.Poster : item.File) is null
                        ? null
                        : item.Kind == MediaKind.Video ? MediaAddress.Poster(Site.Collection, item.Id) : MediaAddress.File(Site.Collection, item.Id);
                    <li class="card media-card">
                        @if (picture is not null)
                        {
                            <a class="thumb" href="@viewer" tabindex="-1" aria-hidden="true"><img src="@picture" srcset="@MediaAddress.SourceSet(Site.Collection, item, file => Site.ContentFile(file) is not null)" sizes="@(item.Sizes.IsEmpty ? null : "(min-width: 40rem) 20rem, 100vw")" alt="" loading="lazy" /></a>
                        }
                        <p class="meta">@T[$"Media_Kind_{item.Kind}"] – @T[$"Media_Representation_{item.Representation}"]</p>
                        <h3><a href="@viewer"><Loc Text="item.Label" /></a></h3>
                        <p><Loc Text="item.CaptionAt(overview.Entity.Id)" /></p>
                    </li>
                }
                @foreach (var appearance in overview.Appearances)
                {
                    <li class="card step-card">
                        <p class="meta">@string.Format(CultureInfo.CurrentCulture, T["Step_Number"], Visitor.Number(appearance.Step.Number))</p>
                        <h3><a href="@(StoryAddress.Of(Site, Visitor, appearance.Step))"><Loc Text="appearance.Step.Event.Label" /></a></h3>
                        <p><Loc Text="appearance.Association.Role" /> <span class="presence">@T[$"Presence_{appearance.Association.Presence}"]</span></p>
                        <p><a class="evidence-link" href="@EvidenceAddress.Of(Site.Collection, appearance.Step.Event.Id, overview.Entity.Id, _here)">@T["Evidence_Link"]<span class="visually-hidden"> – @Visitor.Text(appearance.Step.Event.Label).Value</span></a></p>
                    </li>
                }
            </ul>
            @if (_hasMedia)
            {
                <p class="actions"><a class="action secondary" href="@($"{Site.Collection}/{_explore.Address(ExplorationView.Pictures)}")">@T["Entity_AllPictures"]</a></p>
            }
        </section>
    }

    @if (!overview.Entity.Dated.IsEmpty)
    {
        @* What is stated about the entity itself: when something lasted or happened, how much of something. *@
        <section aria-labelledby="stated">
            <h2 id="stated">@T["Entity_Stated"]</h2>
            @if (_stated.IsEmpty)
            {
                <p class="note">@T["Entity_Stated_Empty"]</p>
            }
            else if (_stated.Years is null)
            {
                @Stated(_stated.In)
            }
            else
            {
                @if (!_stated.In.IsEmpty)
                {
                    <h3>@string.Format(CultureInfo.CurrentCulture, T["Entity_InYears"], _years)</h3>
                    @Stated(_stated.In)
                }
                @if (!_stated.WithoutTime.IsEmpty)
                {
                    <h3>@T["Connections_WithoutTime"]</h3>
                    @Stated(_stated.WithoutTime)
                }
            }
            @* The same quantity stated for several times is drawn as well – the whole series, whatever years are
               chosen: a line of numbers is read as a whole. The list above has every digit of the years asked for. *@
            @foreach (var series in QuantitySeries.Of(overview.Entity, Site.Language))
            {
                <SeriesFigure Series="series" Here="@_here" />
            }
        </section>
    }

    <section aria-labelledby="connections">
        <h2 id="connections">@T["Entity_Connections"]</h2>
        @if (_connected.IsEmpty)
        {
            <p class="note">@T[_connected.LeftOut > 0 ? "Connections_Years_Empty" : "Entity_NoConnections"]</p>
        }
        else
        {
            @if (_connected.Years is null)
            {
                @Connected(_connected.In, overview.Entity)
            }
            else
            {
                @if (!_connected.In.IsEmpty)
                {
                    <h3>@string.Format(CultureInfo.CurrentCulture, T["Connections_InYears"], _years)</h3>
                    @Connected(_connected.In, overview.Entity)
                }
                @if (!_connected.WithoutTime.IsEmpty)
                {
                    <h3>@T["Connections_WithoutTime"]</h3>
                    <p class="note">@T["Connections_WithoutTimeNote"]</p>
                    @Connected(_connected.WithoutTime, overview.Entity)
                }
            }
            <p class="actions">
                <a class="action secondary" href="@($"{Site.Collection}/{_explore.Address(ExplorationView.Connections)}")">@T["Entity_ToGraph"]</a>
                @if (_hasFamily)
                {
                    <a class="action secondary" href="@($"{Site.Collection}/{_explore.Address(ExplorationView.Family)}")">@T["Entity_ToFamily"]</a>
                }
            </p>
        }
    </section>

    @if (!_onward.IsEmpty)
    {
        @* Where to go on from here, each with its reason (step 14.9, R-PUB-06): the threads that pass this name. *@
        <section aria-labelledby="onward">
            <h2 id="onward">@T["Thread_Onward"]</h2>
            <ul class="statements" role="list">
                @foreach (var onward in _onward)
                {
                    <li>
                        @if (onward.Next is { } next)
                        {
                            <a href="@ThreadText.Address(Site, Visitor, next)"><Loc Text="ThreadText.Label(next)" /></a>
                            <text> – </text><Loc Text="next.Stop.Note" />
                        }
                        else
                        {
                            <span>@T["Thread_LastReached"]</span>
                        }
                        <span class="meta">
                            (<a href="@($"{Site.Collection}/thread/{onward.Thread.Id}#stop-{onward.Here.Number}")"><Loc Text="onward.Thread.Label" /></a>)
                        </span>
                    </li>
                }
            </ul>
        </section>
    }

    @* Folded until asked for (step 20.9): every fact of the profile with what is not known, the other names,
       the sources and what other catalogues call it. Nothing is hidden – a page without script shows the fold
       and opens it –, it only does not stand before what a visitor came for. *@
    <details class="fold" id="details">
        <summary>@T["Entity_Details"]</summary>
        @if (_profile is { } profile)
        {
            @* The profile (step 19.5, ADR 0017): the facts the kind needs – each stated or said to be unknown –
               with those that were added, and which picture the head shows. *@
            <section class="profile" aria-labelledby="profile">
                <h2 id="profile">@T["Profile_Title"]</h2>
                <ProfileFactList Lines="[.. profile.Essential, .. profile.More]" />
                <p class="meta">
                    @if (profile.Picture is { } picture)
                    {
                        <a href="@($"{Site.Collection}/media/{picture.Id}")"><Loc Text="picture.Label" /></a>
                    }
                    else
                    {
                        @T["Profile_NoPicture"]
                    }
                </p>
            </section>
        }

        @if (!overview.Entity.Names.IsEmpty)
        {
            @* The other names, each in its own language and with what kind of name it is. *@
            <p class="meta" id="names">@T["Names_Title"]:</p>
            <ul class="names" role="list" aria-labelledby="names">
                @foreach (var name in overview.Entity.Names)
                {
                    <li>
                        <span lang="@name.Language" dir="auto">@name.Name</span>
                        <span class="meta">– @T[$"NameKind_{name.Kind}"]@if (name.Time is { } time) {<text>, @TimeText.Of(time, Visitor, T)</text>}</span>
                    </li>
                }
            </ul>
        }

        @if (overview.Entity.Type == EntityTypes.Theme && overview.Entity.Sources.IsEmpty)
        {
            @* A theme is a grouping of the editors; where it rests on no source the page says what it is instead of leading to an empty list. *@
            <p class="meta">@T["Entity_ThemeNote"]</p>
        }
        else
        {
            <p class="meta"><a href="@EvidenceAddress.Of(Site.Collection, overview.Entity.Id, _here)">@T["Evidence_Title"]</a></p>
        }

        @if (!overview.Entity.Identifiers.IsEmpty)
        {
            @* What others call it. A link leaves Dastan; what the other catalogue states is not vouched for here. *@
            <section aria-labelledby="identifiers">
                <h2 id="identifiers">@T["Identifiers_Title"]</h2>
                <p class="note">@T["Identifiers_Note"]</p>
                <ul class="identifiers" role="list">
                    @foreach (var identifier in overview.Entity.Identifiers)
                    {
                        <li>
                            <span dir="auto">@identifier.Issuer</span>:
                            @if (identifier.Url is { } url)
                            {
                                <a href="@url" rel="external noopener noreferrer"><bdi>@identifier.Value</bdi></a>
                            }
                            else
                            {
                                <bdi>@identifier.Value</bdi>
                            }
                            @if (identifier.Match != IdentifierMatch.Exact)
                            {
                                <span class="meta">– @T[$"IdentifierMatch_{identifier.Match}"]</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </details>
}

@code {
    // What is stated about the name itself, as a list of facts.
    private RenderFragment Stated(IEnumerable<DatedStatement> statements) => __builder =>
    {
        <dl class="facts stated">
            @foreach (var statement in statements)
            {
                <dt id="@($"stated-{statement.Key}")"><Loc Text="statement.Label" /> <DisputedMark Review="statement.Review" />
                    @if (_stated.Possibly.Contains(statement))
                    {
                        <span class="possibly">– @T["Connections_Possibly"]</span>
                    }
                </dt>
                <dd>
                    @if (statement.Quantity is { } quantity)
                    {
                        <strong class="quantity">@QuantityText.Of(quantity, Visitor, T)</strong>
                    }
                    @if (statement.Time is { } time)
                    {
                        <span class="when">@TimeText.Of(time, Visitor, T)</span>
                    }
                    @if (statement.Summary is { } summary)
                    {
                        <p><Loc Text="summary" /></p>
                    }
                </dd>
            }
        </dl>
    };

    // The connections of the name, each with its sources. Many connections stand in groups of the same relation
    // – parents, rule, places – each with its count (D-094), in the order the first of each appears.
    private RenderFragment Connected(IEnumerable<Connection> connections, Entity self) => __builder =>
    {
        var all = connections.ToList();
        var groups = all.GroupBy(connection => Visitor.Text(connection.Relation.Label).Value, StringComparer.Ordinal).ToList();
        if (all.Count > GroupFrom && groups.Count > 1)
        {
            foreach (var group in groups)
            {
                <h3 class="relation-group">@group.Key <span class="count">@Visitor.Number(group.Count())</span></h3>
                <text>@ConnectedList(group, self)</text>
            }
        }
        else
        {
            <text>@ConnectedList(all, self)</text>
        }
    };

    // From how many connections on they are grouped: a few read well as one list.
    private const int GroupFrom = 6;

    private RenderFragment ConnectedList(IEnumerable<Connection> connections, Entity self) => __builder =>
    {
        <ul class="statements" role="list">
            @foreach (var connection in connections)
            {
                var edge = connection.Direction == ConnectionDirection.Incoming
                    ? new Edge(connection.Relation, connection.Other, self)
                    : new Edge(connection.Relation, self, connection.Other);
                <li>
                    <Statement Relation="edge" Self="self.Id" Evidence="true" From="@_here" />
                    @if (_connected.Possibly.Contains(connection))
                    {
                        <span class="possibly">– @T["Connections_Possibly"]</span>
                    }
                </li>
            }
        </ul>
    };

    private YearParts<DatedStatement> _stated = null!;
    private YearParts<Connection> _connected = null!;
    private string _years = string.Empty;
    private EntityOverview? _entity;
    private NodeProfile? _profile;
    private bool _hasFamily;
    // So many pictures stand before the steps of the telling; the rest is one step away.
    private const int _pictures = 3;

    private bool _hasMedia;
    private System.Collections.Immutable.ImmutableArray<ThreadOnward> _onward = [];
    private string _here = string.Empty;
    private Exploration _explore = null!;

    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the identifier of the entity in the address.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        // An entity the visitor has not read to yet and one that does not exist are the same page: not found.
        var known = Collection == Site.Collection && Id.Length > 0 && !Id.Any(char.IsWhiteSpace);
        _entity = known ? Visitor.Projection?.Entity(new EntityId(Id)) : null;
        if (_entity is null)
        {
            Navigation.NotFound();
            return;
        }

        _here = $"{Site.Collection}/entity/{_entity.Entity.Id}";
        _explore = Exploring.Of(Context, Visitor, _entity.Entity.Id, ExplorationView.Overview);
        _profile = Visitor.Projection!.Profile(_entity.Entity.Id);

        // The years the visitor chose are kept to by this page too (step 25.3).
        var present = Clock.GetUtcNow().Year;
        _stated = YearParts.Of(_entity.Entity.Dated, statement => statement.Time, _explore.Span, present);
        _connected = YearParts.Of(_entity.Connections, connection => connection.Relation.Time, _explore.Span, present);
        _years = _explore.Years is { } chosen ? YearsText.Of(chosen, Visitor, T) : string.Empty;
        _hasFamily = !Visitor.Projection!.Family(_entity.Entity.Id)!.Members.IsEmpty;
        _hasMedia = !Visitor.Projection.Gallery(_entity.Entity.Id)!.IsEmpty;
        _onward = Visitor.Projection.Onward(_entity.Entity.Id);
    }
}

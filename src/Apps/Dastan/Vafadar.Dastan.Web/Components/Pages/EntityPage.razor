@page "/{Collection}/entity/{Id}"
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_entity is { } overview)
{
    var story = Visitor.Projection!.Overview().Subject;
    <PageTitle>@Visitor.Text(overview.Entity.Label).Value – @T["Site_Name"]</PageTitle>
    <PageDescription Title="@Visitor.Text(overview.Entity.Label).Value" Text="@Visitor.Text(overview.Entity.Summary).Value" />

    <header class="page-header">
        <p class="meta"><TypeName Type="overview.Entity.Type" /></p>
        <h1><Loc Text="overview.Entity.Label" /></h1>
        <p class="lead"><Loc Text="overview.Entity.Summary" /></p>
        @if (overview.Entity.Position is { } position)
        {
            @* Where the place is. The link is a position a device opens with its own map; the page loads no map. *@
            <p class="meta position">
                @T["Position_Title"]: <a href="@PositionText.Address(position)"><bdi>@PositionText.Of(position, Visitor, T)</bdi></a>
                @if (position.Precision != PositionPrecision.Exact)
                {
                    <span>– @T[$"PositionPrecision_{position.Precision}"]</span>
                }
            </p>
        }
        @if (!overview.Entity.Names.IsEmpty)
        {
            @* The other names, each in its own language and with what kind of name it is. *@
            <p class="meta" id="names">@T["Names_Title"]:</p>
            <ul class="names" role="list" aria-labelledby="names">
                @foreach (var name in overview.Entity.Names)
                {
                    <li>
                        <span lang="@name.Language" dir="auto">@name.Name</span>
                        <span class="meta">– @T[$"NameKind_{name.Kind}"]@if (name.Time is { } time) {<text>, @TimeText.Of(time, Visitor, T)</text>}</span>
                    </li>
                }
            </ul>
        }
        <p class="meta">
            <a href="@Site.Collection">@string.Format(CultureInfo.CurrentCulture, T["Entity_Collection"], Visitor.Text(story.Label).Value)</a>
        </p>
        <p class="meta"><a href="@EvidenceAddress.Of(Site.Collection, overview.Entity.Id, _here)">@T["Evidence_Title"]</a></p>
    </header>

    @if (!overview.Entity.Dated.IsEmpty)
    {
        @* What is stated about the entity itself: when something lasted or happened, how much of something. *@
        <section aria-labelledby="stated">
            <h2 id="stated">@T["Entity_Stated"]</h2>
            <dl class="facts stated">
                @foreach (var statement in overview.Entity.Dated)
                {
                    <dt id="@($"stated-{statement.Key}")"><Loc Text="statement.Label" /> <DisputedMark Review="statement.Review" /></dt>
                    <dd>
                        @if (statement.Quantity is { } quantity)
                        {
                            <strong class="quantity">@QuantityText.Of(quantity, Visitor, T)</strong>
                        }
                        @if (statement.Time is { } time)
                        {
                            <span class="when">@TimeText.Of(time, Visitor, T)</span>
                        }
                        @if (statement.Summary is { } summary)
                        {
                            <p><Loc Text="summary" /></p>
                        }
                    </dd>
                }
            </dl>
            @* The same quantity stated for several times is drawn as well: the list above has every digit. *@
            @foreach (var series in QuantitySeries.Of(overview.Entity, Site.Language))
            {
                <SeriesFigure Series="series" Here="@_here" />
            }
        </section>
    }

    <section aria-labelledby="connections">
        <h2 id="connections">@T["Entity_Connections"]</h2>
        @if (overview.Connections.IsEmpty)
        {
            <p class="note">@T["Entity_NoConnections"]</p>
        }
        else
        {
            <ul class="statements" role="list">
                @foreach (var connection in overview.Connections)
                {
                    var edge = connection.Direction == ConnectionDirection.Incoming
                        ? new Edge(connection.Relation, connection.Other, overview.Entity)
                        : new Edge(connection.Relation, overview.Entity, connection.Other);
                    <li><Statement Relation="edge" Self="overview.Entity.Id" Evidence="true" From="@_here" /></li>
                }
            </ul>
            <p class="actions">
                <a class="action secondary" href="@($"{Site.Collection}/entity/{overview.Entity.Id}/connections")">@T["Entity_ToGraph"]</a>
                @if (_hasFamily)
                {
                    <a class="action secondary" href="@($"{Site.Collection}/entity/{overview.Entity.Id}/family")">@T["Entity_ToFamily"]</a>
                }
            </p>
        }
    </section>

    @if (_hasMedia)
    {
        <p class="actions"><a class="action secondary" href="@($"{Site.Collection}/entity/{overview.Entity.Id}/gallery")">@T["Gallery_Title"]</a></p>
    }

    @if (!overview.Entity.Identifiers.IsEmpty)
    {
        @* What others call it. A link leaves Dastan; what the other catalogue states is not vouched for here. *@
        <section aria-labelledby="identifiers">
            <h2 id="identifiers">@T["Identifiers_Title"]</h2>
            <p class="note">@T["Identifiers_Note"]</p>
            <ul class="identifiers" role="list">
                @foreach (var identifier in overview.Entity.Identifiers)
                {
                    <li>
                        <span dir="auto">@identifier.Issuer</span>:
                        @if (identifier.Url is { } url)
                        {
                            <a href="@url" rel="external noopener noreferrer"><bdi>@identifier.Value</bdi></a>
                        }
                        else
                        {
                            <bdi>@identifier.Value</bdi>
                        }
                        @if (identifier.Match != IdentifierMatch.Exact)
                        {
                            <span class="meta">– @T[$"IdentifierMatch_{identifier.Match}"]</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (!overview.Appearances.IsEmpty)
    {
        <section aria-labelledby="appearances">
            <h2 id="appearances">@T["Entity_Appearances"]</h2>
            <ol class="steps" role="list">
                @foreach (var appearance in overview.Appearances)
                {
                    <li class="step">
                        <p class="meta">@string.Format(CultureInfo.CurrentCulture, T["Step_Number"], Visitor.Number(appearance.Step.Number))</p>
                        <h3><a href="@(StoryAddress.Of(Site, Visitor, appearance.Step))"><Loc Text="appearance.Step.Event.Label" /></a></h3>
                        <p><Loc Text="appearance.Association.Role" /> <span class="presence">@T[$"Presence_{appearance.Association.Presence}"]</span></p>
                        <p><a class="evidence-link" href="@EvidenceAddress.Of(Site.Collection, appearance.Step.Event.Id, overview.Entity.Id, _here)">@T["Evidence_Link"]<span class="visually-hidden"> – @Visitor.Text(appearance.Step.Event.Label).Value</span></a></p>
                    </li>
                }
            </ol>
        </section>
    }
}

@code {
    private EntityOverview? _entity;
    private bool _hasFamily;
    private bool _hasMedia;
    private string _here = string.Empty;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the identifier of the entity in the address.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        // An entity the visitor has not read to yet and one that does not exist are the same page: not found.
        var known = Collection == Site.Collection && Id.Length > 0 && !Id.Any(char.IsWhiteSpace);
        _entity = known ? Visitor.Projection?.Entity(new EntityId(Id)) : null;
        if (_entity is null)
        {
            Navigation.NotFound();
            return;
        }

        _here = $"{Site.Collection}/entity/{_entity.Entity.Id}";
        _hasFamily = !Visitor.Projection!.Family(_entity.Entity.Id)!.Members.IsEmpty;
        _hasMedia = !Visitor.Projection.Gallery(_entity.Entity.Id)!.IsEmpty;
    }
}

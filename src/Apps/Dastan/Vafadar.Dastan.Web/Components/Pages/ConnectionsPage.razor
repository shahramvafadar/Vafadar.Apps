@page "/{Collection}/entity/{Id}/connections"
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T

@if (_view is { } view)
{
    var name = Visitor.Text(view.Focus.Label).Value;
    <PageTitle>@string.Format(CultureInfo.CurrentCulture, T["Connections_Title"], name) – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><TypeName Type="view.Focus.Type" /></p>
        <h1>@string.Format(CultureInfo.CurrentCulture, T["Connections_Title"], name)</h1>
        <p class="meta"><a href="@($"{Site.Collection}/entity/{view.Focus.Id}")">@string.Format(CultureInfo.CurrentCulture, T["Graph_ToEntity"], name)</a></p>
    </header>

    @if (view.Edges.IsEmpty)
    {
        <p class="note">@T["Entity_NoConnections"]</p>
    }
    else
    {
        <p class="note">@T["Connections_Lead"] @T["Stage_Lead"]</p>

        @* The chart is opened and closed at its sides (D-040) as a family tree is: what leads to the name lies
           above it, what the name leads to below it, and what is the same from both sides beside it. A step
           further opens the nearest boxes of a side that can be opened, a step back closes the farthest ones. *@
        var above = Steps(string.Format(CultureInfo.CurrentCulture, T["Flow_Above"], name), ChartWing.Above);
        var below = Steps(string.Format(CultureInfo.CurrentCulture, T["Flow_Below"], name), ChartWing.Below);
        var beside = Steps(T["Flow_Beside"], ChartWing.BesideStart, ChartWing.BesideEnd);
        <ChartStage Id="chart" Label="@string.Format(CultureInfo.CurrentCulture, T["Connections_Graph"], name)" Top="above" Bottom="below" Left="beside" Right="beside">
            <ConnectionsGraph Chart="_chart" Open="_open" Address="Address" />
        </ChartStage>

        @* The list says what the drawing says: both are the same answer of the projection (ADR 0002). *@
        <section aria-labelledby="as-list">
            <h2 id="as-list">@T["Connections_List"]</h2>
            <ul class="statements" role="list">
                @foreach (var edge in view.Edges)
                {
                    <li><Statement Relation="edge" Self="view.Focus.Id" Evidence="true" From="@_here" /></li>
                }
            </ul>
        </section>
    }
}

@code {
    private ConnectionsView? _view;
    private ConnectionsChart _chart = null!;
    private IReadOnlyList<EntityId> _open = [];
    private string _here = string.Empty;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the identifier of the entity in the address.</summary>
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>Gets or sets the rows that are open: identifiers separated by commas.</summary>
    [SupplyParameterFromQuery]
    public string? Open { get; set; }

    protected override void OnInitialized()
    {
        static bool IsIdentifier(string text) => text.Length > 0 && !text.Any(char.IsWhiteSpace);

        // The address is written by anybody: what is not an identifier is dropped, and what the visitor may not
        // see or what is not connected is ignored by the projection.
        _open = [.. (Open ?? string.Empty).Split(',', StringSplitOptions.TrimEntries).Where(IsIdentifier).Select(id => new EntityId(id)).Distinct()];
        var known = Collection == Site.Collection && IsIdentifier(Id);
        _view = known ? Visitor.Projection?.Connections(new EntityId(Id), _open) : null;
        if (_view is null)
        {
            Navigation.NotFound();
            return;
        }

        // Only what is really open stays in the links of the page.
        _open = [.. _view.Expanded.Select(entity => entity.Id)];

        // Where this page stands, with what is open on it: the sources of a relation return here.
        _here = Address(_view.Focus.Id, _open);
        _chart = ConnectionsLayout.Of(_view, text => Visitor.Text(text).Value, Visitor.Language.IsRightToLeft ? 1.9 : 1.6);
    }

    private string Address(EntityId focus, IEnumerable<EntityId> open)
    {
        var boxes = string.Join(',', open.Select(id => id.Value).Distinct());
        return $"{Site.Collection}/entity/{focus}/connections{(boxes.Length > 0 ? $"?open={boxes}" : null)}";
    }

    // The steps of a side: one further opens what the chart says can be opened there, one back closes it again.
    private RenderFragment Steps(string name, params ChartWing[] wings)
    {
        var further = _chart.Further(wings);
        var nearer = _chart.Nearer(wings);
        return @<EdgeSteps Name="@name"
                           Fewer="@(nearer.IsEmpty ? null : Address(_chart.Focus.Id, _open.Except(nearer)) + "#chart")"
                           More="@(further.IsEmpty ? null : Address(_chart.Focus.Id, _open.Concat(further)) + "#chart")" />;
    }
}

@page "/{Collection}/at"
@using Vafadar.Temporal
@inject Visitor Visitor
@inject DastanSite Site
@inject NavigationManager Navigation
@inject IStringLocalizer<Ui> T
@inject TimeProvider Clock

@* One year of a collection (step 14.2, R-PUB-03): the relations of the world that held then, and what is stated
   of its entities for that year – and, by the one reader of a time of the site (step 19.9, ADR 0021), the same
   for a stretch of years and for a depth of time. The time is asked for with a form that asks for a page, so it
   works without a script. Only what the visitor may see at the reading position is asked of the projection. *@
@if (_subject is { } subject)
{
    var name = Visitor.Text(subject.Label).Value;
    var title = _moment is { } shown
        ? string.Format(CultureInfo.CurrentCulture, T["Moment_TitleYear"], name, Written(shown.Year))
        : _held is { } asked
            ? string.Format(CultureInfo.CurrentCulture, T["Moment_TitleTime"], name, TimeText.Of(asked.Asked, Visitor, T))
            : string.Format(CultureInfo.CurrentCulture, T["Moment_Title"], name);
    <PageTitle>@title – @T["Site_Name"]</PageTitle>

    <header class="page-header">
        <p class="meta"><a href="@Site.Collection">@string.Format(CultureInfo.CurrentCulture, T["Story_Back"], name)</a></p>
        <h1>@title</h1>
        <p class="lead">@T["Moment_Lead"]</p>
    </header>

    @if (!_saysWhen)
    {
        @* Nothing to show is said the same way whether nothing exists or nothing has been reached yet. *@
        <p class="note" role="status">
            @T["Moment_NoYears"]
            @if (_continues)
            {
                <text> @T["Gallery_EmptyHint"] </text><a href="@($"{Site.Collection}#reading")">@T["Reading_Change"]</a>
            }
        </p>
    }
    else
    {
        <form class="search moment-form" method="get" action="@($"{Site.Collection}/at#answer")">
            <div class="search-row">
                <p class="field">
                    <label for="moment-year">@T["Moment_Year"]</label>
                    <input type="number" id="moment-year" name="year" value="@_moment?.Year.Number.ToString(CultureInfo.InvariantCulture)" min="1" max="@AskedTime.FurthestYear" step="1" required inputmode="numeric" dir="ltr" />
                </p>
                <p class="field">
                    <label for="moment-era">@T["Moment_Era"]</label>
                    <select id="moment-era" name="era">
                        <option value="ce" selected="@(!_before)">@T["Moment_Era_CommonEra"]</option>
                        <option value="bce" selected="@_before">@T["Moment_Era_BeforeCommonEra"]</option>
                    </select>
                </p>
                <button type="submit" class="action">@T["Moment_Show"]</button>
            </div>
            @if (_years is { } covered)
            {
                <p class="note">@string.Format(CultureInfo.CurrentCulture, T["Moment_Range"], Written(covered.First), Written(covered.Last))</p>
            }
        </form>

        <form class="search moment-form" method="get" action="@($"{Site.Collection}/at#answer")">
            <div class="search-row">
                <p class="field">
                    <label for="moment-time">@T["Moment_Time"]</label>
                    <input type="text" id="moment-time" name="time" value="@_held?.Asked.Written" maxlength="80" required autocomplete="off" dir="ltr" aria-describedby="moment-time-how" />
                    <span class="meta" id="moment-time-how">@T["Search_Year_How"]</span>
                </p>
                <button type="submit" class="action">@T["Moment_Show"]</button>
            </div>
        </form>

        @if (_invalid)
        {
            <p class="note" role="alert">@T[string.IsNullOrWhiteSpace(Time) ? "Moment_Invalid" : "Moment_InvalidTime"]</p>
        }

        @if (_moment is null && _held is null)
        {
            @if (!_invalid)
            {
                <p class="note" role="status">@T["Moment_Choose"]</p>
            }
            @if (_years is { } from)
            {
                <p class="actions"><a class="action secondary" href="@($"{Address(from.First)}#answer")">@string.Format(CultureInfo.CurrentCulture, T["Moment_First"], Written(from.First))</a></p>
            }
        }
        else
        {
            var relations = _moment?.Relations ?? _held!.Relations;
            var statements = _moment?.Stated ?? _held!.Stated;
            var records = _moment?.Records ?? _held!.Records;
            var where = relations.Where(held => held.Edge.To.Type.Nature == EntityNature.Place).ToList();
            var other = relations.Where(held => held.Edge.To.Type.Nature != EntityNature.Place).ToList();

            @* The answer has an address in the page: a form that asks leads to it, past the forms. *@
            <span id="answer" class="anchor"></span>
            @if (_moment is { } moment)
            {
                <nav class="actions" aria-label="@T["Moment_Steps"]">
                    @if (moment.Earlier is { } earlier)
                    {
                        <a class="action secondary" rel="prev" href="@($"{Address(earlier)}#answer")">@string.Format(CultureInfo.CurrentCulture, T["Moment_Earlier"], Written(earlier))</a>
                    }
                    @if (moment.Later is { } later)
                    {
                        <a class="action secondary" rel="next" href="@($"{Address(later)}#answer")">@string.Format(CultureInfo.CurrentCulture, T["Moment_Later"], Written(later))</a>
                    }
                </nav>
            }

            @* What was chosen is carried on (R-EXP-05): the same time, as a gallery of what shows it. *@
            <p class="actions"><a class="action secondary" href="@($"{Site.Collection}/gallery?time={Uri.EscapeDataString(_time)}")">@T["Moment_Pictures"]</a></p>

            @if (relations.IsEmpty && statements.IsEmpty && records.IsEmpty)
            {
                <p class="note" role="status">@T[_held is null ? "Moment_Nothing" : "Moment_NothingTime"]</p>
            }
            else
            {
                <p class="note">@T["Moment_Rule"]</p>
                @Held("where", T["Moment_Where"], where)
                @Held("held", T["Moment_Held"], other)

                @if (!statements.IsEmpty)
                {
                    <section aria-labelledby="stated">
                        <h2 id="stated">@T["Moment_Stated"]</h2>
                        <dl class="facts stated">
                            @foreach (var stated in statements)
                            {
                                <dt>
                                    <a href="@($"{Site.Collection}/entity/{stated.Entity.Id}#stated-{stated.Statement.Key}")"><Loc Text="stated.Entity.Label" /></a>:
                                    <Loc Text="stated.Statement.Label" /> <DisputedMark Review="stated.Statement.Review" />
                                </dt>
                                <dd>
                                    @if (stated.Statement.Quantity is { } quantity)
                                    {
                                        <strong class="quantity">@QuantityText.Of(quantity, Visitor, T)</strong>
                                    }
                                    <span class="when">@TimeText.Of(stated.Statement.Time!, Visitor, T)</span>
                                    @if (stated.Holding == Holding.Possibly)
                                    {
                                        <span class="meta possibly">– @T["Moment_Possibly"]</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </section>
                }

                @* What the records of the names say of themselves (D-098): who lived, what lasted, what happened. *@
                @if (!records.IsEmpty)
                {
                    <section aria-labelledby="records">
                        <h2 id="records">@T["Moment_Records"]</h2>
                        <dl class="facts stated">
                            @foreach (var record in records)
                            {
                                <dt>
                                    <a href="@($"{Site.Collection}/entity/{record.Entity.Id}")"><Loc Text="record.Entity.Label" /></a>:
                                    <Loc Text="TimelineLanes.Named(record.Entity, record.Time, Visitor, T)" />
                                </dt>
                                <dd>
                                    <span class="when">@TimeText.Of(record.Time.Time, Visitor, T)</span>
                                    @if (record.Holding == Holding.Possibly)
                                    {
                                        <span class="meta possibly">– @T["Moment_Possibly"]</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </section>
                }
            }
        }
    }
}

@code {
    private Entity? _subject;
    private YearsCovered? _years;
    private MomentView? _moment;
    private HeldInTime? _held;
    private bool _saysWhen;
    private string _time = string.Empty;
    private bool _invalid;
    private bool _before;
    private bool _continues;
    private string _here = string.Empty;

    /// <summary>Gets or sets the name of the collection in the address.</summary>
    [Parameter]
    public string Collection { get; set; } = string.Empty;

    /// <summary>Gets or sets the year in the address.</summary>
    [SupplyParameterFromQuery(Name = "year")]
    public string? Year { get; set; }

    /// <summary>Gets or sets a time in the address as a visitor typed it: a year, a stretch of years or a depth of time.</summary>
    [SupplyParameterFromQuery(Name = "time")]
    public string? Time { get; set; }

    /// <summary>Gets or sets the era of the year in the address: <c>bce</c> for the time before the common era.</summary>
    [SupplyParameterFromQuery(Name = "era")]
    public string? Era { get; set; }

    protected override void OnInitialized()
    {
        if (Collection != Site.Collection || Visitor.Projection is not { } projection)
        {
            Navigation.NotFound();
            return;
        }

        _subject = projection.Overview().Subject;
        _continues = projection.StoryContinues;
        _years = projection.Years();
        _before = Era == "bce";
        _here = $"{Site.Collection}/at";
        var present = Clock.GetUtcNow().Year;
        _saysWhen = projection.SaysWhen(present);
        if (!_saysWhen)
        {
            return;
        }

        YearOfEra year;
        if (!string.IsNullOrWhiteSpace(Time))
        {
            // What a visitor typed is read by the one reader of the site; what is no time is said to be none.
            switch (AskedTime.Read(Time))
            {
                case AskedTime.Years { IsOneYear: true } one:
                    year = one.First;
                    _before = year.Era == Vafadar.Temporal.Era.BeforeCommonEra;
                    break;
                case { } asked:
                    _held = projection.Held(asked, present);
                    _time = asked.Written;
                    _here = $"{Site.Collection}/at?time={Uri.EscapeDataString(asked.Written)}";
                    return;
                default:
                    _invalid = true;
                    return;
            }
        }
        else if (string.IsNullOrWhiteSpace(Year))
        {
            return;
        }
        else if (!int.TryParse(Year, NumberStyles.None, CultureInfo.InvariantCulture, out var number) || number is < 1 or > AskedTime.FurthestYear || Era is not (null or "" or "ce" or "bce"))
        {
            // The address is written by anybody: a year is a whole number of an era, nothing else.
            _invalid = true;
            return;
        }
        else
        {
            year = new YearOfEra(_before ? Vafadar.Temporal.Era.BeforeCommonEra : Vafadar.Temporal.Era.CommonEra, number);
        }

        _moment = projection.At(year);
        _time = new AskedTime.Years(year, year).Written;
        _here = Address(year);
    }

    private string Address(YearOfEra year) =>
        $"{Site.Collection}/at?year={year.Number.ToString(CultureInfo.InvariantCulture)}{(year.Era == Vafadar.Temporal.Era.BeforeCommonEra ? "&era=bce" : null)}";

    private string Written(YearOfEra year) => TimeText.Year(year.Era, year.Number, Visitor, T);

    // A list of relations that held: each as its sentence, with what is not certain said so.
    private RenderFragment Held(string id, string title, IReadOnlyList<HeldThen> relations) => relations.Count == 0
        ? @<text></text>
        : @<section aria-labelledby="@id">
            <h2 id="@id">@title</h2>
            <ul class="statements" role="list">
                @foreach (var held in relations)
                {
                    <li>
                        <Statement Relation="held.Edge" Evidence="true" From="@_here" />
                        @if (held.Holding == Holding.Possibly)
                        {
                            <span class="meta possibly">– @T["Moment_Possibly"]</span>
                        }
                    </li>
                }
            </ul>
        </section>;
}

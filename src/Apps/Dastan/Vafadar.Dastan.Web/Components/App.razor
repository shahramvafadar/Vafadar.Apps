@inject Visitor Visitor
@inject DastanSite Site
<!DOCTYPE html>
<html lang="@Visitor.Language.Tag" dir="@Visitor.Language.Direction" data-theme="@ThemePreference.Attribute(Visitor.Theme)" data-offline="@(Visitor.KeepsOffline ? "on" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Addresses in the pages are relative to the language of the page: "story" on a Persian page is /fa/story. *@
    <base href="@Base" />
    <link rel="stylesheet" href="@Assets["_content/Vafadar.Web/vafadar.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Every page has Persian text – the name of the language at least. The font is asked for with the page, so
       that the text does not move when it arrives. The address is the one the style sheet asks for – beside
       itself, inside the language – or the font would be fetched twice. *@
    <link rel="preload" href="fonts/vazirmatn-nl-wght.woff2" as="font" type="font/woff2" crossorigin />
    @* A page in a language of Latin letters is set in Inter from its first line to its last: its font is asked for
       with the page too, or every page would be drawn in a font of the device first and move when Inter arrives –
       a button moves away under a finger. A Persian page asks for it only where it shows Latin letters. *@
    @if (Visitor.Language.Direction == "ltr")
    {
        <link rel="preload" href="fonts/inter-wght.woff2" as="font" type="font/woff2" crossorigin />
    }
    @* The icon of the tab (ADR 0026): the drawing where a browser takes one, three sizes of pixels where it does not. *@
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />

    @* The installable app (ADR 0007). These addresses carry no language: there is one app, not one per language. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    @* The colour around the page is the colour of the page – the one the visitor chose, or the one of the device. *@
    @if (Visitor.Theme == ThemeChoice.Auto)
    {
        <meta name="theme-color" content="@Light" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="@Dark" media="(prefers-color-scheme: dark)" />
    }
    else
    {
        <meta name="theme-color" content="@(Visitor.Theme == ThemeChoice.Dark ? Dark : Light)" />
    }
    @if (Site.Audience != Audience.Public)
    {
        @* A demonstration is not for search engines. *@
        <meta name="robots" content="noindex, nofollow" />
    }
    @* Where this page is, and where it is in the other languages (step 14.4): the layout says it, and a page
       that says "not found", "refused" or "an error" takes it back – it has no address of its own. *@
    <SectionOutlet SectionName="@PageAddress.Section" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* The one script of the site: it registers the service worker and brings the name a chart is drawn
       around into sight. No page needs it to show its content. *@
    <script src="@Assets["app.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext Context { get; set; } = null!;

    // The colour of the surface in the light and in the dark appearance (app.css: --surface).
    private const string Light = "#fbfaf7";
    private const string Dark = "#121212";

    private string Base => $"{Context.Request.PathBase}/";
}

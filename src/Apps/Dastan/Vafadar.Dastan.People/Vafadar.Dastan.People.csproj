<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>The store of Dastan's visitors (D-050): their accounts and, with them, what belongs to one person. A database of its own beside the site, apart from the store of the editors; the rules of who may see what are those of Vafadar.Dastan.Core.Personal.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Dastan.Core\Vafadar.Dastan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- The accounts move to ASP.NET Core Identity in step 19.4 (ADR 0016). Named already, so that everything that
         uses the store gets one version of EF Core: the tools of the design time ask for a newer one than Npgsql
         brings, and do not pass theirs on. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vafadar.Dastan.People.Tests" />
  </ItemGroup>

</Project>

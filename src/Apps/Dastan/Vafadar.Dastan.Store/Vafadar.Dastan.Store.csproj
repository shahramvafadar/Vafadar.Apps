<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>The store of Dastan's editors (ADR 0011): the records of a collection in a database, each with the history of its changes. The file of a collection goes in and comes out unchanged in meaning; the public site never reads the store.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Dastan.Data\Vafadar.Dastan.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vafadar.Dastan.Store.Tests" />
  </ItemGroup>

</Project>

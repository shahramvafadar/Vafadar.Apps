<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>Reads Dastan's editorial input into the read model of Vafadar.Dastan.Core and refuses input it does not understand. The place of the later relational store.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reading and writing images (D-056). The second package brings the library for a Linux container; it needs nothing of the system. -->
    <!-- The reports of visitors and the notices about content lie in the database (ADR 0015). -->
    <PackageReference Include="Npgsql" />
    <!-- The mail of the site leaves by SMTP (ADR 0016). -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Dastan.Core\Vafadar.Dastan.Core.csproj" />
  </ItemGroup>

</Project>

digraph DastanFamily {
 graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.45", nodesep="0.9", ranksep="0.8", fontname="DejaVu Sans", label="Family connections in the Shahnameh\nOriginal explanatory diagram · Reveals parentage", labelloc=t, fontsize=20, fontcolor="#173344", dpi=150];
 node [shape=box, style="rounded,filled", fillcolor="#F0F6F5", color="#37756B", fontcolor="#173344", penwidth=1.5, fontname="DejaVu Sans", fontsize=21, margin="0.32,0.2"];
 edge [color="#53736D", fontcolor="#34534D", penwidth=2, arrowsize=0.75, fontname="DejaVu Sans", fontsize=13];
 zal [label="Zal\nAlso called Dastan"];
 rostam [label="Rostam"];
 tahmineh [label="Tahmineh"];
 sohrab [label="Sohrab"];
 {rank=same; rostam; tahmineh;}
 zal -> rostam [label="father of"];
 rostam -> sohrab [label="father of"];
 tahmineh -> sohrab [label="mother of"];
 note [shape=plaintext, fillcolor="white", color="white", fontsize=11, fontcolor="#5A6870", label="Sources: Encyclopaedia Iranica, Zal; Ganjoor, Rostam and Sohrab, section 5.\nNarrative relationships are shown without historical dates."];
 sohrab -> note [style=invis];
}

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Entries.SplitEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Entries"
    x:DataType="local:SplitEditorViewModel"
    Title="{v:Translate Split_Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="8,8" ColumnDefinitions="Auto,*" BackgroundColor="{StaticResource CardBackground}">
            <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            <Label Grid.Column="1" Text="{v:Translate Split_Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Split_Total}" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding TotalText}" Style="{StaticResource AmountLarge}" />
                        <Label Text="{Binding RemainingText}" TextColor="{Binding RemainingColor}" FontAttributes="Bold" />
                        <Label Text="{v:Translate Split_Hint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:SplitPart">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" SemanticProperties.Description="{v:Translate Entry_Category}" />
                                    <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="{StaticResource ExpenseText}" WidthRequest="44"
                                            SemanticProperties.Description="{v:Translate Split_RemovePart}"
                                            Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type local:SplitEditorViewModel}}, x:DataType=local:SplitEditorViewModel}"
                                            CommandParameter="{Binding .}" />
                                    <Entry Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" FontSize="20"
                                           SemanticProperties.Description="{v:Translate Entry_Amount}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Split_AddPart}" Command="{Binding AddCommand}" />
                <Button Text="{v:Translate Split_Join}" Command="{Binding JoinCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        IsVisible="{Binding IsSplit}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Margin="16" Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
    </Grid>
</ContentPage>
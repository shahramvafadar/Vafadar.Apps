<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Accounts.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Accounts"
    x:DataType="local:AccountsViewModel"
    Title="{v:Translate Accounts_Title}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <!-- Empty state -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="12">
                        <fi:SymbolIcon Symbol="Wallet" FontSize="40" HorizontalOptions="Center" ForegroundColor="{StaticResource Primary}" />
                        <Label Text="{v:Translate Accounts_Empty}" HorizontalTextAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Accounts_Add}" Command="{Binding AddCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Totals per currency -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Accounts_Total}" Style="{StaticResource Secondary}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Totals}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CurrencyTotal">
                                    <Label Text="{Binding Text}" Style="{StaticResource AmountLarge}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Active accounts -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Active}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:AccountItem">
                                <local:AccountRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Archived accounts -->
                <Label Text="{v:Translate Accounts_Archived}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasArchived}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasArchived}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Archived}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:AccountItem">
                                <local:AccountRow Opacity="0.6" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="72" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Style="{StaticResource FloatingAddButton}" Text="+" Command="{Binding AddCommand}"
                SemanticProperties.Description="{v:Translate Accounts_Add}" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.More.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.More"
    x:DataType="local:MoreViewModel"
    Title="{v:Translate More_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:MoreItem">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" SemanticProperties.Description="{Binding Title}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:MoreViewModel}}, x:DataType=local:MoreViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding VersionText}" Style="{StaticResource Secondary}" HorizontalOptions="Center" Margin="0,16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.More.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.More"
    x:DataType="local:MoreViewModel"
    Title="{v:Translate More_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="accounts" />
                        </Grid.GestureRecognizers>
                        <fi:SymbolIcon Symbol="Wallet" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{v:Translate Accounts_Title}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="budget" />
                        </Grid.GestureRecognizers>
                        <fi:SymbolIcon Symbol="Target" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{v:Translate Budget_Title}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="categories" />
                        </Grid.GestureRecognizers>
                        <fi:SymbolIcon Symbol="Tag" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{v:Translate Categories_Title}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="backup" />
                        </Grid.GestureRecognizers>
                        <fi:SymbolIcon Symbol="ShieldCheckmark" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{v:Translate Backup_Title}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}" CommandParameter="settings" />
                        </Grid.GestureRecognizers>
                        <fi:SymbolIcon Symbol="Settings" FontSize="24" ForegroundColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{v:Translate Settings_Title}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding VersionText}" Style="{StaticResource Secondary}" HorizontalOptions="Center" Margin="0,16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

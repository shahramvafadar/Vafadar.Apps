<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Forecast.ForecastPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Forecast"
    x:DataType="local:ForecastViewModel"
    Title="{v:Translate Forecast_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding HorizonNames}" SelectedIndex="{Binding HorizonIndex}" AccentColor="{StaticResource Primary}" />
            <Label Text="{Binding BasisText}" Style="{StaticResource Secondary}" />
            <Label Text="{Binding UnreviewedText}" TextColor="{StaticResource WarningText}" FontSize="13"
                   IsVisible="{Binding UnreviewedText, Converter={StaticResource IsNotNullConverter}}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ForecastCard">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{v:Translate Forecast_EndBalance}" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding EndText}" Style="{StaticResource AmountLarge}" />
                                    <Label Text="{Binding MinimumText}" TextColor="{Binding MinimumColor}" />
                                    <Border BackgroundColor="{StaticResource ExpenseBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8"
                                            IsVisible="{Binding Warning, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding Warning}" TextColor="{StaticResource ExpenseText}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8"
                                            IsVisible="{Binding IncompleteText, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding IncompleteText}" TextColor="{StaticResource WarningText}" />
                                    </Border>
                                    <chart:SfCartesianChart HeightRequest="180" FlowDirection="LeftToRight" SemanticProperties.Description="{v:Translate Forecast_Path}">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:DateTimeAxis ShowMajorGridLines="False">
                                                <chart:DateTimeAxis.LabelStyle>
                                                    <chart:ChartAxisLabelStyle LabelFormat="d MMM" />
                                                </chart:DateTimeAxis.LabelStyle>
                                            </chart:DateTimeAxis>
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:StepLineSeries ItemsSource="{Binding Path}" XBindingPath="Date" YBindingPath="Balance"
                                                              Fill="{StaticResource Primary}" StrokeWidth="2" />
                                    </chart:SfCartesianChart>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.EmptyView>
                                        <Label Text="{v:Translate Forecast_NoItems}" Style="{StaticResource Secondary}" Padding="16" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:ForecastRow">
                                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type local:ForecastViewModel}}, x:DataType=local:ForecastViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" />
                                                    <Label Text="{Binding Badge}" FontSize="12" TextColor="{StaticResource WarningText}"
                                                           IsVisible="{Binding Badge, Converter={StaticResource IsNotNullConverter}}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- What the forecast does not know (FOR-06, FOR-07) -->
            <Label Text="{v:Translate Forecast_Disclaimer}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

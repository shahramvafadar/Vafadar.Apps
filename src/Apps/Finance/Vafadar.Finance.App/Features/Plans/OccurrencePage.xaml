<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Plans.OccurrencePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:p="clr-namespace:Vafadar.Finance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Plans"
    x:DataType="local:OccurrenceViewModel"
    Title="{v:Translate Occurrence_Title}">

    <Grid>
        <Label Text="{v:Translate Entry_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />

        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding DueText}" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding PlannedAmountText}" Style="{StaticResource AmountLarge}" />
                        <Label Text="{Binding StatusText}" Style="{StaticResource Secondary}" />
                        <Button Text="{v:Translate Plan_Details}" Command="{Binding OpenPlanCommand}" BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}" HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Confirm -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsOpen}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Occurrence_ActualAmount}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding ActualAmountText}" Keyboard="Numeric" Placeholder="0" FontSize="22" FontAttributes="Bold"
                                   SemanticProperties.Description="{v:Translate Occurrence_ActualAmount}" />
                            <Label Grid.Column="1" Text="{Binding CurrencyCode}" VerticalOptions="Center" Style="{StaticResource Secondary}" />
                        </Grid>
                        <Label Text="{v:Translate Occurrence_ActualDate}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding ActualDate}" />
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                               IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Occurrence_Confirm}" Command="{Binding ConfirmCommand}"
                                IsEnabled="{Binding IsNotBusy}" Margin="0,16,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Link an existing entry instead of recording a second one (REC-17) -->
                <Label Text="{v:Translate Occurrence_Candidates}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasCandidates}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasCandidates}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Candidates}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="p:EntryRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LinkCommand, Source={RelativeSource AncestorType={x:Type local:OccurrenceViewModel}}, x:DataType=local:OccurrenceViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="15" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Change this occurrence only -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsOpen}">
                    <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Occurrence_Change}" Command="{Binding ToggleChangeCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Occurrence_Skip}" Command="{Binding SkipCommand}" />
                </Grid>
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowChange}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Occurrence_MoveDue}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <v:DateField Date="{Binding DueDate}" />
                        <Label Text="{v:Translate Occurrence_AmountThisTime}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding OverrideAmountText}" Keyboard="Numeric" Placeholder="{Binding PlannedAmountText}"
                               SemanticProperties.Description="{v:Translate Occurrence_AmountThisTime}" />
                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding OccurrenceNote}" MaxLength="500" SemanticProperties.Description="{v:Translate Entry_Note}" />
                        <Label Text="{v:Translate Occurrence_ChangeHint}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}" Command="{Binding SaveChangeCommand}" Margin="0,12,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Settled or skipped -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsOpen, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding SettledText}" IsVisible="{Binding SettledText, Converter={StaticResource IsNotNullConverter}}" />
                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Occurrence_Undo}" Command="{Binding UndoCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

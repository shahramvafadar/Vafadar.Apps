<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Settings"
    x:DataType="local:SettingsViewModel"
    Title="{v:Translate Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{v:Translate Settings_Display}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Text="{v:Translate Settings_Language}" Style="{StaticResource FieldLabel}" Margin="0" />
                    <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                            SemanticProperties.Description="{v:Translate Settings_Language}" />

                    <Label Text="{v:Translate Settings_Calendar}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}"
                            SemanticProperties.Description="{v:Translate Settings_Calendar}" />
                    <Label Text="{Binding CalendarPreview}" Style="{StaticResource Secondary}" />

                    <Label Text="{v:Translate Settings_ReportCurrency}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding ReportCurrency}"
                            SemanticProperties.Description="{v:Translate Settings_ReportCurrency}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{v:Translate Settings_About}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Label Text="{Binding VersionText}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

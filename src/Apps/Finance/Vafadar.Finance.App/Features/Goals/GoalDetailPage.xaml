<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Goals.GoalDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Goals"
    x:DataType="local:GoalDetailViewModel"
    Title="{v:Translate Goal_Details}">

    <Grid>
        <Label Text="{v:Translate Goal_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />
        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <fi:SymbolIcon Symbol="{Binding Summary.Icon, FallbackValue=Savings}" FontSize="32" VerticalOptions="Start" ForegroundColor="{StaticResource Primary}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Summary.Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Summary.FundedText}" FontSize="16" />
                            <ProgressBar Progress="{Binding Summary.Progress}" ProgressColor="{Binding Summary.ProgressColor}" />
                            <Label Text="{Binding Summary.DateText}" Style="{StaticResource Secondary}" IsVisible="{Binding Summary.DateText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding Summary.SuggestionText}" TextColor="{StaticResource Primary}" IsVisible="{Binding Summary.SuggestionText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding Summary.WarningText}" TextColor="{StaticResource WarningText}" FontSize="13" IsVisible="{Binding Summary.WarningText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding Summary.StateText}" Style="{StaticResource Secondary}" IsVisible="{Binding Summary.StateText, Converter={StaticResource IsNotNullConverter}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PerAccount}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" Style="{StaticResource Secondary}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Set aside or release (F2-GOAL-02); this never moves money -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsActive}">
                    <VerticalStackLayout Spacing="4">
                        <v:ChoiceChips ItemsSource="{Binding DirectionNames}" SelectedIndex="{Binding DirectionIndex}" AccentColor="{StaticResource Primary}" />
                        <Label Text="{Binding NoAccountsText}" TextColor="{StaticResource WarningText}" IsVisible="{Binding NoAccountsText, Converter={StaticResource IsNotNullConverter}}" />
                        <VerticalStackLayout IsVisible="{Binding HasFundingAccounts}" Spacing="4">
                            <Label Text="{v:Translate Entry_Account}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" SemanticProperties.Description="{v:Translate Entry_Account}" />
                            <Label Text="{Binding SelectedAccount.UnallocatedText}" Style="{StaticResource Secondary}" />
                            <Label Text="{v:Translate Entry_Amount}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{v:Translate Entry_Amount}" />
                            <Label Text="{Binding AmountError}" Style="{StaticResource ErrorText}" IsVisible="{Binding AmountError, Converter={StaticResource IsNotNullConverter}}" />
                            <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}" Command="{Binding AllocateCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,8,0,0" />
                            <Label Text="{v:Translate Goal_SetAsideHint}" Style="{StaticResource Secondary}" FontSize="12" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{v:Translate Goal_History}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.EmptyView>
                            <Label Text="{v:Translate Goal_NoHistory}" Style="{StaticResource Secondary}" Padding="16" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:AllocationRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DeleteAllocationCommand, Source={RelativeSource AncestorType={x:Type local:GoalDetailViewModel}}, x:DataType=local:GoalDetailViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Text}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Edit}" Command="{Binding EditCommand}" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Style="{StaticResource SecondaryButton}" Text="{Binding CompleteText}" Command="{Binding ToggleCompleteCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Goal_Archive}" Command="{Binding ArchiveCommand}" IsVisible="{Binding IsActive}" />
                </Grid>
                <Button Text="{v:Translate Goal_Delete}" Command="{Binding DeleteCommand}" BackgroundColor="Transparent" TextColor="{StaticResource ExpenseText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
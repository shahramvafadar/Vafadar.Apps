<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Categories.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Categories"
    x:DataType="local:CategoriesViewModel"
    Title="{v:Translate Categories_Title}">

    <ContentPage.Resources>
        <DataTemplate x:Key="CategoryRow" x:DataType="local:CategoryItem">
            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:CategoriesViewModel}}, x:DataType=local:CategoriesViewModel}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{Binding Background}" VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsChild}" Value="True">
                            <Setter Property="Margin" Value="28,0,0,0" />
                        </DataTrigger>
                    </Border.Triggers>
                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding Color}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,0,16,16" Spacing="4">
                <Label Text="{v:Translate Categories_Expense}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expense}" BindableLayout.ItemTemplate="{StaticResource CategoryRow}" />
                </Border>

                <Label Text="{v:Translate Categories_Income}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Income}" BindableLayout.ItemTemplate="{StaticResource CategoryRow}" />
                </Border>

                <Label Text="{v:Translate Categories_Archived}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasArchived}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasArchived}" Opacity="0.6">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Archived}" BindableLayout.ItemTemplate="{StaticResource CategoryRow}" />
                </Border>

                <BoxView HeightRequest="72" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Style="{StaticResource FloatingAddButton}" Text="+" Command="{Binding AddCommand}"
                SemanticProperties.Description="{v:Translate Categories_Add}" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Templates.TemplatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Templates"
    x:DataType="local:TemplatesViewModel"
    Title="{v:Translate Templates_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Templates_Intro}" Style="{StaticResource Secondary}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasTemplates, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <fi:SymbolIcon Symbol="Flash" FontSize="36" HorizontalOptions="Center" ForegroundColor="{StaticResource Primary}" />
                    <Label Text="{v:Translate Templates_Empty}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasTemplates}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Templates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:TemplateRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="24" VerticalOptions="Center" ForegroundColor="{StaticResource Primary}" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="16" />
                                    <Label Text="{Binding Details}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{v:Translate Common_Delete}" BackgroundColor="Transparent" TextColor="{StaticResource ExpenseText}"
                                        Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:TemplatesViewModel}}, x:DataType=local:TemplatesViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Finance.App.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Finance.App.Features.Home"
    x:DataType="local:HomeViewModel"
    Title="{v:Translate Home_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Style="{StaticResource Headline}" Text="{v:Translate App_Name}" />
            <Label Style="{StaticResource SubHeadline}" Text="{v:Translate Home_Welcome}" />
            <Label HorizontalOptions="Center" Text="{Binding Today}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

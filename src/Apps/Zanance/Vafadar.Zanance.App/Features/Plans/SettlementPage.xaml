<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Plans.SettlementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    x:DataType="local:SettlementViewModel"
    Title="{v:Translate Settlement_Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="8,8" ColumnDefinitions="Auto,*" BackgroundColor="{DynamicResource CardBackground}">
            <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource TextButton}" />
            <Label Grid.Column="1" Text="{Binding PlanName}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Label Text="{v:Translate Settlement_Intro}" Style="{StaticResource Secondary}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Settlement_From}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <v:DateField Date="{Binding From}" />
                        <Label Text="{v:Translate Settlement_To}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding To}" />
                        <Label Text="{Binding AdvancesText}" FontAttributes="Bold" Margin="0,8,0,0" />
                        <Label Text="{v:Translate Settlement_Actual}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding ActualText}" Keyboard="Numeric" Placeholder="0" FontSize="20" SemanticProperties.Description="{v:Translate Settlement_Actual}" />
                        <Label Text="{Binding UnitNote}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding UnitNote, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding ResultText}" TextColor="{DynamicResource WarningText}" FontSize="16" FontAttributes="Bold"
                               IsVisible="{Binding ResultText, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Margin="16" Style="{StaticResource PrimaryButton}" Text="{v:Translate Settlement_Save}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Plans.PlansPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    x:DataType="local:PlansViewModel"
    Shell.NavBarIsVisible="False"
    Title="{v:Translate Plans_Title}">

    <!-- D-395: match Home's title action and give the list the former bottom action band. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid x:Name="PlansHeader" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,8" FlowDirection="LeftToRight">
            <ImageButton x:Name="HeaderBack" IsVisible="False" WidthRequest="44" HeightRequest="44" Padding="11"
                         BackgroundColor="{DynamicResource PrimarySoft}" CornerRadius="22" VerticalOptions="Center"
                         SemanticProperties.Description="{v:Translate Common_Back}" Clicked="OnHeaderBackClicked" />
            <Label Grid.Column="1" Text="{v:Translate Plans_Title}" Style="{StaticResource PageTitle}"
                   LineBreakMode="WordWrap" VerticalOptions="Center" />
            <Button x:Name="AddAction" Grid.Column="2" Style="{StaticResource FloatingAddButton}" Text="+"
                    WidthRequest="48" HeightRequest="48" Margin="0" CornerRadius="16" VerticalOptions="Center"
                    Command="{Binding AddCommand}" SemanticProperties.Description="{v:Translate Plans_Add}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,4" Spacing="8">
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding SegmentNames}" SelectedIndex="{Binding SegmentIndex}" />

            <!-- Notifications not allowed (REM-02, AT-34) -->
            <Border BackgroundColor="{DynamicResource WarningBackground}" Stroke="{DynamicResource WarningLine}" StrokeShape="RoundRectangle 14" Padding="16,4,8,4"
                    IsVisible="{Binding RemindersOff}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{v:Translate Reminder_PermissionDenied}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Settings_Enable}" Command="{Binding EnableRemindersCommand}" Style="{StaticResource TextButton}"
                            TextColor="{DynamicResource WarningText}" FontAttributes="Bold" />
                </Grid>
            </Border>

            <!-- Automatic entries waiting for review (REC-13) -->
            <Border BackgroundColor="{DynamicResource RefundBackground}" Stroke="{DynamicResource RefundLine}" StrokeShape="RoundRectangle 14" Padding="16,4,8,4"
                    IsVisible="{Binding UnreviewedCount, Converter={StaticResource IsPositiveConverter}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{v:Translate Plans_UnreviewedEntries}" TextColor="{DynamicResource RefundText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Plans_Review}" Command="{Binding ReviewEntriesCommand}" Style="{StaticResource TextButton}"
                            TextColor="{DynamicResource RefundText}" FontAttributes="Bold" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView x:Name="ContentViewport" Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlanRow">
                    <Grid Padding="16,0,16,8">
                        <Border Style="{StaticResource Card}" Padding="0">
                            <local:PlanRowView Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:PlansViewModel}}, x:DataType=local:PlansViewModel}"
                                               CommandParameter="{Binding .}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Header>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- D-318: keep empty feedback outside the Android adapter swap that can hide the first row. -->
        <ScrollView x:Name="EmptyViewport" Grid.Row="2" IsVisible="{Binding IsEmpty}">
            <VerticalStackLayout Padding="32,48" Spacing="16">
                <fi:SymbolIcon Symbol="CalendarClock" FontSize="44" HorizontalOptions="Center" ForegroundColor="{DynamicResource PlanText}" />
                <Label Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                <p:WrappingAction x:Name="EmptyAddAction" Appearance="Primary" Text="{v:Translate Plans_Add}" Command="{Binding AddCommand}" IsVisible="{Binding HasNoPlans}" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Plans.PlansPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    x:DataType="local:PlansViewModel"
    Title="{v:Translate Plans_Title}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,8,16,4" Spacing="8">
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding SegmentNames}" SelectedIndex="{Binding SegmentIndex}" />

            <!-- Notifications not allowed (REM-02, AT-34) -->
            <Border BackgroundColor="{DynamicResource WarningBackground}" Stroke="{DynamicResource WarningLine}" StrokeShape="RoundRectangle 14" Padding="16,4,8,4"
                    IsVisible="{Binding RemindersOff}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{v:Translate Reminder_PermissionDenied}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Settings_Enable}" Command="{Binding EnableRemindersCommand}" BackgroundColor="Transparent"
                            TextColor="{DynamicResource WarningText}" FontAttributes="Bold" />
                </Grid>
            </Border>

            <!-- Automatic entries waiting for review (REC-13) -->
            <Border BackgroundColor="{DynamicResource RefundBackground}" Stroke="{DynamicResource RefundLine}" StrokeShape="RoundRectangle 14" Padding="16,4,8,4"
                    IsVisible="{Binding UnreviewedCount, Converter={StaticResource IsPositiveConverter}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{v:Translate Plans_UnreviewedEntries}" TextColor="{DynamicResource RefundText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Plans_Review}" Command="{Binding ReviewEntriesCommand}" BackgroundColor="Transparent"
                            TextColor="{DynamicResource RefundText}" FontAttributes="Bold" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlanRow">
                    <Grid Padding="16,0,16,8">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <local:PlanRowView Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:PlansViewModel}}, x:DataType=local:PlansViewModel}"
                                           CommandParameter="{Binding .}" />
                    </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,48" Spacing="16">
                    <fi:SymbolIcon Symbol="CalendarClock" FontSize="44" HorizontalOptions="Center" ForegroundColor="{DynamicResource PlanText}" />
                    <Label Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Plans_Add}" Command="{Binding AddCommand}" IsVisible="{Binding HasNoPlans}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Header>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="96" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <Button Grid.Row="1" Style="{StaticResource FloatingAddButton}" Text="+" Command="{Binding AddCommand}"
                SemanticProperties.Description="{v:Translate Plans_Add}" />
    </Grid>
</ContentPage>

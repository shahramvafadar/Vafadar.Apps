<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Plans.PlanEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:entries="clr-namespace:Vafadar.Zanance.App.Features.Entries"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    x:DataType="local:PlanEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- D-98: whole title/action groups wrap at native text scale without adding a second modal header. -->
        <Grid Padding="8,8" BackgroundColor="{DynamicResource CardBackground}">
            <FlexLayout x:Name="ModalHeaderLayout" Direction="Row" Wrap="Wrap" AlignItems="Center">
                <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" FlexLayout.Shrink="0" Margin="4,0" Style="{StaticResource TextButton}" />
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" FlexLayout.Shrink="0" FlexLayout.Grow="1" MaximumWidthRequest="{Binding Width, Source={x:Reference ModalHeaderLayout}, x:DataType=FlexLayout}" />
            </FlexLayout>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16" VerticalOptions="Start" IsVisible="{Binding HasNoAccounts}">
            <VerticalStackLayout Spacing="12">
                <Label Text="{v:Translate Entry_NoAccounts}" HorizontalTextAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Accounts_Add}" Command="{Binding AddAccountCommand}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" IsVisible="{Binding HasNoAccounts, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">

                <!-- What -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <v:ChoiceChips ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}"
                                       IsEnabled="{Binding CanChangeKind}" />

                        <Label Text="{v:Translate Plan_Name}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Name}" Placeholder="{v:Translate Plan_NamePlaceholder}" MaxLength="120"
                               SemanticProperties.Description="{v:Translate Plan_Name}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Label Text="{v:Translate Plan_AmountMode}" Style="{StaticResource FieldLabel}" />
                            <v:HelpButton Grid.Column="1" Topic="AmountMode" Margin="0,8,0,0" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding AmountModeNames}" SelectedIndex="{Binding AmountModeIndex}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowAmount}">
                            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" FontSize="22" FontAttributes="Bold"
                                   SemanticProperties.Description="{v:Translate Entry_Amount}" />
                            <Label Grid.Column="1" Text="{Binding CurrencyCode, Converter={StaticResource CurrencyUnitConverter}}" VerticalOptions="Center" Style="{StaticResource Secondary}" />
                        </Grid>
                        <Label Text="{Binding AmountError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding AmountError, Converter={StaticResource IsNotNullConverter}}" />

                        <Label Text="{v:Translate Debt_PlanHint}" Style="{StaticResource Secondary}" Margin="0,8,0,0" IsVisible="{Binding IsDebtTransfer}" />
                        <Label Text="{v:Translate Entry_Account}" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" SemanticProperties.Description="{v:Translate Entry_Account}" />
                        <VerticalStackLayout IsVisible="{Binding IsTransfer}">
                            <Label Text="{v:Translate Entry_ToAccount}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding ToAccount}" SemanticProperties.Description="{v:Translate Entry_ToAccount}" />
                            <Entry Text="{Binding ToAmountText}" Keyboard="Numeric" Placeholder="0" IsVisible="{Binding ShowToAmount}" Margin="0,8,0,0"
                                   SemanticProperties.Description="{v:Translate LedgerError_DestinationAmountRequired}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsTransfer, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{v:Translate Entry_Category}" Style="{StaticResource FieldLabel}" />
                            <Picker Title="{v:Translate Plan_CategoryOptional}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=entries:CategoryChoice}" SemanticProperties.Description="{v:Translate Entry_Category}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- When -->
                <Border x:Name="ScheduleCard" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Plan_Start}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Label Text="{Binding RuleCalendarName}" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                        <v:DateField Date="{Binding Start}" CalendarOverride="{Binding RuleCalendar}" />

                        <VerticalStackLayout IsVisible="{Binding ShowPastChoice}">
                            <Label Text="{v:Translate Plan_PastStart}" Style="{StaticResource FieldLabel}" />
                            <v:ChoiceChips ItemsSource="{Binding PastNames}" SelectedIndex="{Binding PastIndex}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{v:Translate Plan_Repeat}" Style="{StaticResource FieldLabel}" />
                            <v:HelpButton Grid.Column="1" Topic="PlanRepeat" Margin="0,8,0,0" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding PresetIndex}" />

                        <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8" IsVisible="{Binding ShowCustom}">
                            <Label Text="{v:Translate Plan_Every}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding IntervalText}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                   SemanticProperties.Description="{v:Translate Plan_Every}" />
                            <v:ChoiceChips Grid.Column="2" IsCompact="True" ItemsSource="{Binding UnitNames}" SelectedIndex="{Binding UnitIndex}"
                                           VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding RuleSummary}" FontAttributes="Bold" Margin="0,12,0,0" />
                        <Label Text="{Binding RuleError}" Style="{StaticResource ErrorText}" IsVisible="{Binding RuleError, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding ShortMonthHint}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               IsVisible="{Binding ShortMonthHint, Converter={StaticResource IsNotNullConverter}}" />
                        <!-- Preview of the next dates (REC-04) -->
                        <Label Text="{v:Translate Plan_Preview}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <Border BackgroundColor="{DynamicResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Preview}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" FontSize="14" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding ShowEnd}">
                            <Label Text="{v:Translate Plan_End}" Style="{StaticResource FieldLabel}" />
                            <v:ChoiceChips ItemsSource="{Binding EndNames}" SelectedIndex="{Binding EndIndex}" />
                            <v:DateField Date="{Binding EndDate}" IsVisible="{Binding ShowEndDate}" CalendarOverride="{Binding RuleCalendar}" />
                            <Grid ColumnDefinitions="100,*" ColumnSpacing="8" IsVisible="{Binding ShowCount}">
                                <Entry Text="{Binding CountText}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="{v:Translate End_AfterCount}" />
                                <Label Grid.Column="1" Text="{v:Translate Plan_Times}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button Text="{v:Translate Plan_ChangePattern}" Command="{Binding ToggleRuleOptionsCommand}" Style="{StaticResource TextButton}"
                                HorizontalOptions="Start" IsVisible="{Binding ShowEnd}" />
                        <VerticalStackLayout IsVisible="{Binding ShowRuleOptions}">
                            <VerticalStackLayout IsVisible="{Binding ShowMonthOptions}">
                                <Label Text="{v:Translate Plan_Calendar}" Style="{StaticResource FieldLabel}" />
                                <v:ChoiceChips ItemsSource="{Binding CalendarNames}" SelectedIndex="{Binding CalendarIndex}" />
                                <Label Text="{v:Translate Plan_Day}" Style="{StaticResource FieldLabel}" />
                                <v:ChoiceChips ItemsSource="{Binding DayRuleNames}" SelectedIndex="{Binding DayRuleIndex}" />
                                <VerticalStackLayout IsVisible="{Binding ShowMissingDay}">
                                    <Label Text="{v:Translate Plan_MissingDay}" Style="{StaticResource FieldLabel}" />
                                    <v:ChoiceChips ItemsSource="{Binding MissingDayNames}" SelectedIndex="{Binding MissingDayIndex}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding ShowSecondDay}">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <Label Text="{v:Translate Plan_SecondDay}" VerticalOptions="Center" />
                                        <Switch Grid.Column="1" IsToggled="{Binding HasSecondDay}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Plan_SecondDay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8" IsVisible="{Binding HasSecondDay}">
                                        <Entry Text="{Binding SecondDayText}" Keyboard="Numeric" MaxLength="2" HorizontalTextAlignment="Center"
                                               SemanticProperties.Description="{v:Translate Plan_SecondDayNumber}" />
                                        <Label Grid.Column="1" Text="{v:Translate Plan_SecondDayNumber}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                                <Label Text="{v:Translate Weekend_Title}" Style="{StaticResource FieldLabel}" />
                                <v:HelpButton Grid.Column="1" Topic="WeekendRule" Margin="0,8,0,0" />
                            </Grid>
                            <v:ChoiceChips ItemsSource="{Binding WeekendNames}" SelectedIndex="{Binding WeekendIndex}" />
                            <Label Text="{Binding WeekendHint}" Style="{StaticResource Secondary}" FontSize="12" />
                            <!-- Public holidays (D-29) -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding CanSkipHolidays}">
                                <Label Text="{v:Translate Holiday_Skip}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding SkipHolidays}" SemanticProperties.Description="{v:Translate Holiday_Skip}" />
                            </Grid>
                            <Label Text="{Binding HolidayHint}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding CanSkipHolidays}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowApplyFrom}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                                <Label Text="{v:Translate Plan_ApplyFrom}" Style="{StaticResource FieldLabel}" />
                                <v:HelpButton Grid.Column="1" Topic="PlanApplyFrom" Margin="0,8,0,0" />
                            </Grid>
                            <v:DateField Date="{Binding ApplyFrom}" CalendarOverride="{Binding RuleCalendar}" />
                            <Label Text="{v:Translate Plan_ApplyFromHint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Reminder and automatic posting -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{v:Translate Plan_Reminder}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ReminderEnabled}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Plan_Reminder}" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding ReminderEnabled}">
                            <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                <Entry Text="{Binding ReminderDaysText}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="{v:Translate Plan_DaysBefore}" />
                                <Label Grid.Column="1" Text="{v:Translate Plan_DaysBefore}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{v:Translate Plan_ReminderTime}" Style="{StaticResource FieldLabel}" />
                            <TimePicker Time="{Binding ReminderTime}" HorizontalOptions="Start" SemanticProperties.Description="{v:Translate Plan_ReminderTime}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowReminderOnDueDate}">
                                <Label Text="{v:Translate Plan_ReminderOnDueDate}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding ReminderOnDueDate}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Plan_ReminderOnDueDate}" />
                            </Grid>
                            <Label Text="{Binding ReminderNote}" TextColor="{DynamicResource WarningText}" FontSize="13"
                                   IsVisible="{Binding ReminderNote, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{v:Translate Plan_AutoPost}" VerticalOptions="Center" />
                            <v:HelpButton Grid.Column="1" Topic="AutoPost" />
                            <Switch Grid.Column="2" IsToggled="{Binding AutoPost}" IsEnabled="{Binding CanAutoPost}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Plan_AutoPost}" />
                        </Grid>
                        <Label Text="{v:Translate Plan_AutoPostHint}" Style="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Contract details (F2-CON-01): created in Advanced, shown in Simple once they exist (ZEX-S0502) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowContractCard}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="{v:Translate Contract_Title}" Command="{Binding ToggleContractCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" Padding="0" />
                        <VerticalStackLayout IsVisible="{Binding ShowContract}" Spacing="4">
                            <Label Text="{v:Translate Contract_Provider}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding ContractProvider}" MaxLength="200" SemanticProperties.Description="{v:Translate Contract_Provider}" />
                            <Label Text="{v:Translate Contract_Reference}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding ContractReference}" MaxLength="100" SemanticProperties.Description="{v:Translate Contract_Reference}" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="{v:Translate Contract_End}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasContractEnd}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Contract_End}" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding HasContractEnd}" Spacing="4">
                                <v:DateField Date="{Binding ContractEnd}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{v:Translate Contract_Renews}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding ContractRenews}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Contract_Renews}" />
                                </Grid>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="{v:Translate Contract_Deadline}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasCancellationDeadline}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Contract_Deadline}" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding HasCancellationDeadline}">
                                <v:DateField Date="{Binding CancellationDeadline}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="{v:Translate Contract_Review}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasReviewDate}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Contract_Review}" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding HasReviewDate}">
                                <v:DateField Date="{Binding ReviewDate}" />
                            </VerticalStackLayout>
                            <Label Text="{v:Translate Contract_Hint}" Style="{StaticResource Secondary}" FontSize="12" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" MinimumHeightRequest="60" MaxLength="2000"
                                SemanticProperties.Description="{v:Translate Entry_Note}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding SaveError}" Style="{StaticResource ErrorText}"
                       IsVisible="{Binding SaveError, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Margin="16" Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}"
                IsVisible="{Binding HasNoAccounts, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>
</ContentPage>

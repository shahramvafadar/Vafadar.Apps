<?xml version="1.0" encoding="utf-8" ?>
<!-- One occurrence or plan: a date tile for due items (violet, red when overdue, green for income) or the plan's icon,
     the name, and the amount with its status badge (D-27). The page sets Command for the tap. -->
<ContentView
    x:Class="Vafadar.Zanance.App.Features.Plans.PlanRowView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    x:DataType="local:PlanRow">
    <ContentView.Resources>
        <Style x:Key="PlanRowFigure" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        </Style>
    </ContentView.Resources>
    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" BackgroundColor="Transparent">
        <Border Grid.RowSpan="2" Style="{StaticResource DateTile}" BackgroundColor="{Binding TileBackground}" Stroke="{Binding TileStroke}" IsVisible="{Binding HasDate}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label Text="{Binding DayText}" FontSize="17" FontAttributes="Bold" TextColor="{Binding TileText}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding MonthText}" FontSize="10.5" TextColor="{Binding TileText}" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
            </VerticalStackLayout>
        </Border>
        <Border Grid.RowSpan="2" Style="{StaticResource IconTile}" BackgroundColor="{Binding IconBackground}" Stroke="{Binding TileStroke}" IsVisible="{Binding HasIcon}">
            <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center" Spacing="4">
            <Border Style="{StaticResource Badge}" BackgroundColor="{Binding BadgeBackground}" Stroke="{Binding BadgeStroke}"
                    IsVisible="{Binding Badge, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{Binding Badge}" Style="{StaticResource BadgeText}" TextColor="{Binding BadgeText}" />
            </Border>
        </VerticalStackLayout>
        <!-- D-343: keep the complete sign/digits/unit packet outside the original navigation surface. -->
        <p:AmountReadout Grid.Row="2" Grid.ColumnSpan="2" AmountText="{Binding AmountText}"
                         TextColor="{Binding AmountColor}" CaptionStyle="{StaticResource PlanRowFigure}" />
        <Button Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="-16,0" MinimumHeightRequest="44" Style="{StaticResource OverlayButton}" CornerRadius="0"
                Command="{Binding Command, Source={x:Reference Root}, x:DataType=local:PlanRowView}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=local:PlanRowView}"
                IsVisible="{Binding Command, Source={x:Reference Root}, Converter={StaticResource IsNotNullConverter}, x:DataType=local:PlanRowView}"
                SemanticProperties.Description="{Binding Description}" />
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Holdings.AssetTypeEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Holdings"
    x:DataType="local:AssetTypeEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- D-98: whole title/action groups wrap at native text scale without adding a second modal header. -->
        <Grid Padding="8,8" BackgroundColor="{DynamicResource CardBackground}">
            <FlexLayout x:Name="ModalHeaderLayout" Direction="Row" Wrap="Wrap" AlignItems="Center">
                <p:WrappingAction Text="{Binding CloseText}" Command="{Binding CancelCommand}" FlexLayout.Shrink="0" Margin="4,0" Appearance="Text" />
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" FlexLayout.Shrink="0" FlexLayout.Grow="1" MaximumWidthRequest="{Binding Width, Source={x:Reference ModalHeaderLayout}, x:DataType=FlexLayout}" />
            </FlexLayout>
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding IsReady}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Label Text="{Binding ReloadedSavedSummary}" IsVisible="{Binding RequiresReview}" />
                <Label Text="{v:Translate AssetType_ReloadReview}" IsVisible="{Binding RequiresReview}" />
                <p:WrappingAction Text="{v:Translate Goal_KeepEdits}" Command="{Binding AcceptReviewCommand}" IsVisible="{Binding RequiresReview}" />
                <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate AssetType_Name}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Entry Text="{Binding Name}" Placeholder="{v:Translate AssetType_NamePlaceholder}" MaxLength="100" SemanticProperties.Description="{v:Translate AssetType_Name}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorText}" IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}" />

                        <Label Text="{v:Translate AssetType_Kind}" Style="{StaticResource FieldLabel}" />
                        <v:ChoiceChips ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Label Text="{v:Translate AssetType_MeasuredBy}" Style="{StaticResource FieldLabel}" />
                            <v:HelpButton Grid.Column="1" Topic="AssetDimension" Margin="0,8,0,0" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding DimensionNames}" SelectedIndex="{Binding DimensionIndex}"
                                       IsEnabled="{Binding DimensionLocked, Converter={StaticResource InvertedBoolConverter}}" />
                        <Label Text="{v:Translate AssetType_DimensionLocked}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding DimensionLocked}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Metal and purity (ZEX-AS03): without purity no fine-metal amount is shown -->
                <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource Card}" IsVisible="{Binding HasMetal}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate AssetType_Metal}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <v:ChoiceChips ItemsSource="{Binding MetalNames}" SelectedIndex="{Binding MetalIndex}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Label Text="{v:Translate AssetType_Purity}" Style="{StaticResource FieldLabel}" />
                            <v:HelpButton Grid.Column="1" Topic="Purity" Margin="0,8,0,0" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding PurityNames}" SelectedIndex="{Binding PurityIndex}" />
                        <Entry Text="{Binding PurityText}" Keyboard="Numeric" Placeholder="{v:Translate AssetType_PurityPlaceholder}" IsVisible="{Binding IsOtherPurity}"
                               SemanticProperties.Description="{v:Translate AssetType_Purity}" />
                        <Label Text="{Binding PurityFormatNote}" Style="{StaticResource Secondary}" IsVisible="{Binding PurityFormatNote, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding PurityError}" Style="{StaticResource ErrorText}" IsVisible="{Binding PurityError, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Counted items: unit name, weight of one unit (derived weight only), fractions -->
                <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource Card}" IsVisible="{Binding IsCount}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate AssetType_CountUnit}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Entry Text="{Binding CountUnitName}" Placeholder="{v:Translate AssetType_CountUnitPlaceholder}" MaxLength="40" SemanticProperties.Description="{v:Translate AssetType_CountUnit}" />
                        <Label Text="{v:Translate AssetType_UnitWeight}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding UnitWeightText}" Keyboard="Numeric" Placeholder="{Binding UnitWeightExample}" SemanticProperties.Description="{v:Translate AssetType_UnitWeight}" />
                        <Label Text="{Binding UnitWeightFormatNote}" Style="{StaticResource Secondary}" IsVisible="{Binding UnitWeightFormatNote, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding UnitWeightError}" Style="{StaticResource ErrorText}" IsVisible="{Binding UnitWeightError, Converter={StaticResource IsNotNullConverter}}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="{v:Translate AssetType_Divisible}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding Divisible}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate AssetType_Divisible}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate AssetType_PriceCurrency}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Border Style="{StaticResource FieldBox}">
                            <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding CurrencyCode, Mode=TwoWay}"
                                SemanticProperties.Description="{v:Translate AssetType_PriceCurrency}" />
                        </Border>
                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" MaxLength="1000" SemanticProperties.Description="{v:Translate Entry_Note}" />
                    </VerticalStackLayout>
                </Border>


            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" BackgroundColor="{DynamicResource PageBackground}" IsVisible="{Binding IsCovered}">
            <VerticalStackLayout VerticalOptions="Center" Padding="16" Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{DynamicResource Primary}" />
                <Label Text="{v:Translate AssetType_Loading}" IsVisible="{Binding IsLoading}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,16" Spacing="8">
            <Label x:Name="AssetTypeFeedback" Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
            <p:WrappingAction Text="{v:Translate Settings_RetryLoad}" Command="{Binding ReloadCommand}" IsVisible="{Binding ShowRetry}" />
            <p:WrappingAction Appearance="Primary" Text="{v:Translate Common_Save}" Command="{Binding SaveCommand}" IsVisible="{Binding IsReady}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

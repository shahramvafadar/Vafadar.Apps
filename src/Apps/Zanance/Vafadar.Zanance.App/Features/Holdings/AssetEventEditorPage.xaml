<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Holdings.AssetEventEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Holdings"
    x:DataType="local:AssetEventEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="8,8" ColumnDefinitions="Auto,*" BackgroundColor="{DynamicResource CardBackground}">
            <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="8,0">
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                <Label Text="{Binding TypeName}" Style="{StaticResource Secondary}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <!-- What happened: the kind decides which fields follow -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding CanChooseKind}">
                            <Label Text="{v:Translate AssetEvent_Kind}" Style="{StaticResource FieldLabel}" Margin="0" />
                            <v:HelpButton Topic="AssetEvents" />
                        </HorizontalStackLayout>
                        <v:ChoiceChips ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}" IsVisible="{Binding CanChooseKind}" />
                        <Label Text="{Binding KindHint}" Style="{StaticResource Secondary}" FontSize="13" />

                        <Label Text="{v:Translate Entry_Date}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding Date}" />

                        <Label Text="{v:Translate AssetEvent_Quantity}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding QuantityText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{v:Translate AssetEvent_Quantity}" />
                        <v:ChoiceChips ItemsSource="{Binding UnitNames}" SelectedIndex="{Binding UnitIndex}" IsVisible="{Binding HasUnitChoice}" />

                        <!-- Correction: up or down, always with a reason -->
                        <v:ChoiceChips ItemsSource="{Binding DirectionNames}" SelectedIndex="{Binding DirectionIndex}" IsVisible="{Binding IsCorrection}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Where it is kept; a move has a source and a destination -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding LocationLabel}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Picker ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" SemanticProperties.Description="{Binding LocationLabel}" />
                        <VerticalStackLayout IsVisible="{Binding IsTransfer}" Spacing="4">
                            <Label Text="{v:Translate AssetEvent_To}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Locations}" SelectedItem="{Binding ToLocation}" SemanticProperties.Description="{v:Translate AssetEvent_To}" />
                        </VerticalStackLayout>
                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate AssetEvent_AddLocation}" Command="{Binding AddLocationCommand}" HorizontalOptions="Start" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Purchase or sale: account, price (total or per gram/unit), fee, value in the price currency -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasMoney}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Entry_Account}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" SemanticProperties.Description="{v:Translate Entry_Account}" />
                        <Label Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}" />
                        <v:ChoiceChips ItemsSource="{Binding PriceModeNames}" SelectedIndex="{Binding PriceModeIndex}" />
                        <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding AmountLabel}" />
                        <VerticalStackLayout IsVisible="{Binding HasSecondAmount}" Spacing="4">
                            <Label Text="{Binding SecondAmountLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding SecondAmountText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding SecondAmountLabel}" />
                        </VerticalStackLayout>
                        <Label Text="{v:Translate AssetEvent_Fee}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding FeeText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{v:Translate AssetEvent_Fee}" />
                        <Label Text="{v:Translate AssetEvent_FeeHint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Opening holding or gift: no money moves; the value at the time is optional -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasBasis}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BasisLabel}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Entry Text="{Binding BasisText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding BasisLabel}" />
                        <Label Text="{v:Translate AssetEvent_BasisHint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <VerticalStackLayout IsVisible="{Binding HasReason}" Spacing="4">
                            <Label Text="{Binding ReasonLabel}" Style="{StaticResource FieldLabel}" Margin="0" />
                            <Entry Text="{Binding ReasonText}" MaxLength="200" SemanticProperties.Description="{Binding ReasonLabel}" />
                        </VerticalStackLayout>
                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" MaxLength="1000" SemanticProperties.Description="{v:Translate Entry_Note}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding EffectText}" TextColor="{DynamicResource PlanText}" FontAttributes="Bold" Margin="4,0"
                       IsVisible="{Binding EffectText, Converter={StaticResource IsNotNullConverter}}" />
                <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Margin="16" Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</ContentPage>

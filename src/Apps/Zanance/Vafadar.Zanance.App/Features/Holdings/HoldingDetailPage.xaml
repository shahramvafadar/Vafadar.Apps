<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Holdings.HoldingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Holdings"
    x:DataType="local:HoldingDetailViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="*,Auto">
        <Label Text="{v:Translate Holding_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />
        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <!-- Quantity, where it is kept and what it is worth -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="32" VerticalOptions="Start" ForegroundColor="{DynamicResource SecondaryText}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding QuantityText}" Style="{StaticResource AmountLarge}" />
                            <Label Text="{Binding DerivedText}" Style="{StaticResource Secondary}" IsVisible="{Binding DerivedText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding PurityText}" Style="{StaticResource Secondary}" IsVisible="{Binding PurityText, Converter={StaticResource IsNotNullConverter}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PerLocation}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding ValueText}" FontAttributes="Bold" IsVisible="{Binding ValueText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{v:Translate Holding_ValueUnknown}" TextColor="{DynamicResource WarningText}" FontAttributes="Bold" IsVisible="{Binding ValueUnknown}" />
                            <Label Text="{Binding AverageCostText}" Style="{StaticResource Secondary}" IsVisible="{Binding AverageCostText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding UnrealisedText}" Style="{StaticResource Secondary}" IsVisible="{Binding UnrealisedText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding RealisedText}" Style="{StaticResource Secondary}" IsVisible="{Binding RealisedText, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Actions: Advanced records everything; Simple only corrects the quantity -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" IsVisible="{Binding IsAdvanced}">
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Holding_Buy}" Command="{Binding RecordCommand}" CommandParameter="Purchase" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_Sell}" Command="{Binding RecordCommand}" CommandParameter="Sale" IsEnabled="{Binding HasStock}" />
                    <Button Grid.Row="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_Move}" Command="{Binding RecordCommand}" CommandParameter="LocationTransfer" IsEnabled="{Binding HasStock}" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_AddExisting}" Command="{Binding RecordCommand}" CommandParameter="Opening" />
                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_Remove}" Command="{Binding RecordCommand}" CommandParameter="Outflow" IsEnabled="{Binding HasStock}" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_Correct}" Command="{Binding RecordCommand}" CommandParameter="Correction" />
                </Grid>
                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_Correct}" Command="{Binding RecordCommand}" CommandParameter="Correction"
                        IsVisible="{Binding IsAdvanced, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Prices: per gram or unit, or the total of what is held -->
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{v:Translate Holding_Prices}" Style="{StaticResource SectionHeader}" />
                    <v:HelpButton Topic="HoldingPrices" Margin="0,8,0,0" />
                </HorizontalStackLayout>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <v:ChoiceChips ItemsSource="{Binding PriceModeNames}" SelectedIndex="{Binding PriceModeIndex}" />
                        <Label Text="{Binding PriceLabel}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding PriceText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding PriceLabel}" />
                        <Label Text="{v:Translate Entry_Date}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding PriceDate}" />
                        <Label Text="{Binding PriceError}" Style="{StaticResource ErrorText}" IsVisible="{Binding PriceError, Converter={StaticResource IsNotNullConverter}}" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Holding_SavePrice}" Command="{Binding SavePriceCommand}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Valuations}">
                        <BindableLayout.EmptyView>
                            <Label Text="{v:Translate Holding_NoPrices}" Style="{StaticResource Secondary}" Padding="16" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ValuationRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding PriceText}" />
                                        <Label Text="{Binding SourceText}" Style="{StaticResource Secondary}" IsVisible="{Binding SourceText, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                    <Button Grid.ColumnSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding DeletePriceCommand, Source={RelativeSource AncestorType={x:Type local:HoldingDetailViewModel}}, x:DataType=local:HoldingDetailViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- History: tap to edit or delete -->
                <Label Text="{v:Translate Holding_History}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}">
                        <BindableLayout.EmptyView>
                            <Label Text="{v:Translate Holding_NoHistory}" Style="{StaticResource Secondary}" Padding="16" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:HoldingEventRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Title}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding Detail, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding QuantityText}" TextColor="{Binding QuantityColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.ColumnSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding OpenEventCommand, Source={RelativeSource AncestorType={x:Type local:HoldingDetailViewModel}}, x:DataType=local:HoldingDetailViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Holding_EditType}" Command="{Binding EditTypeCommand}" Margin="0,8,0,0" IsVisible="{Binding IsAdvanced}" />
                <Button Text="{v:Translate Holding_Archive}" Command="{Binding ArchiveCommand}" Style="{StaticResource TextButton}" TextColor="{DynamicResource ExpenseText}" IsVisible="{Binding IsAdvanced}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Undo after a delete -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,16" IsVisible="{Binding UndoText, Converter={StaticResource IsNotNullConverter}}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding UndoText}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{v:Translate Common_Undo}" Command="{Binding UndoCommand}" Style="{StaticResource TextButton}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>

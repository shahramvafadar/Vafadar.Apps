<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Holdings.HoldingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Holdings"
    x:DataType="local:HoldingDetailViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="*,Auto">
        <Label Text="{v:Translate Holding_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />
        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <!-- Quantity, where it is kept and what it is worth -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="32" VerticalOptions="Start" ForegroundColor="{DynamicResource SecondaryText}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <p:AmountReadout AmountText="{Binding QuantityText}" />
                            <Label Text="{Binding DerivedText}" Style="{StaticResource Secondary}" IsVisible="{Binding DerivedText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding PurityText}" Style="{StaticResource Secondary}" IsVisible="{Binding PurityText, Converter={StaticResource IsNotNullConverter}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PerLocation}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding ValueText}" FontAttributes="Bold" IsVisible="{Binding ValueText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{v:Translate Holding_ValueUnknown}" TextColor="{DynamicResource WarningText}" FontAttributes="Bold" IsVisible="{Binding ValueUnknown}" />
                            <Label Text="{Binding AverageCostText}" Style="{StaticResource Secondary}" IsVisible="{Binding AverageCostText, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Text="{Binding UnrealisedText}" Style="{StaticResource Secondary}" IsVisible="{Binding UnrealisedText, Converter={StaticResource IsNotNullConverter}}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding RealisedText, Converter={StaticResource IsNotNullConverter}}">
                                <Label Text="{Binding RealisedText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                <v:HelpButton Grid.Column="1" Topic="HoldingSaleResult" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Growing native actions preserve complete scaled captions, commands and existing mode rules. -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" IsVisible="{Binding IsAdvanced}">
                    <p:WrappingAction Appearance="Primary" Text="{v:Translate Holding_Buy}" SemanticProperties.Hint="{v:Translate Holding_Buy_A11yHint}" Command="{Binding RecordCommand}" CommandParameter="Purchase" />
                    <p:WrappingAction Grid.Column="1" Appearance="Secondary" Text="{v:Translate Holding_Sell}" SemanticProperties.Hint="{v:Translate Holding_Sell_A11yHint}" Command="{Binding RecordCommand}" CommandParameter="Sale" IsEnabled="{Binding HasStock}" />
                    <p:WrappingAction Grid.Row="1" Appearance="Secondary" Text="{v:Translate Holding_Move}" Command="{Binding RecordCommand}" CommandParameter="LocationTransfer" IsEnabled="{Binding HasStock}" />
                    <p:WrappingAction Grid.Row="1" Grid.Column="1" Appearance="Secondary" Text="{v:Translate Holding_AddExisting}" SemanticProperties.Hint="{v:Translate Holding_AddExisting_A11yHint}" Command="{Binding RecordCommand}" CommandParameter="Opening" />
                    <p:WrappingAction Grid.Row="2" Appearance="Secondary" Text="{v:Translate Holding_Remove}" Command="{Binding RecordCommand}" CommandParameter="Outflow" IsEnabled="{Binding HasStock}" />
                    <p:WrappingAction Grid.Row="2" Grid.Column="1" Appearance="Secondary" Text="{v:Translate Holding_Correct}" SemanticProperties.Hint="{v:Translate Holding_Correct_A11yHint}" Command="{Binding RecordCommand}" CommandParameter="Correction" />
                </Grid>
                <p:WrappingAction Appearance="Secondary" Text="{v:Translate Holding_Correct}" SemanticProperties.Hint="{v:Translate Holding_Correct_A11yHint}" Command="{Binding RecordCommand}" CommandParameter="Correction"
                        IsVisible="{Binding IsAdvanced, Converter={StaticResource InvertedBoolConverter}}" />

                <!-- Prices: per gram or unit, or the total of what is held -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                    <Label Text="{v:Translate Holding_Prices}" Style="{StaticResource SectionHeader}" />
                    <v:HelpButton Grid.Column="1" Topic="HoldingPrices" Margin="0,8,0,0" />
                </Grid>
                <Border Style="{StaticResource Card}" BindingContext="{Binding PriceEditor}" x:DataType="local:HoldingPriceEditor">
                    <VerticalStackLayout Spacing="4" IsEnabled="{Binding CanRefresh}">
                        <v:ChoiceChips ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" />
                        <Label Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="ManualPriceInput" Text="{Binding Raw}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding Label}" />
                        <Label x:Name="ManualPriceFeedback" Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{v:Translate Entry_Date}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding Date}" AccessibilityLabel="{v:Translate Entry_Date}" />
                        <p:WrappingAction Appearance="Primary" Text="{v:Translate Holding_SavePrice}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSubmit}" Margin="0,8,0,0" />
                        <p:WrappingAction Appearance="Secondary" Text="{v:Translate Holding_PriceRefresh}" Command="{Binding RefreshCommand}" IsVisible="{Binding NeedsRefresh}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Valuations}">
                        <BindableLayout.EmptyView>
                            <Label Text="{v:Translate Holding_NoPrices}" Style="{StaticResource Secondary}" Padding="16" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ValuationRow">
                                <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding PriceText}" />
                                        <Label Text="{Binding SourceText}" Style="{StaticResource Secondary}" IsVisible="{Binding SourceText, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Text="{Binding DateText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                    <Button Grid.RowSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding DeletePriceCommand, Source={RelativeSource AncestorType={x:Type local:HoldingDetailViewModel}}, x:DataType=local:HoldingDetailViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- History: tap to edit or delete -->
                <Label Text="{v:Translate Holding_History}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}">
                        <BindableLayout.EmptyView>
                            <Label Text="{v:Translate Holding_NoHistory}" Style="{StaticResource Secondary}" Padding="16" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:HoldingEventRow">
                                <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Title}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding Detail, Converter={StaticResource IsNotNullConverter}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Row="1" Text="{Binding QuantityText}" TextColor="{Binding QuantityColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.RowSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding OpenEventCommand, Source={RelativeSource AncestorType={x:Type local:HoldingDetailViewModel}}, x:DataType=local:HoldingDetailViewModel}"
                                            CommandParameter="{Binding Id}" SemanticProperties.Description="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <p:WrappingAction Appearance="Secondary" Text="{v:Translate Holding_EditType}" Command="{Binding EditTypeCommand}" Margin="0,8,0,0" IsVisible="{Binding IsAdvanced}" />
                <p:WrappingAction Text="{v:Translate Holding_Archive}" Command="{Binding ArchiveCommand}" Appearance="Destructive" IsVisible="{Binding IsAdvanced}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Original result feedback stays separate from the scrolling history and keeps its exact Undo. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,16"
                BindingContext="{Binding HistoryEditor}" x:DataType="local:HoldingHistoryEditor" IsVisible="{Binding HasFeedback}">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding UndoText}" IsVisible="{Binding HasUndo}" />
                <Label x:Name="HoldingHistoryFeedback" Text="{Binding Error}" Style="{StaticResource ErrorText}"
                       IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                <p:WrappingAction x:Name="HoldingHistoryUndo" Text="{v:Translate Common_Undo}" Command="{Binding UndoCommand}"
                                  IsVisible="{Binding HasUndo}" Appearance="Text" />
                <p:WrappingAction Text="{v:Translate Holding_HistoryRefresh}" Command="{Binding RefreshCommand}"
                                  IsVisible="{Binding NeedsRefresh}" Appearance="Secondary" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

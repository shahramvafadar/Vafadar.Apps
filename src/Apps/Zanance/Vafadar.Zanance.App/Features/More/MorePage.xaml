<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.More.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.More"
    x:DataType="local:MoreViewModel"
    Title="{v:Translate More_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16,4,16,16" Spacing="8">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:MoreGroup">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="4,12,4,8" />
                            <Border Style="{StaticResource Card}" Padding="0">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:MoreItem">
                                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                                                <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="12.5" LineBreakMode="TailTruncation" MaxLines="2" />
                                                </VerticalStackLayout>
                                                <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                                                <!-- The whole row is one real button: keyboard, screen readers and touch feedback on every platform. -->
                                                <Button Grid.ColumnSpan="3" Margin="-16,-10" BackgroundColor="Transparent" BorderWidth="0" CornerRadius="0"
                                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:MoreViewModel}}, x:DataType=local:MoreViewModel}"
                                                        CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding Subtitle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <!-- Version, data and licences are on About Zanance (D-39). -->
            <BoxView HeightRequest="16" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Categories.CategoryEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Categories"
    x:DataType="local:CategoryEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- D-98: whole title/action groups wrap at native text scale without adding a second modal header. -->
        <Grid Padding="8,8" BackgroundColor="{DynamicResource CardBackground}">
            <FlexLayout x:Name="ModalHeaderLayout" Direction="Row" Wrap="Wrap" AlignItems="Center">
                <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" FlexLayout.Shrink="0" Margin="4,0" Style="{StaticResource TextButton}" />
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" FlexLayout.Shrink="0" FlexLayout.Grow="1" MaximumWidthRequest="{Binding Width, Source={x:Reference ModalHeaderLayout}, x:DataType=FlexLayout}" />
            </FlexLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Category_Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Entry Text="{Binding Name}" Placeholder="{Binding DefaultName}" MaxLength="60"
                               SemanticProperties.Description="{v:Translate Category_Name}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}" />

                        <VerticalStackLayout IsVisible="{Binding IsExisting, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{v:Translate Category_Kind}" Style="{StaticResource FieldLabel}" />
                            <v:ChoiceChips ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding CanHaveParent}">
                            <Label Text="{v:Translate Category_Parent}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Parents}" SelectedItem="{Binding Parent}" SemanticProperties.Description="{v:Translate Category_Parent}" />
                        </VerticalStackLayout>

                        <!-- Flex budgets (D-28) -->
                        <VerticalStackLayout IsVisible="{Binding ShowSpendingType}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                                <Label Text="{v:Translate SpendingType_Title}" Style="{StaticResource FieldLabel}" />
                                <v:HelpButton Grid.Column="1" Topic="SpendingType" Margin="0,8,0,0" />
                            </Grid>
                            <v:ChoiceChips ItemsSource="{Binding SpendingTypeNames}" SelectedIndex="{Binding SpendingTypeIndex}" />
                            <Label Text="{v:Translate SpendingType_Hint}" Style="{StaticResource Secondary}" />
                            <!-- Essential spending: used by the essential coverage and the day-to-day estimate (ZEX-K07) -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{v:Translate Category_Essential}" VerticalOptions="Center" />
                                    <v:HelpButton Topic="Essential" />
                                </HorizontalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsEssential}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Category_Essential}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{v:Translate Category_Color}" Style="{StaticResource FieldLabel}" Margin="4,0" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Palette}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:Swatch">
                                    <!-- Real buttons over the swatches and icons: reachable with the keyboard -->
                                    <Grid Margin="3">
                                        <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="3"
                                                Stroke="Transparent" BackgroundColor="{Binding Color}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource AmountText}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Button Style="{StaticResource OverlayButton}" CornerRadius="22"
                                                Command="{Binding SelectColorCommand, Source={RelativeSource AncestorType={x:Type local:CategoryEditorViewModel}}, x:DataType=local:CategoryEditorViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="{v:Translate Category_Icon}" Style="{StaticResource FieldLabel}" Margin="4,8,4,0" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Icons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:Swatch">
                                    <Grid Margin="2">
                                        <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="2" Stroke="{Binding Outline}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"
                                                           ForegroundColor="{Binding SelectedColor, Source={RelativeSource AncestorType={x:Type local:CategoryEditorViewModel}}, x:DataType=local:CategoryEditorViewModel}" />
                                        </Border>
                                        <Button Style="{StaticResource OverlayButton}" CornerRadius="12"
                                                Command="{Binding SelectIconCommand, Source={RelativeSource AncestorType={x:Type local:CategoryEditorViewModel}}, x:DataType=local:CategoryEditorViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Order and merge (CAT-02) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsExisting}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Category_MoveUp}" Command="{Binding MoveUpCommand}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Category_MoveDown}" Command="{Binding MoveDownCommand}" />
                        </Grid>
                        <Label Text="{v:Translate Category_MergeInto}" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding MergeTargets}" SelectedItem="{Binding MergeTarget}" SemanticProperties.Description="{v:Translate Category_MergeInto}" />
                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Category_Merge}" Command="{Binding MergeCommand}"
                                IsEnabled="{Binding MergeTarget, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Category_Archive}" Command="{Binding ToggleArchiveCommand}"
                        IsVisible="{Binding IsExisting}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsArchived}" Value="True">
                            <Setter Property="Text" Value="{v:Translate Category_Unarchive}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Margin="16" Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</ContentPage>

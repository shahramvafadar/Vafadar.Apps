<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Categories.RulesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Categories"
    x:DataType="local:RulesViewModel"
    Title="{v:Translate Rules_Title}">

    <Grid>
    <ScrollView IsVisible="{Binding Loading.IsReady}" IsEnabled="{Binding CanInteract}">
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Rules_Intro}" Style="{StaticResource Secondary}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{v:Translate Rule_Match}" Style="{StaticResource FieldLabel}" Margin="0" />
                    <Entry Text="{Binding MatchText}" Placeholder="{v:Translate Rule_MatchPlaceholder}" MaxLength="100" SemanticProperties.Description="{v:Translate Rule_Match}" />
                    <Label Text="{v:Translate Entry_Category}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" SemanticProperties.Description="{v:Translate Entry_Category}" />
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Add}" Command="{Binding AddCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasRules}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Match}" FontSize="16" />
                                    <Label Text="{Binding CategoryName}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{v:Translate Common_Delete}" Style="{StaticResource TextButton}" TextColor="{DynamicResource ExpenseText}"
                                        Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:RulesViewModel}}, x:DataType=local:RulesViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Hint="{Binding Match}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.IsLoading}">
        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" Color="{DynamicResource Primary}" />
        <Label Text="{v:Translate Rules_Loading}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.HasFailed}">
        <Label Text="{Binding Feedback}" TextColor="{DynamicResource DebtText}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
        <Button Text="{v:Translate Rules_RetryLoad}" Style="{StaticResource PrimaryButton}" Command="{Binding ReloadCommand}" IsEnabled="{Binding CanReload}" />
    </VerticalStackLayout>
    </Grid>
</ContentPage>
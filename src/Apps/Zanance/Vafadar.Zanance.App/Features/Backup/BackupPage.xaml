<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Backup.BackupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Backup"
    x:DataType="local:BackupViewModel"
    Title="{v:Translate Backup_Title}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <!-- Status -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <fi:SymbolIcon Symbol="ShieldCheckmark" FontSize="32" ForegroundColor="{DynamicResource SecondaryText}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding LastBackupText}" FontSize="15" />
                            <Label Text="{v:Translate Backup_Intro}" Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Create -->
                <Label Text="{v:Translate Backup_Create}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{v:Translate Backup_UsePassword}" VerticalOptions="Center" />
                            <v:HelpButton Grid.Column="1" Topic="BackupPassword" />
                            <Switch Grid.Column="2" IsToggled="{Binding UsePassword}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Backup_UsePassword}" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding UsePassword}">
                            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="{v:Translate Backup_Password}"
                                   SemanticProperties.Description="{v:Translate Backup_Password}" />
                            <Entry Text="{Binding PasswordConfirm}" IsPassword="True" Placeholder="{v:Translate Backup_PasswordConfirm}"
                                   SemanticProperties.Description="{v:Translate Backup_PasswordConfirm}" />
                            <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                <Label Text="{v:Translate Backup_PasswordWarning}" TextColor="{DynamicResource WarningText}" />
                            </Border>
                        </VerticalStackLayout>
                        <Label Text="{v:Translate Backup_NoPasswordWarning}" Style="{StaticResource Secondary}"
                               IsVisible="{Binding UsePassword, Converter={StaticResource InvertedBoolConverter}}" />
                        <Label Text="{Binding CreateError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding CreateError, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding CreateResult}" TextColor="{DynamicResource IncomeText}"
                               IsVisible="{Binding CreateResult, Converter={StaticResource IsNotNullConverter}}" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Backup_CreateAndShare}" Command="{Binding CreateCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        <Label Text="{v:Translate Backup_ShareHint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Backups kept on this device -->
                <Label Text="{v:Translate Backup_OnDevice}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasLocalBackups}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasLocalBackups}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocalBackups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:LocalBackup">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto">
                                    <fi:SymbolIcon Symbol="Archive" FontSize="22" ForegroundColor="{DynamicResource SecondaryText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Details}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                    <!-- The whole row is one real button: keyboard, screen readers and touch -->
                                    <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding OpenLocalCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding Details}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Backup_OnDeviceHint}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding HasLocalBackups}" />

                <!-- Cloud backup (D-35): only with configured OAuth clients; an explicit choice of the user -->
                <Label Text="{v:Translate Cloud_Title}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasCloud}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasCloud}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{v:Translate Cloud_Intro}" Style="{StaticResource Secondary}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CloudAccounts}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CloudAccountRow">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <fi:SymbolIcon Symbol="Cloud" FontSize="22" ForegroundColor="{DynamicResource Primary}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontSize="16" />
                                                <Label Text="{Binding Account}" Style="{StaticResource Secondary}" FlowDirection="LeftToRight"
                                                       IsVisible="{Binding IsConnected}" />
                                                <Label Text="{Binding LastBackupText}" Style="{StaticResource Secondary}" FontSize="12"
                                                       IsVisible="{Binding LastBackupText, Converter={StaticResource IsNotNullConverter}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Cloud_Connect}" IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}"
                                                Command="{Binding ConnectCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <FlexLayout Wrap="Wrap" IsVisible="{Binding IsConnected}">
                                            <Button Style="{StaticResource TextButton}" Text="{v:Translate Cloud_BackUpNow}"
                                                    Command="{Binding BackupToCloudCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Style="{StaticResource TextButton}" Text="{v:Translate Cloud_ShowBackups}"
                                                    Command="{Binding ShowCloudBackupsCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Style="{StaticResource TextButton}" Text="{v:Translate Cloud_Disconnect}"
                                                    Command="{Binding DisconnectCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{v:Translate Cloud_PasswordHint}" Style="{StaticResource Secondary}" FontSize="12" />
                        <Label Text="{Binding CloudError}" Style="{StaticResource ErrorText}" IsVisible="{Binding CloudError, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding CloudResult}" TextColor="{DynamicResource IncomeText}" IsVisible="{Binding CloudResult, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasCloudBackups}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CloudBackups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:CloudBackup">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto">
                                    <fi:SymbolIcon Symbol="CloudArrowDown" FontSize="22" ForegroundColor="{DynamicResource SecondaryText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Details}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                    <!-- The whole row is one real button: keyboard, screen readers and touch -->
                                    <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding OpenCloudCommand, Source={RelativeSource AncestorType={x:Type local:BackupViewModel}}, x:DataType=local:BackupViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding Details}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Cloud_RestoreHint}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding HasCloudBackups}" />

                <!-- Restore -->
                <!-- Before a restore the current data is kept as a safety copy on this device, unencrypted (ZEX-F20, disclosed) -->
            <HorizontalStackLayout Spacing="6">
                <Label Text="{v:Translate Backup_Restore}" Style="{StaticResource SectionHeader}" />
                <v:HelpButton Topic="SafetyCopy" VerticalOptions="Center" />
            </HorizontalStackLayout>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{v:Translate Backup_RestoreIntro}" Style="{StaticResource Secondary}" />
                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Backup_PickFile}" Command="{Binding PickFileCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Label Text="{Binding PickedName}" FontAttributes="Bold" IsVisible="{Binding PickedName, Converter={StaticResource IsNotNullConverter}}" />
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding NeedsRestorePassword}">
                            <Entry Text="{Binding RestorePassword}" IsPassword="True" Placeholder="{v:Translate Backup_Password}"
                                   SemanticProperties.Description="{v:Translate Backup_Password}" />
                            <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Backup_Check}" Command="{Binding CheckCommand}"
                                    IsVisible="{Binding HasPreview, Converter={StaticResource InvertedBoolConverter}}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding RestoreError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding RestoreError, Converter={StaticResource IsNotNullConverter}}" />

                        <!-- Preview before anything is replaced (BAK-09) -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPreview}">
                            <Border BackgroundColor="{DynamicResource PageBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                <Label Text="{Binding PreviewText}" />
                            </Border>
                            <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                <Label Text="{v:Translate Backup_ReplaceWarning}" TextColor="{DynamicResource WarningText}" />
                            </Border>
                            <Button Text="{v:Translate Backup_Replace}" Command="{Binding RestoreCommand}" IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="{DynamicResource ExpenseText}" TextColor="{DynamicResource CardBackground}" CornerRadius="24" MinimumHeightRequest="48" FontAttributes="Bold" />
                            <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelRestoreCommand}" Style="{StaticResource TextButton}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>

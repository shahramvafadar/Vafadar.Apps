<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Goals.GoalEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Goals"
    x:DataType="local:GoalEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- D-98: whole title/action groups wrap at native text scale without adding a second modal header. -->
        <Grid Padding="8,8" BackgroundColor="{DynamicResource CardBackground}">
            <FlexLayout x:Name="ModalHeaderLayout" Direction="Row" Wrap="Wrap" AlignItems="Center">
                <p:WrappingAction Text="{Binding CloseText}" Command="{Binding CancelCommand}" Appearance="Text" FlexLayout.Shrink="0" Margin="4,0" />
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" FlexLayout.Shrink="0" FlexLayout.Grow="1" MaximumWidthRequest="{Binding Width, Source={x:Reference ModalHeaderLayout}, x:DataType=FlexLayout}" />
            </FlexLayout>
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding IsReady}" IsEnabled="{Binding CanInteract}">
            <VerticalStackLayout Padding="16" Spacing="8">

                <Label Text="{Binding ReloadedSavedSummary}" IsVisible="{Binding RequiresReview}" />

                <!-- What the goal measures (ZEX-D07): a balance on one account, or money set aside (Advanced) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowTypeChooser}">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Label Text="{v:Translate Goal_TypeQuestion}" Style="{StaticResource FieldLabel}" Margin="0" />
                            <v:HelpButton Grid.Column="1" Topic="GoalType" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Goal_Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Entry Text="{Binding Name}" Placeholder="{v:Translate Goal_NamePlaceholder}" MaxLength="100" SemanticProperties.Description="{v:Translate Goal_Name}" />
                        <Label Text="{Binding NameError}" Style="{StaticResource ErrorText}" IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}" />

                        <!-- A balance goal follows one money account; its currency is the account's -->
                        <VerticalStackLayout IsVisible="{Binding IsBalanceGoal}">
                            <Label Text="{v:Translate Goal_Account}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" SemanticProperties.Description="{v:Translate Goal_Account}" />
                            <Label Text="{v:Translate Goal_BalanceNote}" Style="{StaticResource Secondary}" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- A quantity goal counts one holding type, at all locations or one; prices are never progress (ZEX-S0701) -->
                        <VerticalStackLayout IsVisible="{Binding IsQuantityGoal}">
                            <Label Text="{v:Translate Goal_Holding}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding HoldingTypes}" SelectedItem="{Binding HoldingType}" SemanticProperties.Description="{v:Translate Goal_Holding}" />
                            <Label Text="{v:Translate Goal_HoldingLocation}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding HoldingLocations}" SelectedItem="{Binding HoldingLocation}" SemanticProperties.Description="{v:Translate Goal_HoldingLocation}" />
                            <Label Text="{v:Translate Goal_QuantityNote}" Style="{StaticResource Secondary}" FontSize="12" />
                        </VerticalStackLayout>

                        <Label Text="{v:Translate Goal_Target}" Style="{StaticResource FieldLabel}" />
                        <v:ChoiceChips ItemsSource="{Binding QuantityUnitNames}" SelectedIndex="{Binding QuantityUnitIndex}" IsVisible="{Binding HasQuantityUnitChoice}" />
                        <!-- Amount and currency each keep a full readable input at larger text sizes. -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" FontSize="22" SemanticProperties.Description="{v:Translate Goal_Target}" />
                            <Border Style="{StaticResource FieldBox}" Grid.Row="1" IsVisible="{Binding ShowCurrencyChoice}">
                                <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding CurrencyCode, Mode=TwoWay}"
                                    IsEnabled="{Binding CurrencyLocked, Converter={StaticResource InvertedBoolConverter}}"
                                    SemanticProperties.Description="{v:Translate Account_Currency}" />
                            </Border>
                            <Label Grid.Row="1" Text="{Binding CurrencyCode, Converter={StaticResource CurrencyUnitConverter}}" FontSize="18" VerticalOptions="Center"
                                   Style="{StaticResource Secondary}" IsVisible="{Binding IsBalanceGoal}" />
                        </Grid>
                        <Label Text="{Binding UnitNote}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding UnitNote, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding AmountError}" Style="{StaticResource ErrorText}" IsVisible="{Binding AmountError, Converter={StaticResource IsNotNullConverter}}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <Label Text="{v:Translate Goal_HasDate}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding HasTargetDate}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Goal_HasDate}" />
                        </Grid>
                        <v:DateField Date="{Binding TargetDate}" AccessibilityLabel="{v:Translate Goal_HasDate}" IsVisible="{Binding HasTargetDate}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                            <Label Text="{v:Translate Goal_ShowOnHome}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowOnHome}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Goal_ShowOnHome}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- The user's plan (ZEX-GO08..GO11): contribution dates and how much; Zanance moves no money -->
                <Label Text="{v:Translate Goal_PlanTitle}" Style="{StaticResource SectionHeader}" />
                <Label Text="{Binding WorkText}" Style="{StaticResource Secondary}" IsVisible="{Binding WorkText, Converter={StaticResource IsNotNullConverter}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Goal_Schedule}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <v:ChoiceChips ItemsSource="{Binding ScheduleNames}" SelectedIndex="{Binding ScheduleIndex}" />
                        <Label Text="{v:Translate Goal_FirstDate}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding FirstDate}" AccessibilityLabel="{v:Translate Goal_FirstDate}" />
                        <Label Text="{Binding ScheduleSummary}" SemanticProperties.Description="{Binding ScheduleSummary}" />
                        <Label Text="{Binding ShortMonthNote}" Style="{StaticResource Secondary}" IsVisible="{Binding ShortMonthNote, Converter={StaticResource IsNotNullConverter}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingDates}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String"><Label Text="{Binding .}" Style="{StaticResource Secondary}" /></DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding RuleError}" Style="{StaticResource ErrorText}" IsVisible="{Binding RuleError, Converter={StaticResource IsNotNullConverter}}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <Label Text="{v:Translate Goal_ContributionReminder}" VerticalOptions="Center" />
                            <v:HelpButton Grid.Column="1" Topic="GoalReminder" AutomationId="GoalReminderHelp" />
                            <Switch x:Name="ContributionReminderSwitch" Grid.Column="2" IsToggled="{Binding ReminderEnabled}" OnColor="{DynamicResource Primary}"
                                    IsEnabled="{Binding CanEditReminder}"
                                    AutomationId="GoalContributionReminder" SemanticProperties.Description="{v:Translate Goal_ContributionReminder}" />
                        </Grid>
                        <Label Text="{Binding ReminderNote}" Style="{StaticResource Secondary}" FontSize="12"
                               IsVisible="{Binding ReminderNote, Converter={StaticResource IsNotNullConverter}}" />

                        <VerticalStackLayout IsVisible="{Binding ShowMethods}" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                                <Label Text="{v:Translate Goal_Method}" Style="{StaticResource FieldLabel}" />
                                <v:HelpButton Grid.Column="1" Topic="ContributionMethod" Margin="0,8,0,0" />
                            </Grid>
                            <v:ChoiceChips ItemsSource="{Binding MethodNames}" SelectedIndex="{Binding MethodIndex}" IsEnabled="{Binding CanChooseMethod}" />
                        </VerticalStackLayout>
                        <Label Text="{Binding CurrentMethodText}" IsVisible="{Binding ShowMethods, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource FieldLabel}" />

                        <VerticalStackLayout IsVisible="{Binding IsShareMethod, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{v:Translate Goal_ContributionAmount}" Style="{StaticResource FieldLabel}" IsVisible="{Binding IsFixedMethod}" />
                            <Label Text="{v:Translate Goal_CutAmount}" Style="{StaticResource FieldLabel}" IsVisible="{Binding IsCutMethod}" />
                            <Entry Text="{Binding ContributionText}" Keyboard="Numeric" Placeholder="0" IsEnabled="{Binding CanEditContribution}" SemanticProperties.Description="{v:Translate Goal_ContributionAmount}" />
                            <Label Text="{Binding ContributionError}" Style="{StaticResource ErrorText}" IsVisible="{Binding ContributionError, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsShareMethod}">
                            <Label Text="{v:Translate Goal_Percent}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding PercentText}" Keyboard="Numeric" Placeholder="10" IsEnabled="{Binding CanEditContribution}" SemanticProperties.Description="{v:Translate Goal_Percent}" />
                            <Label Text="{Binding PercentError}" Style="{StaticResource ErrorText}" IsVisible="{Binding PercentError, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsCutMethod}">
                            <Label Text="{v:Translate Goal_CutCategory}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding CutCategories}" SelectedItem="{Binding CutCategory}" IsEnabled="{Binding CanEditContribution}" SemanticProperties.Description="{v:Translate Goal_CutCategory}" />
                            <Label Text="{Binding RetainedCategoriesText}" Style="{StaticResource Secondary}" IsVisible="{Binding RetainedCategoriesText, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                        <Label Text="{v:Translate Goal_PlanNotTransfer}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Live preview: nothing is saved yet (ZEX-GO14) -->
                <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource PrimarySoft}" Stroke="{DynamicResource PrimaryLine}"
                        IsVisible="{Binding PreviewProgress, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Goal_Preview}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Label Text="{Binding PreviewProgress}" FontAttributes="Bold" SemanticProperties.Description="{Binding PreviewProgress}" />
                        <Label Text="{Binding PreviewPlan}" TextColor="{DynamicResource PlanText}" IsVisible="{Binding PreviewPlan, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding PreviewRequired}" IsVisible="{Binding PreviewRequired, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding PreviewMethod}" Style="{StaticResource Secondary}" IsVisible="{Binding PreviewMethod, Converter={StaticResource IsNotNullConverter}}" />
                        <p:WrappingAction Text="{v:Translate Goal_ApplyCut}" Command="{Binding ApplyCutCommand}" IsVisible="{Binding CanApplyCut}" />
                        <Label Text="{v:Translate Goal_EstimateNote}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Money set aside: priority, protection (Advanced) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsBalanceGoal, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Label Text="{v:Translate Goal_Priority}" Style="{StaticResource FieldLabel}" Margin="0" />
                            <v:HelpButton Grid.Column="1" Topic="GoalPriority" />
                        </Grid>
                        <v:ChoiceChips ItemsSource="{Binding PriorityNames}" SelectedIndex="{Binding PriorityIndex}" />
                        <Label Text="{v:Translate Goal_PriorityHint}" Style="{StaticResource Secondary}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0" IsVisible="{Binding IsAdvanced}">
                            <Label Text="{v:Translate Goal_Protect}" VerticalOptions="Center" />
                            <v:HelpButton Grid.Column="1" Topic="GoalProtect" />
                            <Switch Grid.Column="2" IsToggled="{Binding Protect}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Goal_Protect}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{v:Translate Category_Icon}" Style="{StaticResource Secondary}" />
                        <p:IconPicker SelectedKey="{Binding IconKey}" />
                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" MaxLength="1000" SemanticProperties.Description="{v:Translate Entry_Note}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" BackgroundColor="{DynamicResource PageBackground}" IsVisible="{Binding IsCovered}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{DynamicResource Primary}" VerticalOptions="Center" />
        </Grid>
        <!-- Feedback and all explicit actions remain reachable outside the scroll viewport. -->
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,16" Spacing="8">
            <Label Text="{Binding SaveError}" Style="{StaticResource ErrorText}" IsVisible="{Binding SaveError, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{v:Translate Goal_ReloadReview}" IsVisible="{Binding RequiresReview}" />
            <p:WrappingAction Text="{v:Translate Goal_KeepEdits}" Command="{Binding AcceptReviewCommand}" IsVisible="{Binding RequiresReview}" />
            <p:WrappingAction Text="{v:Translate Settings_RetryLoad}" Command="{Binding ReloadCommand}" IsVisible="{Binding SaveError, Converter={StaticResource IsNotNullConverter}}" />
            <p:WrappingAction Text="{v:Translate Common_Save}" Command="{Binding SaveCommand}" Appearance="Primary" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

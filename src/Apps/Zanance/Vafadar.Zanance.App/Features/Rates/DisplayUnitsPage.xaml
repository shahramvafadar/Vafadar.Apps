<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Rates.DisplayUnitsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Rates"
    x:DataType="local:DisplayUnitsViewModel"
    Title="{v:Translate Unit_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Unit_Intro}" Style="{StaticResource Secondary}" />

            <!-- Defined units -->
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasUnits}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Units}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:DisplayUnitRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Text}" FontSize="16" />
                                    <Label Text="{Binding Example}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{v:Translate Common_Delete}" BackgroundColor="Transparent" TextColor="{DynamicResource ExpenseText}"
                                        Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type local:DisplayUnitsViewModel}}, x:DataType=local:DisplayUnitsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Define a unit -->
            <Label Text="{v:Translate Unit_Add}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{v:Translate Account_Currency}" Style="{StaticResource FieldLabel}" />
                    <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding CurrencyCode, Mode=TwoWay}" SemanticProperties.Description="{v:Translate Account_Currency}" />
                    <Label Text="{v:Translate Unit_Name}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" MaxLength="20" SemanticProperties.Description="{v:Translate Unit_Name}" />
                    <Label Text="{v:Translate Unit_Factor}" Style="{StaticResource FieldLabel}" />
                    <v:ChoiceChips ItemsSource="{Binding FactorNames}" SelectedIndex="{Binding FactorIndex}" />
                    <Label Text="{Binding PreviewText}" Margin="0,8,0,0" IsVisible="{Binding PreviewText, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Add}" Command="{Binding AddCommand}" Margin="0,12,0,0" />
                    <Button Text="{v:Translate Unit_UseToman}" Command="{Binding UseTomanCommand}" BackgroundColor="Transparent"
                            TextColor="{DynamicResource Primary}" HorizontalOptions="Start" Padding="0,8" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{v:Translate Unit_Note}" Style="{StaticResource Secondary}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
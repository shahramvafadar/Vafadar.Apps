<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Rates.RatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Rates"
    x:DataType="local:RatesViewModel"
    Title="{v:Translate Rates_Title}">

    <Grid>
    <ScrollView IsVisible="{Binding Loading.IsReady}">
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Rates_Intro}" Style="{StaticResource Secondary}" />
            <p:WrappingAction Text="{v:Translate Market_Title}" Command="{Binding OpenReferencesCommand}" />
            <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,10"
                    IsVisible="{Binding MissingText, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{Binding MissingText}" TextColor="{DynamicResource WarningText}" />
            </Border>

            <!-- Add a rate -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Rates_Title}" />
            <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                <VerticalStackLayout Spacing="0">
                    <!-- Keep each side of the equation whole, including its scalable currency editor. -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Label Text="1" FontSize="18" VerticalOptions="Center" />
                        <Border Style="{StaticResource FieldBox}" Grid.Column="1">
                            <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding FromCurrency, Mode=TwoWay}"
                                SemanticProperties.Description="{v:Translate Rates_From}" />
                        </Border>
                        <Label Grid.Row="1" Text="=" FontSize="18" VerticalOptions="Center" />
                        <Border Style="{StaticResource FieldBox}" Grid.Row="1" Grid.Column="1">
                            <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding ToCurrency, Mode=TwoWay}"
                                SemanticProperties.Description="{v:Translate Rates_To}" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding PairError}" Style="{StaticResource ErrorText}" IsVisible="{Binding PairError, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{v:Translate Rates_Rate}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding RateText}" Keyboard="Numeric" Placeholder="{Binding RateExample}" SemanticProperties.Description="{v:Translate Rates_Rate}" />
                    <Label Text="{Binding RateFormatNote}" Style="{StaticResource Secondary}" IsVisible="{Binding RateFormatNote, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding RateContextError}" Style="{StaticResource ErrorText}" IsVisible="{Binding RateContextError, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding RateError}" Style="{StaticResource ErrorText}" IsVisible="{Binding RateError, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{v:Translate Entry_Date}" Style="{StaticResource FieldLabel}" />
                    <v:DateField Date="{Binding Date}" AccessibilityLabel="{v:Translate Entry_Date}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <Label Text="{v:Translate Rates_Estimate}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsEstimate}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Rates_Estimate}" />
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Add}" Command="{Binding AddCommand}" Margin="0,12,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
            <p:WrappingAction Text="{v:Translate Rates_Refresh}" Command="{Binding ReloadCommand}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />

            <!-- Stored rates -->
            <Label Text="{v:Translate Rates_Stored}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasRates}" />
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasRates}" IsEnabled="{Binding CanEdit}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:RateRow">
                            <Grid Style="{StaticResource ListRow}" RowDefinitions="Auto,Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Text}" FontSize="15" FlowDirection="LeftToRight" HorizontalOptions="Start" />
                                    <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Row="1" HorizontalOptions="Start" Text="{v:Translate Rates_EstimateBadge}" FontSize="12" Padding="6,1" VerticalOptions="Center"
                                       TextColor="{DynamicResource WarningText}" BackgroundColor="{DynamicResource WarningBackground}" IsVisible="{Binding IsEstimate}" />
                                <!-- The whole row is one real button that offers to delete the rate; the hint says so -->
                                <Button Grid.RowSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                        Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:RatesViewModel}}, x:DataType=local:RatesViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" SemanticProperties.Hint="{v:Translate Rates_Delete}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout IsVisible="{Binding Loading.IsLoading}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="16">
        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" Color="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Rates_Title}" />
        <Label Text="{v:Translate Rates_Title}" Style="{StaticResource Secondary}" />
    </VerticalStackLayout>
    <VerticalStackLayout IsVisible="{Binding Loading.HasFailed}" VerticalOptions="Center" Spacing="12" Padding="16">
        <Label Text="{Binding Error}" HorizontalTextAlignment="Center" />
        <p:WrappingAction Text="{v:Translate Rates_Refresh}" Command="{Binding ReloadCommand}" />
    </VerticalStackLayout>
    </Grid>
</ContentPage>

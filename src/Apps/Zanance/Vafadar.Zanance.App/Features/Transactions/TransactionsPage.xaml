<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Transactions.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Transactions"
    xmlns:ledger="clr-namespace:Vafadar.Zanance.Core.Ledger;assembly=Vafadar.Zanance.Core"
    x:DataType="local:TransactionsViewModel"
    Title="{v:Translate Tx_Title}">

    <!-- D-78: separate scrollable rows from persistent Add/bulk/Undo actions. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Search and filters: the period and the kind stay visible, the rest opens with the filter button (D-27) -->
        <VerticalStackLayout Padding="16,8,16,4" Spacing="10" BackgroundColor="{DynamicResource PageBackground}" IsEnabled="{Binding Loading.IsReady}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource DividerColor}" StrokeShape="RoundRectangle 14" Padding="4,0">
                    <SearchBar Text="{Binding SearchText}" Placeholder="{v:Translate Tx_Search}" SemanticProperties.Description="{v:Translate Common_Search}" />
                </Border>
                <Grid Grid.Column="1">
                    <Border Style="{StaticResource IconButton}" WidthRequest="48" HeightRequest="48">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFilterOpen}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoft}" />
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryLine}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <fi:SymbolIcon Symbol="Filter" FontSize="20" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Button Style="{StaticResource OverlayButton}" Command="{Binding ToggleFilterCommand}" SemanticProperties.Description="{v:Translate Filter_More}" />
                </Grid>
            </Grid>
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding PeriodNames}" SelectedIndex="{Binding PeriodIndex}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <v:ChoiceChips IsCompact="True" ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}" />
                <Button Grid.Column="1" Text="{v:Translate Tx_Unreviewed}" Clicked="OnUnreviewedClicked" CornerRadius="17" MinimumHeightRequest="34" HeightRequest="34"
                        Padding="12,0" FontSize="13" BackgroundColor="{DynamicResource RefundBackground}" TextColor="{DynamicResource RefundText}"
                        BorderColor="{DynamicResource RefundLine}" BorderWidth="1"
                        IsVisible="{Binding UnreviewedCount, Converter={StaticResource IsPositiveConverter}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding UnreviewedOnly}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource RefundText}" />
                            <Setter Property="TextColor" Value="{DynamicResource CardBackground}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- More filters -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsFilterOpen}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount}" IsVisible="{Binding ShowAccountFilter}"
                            Title="{v:Translate Entry_Account}" SemanticProperties.Description="{v:Translate Entry_Account}" />
                    <Picker Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                            Title="{v:Translate Entry_Category}" SemanticProperties.Description="{v:Translate Entry_Category}" />
                </Grid>
                <!-- Saved filters (REP-08): the menu saves or removes; a chip applies one -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Grid>
                            <Border StrokeShape="RoundRectangle 18" Stroke="{DynamicResource Primary}" StrokeThickness="1" HeightRequest="36" WidthRequest="44"
                                    BackgroundColor="Transparent">
                                <fi:SymbolIcon Symbol="Bookmark" FontSize="20" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Button Style="{StaticResource OverlayButton}" CornerRadius="18" Command="{Binding SavedFilterMenuCommand}"
                                    SemanticProperties.Description="{v:Translate Filter_Title}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SavedFilters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ledger:SavedFilter">
                                    <Button Text="{Binding Name}" CornerRadius="18" MinimumHeightRequest="36" Padding="14,0" FontSize="14"
                                            BackgroundColor="{DynamicResource CardBackground}" TextColor="{DynamicResource Primary}"
                                            Command="{Binding ApplySavedFilterCommand, Source={RelativeSource AncestorType={x:Type local:TransactionsViewModel}}, x:DataType=local:TransactionsViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Text="{v:Translate Filter_Hint}" Style="{StaticResource Secondary}" VerticalOptions="Center"
                               IsVisible="{Binding HasSavedFilters, Converter={StaticResource InvertedBoolConverter}}" />
                    </HorizontalStackLayout>
                </ScrollView>
                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Bulk_Select}" Command="{Binding StartSelectingCommand}" HorizontalOptions="Start"
                        MinimumHeightRequest="40" HeightRequest="40" Padding="16,0" FontSize="14"
                        IsVisible="{Binding IsSelecting, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>
            <!-- Drill-down from a number: the filter and the total it adds up to (AT-50) -->
            <!-- The scope of the report the number came from: currency, accounts, confirmed only (ZEX-S0601) -->
            <Border BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 18"
                    Padding="14,0,4,0" HorizontalOptions="Start" IsVisible="{Binding ScopeNote, Converter={StaticResource IsNotNullConverter}}">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding ScopeNote}" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                    <Button Text="✕" Command="{Binding ClearCategoryFilterCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}"
                            Padding="8,0" MinimumWidthRequest="36" SemanticProperties.Description="{v:Translate Tx_ClearFilters}" />
                </HorizontalStackLayout>
            </Border>
            <Border BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 18"
                    Padding="14,0,4,0" HorizontalOptions="Start" IsVisible="{Binding CategoryFilterName, Converter={StaticResource IsNotNullConverter}}">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding CategoryFilterName}" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                    <Button Text="✕" Command="{Binding ClearCategoryFilterCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}"
                            Padding="8,0" MinimumWidthRequest="36" SemanticProperties.Description="{v:Translate Tx_ClearFilters}" />
                </HorizontalStackLayout>
            </Border>
            <Border BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource Primary}" StrokeShape="RoundRectangle 18"
                    Padding="14,0,4,0" HorizontalOptions="Start" IsVisible="{Binding CustomPeriodText, Converter={StaticResource IsNotNullConverter}}">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{Binding CustomPeriodText}" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                    <Button Text="✕" Command="{Binding ClearCategoryFilterCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}"
                            Padding="8,0" MinimumWidthRequest="36" SemanticProperties.Description="{v:Translate Tx_ClearFilters}" />
                </HorizontalStackLayout>
            </Border>
            <Label Text="{Binding SummaryText}" Style="{StaticResource Secondary}" IsVisible="{Binding SummaryText, Converter={StaticResource IsNotNullConverter}}" />
        </VerticalStackLayout>

        <!-- Entries grouped by day -->
        <!-- The native grouped adapter receives the complete snapshot before becoming visible (D-76). -->
        <CollectionView x:Name="ContentViewport" Grid.Row="1" ItemsSource="{Binding Days}" IsGrouped="True" SelectionMode="None" IsVisible="{Binding Loading.IsReady}">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="local:EntryDayGroup">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4" Padding="16,14,16,6">
                        <Label Text="{Binding Header}" Style="{StaticResource Secondary}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding NetText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="p:EntryRow">
                    <!-- Padding, not a margin on the row: Windows ignores the margin of a list item's root, and the rows ran edge to edge -->
                    <Grid Padding="16,0">
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding Selection.IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoft}" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Border Grid.RowSpan="2" Style="{StaticResource IconTile}" BackgroundColor="{Binding IconBackground}" Stroke="{Binding IconStroke}">
                                <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" />
                                <!-- D-78: identity wraps above its amount; the review dot retains a separate column. -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse WidthRequest="8" HeightRequest="8" Margin="0,0,6,0" Fill="{DynamicResource RefundText}" VerticalOptions="Center" IsVisible="{Binding IsUnreviewed}"
                                             SemanticProperties.Description="{v:Translate Tx_Unreviewed}" />
                                    <Label Grid.Column="1" Text="{Binding Subtitle}" Style="{StaticResource Secondary}" LineBreakMode="WordWrap" />
                                </Grid>
                            </VerticalStackLayout>
                            <Label Grid.Row="1" Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontSize="15"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                            <!-- The whole row is one real button: keyboard, screen readers and touch -->
                            <Button Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                    Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:TransactionsViewModel}}, x:DataType=local:TransactionsViewModel}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding AmountText}" />
                            <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="22" ForegroundColor="{DynamicResource Primary}" VerticalOptions="Start" HorizontalOptions="Start"
                                           Margin="-6,-4,0,0" IsVisible="{Binding Selection.IsSelected}" InputTransparent="True" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32,48" Spacing="16">
                    <fi:SymbolIcon Symbol="Receipt" FontSize="44" HorizontalOptions="Center" ForegroundColor="{DynamicResource Muted}" />
                    <Label Text="{v:Translate Tx_Empty}" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoEntriesAtAll}" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Tx_Add}" Command="{Binding AddCommand}"
                            IsVisible="{Binding HasNoEntriesAtAll}" />
                    <Label Text="{v:Translate Tx_EmptyFiltered}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasNoEntriesAtAll, Converter={StaticResource InvertedBoolConverter}}" />
                    <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Tx_ClearFilters}" Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding HasNoEntriesAtAll, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <BoxView HeightRequest="12" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.IsLoading}">
            <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" Color="{DynamicResource Primary}"
                               WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
            <Label Text="{v:Translate Tx_Loading}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" SemanticProperties.Description="{v:Translate Tx_Loading}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="16" VerticalOptions="Center" IsVisible="{Binding Loading.HasFailed}">
            <Label Text="{v:Translate Error_Unexpected}" HorizontalTextAlignment="Center" />
            <Button x:Name="RetryLoadButton" Text="{v:Translate Tx_RetryLoad}" Style="{StaticResource SecondaryButton}" Clicked="OnReloadClicked" />
        </VerticalStackLayout>

        <Button x:Name="AddAction" Grid.Row="2" Style="{StaticResource FloatingAddButton}" Text="+" Command="{Binding AddCommand}"
                IsEnabled="{Binding Loading.IsReady}"
                SemanticProperties.Description="{v:Translate Tx_Add}" IsVisible="{Binding IsSelecting, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- Bulk actions (F2-TX-04) -->
        <Border x:Name="BulkActions" Grid.Row="2" IsVisible="{Binding IsSelecting}" VerticalOptions="End" Margin="8" Padding="12,8"
                IsEnabled="{Binding Loading.IsReady}"
                BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource DividerColor}" StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Text="{Binding SelectionText}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Bulk_SelectAll}" Command="{Binding SelectAllCommand}" Style="{StaticResource TextButton}" />
                    <Button Grid.Column="2" Text="{v:Translate Common_Cancel}" Command="{Binding StopSelectingCommand}" Style="{StaticResource TextButton}" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" IsEnabled="{Binding HasSelection}">
                    <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Bulk_Reviewed}" Command="{Binding BulkReviewedCommand}" FontSize="12" Padding="4,0" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate Entry_Category}" Command="{Binding BulkCategoryCommand}" FontSize="12" Padding="4,0" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Text="{v:Translate Bulk_Tag}" Command="{Binding BulkTagCommand}" FontSize="12" Padding="4,0" />
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Text="{v:Translate Common_Delete}" Command="{Binding BulkDeleteCommand}" FontSize="12" Padding="4,0"
                            TextColor="{DynamicResource ExpenseText}" BorderColor="{DynamicResource ExpenseText}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Undo after delete -->
        <Border x:Name="UndoNotice" Grid.Row="3" IsVisible="{Binding ShowUndo}" VerticalOptions="End" Margin="16,0,16,12" Padding="16,4,8,4"
                BackgroundColor="{DynamicResource SnackbarBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Text="{v:Translate Tx_Deleted}" TextColor="{DynamicResource SnackbarText}" VerticalOptions="Center" />
                <Button Grid.Row="1" HorizontalOptions="End" Text="{v:Translate Common_Undo}" Command="{Binding UndoDeleteCommand}" BackgroundColor="Transparent"
                        TextColor="{DynamicResource SnackbarAction}" FontAttributes="Bold" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>

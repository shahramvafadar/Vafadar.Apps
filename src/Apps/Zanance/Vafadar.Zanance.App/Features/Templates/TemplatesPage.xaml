<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Templates.TemplatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Templates"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    x:DataType="local:TemplatesViewModel"
    Title="{v:Translate Templates_Title}">

    <Grid RowDefinitions="*,Auto">
    <ScrollView IsVisible="{Binding Loading.IsReady}" IsEnabled="{Binding CanInteract}">
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Templates_Intro}" Style="{StaticResource Secondary}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasTemplates, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <fi:SymbolIcon Symbol="Flash" FontSize="36" HorizontalOptions="Center" ForegroundColor="{DynamicResource Muted}" />
                    <Label Text="{v:Translate Templates_Empty}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasTemplates}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Templates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:TemplateRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{Binding IconBackground}" Stroke="{Binding IconStroke}">
                                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" MaxLines="-1" />
                                    <Label Text="{Binding Details}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{v:Translate Common_Delete}" Style="{StaticResource TextButton}" TextColor="{DynamicResource ExpenseText}" SemanticProperties.Hint="{Binding Name}"
                                        Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type local:TemplatesViewModel}}, x:DataType=local:TemplatesViewModel}"
                                        CommandParameter="{Binding .}" IsEnabled="{Binding Actions.CanDeleteTemplates, Source={RelativeSource AncestorType={x:Type local:TemplatesViewModel}}, x:DataType=local:TemplatesViewModel}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.IsLoading}">
        <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" Color="{DynamicResource Primary}" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
        <Label Text="{v:Translate Templates_Loading}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
    <Label Text="{Binding Feedback}" Margin="32" VerticalOptions="Center" IsVisible="{Binding Loading.HasFailed}" />
    <VerticalStackLayout Grid.Row="1" Padding="16,8,16,16" Spacing="8">
        <Label Text="{Binding Actions.Feedback}" Style="{StaticResource ErrorText}" IsVisible="{Binding Actions.Feedback, Converter={StaticResource IsNotNullConverter}}" />
        <p:WrappingAction Text="{v:Translate Templates_Reload}" Command="{Binding ReloadCommand}" IsEnabled="{Binding CanReload}" />
    </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:accounts="clr-namespace:Vafadar.Zanance.App.Features.Accounts"
    xmlns:plans="clr-namespace:Vafadar.Zanance.App.Features.Plans"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Home"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:progress="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    x:DataType="local:HomeViewModel"
    Title="{v:Translate App_Name}">

    <!-- Home (D-27, D-37): the balance first, quick add right below it, what needs attention, then the sections the user
         keeps (§21.5). One job per card; the first screen answers "where do I stand?" and "add an expense" without scrolling. -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="Sections" Padding="16,8,16,16" Spacing="12">

                <!-- Welcome without accounts -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasAccounts, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="14">
                        <Image Source="zanance_symbol.png" HeightRequest="56" WidthRequest="54" HorizontalOptions="Center" SemanticProperties.Description="{v:Translate App_Name}" />
                        <Label Text="{v:Translate Home_NoAccounts}" HorizontalTextAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Accounts_Add}" Command="{Binding AddEntryCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Recorded balance (FIN-13); tap for the accounts -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasAccounts}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAccountsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{v:Translate Home_Balance}" Style="{StaticResource Secondary}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Balances}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="accounts:CurrencyTotal">
                                    <Label Text="{Binding Text}" Style="{StaticResource AmountLarge}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding ConfirmedBalanceText}" TextColor="{DynamicResource WarningText}" FontSize="12.5"
                               IsVisible="{Binding ConfirmedBalanceText, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding IncompleteText}" TextColor="{DynamicResource WarningText}" FontSize="12.5"
                               IsVisible="{Binding IncompleteText, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{Binding CombinedText}" FontSize="13" IsVisible="{Binding CombinedText, Converter={StaticResource IsNotNullConverter}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRatesCommand}" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CombinedIncomplete}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource WarningText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{v:Translate Home_BalanceHint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick add (UX-04, D-37): the kind is chosen here, so an expense is amount, category, Save. Expense is the
                     everyday action (blue); income and transfer carry their meaning colours. Templates fill the form in one tap. -->
                <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding HasAccounts}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Grid Style="{StaticResource QuickAction}" RowDefinitions="Auto,Auto">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource PrimarySoft}" Stroke="{DynamicResource PrimaryLine}" HorizontalOptions="Center">
                                    <fi:SymbolIcon Symbol="ArrowUpRight" FontSize="20" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Row="1" Text="{v:Translate EntryKind_Expense}" Style="{StaticResource QuickActionLabel}" />
                                <Button Grid.RowSpan="2" Style="{StaticResource OverlayButton}" Command="{Binding AddKindCommand}" CommandParameter="Expense"
                                        SemanticProperties.Description="{v:Translate Entry_NewExpense}" ToolTipProperties.Text="{v:Translate Entry_NewExpense}" />
                            </Grid>
                            <Grid Grid.Column="1" Style="{StaticResource QuickAction}" RowDefinitions="Auto,Auto">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource IncomeBackground}" Stroke="{DynamicResource IncomeLine}" HorizontalOptions="Center">
                                    <fi:SymbolIcon Symbol="ArrowDownLeft" FontSize="20" ForegroundColor="{DynamicResource IncomeText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Row="1" Text="{v:Translate EntryKind_Income}" Style="{StaticResource QuickActionLabel}" />
                                <Button Grid.RowSpan="2" Style="{StaticResource OverlayButton}" Command="{Binding AddKindCommand}" CommandParameter="Income"
                                        SemanticProperties.Description="{v:Translate Entry_NewIncome}" ToolTipProperties.Text="{v:Translate Entry_NewIncome}" />
                            </Grid>
                            <Grid Grid.Column="2" Style="{StaticResource QuickAction}" RowDefinitions="Auto,Auto">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource TransferBackground}" Stroke="{DynamicResource TransferLine}" HorizontalOptions="Center">
                                    <fi:SymbolIcon Symbol="ArrowSwap" FontSize="20" ForegroundColor="{DynamicResource TransferText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Row="1" Text="{v:Translate EntryKind_Transfer}" Style="{StaticResource QuickActionLabel}" />
                                <Button Grid.RowSpan="2" Style="{StaticResource OverlayButton}" Command="{Binding AddKindCommand}" CommandParameter="Transfer"
                                        SemanticProperties.Description="{v:Translate Entry_NewTransfer}" ToolTipProperties.Text="{v:Translate Entry_NewTransfer}" />
                            </Grid>
                            <!-- A receipt photo or PDF, read on the device; neutral, because it is a way to add an expense -->
                            <Grid Grid.Column="3" Style="{StaticResource QuickAction}" RowDefinitions="Auto,Auto">
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}" HorizontalOptions="Center">
                                    <fi:SymbolIcon Symbol="Receipt" FontSize="20" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Row="1" Text="{v:Translate Receipt_Title}" Style="{StaticResource QuickActionLabel}" />
                                <Button Grid.RowSpan="2" Style="{StaticResource OverlayButton}" Command="{Binding ReadReceiptCommand}"
                                        SemanticProperties.Description="{v:Translate Home_ReadReceipt}" ToolTipProperties.Text="{v:Translate Home_ReadReceipt}" />
                            </Grid>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasQuickTemplates}">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding QuickTemplates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:QuickTemplate">
                                        <Grid>
                                            <Border Style="{StaticResource TemplatePill}">
                                                <HorizontalStackLayout Spacing="6">
                                                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="16" ForegroundColor="{Binding IconColor}" VerticalOptions="Center" />
                                                    <Label Text="{Binding Name}" FontSize="13.5" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Button Style="{StaticResource OverlayButton}" CornerRadius="20"
                                                    Command="{Binding UseTemplateCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}"
                                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Description}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Getting started (ONB-04, D-41): what makes Home useful, ticked off as it is done -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding ShowGettingStarted}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14,8,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{v:Translate Home_StartTitle}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{v:Translate Home_StartText}" Style="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Style="{StaticResource TextButton}" Text="{v:Translate Home_StartHide}" Command="{Binding HideGettingStartedCommand}" VerticalOptions="Start" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="24" ForegroundColor="{DynamicResource IncomeText}" VerticalOptions="Center" IsVisible="{Binding FirstEntryDone}" />
                            <fi:SymbolIcon Symbol="Circle" FontSize="24" ForegroundColor="{DynamicResource StrokeStrong}" VerticalOptions="Center"
                                           IsVisible="{Binding FirstEntryDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Grid.Column="1" Text="{v:Translate Home_StartEntry}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding FirstEntryDone}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}"
                                           IsVisible="{Binding FirstEntryDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding AddKindCommand}" CommandParameter="Expense"
                                    IsVisible="{Binding FirstEntryDone, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="{v:Translate Home_StartEntry}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="24" ForegroundColor="{DynamicResource IncomeText}" VerticalOptions="Center" IsVisible="{Binding PlanDone}" />
                            <fi:SymbolIcon Symbol="Circle" FontSize="24" ForegroundColor="{DynamicResource StrokeStrong}" VerticalOptions="Center"
                                           IsVisible="{Binding PlanDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Grid.Column="1" Text="{v:Translate Home_StartPlan}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding PlanDone}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}"
                                           IsVisible="{Binding PlanDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding AddPlanCommand}"
                                    IsVisible="{Binding PlanDone, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="{v:Translate Home_StartPlan}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" FontSize="24" ForegroundColor="{DynamicResource IncomeText}" VerticalOptions="Center" IsVisible="{Binding BudgetDone}" />
                            <fi:SymbolIcon Symbol="Circle" FontSize="24" ForegroundColor="{DynamicResource StrokeStrong}" VerticalOptions="Center"
                                           IsVisible="{Binding BudgetDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Grid.Column="1" Text="{v:Translate Home_StartBudget}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding BudgetDone}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}"
                                           IsVisible="{Binding BudgetDone, Converter={StaticResource InvertedBoolConverter}}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding AddBudgetCommand}"
                                    IsVisible="{Binding BudgetDone, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="{v:Translate Home_StartBudget}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Needs attention: always an action, never just a red number (DASH-03) -->
                <VerticalStackLayout Spacing="0" IsVisible="{Binding HasAttention}">
                    <Label Text="{v:Translate Home_Attention}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding DueCount, Converter={StaticResource IsPositiveConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenDueCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{Binding DueTileBackground}" Stroke="{Binding DueTileLine}">
                                    <fi:SymbolIcon Symbol="CalendarClock" FontSize="20" ForegroundColor="{Binding DueTileText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding DueText}" Style="{StaticResource RowTitle}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            </Grid>

                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding UnreviewedCount, Converter={StaticResource IsPositiveConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenUnreviewedCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource RefundBackground}" Stroke="{DynamicResource RefundLine}">
                                    <fi:SymbolIcon Symbol="Eye" FontSize="20" ForegroundColor="{DynamicResource RefundText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding UnreviewedText}" Style="{StaticResource RowTitle}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            </Grid>
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ReimbursementText, Converter={StaticResource IsNotNullConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReimbursementsCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource RefundBackground}" Stroke="{DynamicResource RefundLine}">
                                    <fi:SymbolIcon Symbol="ArrowUndo" FontSize="20" ForegroundColor="{DynamicResource RefundText}" HorizontalOptions="Center" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding ReimbursementText}" Style="{StaticResource RowTitle}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            </Grid>
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ContractText, Converter={StaticResource IsNotNullConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenContractCommand}" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource PlanBackground}" Stroke="{DynamicResource PlanLine}">
                                    <fi:SymbolIcon Symbol="DocumentText" FontSize="20" ForegroundColor="{DynamicResource PlanText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding ContractText}" Style="{StaticResource RowTitle}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Sections the user can hide and reorder (§21.5); balance and attention stay on top (DASH-03) -->
                <VerticalStackLayout x:Name="PeriodSection" Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEntries}">
                        <Label Text="{v:Translate Home_ThisPeriod}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                        <Label Grid.Column="1" Text="{v:Translate Report_Title}" Style="{StaticResource SectionLink}" Margin="4,4,4,8">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <!-- The period of the numbers below (DASH-01): chosen here, next to what it changes -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,8" IsVisible="{Binding HasEntries}">
                        <v:ChoiceChips IsCompact="True" ItemsSource="{Binding PeriodNames}" SelectedIndex="{Binding PeriodIndex}" />
                        <Label Text="{Binding ScopeText}" Style="{StaticResource Secondary}" FontSize="12" Margin="4,0" />
                    </VerticalStackLayout>
                    <!-- Income and expense of the period; tap for the entries behind each number -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Periods}" Spacing="8" IsVisible="{Binding HasEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:PeriodSummary">
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenIncomeCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}" />
                                            </Grid.GestureRecognizers>
                                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource IncomeBackground}" Stroke="{DynamicResource IncomeLine}">
                                                <fi:SymbolIcon Symbol="ArrowDownLeft" FontSize="17" ForegroundColor="{DynamicResource IncomeText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{v:Translate KindFilter_Income}" Style="{StaticResource Secondary}" />
                                                <Label Text="{Binding IncomeText}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource IncomeText}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenExpenseCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}" />
                                            </Grid.GestureRecognizers>
                                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                                <fi:SymbolIcon Symbol="ArrowUpRight" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{v:Translate KindFilter_Expenses}" Style="{StaticResource Secondary}" />
                                                <Label Text="{Binding ExpenseText}" FontSize="16" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" />
                                        <Label Grid.Row="2" Text="{v:Translate Home_Result}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                            <Label Text="{Binding ResultText}" FontSize="16" FontAttributes="Bold" TextColor="{Binding ResultColor}" HorizontalOptions="End" />
                                            <Label Text="{Binding RefundsText}" TextColor="{DynamicResource RefundText}" FontSize="12" HorizontalOptions="End"
                                                   IsVisible="{Binding RefundsText, Converter={StaticResource IsNotNullConverter}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ForecastSection" Spacing="0">
                    <!-- Forecast (Advanced): the estimate after the recorded plans -->
                    <Border Style="{StaticResource Card}" Padding="14,12" IsVisible="{Binding ForecastEndText, Converter={StaticResource IsNotNullConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenForecastCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource IconTile}" BackgroundColor="{DynamicResource PlanBackground}" Stroke="{DynamicResource PlanLine}">
                                <fi:SymbolIcon Symbol="DataTrending" FontSize="20" ForegroundColor="{DynamicResource PlanText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{v:Translate Forecast_EndBalance}" Style="{StaticResource Secondary}" FontSize="12" />
                                <Label Text="{Binding ForecastEndText}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding ForecastLowText}" TextColor="{Binding ForecastLowColor}" FontSize="13" />
                                <Label Text="{Binding ForecastNote}" TextColor="{DynamicResource WarningText}" FontSize="12"
                                       IsVisible="{Binding ForecastNote, Converter={StaticResource IsNotNullConverter}}" />
                            </VerticalStackLayout>
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="BudgetSection" Spacing="0">
                    <!-- Budget remaining (only when a budget exists) -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBudget}">
                        <Label Text="{v:Translate Budget_Title}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                        <Label Grid.Column="1" Text="{v:Translate Home_Details}" Style="{StaticResource SectionLink}" Margin="4,4,4,8">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenBudgetCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasBudget}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBudgetCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding BudgetText}" FontSize="15" FontAttributes="Bold" />
                            <progress:SfLinearProgressBar Progress="{Binding BudgetProgress}" ProgressFill="{Binding BudgetColor}" />
                            <Label Text="{Binding BudgetDailyText}" Style="{StaticResource Secondary}"
                                   IsVisible="{Binding BudgetDailyText, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="UpcomingSection" Spacing="0">
                    <!-- Next due items -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasUpcoming}">
                        <Label Text="{v:Translate Home_Upcoming}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                        <Label Grid.Column="1" Text="{v:Translate Home_All}" Style="{StaticResource SectionLink}" Margin="4,4,4,8">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDueCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasUpcoming}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Upcoming}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="plans:PlanRow">
                                    <plans:PlanRowView>
                                        <plans:PlanRowView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenOccurrenceCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </plans:PlanRowView.GestureRecognizers>
                                    </plans:PlanRowView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="RecentSection" Spacing="0">
                    <!-- The latest entries (D-37): what was recorded last, one tap to its details -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRecent}">
                        <Label Text="{v:Translate Home_Recent}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                        <Label Grid.Column="1" Text="{v:Translate Home_All}" Style="{StaticResource SectionLink}" Margin="4,4,4,8">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTransactionsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasRecent}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentEntries}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="p:EntryRow">
                                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto">
                                        <Border Style="{StaticResource IconTile}" BackgroundColor="{Binding IconBackground}" Stroke="{Binding IconStroke}">
                                            <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                            <!-- A grid, not a stack: the subtitle gets the remaining width and is shortened instead of running under the amount -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Ellipse WidthRequest="8" HeightRequest="8" Margin="0,0,6,0" Fill="{DynamicResource RefundText}" VerticalOptions="Center" IsVisible="{Binding IsUnreviewed}"
                                                         SemanticProperties.Description="{v:Translate Tx_Unreviewed}" />
                                                <Label Grid.Column="1" Text="{Binding Subtitle}" Style="{StaticResource Secondary}" LineBreakMode="TailTruncation" MaxLines="1" />
                                            </Grid>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                                Command="{Binding OpenEntryCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CategoriesSection" Spacing="0">
                    <!-- Expense by category: chart with a table that is also the accessible alternative (UX-06) -->
                    <Label Text="{v:Translate Home_ExpenseByCategory}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" IsVisible="{Binding HasEntries}" />
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasEntries}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{v:Translate Home_NoExpenses}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center"
                                   IsVisible="{Binding HasSlices, Converter={StaticResource InvertedBoolConverter}}" />
                            <Grid IsVisible="{Binding HasSlices}">
                                <chart:SfCircularChart HeightRequest="190" FlowDirection="LeftToRight" BackgroundColor="Transparent"
                                                       SemanticProperties.Description="{v:Translate Home_ExpenseByCategory}">
                                    <chart:DoughnutSeries ItemsSource="{Binding Slices}" XBindingPath="Name" YBindingPath="Value"
                                                          PaletteBrushes="{Binding SliceBrushes}" InnerRadius="0.66" StrokeWidth="2" EnableTooltip="True" Stroke="{DynamicResource CardBackground}" />
                                </chart:SfCircularChart>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" Spacing="0">
                                    <Label Text="{v:Translate Chart_Total}" Style="{StaticResource Secondary}" FontSize="12" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding SliceTotalText}" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Slices}" IsVisible="{Binding HasSlices}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:CategorySlice">
                                        <Grid ColumnDefinitions="Auto,*,Auto,52" ColumnSpacing="10" MinimumHeightRequest="40">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenSliceCommand, Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, x:DataType=local:HomeViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="3" Color="{Binding Color}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Secondary}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding ChartNote}" Style="{StaticResource Secondary}" FontSize="12"
                                   IsVisible="{Binding ChartNote, Converter={StaticResource IsNotNullConverter}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="AccountsSection" Spacing="0">
                    <!-- Accounts -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAccounts}">
                        <Label Text="{v:Translate Home_AccountsSection}" Style="{StaticResource SectionHeader}" Margin="4,4,4,8" />
                        <Label Grid.Column="1" Text="{v:Translate Home_All}" Style="{StaticResource SectionLink}" Margin="4,4,4,8">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAccountsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasAccounts}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Accounts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="accounts:AccountItem">
                                    <accounts:AccountRow />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Style="{StaticResource TextButton}" Text="{v:Translate HomeLayout_Customize}" Command="{Binding CustomizeCommand}" HorizontalOptions="Center" />

                <BoxView HeightRequest="72" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Style="{StaticResource FloatingAddButton}" Text="+" Command="{Binding AddEntryCommand}"
                SemanticProperties.Description="{v:Translate Tx_Add}" />

        <!-- Reading a receipt takes a moment on the device -->
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="48" HeightRequest="48" />
    </Grid>
</ContentPage>

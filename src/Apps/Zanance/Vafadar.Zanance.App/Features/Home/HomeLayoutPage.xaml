<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Home.HomeLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Home"
    x:DataType="local:HomeLayoutViewModel"
    Title="{v:Translate HomeLayout_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate HomeLayout_Intro}" Style="{StaticResource Secondary}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:HomeSectionRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,44,44,Auto" ColumnSpacing="6">
                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Style="{StaticResource MoveButton}" IsVisible="{Binding CanMoveUp}"
                                        Command="{Binding MoveUpCommand, Source={RelativeSource AncestorType={x:Type local:HomeLayoutViewModel}}, x:DataType=local:HomeLayoutViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="{v:Translate HomeLayout_Up}">
                                    <Button.ImageSource>
                                        <fi:SymbolImageSource Symbol="ArrowUp" Size="18" Color="{DynamicResource Primary}" />
                                    </Button.ImageSource>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource MoveButton}" IsVisible="{Binding CanMoveDown}"
                                        Command="{Binding MoveDownCommand, Source={RelativeSource AncestorType={x:Type local:HomeLayoutViewModel}}, x:DataType=local:HomeLayoutViewModel}"
                                        CommandParameter="{Binding .}" SemanticProperties.Description="{v:Translate HomeLayout_Down}">
                                    <Button.ImageSource>
                                        <fi:SymbolImageSource Symbol="ArrowDown" Size="18" Color="{DynamicResource Primary}" />
                                    </Button.ImageSource>
                                </Button>
                                <Switch Grid.Column="3" IsToggled="{Binding IsVisible}" OnColor="{DynamicResource Primary}" VerticalOptions="Center"
                                        SemanticProperties.Description="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
            <Button Text="{v:Translate HomeLayout_Reset}" Command="{Binding ResetCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Forecast.ForecastPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Forecast"
    x:DataType="local:ForecastViewModel"
    Title="{v:Translate Forecast_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding HorizonNames}" SelectedIndex="{Binding HorizonIndex}" />
            <Label Text="{Binding BasisText}" Style="{StaticResource Secondary}" />
            <Label Text="{v:Translate Forecast_WhatIfHint}" Style="{StaticResource Secondary}" FontSize="12" />
            <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,4"
                    IsVisible="{Binding HasScenario}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{v:Translate Forecast_WhatIfActive}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{v:Translate Forecast_WhatIfReset}" Command="{Binding ResetScenarioCommand}"
                            BackgroundColor="Transparent" TextColor="{DynamicResource WarningText}" FontAttributes="Bold" />
                </Grid>
            </Border>
            <Label Text="{Binding UnreviewedText}" TextColor="{DynamicResource WarningText}" FontSize="13"
                   IsVisible="{Binding UnreviewedText, Converter={StaticResource IsNotNullConverter}}" />

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:ForecastCard">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{v:Translate Forecast_EndBalance}" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding EndText}" Style="{StaticResource AmountLarge}" />
                                    <Label Text="{Binding MinimumText}" TextColor="{Binding MinimumColor}" />
                                    <Border BackgroundColor="{DynamicResource ExpenseBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8"
                                            IsVisible="{Binding Warning, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding Warning}" TextColor="{DynamicResource ExpenseText}" />
                                    </Border>
                                    <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8"
                                            IsVisible="{Binding IncompleteText, Converter={StaticResource IsNotNullConverter}}">
                                        <Label Text="{Binding IncompleteText}" TextColor="{DynamicResource WarningText}" />
                                    </Border>
                                    <chart:SfCartesianChart HeightRequest="180" FlowDirection="LeftToRight" SemanticProperties.Description="{v:Translate Forecast_Path}" IsVisible="{Binding HasItems}">
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:DateTimeAxis ShowMajorGridLines="False" LabelCreated="OnDateLabelCreated">
                                    <chart:DateTimeAxis.MajorGridLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource DividerColor}" StrokeWidth="1" />
                                    </chart:DateTimeAxis.MajorGridLineStyle>
                                    <chart:DateTimeAxis.AxisLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource StrokeStrong}" StrokeWidth="1" />
                                    </chart:DateTimeAxis.AxisLineStyle>
                                    <chart:DateTimeAxis.MajorTickStyle>
                                        <chart:ChartAxisTickStyle Stroke="{DynamicResource StrokeStrong}" />
                                    </chart:DateTimeAxis.MajorTickStyle>
                                    <chart:DateTimeAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="11" />
                                    </chart:DateTimeAxis.LabelStyle>                                </chart:DateTimeAxis>
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis LabelCreated="OnAxisLabelCreated">
                                    <chart:NumericalAxis.MajorGridLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource DividerColor}" StrokeWidth="1" />
                                    </chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:NumericalAxis.AxisLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource StrokeStrong}" StrokeWidth="1" />
                                    </chart:NumericalAxis.AxisLineStyle>
                                    <chart:NumericalAxis.MajorTickStyle>
                                        <chart:ChartAxisTickStyle Stroke="{DynamicResource StrokeStrong}" />
                                    </chart:NumericalAxis.MajorTickStyle>
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="11" />
                                    </chart:NumericalAxis.LabelStyle>                                </chart:NumericalAxis>
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:StepLineSeries ItemsSource="{Binding Path}" XBindingPath="Date" YBindingPath="Balance"
                                                              Fill="{DynamicResource PlanText}" StrokeWidth="2" />
                                    </chart:SfCartesianChart>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.EmptyView>
                                        <!-- Without plans the balance cannot change: say how to get a forecast instead of a flat line -->
                                        <VerticalStackLayout Padding="16" Spacing="12">
                                            <Label Text="{v:Translate Forecast_NoItems}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                            <Label Text="{v:Translate Forecast_NoPlansHint}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" />
                                            <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Plans_Add}"
                                                    Command="{Binding AddPlanCommand, Source={RelativeSource AncestorType={x:Type local:ForecastViewModel}}, x:DataType=local:ForecastViewModel}" />
                                        </VerticalStackLayout>
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:ForecastRow">
                                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" Opacity="{Binding Opacity}">
                                                <Label Text="{Binding DateText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" />
                                                    <Label Text="{Binding Badge}" FontSize="12" TextColor="{DynamicResource WarningText}"
                                                           IsVisible="{Binding Badge, Converter={StaticResource IsNotNullConverter}}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                                <!-- The whole row is one real button: keyboard, screen readers and touch -->
                                                <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                                        Command="{Binding OpenItemCommand, Source={RelativeSource AncestorType={x:Type local:ForecastViewModel}}, x:DataType=local:ForecastViewModel}"
                                                        CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding DateText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- What the forecast does not know (FOR-06, FOR-07) -->
            <Label Text="{v:Translate Forecast_Disclaimer}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

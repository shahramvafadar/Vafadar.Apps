<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Forecast.SnapshotPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:reports="clr-namespace:Vafadar.Zanance.App.Features.Reports"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Forecast"
    x:DataType="local:SnapshotViewModel"
    Title="{Binding Name}">

    <Grid>
        <Label Text="{v:Translate Snapshot_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />
        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding SavedText}" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding AssumptionsText}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding AssumptionsText, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{v:Translate Snapshot_ReadOnly}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{v:Translate Snapshot_NotStarted}" Style="{StaticResource Secondary}" Margin="4,8" IsVisible="{Binding NotStarted}" />

                <!-- Saved path and reality; the table below is the alternative to the chart -->
                <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding NotStarted, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ComparedText}" FontAttributes="Bold" />
                        <chart:SfCartesianChart HeightRequest="220" FlowDirection="LeftToRight" SemanticProperties.Description="{v:Translate Snapshot_Chart}">
                            <chart:SfCartesianChart.Legend>
                                <chart:ChartLegend />
                            </chart:SfCartesianChart.Legend>
                            <chart:SfCartesianChart.XAxes>
                                <chart:DateTimeAxis>
                                    <chart:DateTimeAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="10" LabelFormat="dd.MM" />
                                    </chart:DateTimeAxis.LabelStyle>
                                </chart:DateTimeAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis>
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="10" />
                                    </chart:NumericalAxis.LabelStyle>
                                </chart:NumericalAxis>
                            </chart:SfCartesianChart.YAxes>
                            <chart:LineSeries ItemsSource="{Binding Points}" XBindingPath="Date" YBindingPath="Saved" Fill="{DynamicResource Muted}" StrokeWidth="2" Label="{v:Translate Snapshot_SavedPath}" />
                            <chart:LineSeries ItemsSource="{Binding Points}" XBindingPath="Date" YBindingPath="Actual" Fill="{DynamicResource Primary}" StrokeWidth="2" Label="{v:Translate Snapshot_ActualPath}" />
                        </chart:SfCartesianChart>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                            <Label Text="{v:Translate Entry_Date}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="1" Text="{v:Translate Snapshot_SavedPath}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="2" Text="{v:Translate Snapshot_ActualPath}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="3" Text="{v:Translate Snapshot_Difference}" Style="{StaticResource Secondary}" FontSize="12" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ComparisonRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="28">
                                        <Label Text="{Binding DateText}" FontSize="12" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding SavedText}" FontSize="12" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding ActualText}" FontSize="12" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding DifferenceText}" TextColor="{Binding DifferenceColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Where the difference comes from: the parts add up to it -->
                <Label Text="{v:Translate Snapshot_Parts}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="reports:AmountLine">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Label}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Amount}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Snapshot_PartsNote}" Style="{StaticResource Secondary}" FontSize="12" Margin="4,0" />

                <Button Text="{v:Translate Snapshot_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource TextButton}" TextColor="{DynamicResource ExpenseText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

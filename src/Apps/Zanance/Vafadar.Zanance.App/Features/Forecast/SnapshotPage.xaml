<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Forecast.SnapshotPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:reports="clr-namespace:Vafadar.Zanance.App.Features.Reports"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Forecast"
    x:DataType="local:SnapshotViewModel"
    Title="{Binding Name}">

    <ContentPage.Resources>
        <!-- D-311: retain table/body typography and complete original signed amounts. -->
        <Style x:Key="SnapshotTableFigure" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
        </Style>
        <Style x:Key="SnapshotTableTotal" TargetType="Label" BasedOn="{StaticResource SnapshotTableFigure}">
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="SnapshotPartFigure" TargetType="Label" BasedOn="{StaticResource SnapshotTableFigure}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SnapshotPartTotal" TargetType="Label" BasedOn="{StaticResource SnapshotPartFigure}">
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>


    <Grid>
    <Grid IsVisible="{Binding Loading.IsReady}">
        <Label Text="{v:Translate Snapshot_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />
        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding SavedText}" Style="{StaticResource Secondary}" />
                        <Label Text="{Binding AssumptionsText}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding AssumptionsText, Converter={StaticResource IsNotNullConverter}}" />
                        <Label Text="{v:Translate Snapshot_ReadOnly}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding AccessError}" Style="{StaticResource ErrorText}" IsVisible="{Binding AccessError, Converter={StaticResource IsNotNullConverter}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedRows}" IsVisible="{Binding CanCompare, Converter={StaticResource InvertedBoolConverter}}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ComparisonRow">
                            <VerticalStackLayout Spacing="4"><Label Text="{Binding DateText}" /><p:AmountReadout AmountText="{Binding SavedText}" /></VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{v:Translate Snapshot_NotStarted}" Style="{StaticResource Secondary}" Margin="4,8" IsVisible="{Binding ShowNotStarted}" />

                <!-- Saved path and reality; the table below is the alternative to the chart -->
                <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding NotStarted, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ComparedText}" FontAttributes="Bold" />
                        <chart:SfCartesianChart HeightRequest="220" FlowDirection="LeftToRight" SemanticProperties.Description="{v:Translate Snapshot_Chart}">
                            <chart:SfCartesianChart.Legend>
                                <chart:ChartLegend />
                            </chart:SfCartesianChart.Legend>
                            <chart:SfCartesianChart.XAxes>
                                <chart:DateTimeAxis>
                                    <chart:DateTimeAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="10" LabelFormat="dd.MM" />
                                    </chart:DateTimeAxis.LabelStyle>
                                </chart:DateTimeAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis>
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="10" />
                                    </chart:NumericalAxis.LabelStyle>
                                </chart:NumericalAxis>
                            </chart:SfCartesianChart.YAxes>
                            <chart:LineSeries ItemsSource="{Binding Points}" XBindingPath="Date" YBindingPath="Saved" Fill="{DynamicResource Muted}" StrokeWidth="2" Label="{v:Translate Snapshot_SavedPath}" />
                            <chart:LineSeries ItemsSource="{Binding Points}" XBindingPath="Date" YBindingPath="Actual" Fill="{DynamicResource Primary}" StrokeWidth="2" Label="{v:Translate Snapshot_ActualPath}" />
                        </chart:SfCartesianChart>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:ComparisonRow">
                                    <VerticalStackLayout Spacing="4" Padding="0,6">
                                        <Label Text="{Binding DateText}" FontSize="12" LineBreakMode="WordWrap" />
                                        <Label Text="{v:Translate Snapshot_SavedPath}" Style="{StaticResource Secondary}" FontSize="12" />
                                        <p:AmountReadout AmountText="{Binding SavedText}" CaptionStyle="{StaticResource SnapshotTableFigure}" />
                                        <Label Text="{v:Translate Snapshot_ActualPath}" Style="{StaticResource Secondary}" FontSize="12" />
                                        <p:AmountReadout AmountText="{Binding ActualText}" CaptionStyle="{StaticResource SnapshotTableFigure}" />
                                        <Label Text="{v:Translate Snapshot_Difference}" Style="{StaticResource Secondary}" FontSize="12" />
                                        <p:AmountReadout AmountText="{Binding DifferenceText}" TextColor="{Binding DifferenceColor}" CaptionStyle="{StaticResource SnapshotTableTotal}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Where the difference comes from: the parts add up to it -->
                <Label Text="{v:Translate Snapshot_Parts}" Style="{StaticResource SectionHeader}" IsVisible="{Binding CanCompare}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Parts}" Spacing="8" IsVisible="{Binding CanCompare}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="reports:AmountLine">
                                <VerticalStackLayout Spacing="4" Padding="0,4">
                                    <Label Text="{Binding Label}" LineBreakMode="WordWrap" />
                                    <p:AmountReadout AmountText="{Binding Amount}" CaptionStyle="{StaticResource SnapshotPartFigure}">
                                        <p:AmountReadout.Triggers>
                                            <DataTrigger TargetType="p:AmountReadout" Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="CaptionStyle" Value="{StaticResource SnapshotPartTotal}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="p:AmountReadout" Binding="{Binding IsNegative}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
                                            </DataTrigger>
                                        </p:AmountReadout.Triggers>
                                    </p:AmountReadout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Snapshot_PartsNote}" Style="{StaticResource Secondary}" FontSize="12" Margin="4,0" IsVisible="{Binding CanCompare}" />

                <Button Text="{v:Translate Snapshot_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource TextButton}" TextColor="{DynamicResource ExpenseText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
        <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.IsLoading}">
            <ActivityIndicator IsRunning="{Binding Loading.IsLoading}" Color="{DynamicResource Primary}" />
            <Label Text="{v:Translate Forecast_Loading}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center" IsVisible="{Binding Loading.HasFailed}">
            <Label Text="{v:Translate Forecast_LoadFailed}" HorizontalTextAlignment="Center" />
            <p:WrappingAction Text="{v:Translate Forecast_Refresh}" Command="{Binding ReloadCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

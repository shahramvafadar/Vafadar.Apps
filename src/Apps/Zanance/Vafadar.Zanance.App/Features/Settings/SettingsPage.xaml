<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Settings"
    x:DataType="local:SettingsViewModel"
    Title="{v:Translate Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Language and region: how dates, numbers and weeks are shown -->
            <Label Text="{v:Translate Settings_LanguageRegion}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Text="{v:Translate Settings_Language}" Style="{StaticResource FieldLabel}" Margin="0" />
                    <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                            SemanticProperties.Description="{v:Translate Settings_Language}" />

                    <Label Text="{v:Translate Settings_Calendar}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}"
                            SemanticProperties.Description="{v:Translate Settings_Calendar}" />
                    <Label Text="{Binding CalendarPreview}" Style="{StaticResource Secondary}" />

                    <Label Text="{v:Translate Settings_Region}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                            SemanticProperties.Description="{v:Translate Settings_Region}" />
                    <Label Text="{v:Translate Settings_RegionHint}" Style="{StaticResource Secondary}" />

                    <Label Text="{v:Translate Settings_WeekStart}" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding WeekStarts}" SelectedItem="{Binding SelectedWeekStart}"
                            SemanticProperties.Description="{v:Translate Settings_WeekStart}" />
                </VerticalStackLayout>
            </Border>

            <!-- Money and months: what every total and budget is counted in (D-39) -->
            <Label Text="{v:Translate Settings_MoneyMonths}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <!-- Three separate defaults (ZEX-P01): changing one never changes another or any stored amount -->
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{v:Translate Settings_DefaultCurrency}" Style="{StaticResource FieldLabel}" Margin="0" />
                        <v:HelpButton Topic="DefaultCurrency" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource FieldBox}">
                        <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding DefaultCurrency, Mode=TwoWay}"
                            SemanticProperties.Description="{v:Translate Settings_DefaultCurrency}" />
                    </Border>
                    <Label Text="{v:Translate Settings_DefaultCurrencyHint}" Style="{StaticResource Secondary}" IsVisible="{Binding DefaultCurrencyChanged}" />

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{v:Translate Settings_DefaultAccount}" Style="{StaticResource FieldLabel}" />
                        <v:HelpButton Topic="DefaultAccount" Margin="0,8,0,0" />
                    </HorizontalStackLayout>
                    <Picker ItemsSource="{Binding DefaultAccounts}" SelectedItem="{Binding DefaultAccount}"
                            SemanticProperties.Description="{v:Translate Settings_DefaultAccount}" />

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{v:Translate Settings_ReportCurrency}" Style="{StaticResource FieldLabel}" />
                        <v:HelpButton Topic="ReportCurrency" Margin="0,8,0,0" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource FieldBox}">
                        <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding ReportCurrency, Mode=TwoWay}"
                            SemanticProperties.Description="{v:Translate Settings_ReportCurrency}" />
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding IsAdvanced}">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="{v:Translate Settings_ShowConverted}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ValuationEnabled}" SemanticProperties.Description="{v:Translate Settings_ShowConverted}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{v:Translate Settings_RateFreshness}" Style="{StaticResource FieldLabel}" />
                            <v:HelpButton Topic="RateFreshness" Margin="0,8,0,0" />
                        </HorizontalStackLayout>
                        <Picker ItemsSource="{Binding FreshnessNames}" SelectedIndex="{Binding FreshnessIndex}"
                                SemanticProperties.Description="{v:Translate Settings_RateFreshness}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{v:Translate Settings_MonthStart}" Style="{StaticResource FieldLabel}" />
                        <v:HelpButton Topic="MonthStartDay" Margin="0,8,0,0" />
                    </HorizontalStackLayout>
                    <Picker ItemsSource="{Binding StartDayNames}" SelectedIndex="{Binding StartDayIndex}"
                            SemanticProperties.Description="{v:Translate Settings_MonthStart}" />
                    <Label Text="{v:Translate Settings_MonthStartHint}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Appearance (UX-08, D-22, D-27) -->
            <Label Text="{v:Translate Theme_Title}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <v:ChoiceChips ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding IsPersian}">
                        <Label Text="{v:Translate Settings_PersianDigits}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PersianDigits}" SemanticProperties.Description="{v:Translate Settings_PersianDigits}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Experience (UX-01) -->
            <HorizontalStackLayout Spacing="6">
                <Label Text="{v:Translate Settings_Experience}" Style="{StaticResource SectionHeader}" />
                <v:HelpButton Topic="Mode" Margin="0,12,0,0" />
            </HorizontalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <v:ChoiceChips ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" />
                    <Label Text="{v:Translate Mode_Hint}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Privacy and security (SEC-01..03) -->
            <Label Text="{v:Translate Settings_Security}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding LockAvailable}">
                        <Label Text="{v:Translate Lock_Setting}" VerticalOptions="Center" />
                        <v:HelpButton Grid.Column="1" Topic="AppLock" />
                        <Switch x:Name="LockSwitch" Grid.Column="2" IsToggled="{Binding LockEnabled}" OnColor="{DynamicResource Primary}" Toggled="OnLockToggled" />
                    </Grid>
                    <Label Text="{v:Translate Lock_NotAvailableHint}" Style="{StaticResource Secondary}"
                           IsVisible="{Binding LockAvailable, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label Text="{v:Translate Lock_Hint}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Notifications (REM-01, REM-03, REM-05) -->
            <Label Text="{v:Translate Settings_Notifications}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{v:Translate Reminder_NotOnThisDevice}" Style="{StaticResource Secondary}"
                           IsVisible="{Binding NotificationsSupported, Converter={StaticResource InvertedBoolConverter}}" />
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding NotificationsSupported}">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding NotificationsEnabled, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{v:Translate Reminder_PermissionDenied}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{v:Translate Settings_Enable}" Command="{Binding EnableNotificationsCommand}"
                                    BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontAttributes="Bold" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{v:Translate Settings_ShowDetails}" VerticalOptions="Center" />
                            <v:HelpButton Grid.Column="1" Topic="NotificationDetails" />
                            <Switch Grid.Column="2" IsToggled="{Binding ShowDetails}" OnColor="{DynamicResource Primary}" />
                        </Grid>
                        <Label Text="{v:Translate Settings_ShowDetailsHint}" Style="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                    <Label Text="{v:Translate Settings_ReminderDefaults}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                        <Entry Text="{Binding ReminderDaysText}" Keyboard="Numeric" HorizontalTextAlignment="Center"
                               SemanticProperties.Description="{v:Translate Plan_DaysBefore}" />
                        <Label Grid.Column="1" Text="{v:Translate Plan_DaysBefore}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{v:Translate Plan_ReminderTime}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <TimePicker Time="{Binding ReminderTime}" HorizontalOptions="Start" SemanticProperties.Description="{v:Translate Plan_ReminderTime}" />
                </VerticalStackLayout>
            </Border>


            <Label Text="{v:Translate Settings_DangerZone}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{v:Translate Settings_DeleteAllHint}" Style="{StaticResource Secondary}" />
                    <Button Text="{v:Translate Settings_DeleteAll}" Command="{Binding DeleteAllDataCommand}" BackgroundColor="Transparent"
                            TextColor="{DynamicResource ExpenseText}" BorderColor="{DynamicResource ExpenseText}" BorderWidth="1" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

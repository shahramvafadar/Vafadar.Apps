<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Reports.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:home="clr-namespace:Vafadar.Zanance.App.Features.Home"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Reports"
    x:DataType="local:ReportsViewModel"
    Title="{v:Translate Report_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Period and report -->
            <v:ChoiceChips IsCompact="True" ItemsSource="{Binding ReportNames}" SelectedIndex="{Binding ReportIndex}" />
            <Grid ColumnDefinitions="48,*,48,Auto">
                <Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="{v:Translate Budget_PreviousMonth}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                    </Border.GestureRecognizers>
                    <fi:SymbolIcon Symbol="{Binding PreviousIcon}" FontSize="22" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{Binding PeriodText}" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="{v:Translate Budget_NextMonth}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextCommand}" />
                    </Border.GestureRecognizers>
                    <fi:SymbolIcon Symbol="{Binding NextIcon}" FontSize="22" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <v:ChoiceChips Grid.Column="3" IsCompact="True" ItemsSource="{Binding PeriodKindNames}" SelectedIndex="{Binding PeriodKind}"
                               VerticalOptions="Center" />
            </Grid>

            <!-- Nothing recorded yet: one empty state with the way out, like the other lists (UX-05) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowEmpty}">
                <VerticalStackLayout Spacing="12">
                    <fi:SymbolIcon Symbol="DataPie" FontSize="36" ForegroundColor="{DynamicResource Muted}" HorizontalOptions="Center" />
                    <Label Text="{v:Translate Report_Empty}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Tx_Add}" Command="{Binding AddEntryCommand}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="{v:Translate Report_SharePdf}" Command="{Binding SharePdfCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="Transparent"
                    TextColor="{DynamicResource Primary}" HorizontalOptions="End" Padding="8,0"
                    IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Expenses by category: gross chart, refunds card, net table (REP-02) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowExpenses}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{v:Translate Report_GrossByCategory}" Style="{StaticResource Secondary}" />
                        <Label Text="{v:Translate Home_NoExpenses}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasSlices, Converter={StaticResource InvertedBoolConverter}}" />
                        <Grid IsVisible="{Binding HasSlices}">
                            <chart:SfCircularChart HeightRequest="220" FlowDirection="LeftToRight"
                                               SemanticProperties.Description="{v:Translate Report_GrossByCategory}">
                            <chart:DoughnutSeries ItemsSource="{Binding Slices}" XBindingPath="Name" YBindingPath="Value"
                                                  PaletteBrushes="{Binding SliceBrushes}" InnerRadius="0.6" StrokeWidth="2" EnableTooltip="True" Stroke="{DynamicResource CardBackground}" />
                        </chart:SfCircularChart>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" Spacing="0">
                                <Label Text="{v:Translate Chart_Total}" Style="{StaticResource Secondary}" FontSize="12" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding SliceTotalText}" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding CurrencyNote}" Style="{StaticResource Secondary}" FontSize="12"
                               IsVisible="{Binding CurrencyNote, Converter={StaticResource IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding RefundsText, Converter={StaticResource IsNotNullConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenExpensesCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding RefundsText}" TextColor="{DynamicResource RefundText}" />
                </Border>

                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,4">
                            <Label Text="{v:Translate Entry_Category}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="1" Text="{v:Translate Report_Net}" Style="{StaticResource Secondary}" FontSize="12" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryReportRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Padding="0,6">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCategoryCommand, Source={RelativeSource AncestorType={x:Type local:ReportsViewModel}}, x:DataType=local:ReportsViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding Color}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Text="{Binding NetText}" VerticalOptions="Center" FontAttributes="Bold" TextColor="{Binding NetColor}" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DetailText}" Style="{StaticResource Secondary}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Income and expense -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowIncomeExpense}">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomeExpenseLines}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:AmountLine">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Label}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Amount}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                                <Setter Property="FontSize" Value="17" />
                                            </DataTrigger>                                            <DataTrigger TargetType="Label" Binding="{Binding IsPositive}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource IncomeText}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate KindFilter_Income}" Command="{Binding OpenIncomeCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Text="{v:Translate KindFilter_Expenses}" Command="{Binding OpenExpensesCommand}" />
                    </Grid>
                    <Label Text="{v:Translate Report_BalanceHint}" Style="{StaticResource Secondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Trend -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowTrend}">
                <Border Style="{StaticResource Card}">
                    <chart:SfCartesianChart HeightRequest="240" FlowDirection="LeftToRight" SemanticProperties.Description="{v:Translate Report_Trend}">
                        <chart:SfCartesianChart.Legend>
                            <chart:ChartLegend>
                                <chart:ChartLegend.LabelStyle>
                                    <chart:ChartLegendLabelStyle TextColor="{DynamicResource SecondaryText}" />
                                </chart:ChartLegend.LabelStyle>
                            </chart:ChartLegend>
                        </chart:SfCartesianChart.Legend>
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis LabelRotation="0" LabelCreated="OnAxisLabelCreated">
                                    <chart:CategoryAxis.MajorGridLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource DividerColor}" StrokeWidth="1" />
                                    </chart:CategoryAxis.MajorGridLineStyle>
                                    <chart:CategoryAxis.AxisLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource StrokeStrong}" StrokeWidth="1" />
                                    </chart:CategoryAxis.AxisLineStyle>
                                    <chart:CategoryAxis.MajorTickStyle>
                                        <chart:ChartAxisTickStyle Stroke="{DynamicResource StrokeStrong}" />
                                    </chart:CategoryAxis.MajorTickStyle>
                                    <chart:CategoryAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="11" />
                                    </chart:CategoryAxis.LabelStyle>                                </chart:CategoryAxis>
                        </chart:SfCartesianChart.XAxes>
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis LabelCreated="OnAxisLabelCreated">
                                    <chart:NumericalAxis.MajorGridLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource DividerColor}" StrokeWidth="1" />
                                    </chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:NumericalAxis.AxisLineStyle>
                                        <chart:ChartLineStyle Stroke="{DynamicResource StrokeStrong}" StrokeWidth="1" />
                                    </chart:NumericalAxis.AxisLineStyle>
                                    <chart:NumericalAxis.MajorTickStyle>
                                        <chart:ChartAxisTickStyle Stroke="{DynamicResource StrokeStrong}" />
                                    </chart:NumericalAxis.MajorTickStyle>
                                    <chart:NumericalAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle TextColor="{DynamicResource SecondaryText}" FontSize="11" />
                                    </chart:NumericalAxis.LabelStyle>                                </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>
                        <chart:ColumnSeries ItemsSource="{Binding Trend}" XBindingPath="Label" YBindingPath="Income" Fill="{DynamicResource IncomeText}"
                                            Label="{v:Translate KindFilter_Income}" />
                        <chart:ColumnSeries ItemsSource="{Binding Trend}" XBindingPath="Label" YBindingPath="Expense" Fill="{DynamicResource Muted}"
                                            Label="{v:Translate KindFilter_Expenses}" />
                    </chart:SfCartesianChart>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="0">
                    <!-- Column titles, so the three amounts of a row read as income, expenses and result -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,4">
                        <Label Text="{v:Translate Report_Month}" Style="{StaticResource Secondary}" FontSize="12" />
                        <Label Grid.Column="1" Text="{v:Translate KindFilter_Income}" Style="{StaticResource Secondary}" FontSize="12" />
                        <Label Grid.Column="2" Text="{v:Translate KindFilter_Expenses}" Style="{StaticResource Secondary}" FontSize="12" />
                        <Label Grid.Column="3" Text="{v:Translate Home_Result}" Style="{StaticResource Secondary}" FontSize="12" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trend}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:TrendPoint">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="36">
                                    <Label Text="{Binding Label}" VerticalOptions="Center" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding IncomeText}" TextColor="{DynamicResource IncomeText}" VerticalOptions="Center" FontSize="13" />
                                    <Label Grid.Column="2" Text="{Binding ExpenseText}" VerticalOptions="Center" FontSize="13" />
                                    <Label Grid.Column="3" Text="{Binding ResultText}" TextColor="{Binding ResultColor}" FontAttributes="Bold" VerticalOptions="Center" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Report_PartialHint}" Style="{StaticResource Secondary}" FontSize="12" />
            </VerticalStackLayout>

            <!-- Account movement (REP-03) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowAccounts}" BindableLayout.ItemsSource="{Binding Accounts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountReport">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:AmountLine">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Label}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Amount}" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsTotal}" Value="True">
                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                        </DataTrigger>                                                        <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                                                            <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Spending by tag (F2-TX-04) -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowTags}">
                <Label Text="{v:Translate Report_NoTags}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" Margin="0,16"
                       IsVisible="{Binding HasTagRows, Converter={StaticResource InvertedBoolConverter}}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasTagRows}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TagRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:TagReportRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenTagCommand, Source={RelativeSource AncestorType={x:Type local:ReportsViewModel}}, x:DataType=local:ReportsViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="16" />
                                        <Label Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{v:Translate Report_TagsNote}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding HasTagRows}" />
            </VerticalStackLayout>

            <!-- Plan versus actual -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowPlans}">
                <Label Text="{v:Translate Report_NoPlans}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" Margin="0,16"
                       IsVisible="{Binding HasPlanRows, Converter={StaticResource InvertedBoolConverter}}" />
                <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding HasPlanRows}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="0,0,0,6">
                            <Label Text="{v:Translate Plan_Name}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="1" Text="{v:Translate Report_Planned}" Style="{StaticResource Secondary}" FontSize="12" />
                            <Label Grid.Column="2" Text="{v:Translate Report_Actual}" Style="{StaticResource Secondary}" FontSize="12" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:PlanReportRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="0,6">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" />
                                            <Label Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding PlannedText}" VerticalOptions="Center" FontSize="13" />
                                        <Label Grid.Column="2" Text="{Binding ActualText}" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

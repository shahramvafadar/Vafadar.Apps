<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Profiles.ProfilesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Profiles"
    x:DataType="local:ProfilesViewModel"
    Title="{v:Translate Profile_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="{v:Translate Profile_Intro}" Style="{StaticResource Secondary}" />

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Profiles}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ProfileRow">
                            <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" SemanticProperties.Description="{Binding Name}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseCommand, Source={RelativeSource AncestorType={x:Type local:ProfilesViewModel}}, x:DataType=local:ProfilesViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <fi:SymbolIcon Symbol="Person" FontSize="22" ForegroundColor="{DynamicResource Primary}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="16" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Secondary}" IsVisible="{Binding Detail, Converter={StaticResource IsNotNullConverter}}" />
                                </VerticalStackLayout>
                                <fi:SymbolIcon Grid.Column="2" Symbol="Checkmark" FontSize="20" ForegroundColor="{DynamicResource Primary}" VerticalOptions="Center"
                                               IsVisible="{Binding IsCurrent}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" />
            <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Profile_Add}" Command="{Binding AddCommand}" />
            <Label Text="{v:Translate Profile_Note}" Style="{StaticResource Secondary}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

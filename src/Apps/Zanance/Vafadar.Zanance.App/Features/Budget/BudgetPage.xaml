<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Budget.BudgetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Budget"
    xmlns:reports="clr-namespace:Vafadar.Zanance.App.Features.Reports"
    xmlns:progress="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    x:DataType="local:BudgetViewModel"
    Title="{v:Translate Budget_Title}">

    <ContentPage.Resources>
        <DataTemplate x:Key="LineTemplate" x:DataType="local:BudgetLine">
            <VerticalStackLayout Spacing="6" Padding="0,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding SpentText}" FontAttributes="Bold" />
                        <Label Text="{Binding LimitText}" Style="{StaticResource Secondary}" />
                    </HorizontalStackLayout>
                </Grid>
                <progress:SfLinearProgressBar Progress="{Binding Progress}" ProgressFill="{Binding ProgressColor}" />
                <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" />
                <Label Text="{Binding CarryText}" Style="{StaticResource Secondary}" FontSize="12" IsVisible="{Binding CarryText, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Period length (§10.3, Advanced): month, week or two weeks -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsAdvanced}">
                <v:ChoiceChips IsCompact="True" ItemsSource="{Binding PeriodNames}" SelectedIndex="{Binding PeriodIndex}" />
                <v:HelpButton Grid.Column="1" Topic="BudgetPeriod" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsTwoWeeks}">
                <Label Text="{v:Translate Budget_FortnightStart}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                <v:HelpButton Grid.Column="1" Topic="FortnightStart" />
                <v:DateField Grid.Column="2" Date="{Binding FortnightStart}" SemanticProperties.Description="{v:Translate Budget_FortnightStart}" />
            </Grid>

            <!-- Period -->
            <Grid ColumnDefinitions="48,*,48">
                <Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="{Binding PreviousLabel}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                    </Border.GestureRecognizers>
                    <fi:SymbolIcon Symbol="{Binding PreviousIcon}" FontSize="22" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding PeriodText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CurrencyText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ScopeText}" TextColor="{DynamicResource WarningText}" FontSize="13" HorizontalTextAlignment="Center"
                           IsVisible="{Binding ScopeText, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="48" SemanticProperties.Description="{Binding NextLabel}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextCommand}" />
                    </Border.GestureRecognizers>
                    <fi:SymbolIcon Symbol="{Binding NextIcon}" FontSize="22" ForegroundColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- No budget is not a zero budget (BUD-01) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasBudget, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="12">
                    <fi:SymbolIcon Symbol="Target" FontSize="40" HorizontalOptions="Center" ForegroundColor="{DynamicResource Muted}" />
                    <Label Text="{v:Translate Budget_None}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Budget_Create}" Command="{Binding EditCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Budget_CopyPrevious}" Command="{Binding CopyPreviousCommand}"
                            IsVisible="{Binding CanCopyPrevious}" />
                </VerticalStackLayout>
            </Border>

            <!-- Envelopes (§10.3, BUD-11/12): money at hand not yet assigned to an envelope or a goal -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEnvelopes}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{v:Translate Envelope_Unassigned}" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding UnassignedText}" Style="{StaticResource AmountLarge}" TextColor="{Binding UnassignedColor}"
                           IsVisible="{Binding UnassignedText, Converter={StaticResource IsNotNullConverter}}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EnvelopeLines}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="reports:AmountLine">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Label}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Amount}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding EnvelopeNote}" TextColor="{DynamicResource WarningText}" FontSize="13"
                           IsVisible="{Binding EnvelopeNote, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{v:Translate Envelope_Hint}" Style="{StaticResource Secondary}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Overall limit -->
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding HasTotal}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TotalLines}" BindableLayout.ItemTemplate="{StaticResource LineTemplate}" />
            </Border>

            <!-- Flex (D-28): bills are expected from the plans, the limit above is for flexible spending only -->
            <Label Text="{v:Translate Flex_Bills}" Style="{StaticResource SectionHeader}" IsVisible="{Binding IsFlex}" />
            <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsFlex}">
                <VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FlexLines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FlexLine">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*" BackgroundColor="Transparent">
                                    <Border Style="{StaticResource IconTile}" BackgroundColor="{Binding TileBackground}" Stroke="{Binding TileStroke}">
                                        <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding IconColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                        <Label Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" />
                    <VerticalStackLayout Padding="16,10" Spacing="4">
                        <Label Text="{Binding FlexTotalText}" FontAttributes="Bold" />
                        <Label Text="{v:Translate Flex_Hint}" Style="{StaticResource Secondary}" FontSize="12" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Category limits: an analysis of the same expenses, never added to the total (AT-40) -->
            <Label Text="{Binding CategoriesHeader}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasCategoryLines}" />
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding HasCategoryLines}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryLines}" BindableLayout.ItemTemplate="{StaticResource LineTemplate}" />
            </Border>

            <!-- Unreviewed entries are visible in the numbers (BUD-04) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasBudget}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{v:Translate Budget_ConfirmedOnly}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ConfirmedOnly}" OnColor="{DynamicResource Primary}" />
                    </Grid>
                    <Label Text="{Binding UnreviewedText}" TextColor="{DynamicResource WarningText}"
                           IsVisible="{Binding UnreviewedText, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Plans of this month -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding PlannedText, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PlannedText}" />
                    <Label Text="{Binding EquivalentText}" Style="{StaticResource Secondary}"
                           IsVisible="{Binding EquivalentText, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasBudget}" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Edit}" Command="{Binding EditCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Text="{v:Translate Budget_CopyNext}" Command="{Binding CopyToNextCommand}" />
                <Button Text="{v:Translate Budget_Delete}" Command="{Binding DeleteCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource ExpenseText}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

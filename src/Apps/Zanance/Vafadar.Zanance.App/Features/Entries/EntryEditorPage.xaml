<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Entries.EntryEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Entries"
    xmlns:ledger="clr-namespace:Vafadar.Zanance.Core.Ledger;assembly=Vafadar.Zanance.Core"
    x:DataType="local:EntryEditorViewModel"
    Title="{Binding Title}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Padding="8,8" ColumnDefinitions="Auto,*" BackgroundColor="{DynamicResource CardBackground}">
            <Button Text="{v:Translate Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource TextButton}" />
            <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
        </Grid>

        <!-- No account yet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16" VerticalOptions="Start" IsVisible="{Binding HasNoAccounts}">
            <VerticalStackLayout Spacing="12">
                <fi:SymbolIcon Symbol="Wallet" FontSize="40" HorizontalOptions="Center" ForegroundColor="{DynamicResource Muted}" />
                <Label Text="{v:Translate Entry_NoAccounts}" HorizontalTextAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Accounts_Add}" Command="{Binding AddAccountCommand}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" IsVisible="{Binding HasNoAccounts, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">

                <!-- Values read from a receipt, waiting for review (D-31) -->
                <Border BackgroundColor="{DynamicResource RefundBackground}" Stroke="{DynamicResource RefundLine}" StrokeShape="RoundRectangle 14" Padding="14,10"
                        IsVisible="{Binding ReceiptNote, Converter={StaticResource IsNotNullConverter}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <fi:SymbolIcon Symbol="ScanText" FontSize="20" ForegroundColor="{DynamicResource RefundText}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ReceiptNote}" TextColor="{DynamicResource RefundText}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Quick templates (TX-04), new entries only -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasTemplates}">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding TemplateChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:TemplateChip">
                                <!-- The same pill as on Home: category icon and name -->
                                <Grid>
                                    <Border Style="{StaticResource TemplatePill}">
                                        <HorizontalStackLayout Spacing="6">
                                            <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="16" ForegroundColor="{Binding IconColor}" VerticalOptions="Center" />
                                            <Label Text="{Binding Template.Name}" FontSize="13.5" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Button Style="{StaticResource OverlayButton}" CornerRadius="20"
                                            Command="{Binding ApplyTemplateCommand, Source={RelativeSource AncestorType={x:Type local:EntryEditorViewModel}}, x:DataType=local:EntryEditorViewModel}"
                                            CommandParameter="{Binding Template}" SemanticProperties.Description="{Binding Template.Name}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Kind and amount -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <v:ChoiceChips ItemsSource="{Binding KindNames}" SelectedIndex="{Binding KindIndex}"
                                       IsVisible="{Binding CanChangeKind}" SemanticProperties.Description="{v:Translate Entry_Kind}" />
                        <Label Text="{Binding FixedKindText}" FontAttributes="Bold" FontSize="16"
                               IsVisible="{Binding FixedKindText, Converter={StaticResource IsNotNullConverter}}" />
                        <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8"
                                IsVisible="{Binding RefundInfo, Converter={StaticResource IsNotNullConverter}}">
                            <Label Text="{Binding RefundInfo}" TextColor="{DynamicResource WarningText}" />
                        </Border>

                        <Label Text="{v:Translate Entry_Amount}" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="AmountEntry" Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="0" FontSize="28" FontAttributes="Bold"
                                   SemanticProperties.Description="{v:Translate Entry_Amount}" />
                            <Label Grid.Column="1" Text="{Binding CurrencyCode, Converter={StaticResource CurrencyUnitConverter}}" FontSize="18" VerticalOptions="Center" Style="{StaticResource Secondary}" />
                        </Grid>
                        <Label Text="{Binding AmountError}" Style="{StaticResource ErrorText}"
                               IsVisible="{Binding AmountError, Converter={StaticResource IsNotNullConverter}}" />

                        <!-- The account sits directly under the amount, always visible (ZEX-S0103) -->
                        <Label Text="{v:Translate Entry_Account}" Style="{StaticResource FieldLabel}"
                               IsVisible="{Binding IsTransfer, Converter={StaticResource InvertedBoolConverter}}" />
                        <Label Text="{v:Translate Entry_FromAccount}" Style="{StaticResource FieldLabel}" IsVisible="{Binding IsTransfer}" />
                        <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"
                                SemanticProperties.Description="{v:Translate Entry_Account}" />
                        <Label Text="{v:Translate Entry_ChooseAccount}" TextColor="{DynamicResource WarningText}" FontAttributes="Bold"
                               IsVisible="{Binding NeedsAccount}" SemanticProperties.Description="{v:Translate Entry_ChooseAccount}" />
                        <Label Text="{Binding AccountNotice}" TextColor="{DynamicResource WarningText}"
                               IsVisible="{Binding AccountNotice, Converter={StaticResource IsNotNullConverter}}" />
                        <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,6"
                                IsVisible="{Binding CurrencyNotice, Converter={StaticResource IsNotNullConverter}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding CurrencyNotice}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center"
                                       SemanticProperties.Description="{Binding CurrencyNotice}" />
                                <Button Grid.Column="1" Text="{v:Translate Entry_UndoAccountChange}" Command="{Binding UndoAccountChangeCommand}" Style="{StaticResource TextButton}" />
                            </Grid>
                        </Border>
                        <Label Text="{v:Translate Entry_TransferHint}" Style="{StaticResource Secondary}" IsVisible="{Binding IsTransfer}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Category grid -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowCategories}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding RuleHint, Converter={StaticResource IsNotNullConverter}}">
                            <Label Text="{Binding RuleHint}" Style="{StaticResource Secondary}" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{v:Translate Common_Undo}" Command="{Binding UndoSuggestionCommand}" Style="{StaticResource TextButton}" />
                        </Grid>
                        <Label Text="{v:Translate Entry_Category}" Style="{StaticResource FieldLabel}" Margin="4,0" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryChoice">
                                    <!-- A real button over the chip: reachable with the keyboard and announced as a button -->
                                    <Grid Margin="0,0,8,8">
                                        <Border Padding="4,4,14,4" StrokeThickness="1.5" Stroke="{Binding Outline}"
                                                StrokeShape="RoundRectangle 22" BackgroundColor="{Binding Fill}" MinimumHeightRequest="44">
                                            <HorizontalStackLayout Spacing="8">
                                                <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                                        BackgroundColor="{Binding Background}" VerticalOptions="Center">
                                                    <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="18" ForegroundColor="{Binding Color}"
                                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Button Style="{StaticResource OverlayButton}" CornerRadius="22"
                                                Command="{Binding SelectCategoryCommand, Source={RelativeSource AncestorType={x:Type local:EntryEditorViewModel}}, x:DataType=local:EntryEditorViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Title, date and accounts -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Entry_Title}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Entry Text="{Binding EntryTitle}" Placeholder="{v:Translate Entry_TitlePlaceholder}" MaxLength="120"
                               SemanticProperties.Description="{v:Translate Entry_Title}" />

                        <Label Text="{v:Translate Entry_Date}" Style="{StaticResource FieldLabel}" />
                        <v:DateField Date="{Binding Date}" />

                        <VerticalStackLayout IsVisible="{Binding IsTransfer}">
                            <Label Text="{v:Translate Entry_ToAccount}" Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding ToAccounts}" SelectedItem="{Binding ToAccount}" SemanticProperties.Description="{v:Translate Entry_ToAccount}" />

                            <VerticalStackLayout IsVisible="{Binding ShowToAmount}">
                                <Label Text="{Binding ToAmountLabel}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ToAmountText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{Binding ToAmountLabel}" />
                                <Label Text="{Binding ImpliedRateText}" Style="{StaticResource Secondary}"
                                       IsVisible="{Binding ImpliedRateText, Converter={StaticResource IsNotNullConverter}}" />
                            </VerticalStackLayout>

                            <Label Text="{v:Translate Entry_Fee}" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Text="{Binding FeeText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{v:Translate Entry_Fee}" />
                                <Label Grid.Column="1" Text="{Binding CurrencyCode, Converter={StaticResource CurrencyUnitConverter}}" VerticalOptions="Center" Style="{StaticResource Secondary}" />
                            </Grid>
                            <Label Text="{v:Translate Entry_FeeHint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />

                            <!-- A fee charged at the destination, in its currency (Advanced, ZEX-S0204) -->
                            <VerticalStackLayout IsVisible="{Binding ShowDestinationFee}">
                                <Label Text="{v:Translate Entry_DestinationFee}" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding DestinationFeeText}" Keyboard="Numeric" Placeholder="0" SemanticProperties.Description="{v:Translate Entry_DestinationFee}" />
                                    <Label Grid.Column="1" Text="{Binding ToCurrencyCode, Converter={StaticResource CurrencyUnitConverter}}" VerticalOptions="Center" Style="{StaticResource Secondary}" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- More details -->
                <Button Text="{v:Translate Entry_MoreDetails}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDetails}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{v:Translate Entry_Payee}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Entry Text="{Binding Payee}" MaxLength="120" SemanticProperties.Description="{v:Translate Entry_Payee}" />

                        <!-- Tags (F2-TX-04) -->
                        <Label Text="{v:Translate Entry_Tags}" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding TagsText}" Placeholder="{v:Translate Entry_TagsPlaceholder}" MaxLength="320"
                               SemanticProperties.Description="{v:Translate Entry_Tags}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TagSuggestions}" Margin="0,4,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Text="{Binding ., StringFormat='+ {0}'}" FontSize="13" Padding="12,0" HeightRequest="40" MinimumHeightRequest="40" Margin="0,0,6,6" CornerRadius="20"
                                            BackgroundColor="{DynamicResource PageBackground}" TextColor="{DynamicResource Primary}"
                                            Command="{Binding AddTagCommand, Source={RelativeSource AncestorType={x:Type local:EntryEditorViewModel}}, x:DataType=local:EntryEditorViewModel}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Reimbursable (F2-TX-03) -->
                        <VerticalStackLayout IsVisible="{Binding IsExpense}" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{v:Translate Entry_Reimbursable}" VerticalOptions="Center" />
                                <v:HelpButton Grid.Column="1" Topic="Reimbursable" />
                                <Switch Grid.Column="2" IsToggled="{Binding ReimbursableEnabled}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Entry_Reimbursable}" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding ReimbursableEnabled}" Spacing="0">
                                <Label Text="{v:Translate Entry_ReimbursableAmount}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ReimbursableText}" Keyboard="Numeric" Placeholder="{v:Translate Entry_ReimbursableAll}"
                                       SemanticProperties.Description="{v:Translate Entry_ReimbursableAmount}" />
                                <Label Text="{v:Translate Entry_ReimbursedBy}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ReimbursedBy}" MaxLength="120" Placeholder="{v:Translate Entry_ReimbursedByPlaceholder}"
                                       SemanticProperties.Description="{v:Translate Entry_ReimbursedBy}" />
                                <!-- An optional day the money is expected back (ZEX-K12) -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <Label Text="{v:Translate Entry_ReimbursementDue}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding HasReimbursementDue}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Entry_ReimbursementDue}" />
                                </Grid>
                                <v:DateField Date="{Binding ReimbursementDue}" IsVisible="{Binding HasReimbursementDue}" />
                                <Label Text="{v:Translate Entry_ReimbursableHint}" Style="{StaticResource Secondary}" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Aggregated entry (ZEX-P21, Advanced): sums up several purchases of a range; overlaps are asked for on save -->
                        <VerticalStackLayout IsVisible="{Binding CanAggregate}" Margin="0,12,0,0" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{v:Translate Entry_Aggregated}" VerticalOptions="Center" />
                                <v:HelpButton Grid.Column="1" Topic="Aggregated" />
                                <Switch Grid.Column="2" IsToggled="{Binding IsAggregated}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Entry_Aggregated}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsAggregated}">
                                <VerticalStackLayout>
                                    <Label Text="{v:Translate Entry_AggregatedFrom}" Style="{StaticResource FieldLabel}" />
                                    <v:DateField Date="{Binding AggregatedFrom}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{v:Translate Entry_AggregatedTo}" Style="{StaticResource FieldLabel}" />
                                    <v:DateField Date="{Binding AggregatedTo}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <Label Text="{v:Translate Entry_Note}" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="2000"
                                SemanticProperties.Description="{v:Translate Entry_Note}" />

                        <VerticalStackLayout IsVisible="{Binding ShowCategories}">
                            <Label Text="{v:Translate Entry_Icon}" Style="{StaticResource FieldLabel}" />
                            <p:IconPicker SelectedKey="{Binding IconKey}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsTransfer, Converter={StaticResource InvertedBoolConverter}}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
                                <Label Text="{v:Translate Entry_Foreign}" VerticalOptions="Center" />
                                <v:HelpButton Grid.Column="1" Topic="ForeignAmount" />
                                <Switch Grid.Column="2" IsToggled="{Binding ForeignEnabled}" OnColor="{DynamicResource Primary}" SemanticProperties.Description="{v:Translate Entry_Foreign}" />
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding ForeignEnabled}">
                                <Label Text="{v:Translate Entry_ForeignAmount}" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                                    <Entry Text="{Binding ForeignAmountText}" Keyboard="Numeric" Placeholder="0"
                                           SemanticProperties.Description="{v:Translate Entry_ForeignAmount}" />
                                    <Border Style="{StaticResource FieldBox}" Grid.Column="1">
                                        <inputs:SfComboBox Style="{StaticResource CurrencyBox}" ItemsSource="{Binding CurrencyCodes}" SelectedItem="{Binding ForeignCurrency, Mode=TwoWay}"
                                            SemanticProperties.Description="{v:Translate Account_Currency}" />
                                    </Border>
                                </Grid>
                                <Label Text="{v:Translate Entry_ForeignHint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding SaveError}" Style="{StaticResource ErrorText}"
                       IsVisible="{Binding SaveError, Converter={StaticResource IsNotNullConverter}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- What saving does, said before Save (ZEX-S0103, S0204); Save waits for an account -->
        <VerticalStackLayout Grid.Row="2" Padding="16,8,16,16" Spacing="6"
                             IsVisible="{Binding HasNoAccounts, Converter={StaticResource InvertedBoolConverter}}">
            <Label Text="{Binding EffectText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center"
                   IsVisible="{Binding EffectText, Converter={StaticResource IsNotNullConverter}}" SemanticProperties.Description="{Binding EffectText}" />
            <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Save}"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            <Label Text="{v:Translate Entry_ChooseAccount}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" FontSize="12"
                   IsVisible="{Binding NeedsAccount}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vafadar.Zanance.App.Features.Entries.EntryDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Entries"
    x:DataType="local:EntryDetailViewModel"
    Title="{v:Translate Entry_Details}">

    <Grid>
        <Label Text="{v:Translate Entry_NotFound}" Margin="32" HorizontalTextAlignment="Center" IsVisible="{Binding NotFound}" />

        <ScrollView IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="8">

                <!-- Summary -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 28"
                                BackgroundColor="{Binding IconBackground}" HorizontalOptions="Center">
                            <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="30" ForegroundColor="{Binding IconColor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding Heading}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding KindText}" Style="{StaticResource Secondary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontSize="30" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Needs review -->
                <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,8"
                        IsVisible="{Binding IsUnreviewed}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{v:Translate Tx_Unreviewed}" TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{v:Translate Entry_MarkReviewed}" Command="{Binding MarkReviewedCommand}"
                                BackgroundColor="Transparent" TextColor="{DynamicResource WarningText}" FontAttributes="Bold" />
                    </Grid>
                </Border>

                <!-- Fields -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Lines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:DetailLine">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Label}" Style="{StaticResource Secondary}"
                                           IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="{Binding Value}" FontSize="16" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding SplitText}" Style="{StaticResource Secondary}" IsVisible="{Binding SplitText, Converter={StaticResource IsNotNullConverter}}" />

                <!-- Refunds of this purchase -->
                <Label Text="{v:Translate Entry_Refunds}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasRefunds}" />
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding HasRefunds}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Refunds}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="p:EntryRow">
                                <Grid Style="{StaticResource ListRow}" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Subtitle}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding AmountText}" TextColor="{Binding AmountColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <!-- The whole row is one real button: keyboard, screen readers and touch -->
                                    <Button Grid.ColumnSpan="2" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                            Command="{Binding OpenRefundCommand, Source={RelativeSource AncestorType={x:Type local:EntryDetailViewModel}}, x:DataType=local:EntryDetailViewModel}"
                                            CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Subtitle}" SemanticProperties.Hint="{Binding AmountText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="{DynamicResource WarningBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,8"
                        IsVisible="{Binding ReimbursementText, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ReimbursementText}" TextColor="{DynamicResource WarningText}" />
                        <Button Text="{v:Translate Entry_RecordReimbursement}" Command="{Binding RecordReimbursementCommand}" IsVisible="{Binding CanRecordReimbursement}"
                                BackgroundColor="Transparent" TextColor="{DynamicResource WarningText}" FontAttributes="Bold" HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding RefundableText}" Style="{StaticResource Secondary}"
                       IsVisible="{Binding RefundableText, Converter={StaticResource IsNotNullConverter}}" />

                <!-- Receipts and documents (F2-TX-04) -->
                <Label Text="{v:Translate Attachment_Title}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attachments}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:AttachmentRow">
                                    <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Grid WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                            <Image Source="{Binding Preview}" Aspect="AspectFill" IsVisible="{Binding HasPreview}" />
                                            <fi:SymbolIcon Symbol="Document" FontSize="28" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center"
                                                           IsVisible="{Binding HasPreview, Converter={StaticResource InvertedBoolConverter}}" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" LineBreakMode="MiddleTruncation" />
                                            <Label Text="{Binding Details}" Style="{StaticResource Secondary}" />
                                        </VerticalStackLayout>
                                        <!-- Preview and name open the file; Read and Delete stay their own buttons -->
                                        <Button Grid.ColumnSpan="2" Margin="-16,-10,0,-10" Style="{StaticResource OverlayButton}" CornerRadius="0"
                                                Command="{Binding OpenAttachmentCommand, Source={RelativeSource AncestorType={x:Type local:EntryDetailViewModel}}, x:DataType=local:EntryDetailViewModel}"
                                                CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding Details}" />
                                        <Button Grid.Column="2" Style="{StaticResource TextButton}" Text="{v:Translate Receipt_Read}" IsVisible="{Binding CanRead}"
                                                Command="{Binding ReadReceiptCommand, Source={RelativeSource AncestorType={x:Type local:EntryDetailViewModel}}, x:DataType=local:EntryDetailViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="3" Text="{v:Translate Common_Delete}" BackgroundColor="Transparent" TextColor="{DynamicResource ExpenseText}"
                                                Command="{Binding DeleteAttachmentCommand, Source={RelativeSource AncestorType={x:Type local:EntryDetailViewModel}}, x:DataType=local:EntryDetailViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{v:Translate Attachment_Add}" Command="{Binding AddAttachmentCommand}" BackgroundColor="Transparent"
                                TextColor="{DynamicResource Primary}" HorizontalOptions="Start" Padding="16,8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Actions -->
                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Common_Edit}" Command="{Binding EditCommand}" Margin="0,8,0,0"
                        IsVisible="{Binding IsHoldingMoney, Converter={StaticResource InvertedBoolConverter}}" />
                <!-- The money of a holding purchase or sale is changed together with the holding (ZEX-AS14) -->
                <Label Text="{v:Translate Entry_HoldingMoney}" Style="{StaticResource Secondary}" Margin="4,8,4,0" IsVisible="{Binding IsHoldingMoney}" />
                <Button Style="{StaticResource PrimaryButton}" Text="{v:Translate Entry_OpenHolding}" Command="{Binding EditCommand}" IsVisible="{Binding IsHoldingMoney}" />
                <!-- Further actions as rows, like More: one card instead of a stack of equal buttons -->
                <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding IsHoldingMoney, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding CanRefund}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="ArrowUndo" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{v:Translate Entry_Refund}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding RefundCommand}"
                                    SemanticProperties.Description="{v:Translate Entry_Refund}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="Copy" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{v:Translate Entry_Duplicate}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding DuplicateCommand}"
                                    SemanticProperties.Description="{v:Translate Entry_Duplicate}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding CanMakeRecurring}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="ArrowRepeatAll" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{v:Translate Entry_MakeRecurring}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding MakeRecurringCommand}"
                                    SemanticProperties.Description="{v:Translate Entry_MakeRecurring}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding CanPayBack}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="ArrowReply" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{v:Translate Entry_PayBack}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding PayBackCommand}"
                                    SemanticProperties.Description="{v:Translate Entry_PayBack}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding CanSplit}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="SplitHorizontal" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding SplitActionText}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding SplitCommand}"
                                    SemanticProperties.Description="{Binding SplitActionText}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding RuleActionText, Converter={StaticResource IsNotNullConverter}}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="TextBulletList" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding RuleActionText}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding SaveRuleCommand}"
                                    SemanticProperties.Description="{Binding RuleActionText}" />
                        </Grid>
                        <Grid Style="{StaticResource ListRow}" ColumnDefinitions="Auto,*,Auto" BackgroundColor="Transparent" IsVisible="{Binding CanSaveTemplate}">
                            <Border Style="{StaticResource IconTileSmall}" BackgroundColor="{DynamicResource SurfaceMuted}" Stroke="{DynamicResource DividerColor}">
                                <fi:SymbolIcon Symbol="Flash" FontSize="17" ForegroundColor="{DynamicResource SecondaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{v:Translate Templates_SaveAction}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <fi:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="16" ForegroundColor="{DynamicResource Muted}" VerticalOptions="Center" ScaleX="{DynamicResource ReadingScaleX}" />
                            <Button Grid.ColumnSpan="3" Margin="-16,-10" Style="{StaticResource OverlayButton}" CornerRadius="0" Command="{Binding SaveAsTemplateCommand}"
                                    SemanticProperties.Description="{v:Translate Templates_SaveAction}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Button Text="{v:Translate Entry_Delete}" Command="{Binding DeleteCommand}" BackgroundColor="Transparent"
                        TextColor="{DynamicResource ExpenseText}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding IsHoldingMoney, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

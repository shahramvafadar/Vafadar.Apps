<?xml version="1.0" encoding="utf-8" ?>
<!-- One account in a list. The binding context is an AccountItem; a tap opens the account details. The tile colour says what
     kind of money it is (D-27). -->
<Grid
    x:Class="Vafadar.Zanance.App.Features.Accounts.AccountRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="http://vafadar.pro/schemas/maui"
    xmlns:fi="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    xmlns:local="clr-namespace:Vafadar.Zanance.App.Features.Accounts"
    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
    x:DataType="local:AccountItem"
    Style="{StaticResource ListRow}"
    ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6">

    <Border Grid.Column="0" Style="{StaticResource IconTile}" BackgroundColor="{Binding TileBackground}" Stroke="{Binding TileStroke}">
        <fi:SymbolIcon Symbol="{Binding Icon}" FontSize="20" ForegroundColor="{Binding TileText}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Border>
    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
        <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" LineBreakMode="WordWrap" />
        <!-- D-96: bound each badge before measuring its wrapped height. Flex shrink otherwise narrows already
             measured text without growing its row, clipping the second line at large native text scale. -->
        <FlexLayout x:Name="AccountDescriptions" Wrap="Wrap" AlignItems="Start">
            <Label Text="{Binding TypeName}" Style="{StaticResource Secondary}" Margin="0,0,8,0" FlexLayout.Shrink="0"
                   MaximumWidthRequest="{Binding Width, Source={x:Reference AccountDescriptions}, x:DataType=FlexLayout}" />
            <Label Text="{v:Translate Accounts_Default}" TextColor="{DynamicResource Primary}" FontSize="13" FontAttributes="Bold" Margin="0,0,8,0" IsVisible="{Binding IsDefault}" FlexLayout.Shrink="0"
                   MaximumWidthRequest="{Binding Width, Source={x:Reference AccountDescriptions}, x:DataType=FlexLayout}" />
            <Label Text="{v:Translate Accounts_NotInTotals}" Style="{StaticResource Secondary}" Margin="0,0,8,0" IsVisible="{Binding NotInTotals}" FlexLayout.Shrink="0"
                   MaximumWidthRequest="{Binding Width, Source={x:Reference AccountDescriptions}, x:DataType=FlexLayout}" />
            <Label Text="{v:Translate Account_Incomplete}" TextColor="{DynamicResource WarningText}" FontSize="13" IsVisible="{Binding OpeningUnknown}" FlexLayout.Shrink="0"
                   MaximumWidthRequest="{Binding Width, Source={x:Reference AccountDescriptions}, x:DataType=FlexLayout}" />
        </FlexLayout>
    </VerticalStackLayout>
    <p:AmountReadout Grid.Row="1" Grid.ColumnSpan="2" AmountText="{Binding BalanceText}" CaptionStyle="{StaticResource RowMoneyFigure}"
                     TextColor="{DynamicResource AmountText}">
        <p:AmountReadout.Triggers>
            <DataTrigger TargetType="p:AmountReadout" Binding="{Binding IsNegative}" Value="True">
                <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
            </DataTrigger>
        </p:AmountReadout.Triggers>
    </p:AmountReadout>
    <!-- D-344: the unchanged account-details handler owns identity/status, not the amount scroll viewport. -->
    <Button Grid.ColumnSpan="2" Margin="-16,0" MinimumHeightRequest="44" Style="{StaticResource OverlayButton}" CornerRadius="0" Clicked="OnTapped"
            SemanticProperties.Description="{Binding Name}" SemanticProperties.Hint="{Binding BalanceText}" />
</Grid>

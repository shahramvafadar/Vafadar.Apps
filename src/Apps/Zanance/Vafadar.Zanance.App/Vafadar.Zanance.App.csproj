<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RepoRoot)eng\Maui.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vafadar.Zanance.App</RootNamespace>
    <Description>Vafadar Zanance: personal income and expense tracking with reports (Android, iOS, Windows).</Description>

    <!-- Display name (localized at runtime through resources; this is the installer / launcher fallback). -->
    <ApplicationTitle>Zanance</ApplicationTitle>

    <!-- App identifier: NEVER change after the first store release. Must match ZananceApp.AppId. -->
    <ApplicationId>pro.vafadar.zanance</ApplicationId>

    <!--
      Versions. ApplicationDisplayVersion is the user-visible version (semantic: major.minor.patch).
      ApplicationVersion is the store build number (Android versionCode / iOS CFBundleVersion) and must increase with
      every store upload. See docs/guides/release-and-publishing.md.
    -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows: unpackaged .exe for development and personal use. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup Label="MAUI resources">
    <!--
      Brand assets (D-26), generated from the approved master by branding/zanance/scripts/integrate.mjs.
      Launcher icon: neutral light background + the colour symbol. The foreground keeps the symbol inside the Android
      adaptive safe circle; iOS and Windows have no such mask, so the same foreground is scaled up there.
      Splash: Android 12+ crops the splash image to a circle, so Android shows the symbol only; iOS shows symbol +
      wordmark. The unpackaged Windows app shows no splash screen.
    -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F4F6F8"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F4F6F8" ForegroundScale="1.35"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F6F8" BaseSize="128,128"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiSplashScreen Include="Resources\Splash\splashlockup.svg" Color="#F4F6F8" BaseSize="256,75"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Authentication.Maui\Vafadar.Authentication.Maui.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Backup\Vafadar.Backup.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Backup.GoogleDrive\Vafadar.Backup.GoogleDrive.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Backup.OneDrive\Vafadar.Backup.OneDrive.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Documents.Maui\Vafadar.Documents.Maui.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Maui\Vafadar.Maui.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Core\Vafadar.Zanance.Core.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Data\Vafadar.Zanance.Data.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Reports\Vafadar.Zanance.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Syncfusion.Maui.Charts" />
    <PackageReference Include="Syncfusion.Maui.Inputs" />
    <PackageReference Include="Syncfusion.Maui.ProgressBar" />
  </ItemGroup>

  <!-- Local notifications on phones only: the Windows build of the plugin needs a newer Windows App SDK than MAUI. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="Plugin.LocalNotification" />
  </ItemGroup>

  <!--
    Cloud backup (D-35, D-50): the OAuth clients come from Directory.Secrets.props or CI secrets. Without them the app
    has no cloud backup, and the Android release build keeps removing the network permission (D-20).
    Microsoft uses one Entra public client everywhere; Google has one client per platform (Android, iOS, Desktop app
    for Windows). Each platform compiles only its own Google client id; the others become empty strings.
  -->
  <PropertyGroup>
    <ZananceTargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</ZananceTargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MicrosoftEntraClientId)' != ''">
    <DefineConstants>$(DefineConstants);CLOUD_MICROSOFT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AppSecret Include="MicrosoftEntraClientId" Value="$(MicrosoftEntraClientId)" />
    <AppSecret Include="GoogleOAuthClientIdAndroid" Value="$(GoogleOAuthClientIdAndroid)" Condition="'$(ZananceTargetPlatform)' == 'android'" />
    <AppSecret Include="GoogleOAuthClientIdAndroid" Value="" Condition="'$(ZananceTargetPlatform)' != 'android'" />
    <AppSecret Include="GoogleOAuthClientIdIos" Value="$(GoogleOAuthClientIdIos)" Condition="'$(ZananceTargetPlatform)' == 'ios'" />
    <AppSecret Include="GoogleOAuthClientIdIos" Value="" Condition="'$(ZananceTargetPlatform)' != 'ios'" />
    <AppSecret Include="GoogleOAuthClientIdWindows" Value="$(GoogleOAuthClientIdWindows)" Condition="'$(ZananceTargetPlatform)' == 'windows'" />
    <AppSecret Include="GoogleOAuthClientIdWindows" Value="" Condition="'$(ZananceTargetPlatform)' != 'windows'" />
  </ItemGroup>

  <!--
    iOS sign-in redirects (D-50). The URL schemes depend on the configured clients, so they are not in Info.plist but
    generated at build time into a partial app manifest that the iOS SDK merges into Info.plist:
      * msauth.<bundle id>                       – Microsoft (MSAL), when MicrosoftEntraClientId is set;
      * com.googleusercontent.apps.<client id>   – Google (reversed iOS client id), when GoogleOAuthClientIdIos is set.
    A build without clients registers no URL scheme. The keychain group for the token caches is in
    Platforms/iOS/Entitlements.plist (picked up by MAUI by convention).
  -->
  <PropertyGroup Condition="'$(ZananceTargetPlatform)' == 'ios'">
    <CollectAppManifestsDependsOn>$(CollectAppManifestsDependsOn);ZananceCloudUrlSchemes</CollectAppManifestsDependsOn>
  </PropertyGroup>

  <Target Name="ZananceCloudUrlSchemes" Condition="'$(ZananceTargetPlatform)' == 'ios'">
    <PropertyGroup>
      <_ZananceUrlSchemesPlist>$(IntermediateOutputPath)ZananceCloudUrlSchemes.plist</_ZananceUrlSchemesPlist>
      <_ZananceGoogleScheme Condition="$(GoogleOAuthClientIdIos.EndsWith('.apps.googleusercontent.com'))">com.googleusercontent.apps.$(GoogleOAuthClientIdIos.Replace('.apps.googleusercontent.com', ''))</_ZananceGoogleScheme>
    </PropertyGroup>
    <Warning Condition="'$(GoogleOAuthClientIdIos)' != '' and '$(_ZananceGoogleScheme)' == ''"
             Text="GoogleOAuthClientIdIos does not end with .apps.googleusercontent.com; Google Drive is not offered on iOS." />
    <ItemGroup>
      <_ZananceUrlScheme Include="msauth.$(ApplicationId)" Condition="'$(MicrosoftEntraClientId)' != ''" />
      <_ZananceUrlScheme Include="$(_ZananceGoogleScheme)" Condition="'$(_ZananceGoogleScheme)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_ZananceUrlTypes>@(_ZananceUrlScheme->'&lt;dict&gt;&lt;key&gt;CFBundleURLName&lt;/key&gt;&lt;string&gt;%(Identity)&lt;/string&gt;&lt;key&gt;CFBundleURLSchemes&lt;/key&gt;&lt;array&gt;&lt;string&gt;%(Identity)&lt;/string&gt;&lt;/array&gt;&lt;/dict&gt;', '')</_ZananceUrlTypes>
    </PropertyGroup>
    <ItemGroup>
      <_ZananceUrlSchemesLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;" />
      <_ZananceUrlSchemesLine Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
      <_ZananceUrlSchemesLine Include="&lt;plist version=&quot;1.0&quot;&gt;&lt;dict&gt;&lt;key&gt;CFBundleURLTypes&lt;/key&gt;&lt;array&gt;$(_ZananceUrlTypes)&lt;/array&gt;&lt;/dict&gt;&lt;/plist&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_ZananceUrlSchemesPlist)" Lines="@(_ZananceUrlSchemesLine)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Condition="'@(_ZananceUrlScheme)' != ''" />
    <ItemGroup Condition="'@(_ZananceUrlScheme)' != ''">
      <PartialAppManifest Include="$(_ZananceUrlSchemesPlist)" />
      <FileWrites Include="$(_ZananceUrlSchemesPlist)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(MicrosoftEntraClientId)$(GoogleOAuthClientIdAndroid)' == ''">
    <AndroidManifestOverlay Include="Platforms\Android\ReleaseManifest.xml" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RepoRoot)eng\Maui.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vafadar.Zanance.App</RootNamespace>
    <Description>Vafadar Zanance: personal income and expense tracking with reports (Android, iOS, Windows).</Description>

    <!-- Display name (localized at runtime through resources; this is the installer / launcher fallback). -->
    <ApplicationTitle>Zanance</ApplicationTitle>

    <!-- App identifier: NEVER change after the first store release. Must match ZananceApp.AppId. -->
    <ApplicationId>pro.vafadar.zanance</ApplicationId>

    <!--
      Versions. ApplicationDisplayVersion is the user-visible version (semantic: major.minor.patch).
      ApplicationVersion is the store build number (Android versionCode / iOS CFBundleVersion) and must increase with
      every store upload. See docs/guides/release-and-publishing.md.
    -->
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows: unpackaged .exe for development and personal use. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup Label="MAUI resources">
    <!--
      Brand assets (D-26), generated from the approved master by branding/zanance/scripts/integrate.mjs.
      Launcher icon: neutral light background + the colour symbol. The foreground keeps the symbol inside the Android
      adaptive safe circle; iOS and Windows have no such mask, so the same foreground is scaled up there.
      Splash: Android 12+ crops the splash image to a circle, so Android shows the symbol only; iOS shows symbol +
      wordmark. The unpackaged Windows app shows no splash screen.
    -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F4F6F8"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F4F6F8" ForegroundScale="1.35"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F6F8" BaseSize="128,128"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiSplashScreen Include="Resources\Splash\splashlockup.svg" Color="#F4F6F8" BaseSize="256,75"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Backup\Vafadar.Backup.csproj" />
    <ProjectReference Include="..\..\..\Libraries\Vafadar.Maui\Vafadar.Maui.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Core\Vafadar.Zanance.Core.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Data\Vafadar.Zanance.Data.csproj" />
    <ProjectReference Include="..\Vafadar.Zanance.Reports\Vafadar.Zanance.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Syncfusion.Maui.Charts" />
    <PackageReference Include="Syncfusion.Maui.Inputs" />
    <PackageReference Include="Syncfusion.Maui.ProgressBar" />
  </ItemGroup>

  <!-- Local notifications on phones only: the Windows build of the plugin needs a newer Windows App SDK than MAUI. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="Plugin.LocalNotification" />
  </ItemGroup>

</Project>

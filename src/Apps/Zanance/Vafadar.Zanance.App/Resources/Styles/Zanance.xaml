<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Visual system of Zanance (docs/03-ux-design.md §6). Light values here; Presentation/Palette.cs sets the light or dark
     variant at run time, so colors are used as DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:v="http://vafadar.pro/schemas/maui"
                    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
                    xmlns:progress="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
                    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs">

    <v:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    <v:IsNotNullConverter x:Key="IsNotNullConverter" />
    <p:CurrencyUnitConverter x:Key="CurrencyUnitConverter" />
    <v:IsPositiveConverter x:Key="IsPositiveConverter" />

    <Color x:Key="IncomeText">#1B5E20</Color>
    <Color x:Key="IncomeBackground">#E8F5E9</Color>
    <Color x:Key="ExpenseText">#B71C1C</Color>
    <Color x:Key="ExpenseBackground">#FFEBEE</Color>
    <Color x:Key="TransferText">#37474F</Color>
    <Color x:Key="TransferBackground">#ECEFF1</Color>
    <Color x:Key="WarningText">#8D5B00</Color>
    <Color x:Key="WarningBackground">#FFF4E0</Color>
    <Color x:Key="PageBackground">#F6F7F6</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="SecondaryText">#5F6368</Color>
    <Color x:Key="DividerColor">#E3E6E3</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="AmountText">#1F1F1F</Color>
    <Color x:Key="NearLimit">#F9A825</Color>
    <Color x:Key="Muted">#9E9E9E</Color>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
    </Style>

    <!-- Budget and goal progress (0–1): rounded bar on a visible track, filled in the reading direction. -->
    <Style TargetType="progress:SfLinearProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="TrackHeight" Value="8" />
        <Setter Property="ProgressHeight" Value="8" />
        <Setter Property="TrackFill" Value="{DynamicResource DividerColor}" />
        <!-- Rounded ends on the phones; the Windows renderer draws artefacts at rounded ends, so it keeps square ones. -->
        <Setter Property="TrackCornerRadius" Value="{OnPlatform Default=4, WinUI=0}" />
        <Setter Property="ProgressCornerRadius" Value="{OnPlatform Default=4, WinUI=0}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="AnimationDuration" Value="400" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="ScaleX" Value="{DynamicResource ReadingScaleX}" />
    </Style>

    <!-- Currency selection: about 50 codes, so typing filters the list ("IR" finds IRR). -->
    <Style x:Key="CurrencyBox" TargetType="inputs:SfComboBox">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="IsFilteringEnabled" Value="True" />
        <Setter Property="TextSearchMode" Value="StartsWith" />
        <Setter Property="IsClearButtonVisible" Value="False" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="DropDownBackground" Value="{DynamicResource CardBackground}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="DropDownIconColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource IncomeBackground}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="Margin" Value="0,16,0,4" />
    </Style>

    <Style x:Key="Secondary" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
    </Style>

    <Style x:Key="AmountLarge" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <Style x:Key="FloatingAddButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
    </Style>

    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
    </Style>
</ResourceDictionary>

<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Visual system of Zanance (docs/03-ux-design.md §6, D-27). Presentation/Palette.cs sets the light or dark colours at start
     and on every theme change, so colours are always used as DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:v="http://vafadar.pro/schemas/maui"
                    xmlns:p="clr-namespace:Vafadar.Zanance.App.Presentation"
                    xmlns:progress="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
                    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs">

    <v:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    <v:IsNotNullConverter x:Key="IsNotNullConverter" />
    <p:CurrencyUnitConverter x:Key="CurrencyUnitConverter" />
    <v:IsPositiveConverter x:Key="IsPositiveConverter" />

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
    </Style>

    <!-- Budget and goal progress (0–1): rounded bar on a visible track, filled in the reading direction. -->
    <Style TargetType="progress:SfLinearProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="TrackHeight" Value="8" />
        <Setter Property="ProgressHeight" Value="8" />
        <Setter Property="TrackFill" Value="{DynamicResource DividerColor}" />
        <!-- Rounded ends on the phones; the Windows renderer draws artefacts at rounded ends, so it keeps square ones. -->
        <Setter Property="TrackCornerRadius" Value="{OnPlatform Default=4, WinUI=0}" />
        <Setter Property="ProgressCornerRadius" Value="{OnPlatform Default=4, WinUI=0}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="AnimationDuration" Value="400" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="ScaleX" Value="{DynamicResource ReadingScaleX}" />
    </Style>

    <!-- Currency selection: about 50 codes, so typing filters the list ("IR" finds IRR). -->
    <Style x:Key="CurrencyBox" TargetType="inputs:SfComboBox">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="IsFilteringEnabled" Value="True" />
        <Setter Property="TextSearchMode" Value="StartsWith" />
        <Setter Property="IsClearButtonVisible" Value="False" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="DropDownBackground" Value="{DynamicResource CardBackground}" />
        <Setter Property="DropDownItemTextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="DropDownIconColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="SelectedDropDownItemBackground" Value="{DynamicResource IncomeBackground}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <!-- Title of a root page (the tab pages show it in the content, not in a navigation bar). -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="Margin" Value="4,16,4,2" />
    </Style>

    <!-- The small action at the end of a section header ("All", "Details"). -->
    <Style x:Key="SectionLink" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="4,16,4,2" />
    </Style>

    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="Secondary" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
    </Style>

    <!-- The bold display face (Urbanist in English and German, Vazirmatn Bold in Persian), so no synthetic bold. -->
    <Style x:Key="AmountLarge" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource AmountText}" />
        <Setter Property="BorderColor" Value="{DynamicResource StrokeStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Destructive actions (delete, restore over the data): red only where something can be lost. -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ExpenseBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource ExpenseText}" />
        <Setter Property="BorderColor" Value="{DynamicResource DangerLine}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="FloatingAddButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Shadow">
            <Shadow Brush="#1D56C9" Opacity="0.28" Radius="14" Offset="0,6" />
        </Setter>
    </Style>

    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="60" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
    </Style>

    <!-- Rounded square that carries a row's icon in its meaning colour (background, outline and icon from one family). -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="IconTileSmall" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <!-- Day and month of a due date in a plan row. -->
    <Style x:Key="DateTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Small pill with a status ("2 days overdue", "80%"). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="IconButton" TargetType="Border">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource DividerColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="v:ChoiceChips">
        <Setter Property="AccentColor" Value="{DynamicResource Primary}" />
        <Setter Property="SelectedFill" Value="{DynamicResource PrimarySoft}" />
        <Setter Property="SelectedOutline" Value="{DynamicResource PrimaryLine}" />
        <Setter Property="OutlineColor" Value="{DynamicResource StrokeStrong}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryText}" />
        <Setter Property="ChipBackground" Value="{DynamicResource CardBackground}" />
    </Style>
</ResourceDictionary>
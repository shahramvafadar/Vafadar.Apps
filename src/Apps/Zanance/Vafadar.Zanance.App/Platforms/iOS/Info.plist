<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fa</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Face ID for the optional app lock (SEC-01); iOS ends the app without this text. Localised in *.lproj/InfoPlist.strings. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Zanance uses Face ID to unlock the app when app lock is enabled.</string>
	<!-- Camera for photographing receipts (D-38); asked only when the user chooses "Take a photo". Localised in *.lproj/InfoPlist.strings. -->
	<key>NSCameraUsageDescription</key>
	<string>Zanance uses the camera to scan receipts. Receipt text is processed on your device.</string>
	<!-- Sign-in URL schemes (CFBundleURLTypes) are generated at build time from the configured OAuth clients: msauth.<bundle id>
	     for Microsoft, the reversed iOS client id for Google (see ZananceCloudUrlSchemes in Vafadar.Zanance.App.csproj, D-50). -->
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>

<maui:MauiWinUIApplication
    x:Class="Vafadar.Zanance.App.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Vafadar.Zanance.App.WinUI">

    <!-- The keyboard focus ring in the action blue of the palette (Presentation/Palette.cs, D-37) instead of the system's
         black and white; it keeps the rounded corners of each control. -->
    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#1D56C9" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#79A6FF" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#1C2536" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>

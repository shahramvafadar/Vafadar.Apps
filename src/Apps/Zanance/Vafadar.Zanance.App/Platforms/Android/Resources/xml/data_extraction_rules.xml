<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml, for both cloud backup and device transfer (D-63). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pro.vafadar.zanance.microsoft.maui.essentials.preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pro.vafadar.zanance.microsoft.maui.essentials.preferences.xml" />
    </device-transfer>
</data-extraction-rules>

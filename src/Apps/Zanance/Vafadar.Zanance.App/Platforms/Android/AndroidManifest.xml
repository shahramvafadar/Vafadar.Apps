<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:localeConfig="@xml/locales_config"></application>
	<!-- Works fully offline: no network permission (privacy matrix DF-15). Debug builds add INTERNET for the debugger; only a build
	     configured for cloud backup keeps it in release (D-35), used for the user's own Google Drive or OneDrive only. -->
	<!-- Reminders (REM-01): asking is done only when the user turns a reminder on (REM-03). -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Scheduled reminders are restored after a restart (REM-07). No exact-alarm permission is needed (REM-09). -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- ML Kit (receipt reading, D-31) asks for network access for its usage statistics; the app never goes online (D-20).
	     The release build also removes INTERNET (ReleaseManifest.xml); Debug keeps it for the debugger. -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>

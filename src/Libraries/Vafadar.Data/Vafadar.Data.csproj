<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>On-device SQLite databases with EF Core: base DbContext and conventions, audit timestamps, and a consistent backup source.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="..\Vafadar.Backup\Vafadar.Backup.csproj" />
    <ProjectReference Include="..\Vafadar.Core\Vafadar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host selects its native engine; shared persistence must not import a default bundle. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
  </ItemGroup>

</Project>

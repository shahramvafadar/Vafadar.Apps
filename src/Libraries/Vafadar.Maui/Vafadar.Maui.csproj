<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RepoRoot)eng\Maui.props" />

  <PropertyGroup>
    <Description>Shared .NET MAUI infrastructure: app bootstrap (UseVafadar), preferences, localization in XAML, right-to-left layout, Syncfusion setup, MVVM base types, shared controls and device authentication.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Core\Vafadar.Core.csproj" />
    <ProjectReference Include="..\Vafadar.Localization\Vafadar.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Maui" />
    <PackageReference Include="Syncfusion.Licensing" />
    <PackageReference Include="Syncfusion.Maui.Calendar" />
    <PackageReference Include="Syncfusion.Maui.Core" />
  </ItemGroup>

  <!-- Device authentication for the app lock (Security/DeviceAuthenticator). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Biometric" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RepoRoot)eng\Maui.props" />

  <PropertyGroup>
    <Description>Sign-in with Microsoft (MSAL) and Google (Google Identity authorization API on Android) for backups in the user's own OneDrive or Google Drive. Only minimal scopes; tokens stay on the device.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Authentication\Vafadar.Authentication.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <!-- The token cache of the desktop is kept with DPAPI (Android keeps it in MSAL's own protected storage). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <!-- The AndroidX Ktx and lifecycle packages are pinned so Play services and MAUI agree on versions (NU1608). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(RepoRoot)eng\Maui.props" />

  <PropertyGroup>
    <Description>Sign-in with Microsoft (MSAL on Android, iOS and Windows) and Google (Google Identity authorization API on Android, system browser with PKCE on iOS and Windows) for backups in the user's own OneDrive or Google Drive. Only minimal scopes; tokens stay on the device.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vafadar.Authentication\Vafadar.Authentication.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <!-- The token caches of the desktop (MSAL, Google) are kept with DPAPI; Android and iOS keep them in protected platform storage. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <!-- The AndroidX Ktx and lifecycle packages are pinned so Play services and MAUI agree on versions (NU1608). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
  </ItemGroup>

</Project>

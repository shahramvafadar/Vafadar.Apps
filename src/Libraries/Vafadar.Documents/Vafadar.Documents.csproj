<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(VafadarTargetFramework)</TargetFramework>
    <Description>Text of documents on the device: rows from recognised words (left-to-right and right-to-left) and the text layer of PDF files. Platform independent.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Licensing" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" />
    <!-- Explicit patched dependencies also protect standalone document/report consumers. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>

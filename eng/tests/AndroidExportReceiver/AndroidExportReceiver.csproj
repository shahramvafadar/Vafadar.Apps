<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>pro.vafadar.zanance.exportreview</ApplicationId>
    <ApplicationTitle>Zanance export review</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidDebuggable>true</AndroidDebuggable>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <!-- This independent local receiver must not inherit application licence or provider material. -->
  <ItemGroup><AppSecret Remove="@(AppSecret)" /></ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>pro.vafadar.zanance.layoutreview</ApplicationId>
    <ApplicationTitle>Zanance layout review</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidDebuggable>false</AndroidDebuggable>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <!-- Compile the actual native waiter without MAUI substitutes, secrets or a reference to Main. -->
  <ItemGroup>
    <AppSecret Remove="@(AppSecret)" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Presentation/AndroidValidationLayout.cs" Link="AndroidValidationLayout.cs" />
  </ItemGroup>
  <Target Name="RequireOwnedLayoutReview" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ApplicationId)' != 'pro.vafadar.zanance.layoutreview' Or '$(Configuration)' != 'Release'"
           Text="Native layout qualification requires its fixed independent Release identity." />
  </Target>
</Project>

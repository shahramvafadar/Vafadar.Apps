<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <ApplicationId>pro.vafadar.zanance.nativecompatibility</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Independent compatibility checks of official source-built SQLCipher with original data sources.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Features/Backup/ProtectedBackupRestoreReceiver.cs" Link="ProtectedBackupRestoreReceiver.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Features/Backup/BackupRestorePublication.cs" Link="BackupRestorePublication.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Startup/ProtectedProfileStorage.cs" Link="ProtectedProfileStorage.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Startup/IAppDatabaseStartup.cs" Link="IAppDatabaseStartup.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Startup/ProtectedProfileRecovery.cs" Link="ProtectedProfileRecovery.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Startup/ProtectedDatabaseStartup.cs" Link="ProtectedDatabaseStartup.cs" />
    <PackageReference Include="Microsoft.Maui.Essentials" />
    <Using Include="Microsoft.Maui.Storage" />
    <Compile Include="$(RepoRoot)src/Libraries/Vafadar.Maui/Hosting/MauiSettingsStore.cs" Link="MauiSettingsStore.cs" />
    <Compile Include="$(RepoRoot)src/Libraries/Vafadar.Maui/Hosting/AndroidSettingsPersistence.cs" Link="AndroidSettingsPersistence.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlcipher" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Core/Vafadar.Zanance.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup/Vafadar.Backup.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Localization/Vafadar.Localization.csproj" />
    <!-- Provider-neutral production assemblies retain their real dependency graph and frozen migration resources. -->
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Data/Vafadar.Zanance.Data.csproj" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidDatabaseKeyProtector.cs" Link="AndroidDatabaseKeyProtector.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidDatabaseKeyEnvelopeStore.Recovery.cs" Link="AndroidDatabaseKeyEnvelopeStore.Recovery.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidDatabaseKeyEnvelopeStore.cs" Link="AndroidDatabaseKeyEnvelopeStore.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidGenerationMigrationStorage.cs" Link="AndroidGenerationMigrationStorage.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidProfileRetirementFiles.cs" Link="AndroidProfileRetirementFiles.cs" />
    <Compile Include="../Compatibility/SchemaCompatibility.cs" Link="SchemaCompatibility.cs" />
    <Compile Include="../Compatibility/FreshStartupCompatibility.cs" Link="FreshStartupCompatibility.cs" />
    <Compile Include="../Compatibility/RestoreSessionCompatibility.cs" Link="RestoreSessionCompatibility.cs" />
    <Compile Include="../Compatibility/ProtectedStartupCompatibility.cs" Link="ProtectedStartupCompatibility.cs" />
    <Compile Include="../Compatibility/RecoveryCompatibility.cs" Link="RecoveryCompatibility.cs" />
    <Compile Include="../Compatibility/OriginalProfileFixture.cs" Link="OriginalProfileFixture.cs" />
    <Compile Include="../Compatibility/JournalCompatibility.cs" Link="JournalCompatibility.cs" />
    <Compile Include="../Compatibility/SharedRetirementCompatibility.cs" Link="SharedRetirementCompatibility.cs" />
    <Compile Include="../Compatibility/RetirementDiscoveryFreshCompatibility.cs" Link="RetirementDiscoveryFreshCompatibility.cs" />
    <Compile Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Profiles/*.cs"
             Exclude="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/Profiles/ProfileService.Maui.cs" />
    <AndroidNativeLibrary Include="$(NativeCandidateDirectory)/arm64-v8a/libsqlcipher.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(NativeCandidateDirectory)/x86_64/libsqlcipher.so" Abi="x86_64" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NativeCandidateDirectory)' == '' Or !Exists('$(NativeCandidateDirectory)/x86_64/libsqlcipher.so') Or !Exists('$(NativeCandidateDirectory)/arm64-v8a/libsqlcipher.so')"
           Text="Provide NativeCandidateDirectory pointing to independently source-built Android slices." />
  </Target>
</Project>

<Project>

  <!--
    Build-time secrets for app projects.

    An app declares the secrets it needs:

      <ItemGroup>
        <AppSecret Include="SyncfusionLicenseKey" Value="$(SyncfusionLicenseKey)" />
      </ItemGroup>

    and this target generates an internal static class `AppSecrets` (in the project's root namespace) with one
    string constant per secret. Values come from MSBuild properties, which are populated from:

      * environment variables (GitHub Actions secrets in CI), or
      * the git-ignored Directory.Secrets.props at the repository root (local development).

    Missing values become empty strings so that builds without secrets (e.g. pull requests from forks) still work.
    Values must not contain semicolons or triple quotes.

    NOTE: anything compiled into an app can be extracted from the app package. This mechanism keeps secrets out of
    the public source code; it does not make them secret from people who download the app.
  -->

  <!--
    Runs before BeforeBuild because the WinUI XAML compiler compiles the project in a pre-pass (XamlPreCompile)
    before CoreCompile; CoreCompile is kept for IDE design-time builds, which skip BeforeBuild.
  -->
  <Target Name="VafadarGenerateAppSecrets"
          BeforeTargets="BeforeBuild;CoreCompile"
          Condition="'@(AppSecret)' != '' and '$(Language)' == 'C#'">

    <PropertyGroup>
      <_VafadarAppSecretsFile>$(IntermediateOutputPath)AppSecrets.g.cs</_VafadarAppSecretsFile>
    </PropertyGroup>

    <ItemGroup>
      <_VafadarAppSecretLine Include="// &lt;auto-generated&gt; Generated by eng/AppSecrets.targets. Do not edit. &lt;/auto-generated&gt;" />
      <_VafadarAppSecretLine Include="namespace $(RootNamespace)%3B" />
      <_VafadarAppSecretLine Include="[global::System.CodeDom.Compiler.GeneratedCode(&quot;Vafadar.AppSecrets&quot;, &quot;1.0&quot;)]" />
      <_VafadarAppSecretLine Include="internal static class AppSecrets" />
      <_VafadarAppSecretLine Include="{" />
      <_VafadarAppSecretLine Include="    internal const string %(AppSecret.Identity) = &quot;&quot;&quot;%(AppSecret.Value)&quot;&quot;&quot;%3B"
                             Condition="'%(AppSecret.Value)' != ''" />
      <_VafadarAppSecretLine Include="    internal const string %(AppSecret.Identity) = &quot;&quot;%3B"
                             Condition="'%(AppSecret.Value)' == ''" />
      <_VafadarAppSecretLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_VafadarAppSecretsFile)"
                      Lines="@(_VafadarAppSecretLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <Message Importance="high"
             Text="$(MSBuildProjectName): app secret '%(AppSecret.Identity)' is not set; the app will be built without it."
             Condition="'%(AppSecret.Value)' == '' and '$(Configuration)' == 'Release'" />

    <ItemGroup>
      <Compile Include="$(_VafadarAppSecretsFile)" />
      <FileWrites Include="$(_VafadarAppSecretsFile)" />
    </ItemGroup>
  </Target>

</Project>

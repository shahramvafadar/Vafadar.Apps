<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <VafadarNotificationCoreBaseline Condition="'$(VafadarNotificationQueueCorrection)' != 'true'">true</VafadarNotificationCoreBaseline>
    <SupportedOSPlatformVersion>35.0</SupportedOSPlatformVersion>
    <UseMaui>true</UseMaui>
    <OutputType>Exe</OutputType>
    <ApplicationId>pro.vafadar.zanance.notificationqueuebaselinereview</ApplicationId>
    <ApplicationTitle>Zanance notification queue review</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidKeyStore>false</AndroidKeyStore>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <!-- Different identities preserve the failing baseline and the corrected native queue independently. -->
  <PropertyGroup Condition="'$(VafadarNotificationQueueCorrection)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.notificationqueuefixedreview</ApplicationId>
    <DefineConstants>$(DefineConstants);FIXED_NOTIFICATION_QUEUE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(VafadarNotificationQueueCorrection)' == 'true'">
    <PackageReference Include="Plugin.LocalNotification.Core" ExcludeAssets="all" />
    <ProjectReference Include="../../notifications/Plugin.LocalNotification.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Plugin.LocalNotification" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="../../../src/Apps/Zanance/Vafadar.Zanance.Core/Vafadar.Zanance.Core.csproj"
                      Condition="'$(VafadarQueueFinancialCoreBinary)' == ''" />
    <!-- D-580: comparison builds may bind identical verified financial inputs before linking/AOT. -->
    <Reference Include="Vafadar.Zanance.Core" Condition="'$(VafadarQueueFinancialCoreBinary)' != ''">
      <HintPath>$(VafadarQueueFinancialCoreBinary)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vafadar.Core" Condition="'$(VafadarQueueFinancialCoreBinary)' != ''">
      <HintPath>$(VafadarQueueBaseCoreBinary)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Reminders/IReminderScheduler.cs" Link="Original/IReminderScheduler.cs" />
    <Compile Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Reminders/LocalNotificationScheduler.cs" Link="Original/LocalNotificationScheduler.cs" />
    <Compile Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Reminders/ReminderDeliveryWindow.cs" Link="Original/ReminderDeliveryWindow.cs" />
    <Compile Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Reminders/ReminderPublication.cs" Link="Original/ReminderPublication.cs" />
    <AndroidResource Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/Resources/drawable/ic_stat_zanance.xml" Link="Resources/drawable/ic_stat_zanance.xml" />
    <AndroidAsset Include="../../../src/Apps/Zanance/Vafadar.Zanance.App/Resources/Strings/AppResources.resx" Link="captions/AppResources.resx" />
  </ItemGroup>
  <Target Name="SelectOriginalServicedDeliveryRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Condition="'%(FrameworkReference.Identity)' == 'Microsoft.NETCore.App'">
        <RuntimeFrameworkVersion>$(VafadarSecurityRuntimeVersion)</RuntimeFrameworkVersion>
      </FrameworkReference>
    </ItemGroup>
  </Target>
  <Import Project="$(RepoRoot)eng/AndroidAotRuntime.targets" />
</Project>

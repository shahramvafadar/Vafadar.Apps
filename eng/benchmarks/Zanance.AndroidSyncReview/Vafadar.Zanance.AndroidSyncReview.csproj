<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng/Maui.props" />
  <PropertyGroup>
    <VafadarMauiTargetFrameworks>net10.0-android</VafadarMauiTargetFrameworks>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vafadar.Zanance.App</RootNamespace>
    <ApplicationTitle>Zanance sync review</ApplicationTitle>
    <ApplicationId>pro.vafadar.zanance.androidsyncreview</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RunAOTCompilation>true</RunAOTCompilation>
    <DefineConstants>$(DefineConstants);PERSONAL_SYNC</DefineConstants>
    <PublishTrimmed>true</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>
    <OriginalAppRoot>$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/</OriginalAppRoot>
    <AndroidManifest>../../../src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewLinkedGroup)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidsyncgroupreview</ApplicationId>
    <DefineConstants>$(DefineConstants);SYNC_GROUP_REVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewPortableRecords)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidsyncportablereview</ApplicationId>
    <DefineConstants>$(DefineConstants);SYNC_PORTABLE_REVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewAttachments)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidsyncattachmentreview</ApplicationId>
    <DefineConstants>$(DefineConstants);SYNC_ATTACHMENT_REVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewNetwork)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidsyncnetwork</ApplicationId>
    <DefineConstants>$(DefineConstants);SYNC_NETWORK_REVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewPublicService)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidsyncpublicreview</ApplicationId>
    <DefineConstants>$(DefineConstants);SYNC_PUBLIC_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- Compile original production sources and XAML; the application never references this independent caller. -->
  <PropertyGroup Condition="'$(ReviewHouseholdFiles)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.androidhouseholdfiles</ApplicationId>
    <DefineConstants>$(DefineConstants);HOUSEHOLD_FILE_REVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReviewHouseholdSnapshot)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.householdsnapshotreview</ApplicationId>
    <DefineConstants>$(DefineConstants);HOUSEHOLD_SNAPSHOT_REVIEW;HOUSEHOLD_FILE_REVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../sync/HouseholdRoundtrip/HistoryQualification.NativeBound.cs" Link="Native/HistoryQualification.NativeBound.cs"
             Condition="'$(ReviewHouseholdSnapshot)' == 'true'" />
    <Compile Include="$(OriginalAppRoot)**/*.cs"
             Exclude="$(OriginalAppRoot)bin/**;$(OriginalAppRoot)obj/**;$(OriginalAppRoot)Platforms/Windows/**;$(OriginalAppRoot)Platforms/iOS/**;$(OriginalAppRoot)Platforms/Android/MainActivity.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
    <MauiXaml Include="$(OriginalAppRoot)**/*.xaml"
              Exclude="$(OriginalAppRoot)bin/**;$(OriginalAppRoot)obj/**;$(OriginalAppRoot)Platforms/Windows/**"
              Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(OriginalAppRoot)Resources/Strings/*.resx" Link="Resources/Strings/%(Filename)%(Extension)" />
    <AndroidResource Include="$(OriginalAppRoot)Platforms/Android/Resources/**" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidManifestOverlay Include="$(OriginalAppRoot)Platforms/Android/ReleaseManifest.xml" Condition="'$(ReviewNetwork)' != 'true'" />
    <AndroidManifestOverlay Include="$(OriginalAppRoot)Platforms/Android/PersonalSyncManifest.xml" Condition="'$(ReviewNetwork)' == 'true'" />
    <MauiIcon Include="$(OriginalAppRoot)Resources/AppIcon/appicon.svg" ForegroundFile="$(OriginalAppRoot)Resources/AppIcon/appiconfg.svg" Color="#F4F6F8" />
    <MauiSplashScreen Include="$(OriginalAppRoot)Resources/Splash/splash.svg" Color="#F4F6F8" BaseSize="128,128" />
    <MauiImage Include="$(OriginalAppRoot)Resources/Images/*" />
    <MauiFont Include="$(OriginalAppRoot)Resources/Fonts/*.ttf" />
    <MauiAsset Include="$(OriginalAppRoot)Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Authentication.Maui/Vafadar.Authentication.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup/Vafadar.Backup.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup.GoogleDrive/Vafadar.Backup.GoogleDrive.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup.OneDrive/Vafadar.Backup.OneDrive.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Documents.Maui/Vafadar.Documents.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Maui/Vafadar.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Core/Vafadar.Zanance.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Data/Vafadar.Zanance.Data.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Reports/Vafadar.Zanance.Reports.csproj" />
    <PackageReference Include="Vafadar.Native.SqlCipher.Android" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Syncfusion.Maui.Charts" />
    <PackageReference Include="Syncfusion.Maui.Inputs" />
    <PackageReference Include="Syncfusion.Maui.ProgressBar" />
    <PackageReference Include="Plugin.LocalNotification" />
    <AppSecret Include="MicrosoftEntraClientId" Value="" />
    <AppSecret Include="GoogleOAuthClientIdAndroid" Value="" />
    <AppSecret Include="GoogleOAuthClientIdIos" Value="" />
    <AppSecret Include="GoogleOAuthClientIdWindows" Value="" />
  </ItemGroup>
  <Target Name="SelectPatchedCoreRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Condition="'%(FrameworkReference.Identity)' == 'Microsoft.NETCore.App'">
        <RuntimeFrameworkVersion>$(VafadarSecurityRuntimeVersion)</RuntimeFrameworkVersion>
      </FrameworkReference>
    </ItemGroup>
  </Target>
  <Target Name="PrepareAndroidCipherDependency" BeforeTargets="_GenerateRestoreGraphProjectEntry">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)eng/native/sqlcipher/Ensure-AndroidPackage.ps1&quot;" />
  </Target>
</Project>

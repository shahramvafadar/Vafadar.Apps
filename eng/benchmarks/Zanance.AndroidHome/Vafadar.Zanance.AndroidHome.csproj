<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng/Maui.props" />
  <PropertyGroup>
    <VafadarMauiTargetFrameworks>net10.0-android</VafadarMauiTargetFrameworks>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vafadar.Zanance.App</RootNamespace>
    <AssemblyName>Vafadar.Zanance.App</AssemblyName>
    <ApplicationTitle>Zanance Home review</ApplicationTitle>
    <ApplicationId>pro.vafadar.zanance.androidhomereview</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ZANANCE_INDEPENDENT_HOME_REVIEW</DefineConstants>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- D-543: choose the caller RID locally so plain financial dependencies retain shipping AnyCPU inputs. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(ReviewRuntimeIdentifier)' != ''">$(ReviewRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
    <OriginalAppRoot>$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.App/</OriginalAppRoot>
    <AndroidManifest>../../../src/Apps/Zanance/Vafadar.Zanance.App/Platforms/Android/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <!-- D-574: a loaded cold cohort reuses original owned sources, never a shipping UID or an older financial phase. -->
  <PropertyGroup Condition="'$(ReviewLoadedColdStart)' == 'true'">
    <DefineConstants>$(DefineConstants);LOADED_COLD_START_REVIEW</DefineConstants>
  </PropertyGroup>
  <Target Name="RequireOriginalLoadedColdIdentity" BeforeTargets="PrepareForBuild" Condition="'$(ReviewLoadedColdStart)' == 'true'">
    <Error Condition="'$(ApplicationId)' != 'pro.vafadar.zanance.androidhomereview' or '$(RuntimeIdentifier)' != 'android-arm64' or '$(ReviewNativeFaultPc)' == 'true'"
           Text="Loaded cold review requires only the original independent ARM64 caller, without a fault observer." />
  </Target>
  <!-- A process-local signal observer is never linked into the shipping application or another review flavor. -->
  <PropertyGroup Condition="'$(ReviewNativeFaultPc)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_FAULT_PC_REVIEW</DefineConstants>
    <ReviewFaultPcAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</ReviewFaultPcAbi>
    <ReviewFaultPcAbi Condition="'$(RuntimeIdentifier)' == 'android-arm64'">arm64-v8a</ReviewFaultPcAbi>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReviewNativeFaultPc)' == 'true'">
    <AndroidNativeLibrary Include="$(ReviewFaultPcLibrary)" Abi="$(ReviewFaultPcAbi)" />
  </ItemGroup>
  <Target Name="RequireOwnedNativeFaultPcInputs" BeforeTargets="PrepareForBuild" Condition="'$(ReviewNativeFaultPc)' == 'true'">
    <Error Condition="'$(ApplicationId)' != 'pro.vafadar.zanance.androidhomereview' or '$(ReviewFaultPcAbi)' == '' or !Exists('$(ReviewFaultPcLibrary)')"
           Text="A verified native observer for the original independent package and exact ABI is required." />
  </Target>
  <!-- D-562: a new native writer regression must never replace retained callers or shipping Main. -->
  <PropertyGroup Condition="'$(ReviewLedgerConflict)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.ledgerconflictreview</ApplicationId>
    <DefineConstants>$(DefineConstants);LEDGER_CONFLICT_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- D-549: new minimum-API/page-size codec fixtures cannot touch retained callers or Main. -->
  <PropertyGroup Condition="'$(ReviewLedgerCodecCompatibility)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.ledgercodeccompatibility</ApplicationId>
    <DefineConstants>$(DefineConstants);LEDGER_CODEC_COMPATIBILITY</DefineConstants>
  </PropertyGroup>
  <!-- Title-action qualification must not replace callers with retained financial evidence. -->
  <PropertyGroup Condition="'$(ReviewTransactionsHeader)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.transactionsheaderreview</ApplicationId>
    <DefineConstants>$(DefineConstants);TRANSACTIONS_HEADER_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- Original SUPA presentation owns no accepted financial source or existing caller. -->
  <PropertyGroup Condition="'$(ReviewSupaCsv)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.supacsvreview</ApplicationId>
    <DefineConstants>$(DefineConstants);SUPA_CSV_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- A budget-only publication cohort must not reuse the accepted ledger writer's identity. -->
  <PropertyGroup Condition="'$(ReviewHomeBudget)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.homebudgetreview</ApplicationId>
    <DefineConstants>$(DefineConstants);HOME_BUDGET_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- The protected Home concurrency cohort owns no previous caller or financial source. -->
  <PropertyGroup Condition="'$(ReviewHomeFinancial)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.homefinancialreview</ApplicationId>
    <DefineConstants>$(DefineConstants);HOME_FINANCIAL_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- The physical retained-tab cohort must not replace a caller with retained financial evidence. -->
  <PropertyGroup Condition="'$(ReviewForecastPhone)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.forecastreturnreview</ApplicationId>
    <DefineConstants>$(DefineConstants);FORECAST_RETURN_PHONE_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- New native source-help qualification owns no retained caller/financial data. -->
  <PropertyGroup Condition="'$(ReviewReceiptSource)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.receiptsourcereview</ApplicationId>
    <DefineConstants>$(DefineConstants);RECEIPT_SOURCE_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- Scanned receipt inputs belong only to the independent caller, never to the shipping app. -->
  <ItemGroup Condition="'$(ScannedReceiptRoot)' != ''">
    <MauiAsset Include="$(ScannedReceiptRoot)/scan-*.pdf" LogicalName="scanned-receipts/%(Filename)%(Extension)" />
    <MauiAsset Include="$(ScannedReceiptRoot)/manifest.json" LogicalName="scanned-receipts/manifest.json" />
  </ItemGroup>
  <!-- Public receipt evidence is opt-in, local-only and never part of the product package. -->
  <ItemGroup Condition="'$(ReceiptCorpusRoot)' != ''">
    <MauiAsset Include="$(ReceiptCorpusRoot)/test-*.jpg" LogicalName="receipt-corpus/%(Filename)%(Extension)" />
    <MauiAsset Include="$(ReceiptCorpusRoot)/manifest.json" LogicalName="receipt-corpus/manifest.json" />
    <MauiAsset Include="$(ReceiptCorpusRoot)/LICENSE-CC-BY" LogicalName="receipt-corpus/LICENSE-CC-BY" />
    <MauiAsset Include="$(ReceiptCorpusRoot)/attribution.txt" LogicalName="receipt-corpus/attribution.txt" />
  </ItemGroup>
  <!-- The separately identified physical focus probe owns no financial account, entry or type. -->
  <PropertyGroup Condition="'$(ReviewCurrencyFocusPhone)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.currencyfocusreview</ApplicationId>
    <DefineConstants>$(DefineConstants);CURRENCY_FOCUS_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- D-436: only the explicit retained fictional package may inspect its original protected household UI. -->
  <PropertyGroup Condition="'$(ReviewHouseholdMoney)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.householdlifecycle</ApplicationId>
    <DefineConstants>$(DefineConstants);HOUSEHOLD_MONEY_REVIEW</DefineConstants>
  </PropertyGroup>
  <!-- Only this new independent fixture opts into local TLS enrollment; shipping and old fixtures remain offline. -->
  <PropertyGroup Condition="'$(ReviewFreshHouseholdMoney)' == 'true'">
    <ApplicationId>pro.vafadar.zanance.householdmoneyreview</ApplicationId>
    <DefineConstants>$(DefineConstants);HOUSEHOLD_MONEY_REVIEW;HOUSEHOLD_MONEY_FRESH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReviewFreshHouseholdMoney)' == 'true'">
    <AndroidManifestOverlay Include="$(OriginalAppRoot)Platforms/Android/PersonalSyncManifest.xml" />
  </ItemGroup>
  <!-- D-320: measure the original release compilation inputs as well as its source/native library. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidAotProfile Include="$(OriginalAppRoot)Platforms/Android/Profiles/startup.aprof" />
  </ItemGroup>
  <!-- Compile original production sources and XAML; the application never references this independent caller. -->
  <ItemGroup>
    <Compile Include="$(OriginalAppRoot)**/*.cs"
             Exclude="$(OriginalAppRoot)bin/**;$(OriginalAppRoot)obj/**;$(OriginalAppRoot)artifacts/**;$(OriginalAppRoot)Platforms/Windows/**;$(OriginalAppRoot)Platforms/iOS/**;$(OriginalAppRoot)Platforms/Android/MainActivity.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
    <Compile Include="../Zanance.Performance/PerformanceFixture.cs" Link="PerformanceFixture.cs" />
    <MauiXaml Include="$(OriginalAppRoot)**/*.xaml"
              Exclude="$(OriginalAppRoot)bin/**;$(OriginalAppRoot)obj/**;$(OriginalAppRoot)artifacts/**;$(OriginalAppRoot)Platforms/Windows/**"
              Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(OriginalAppRoot)Resources/Strings/*.resx" Link="Resources/Strings/%(Filename)%(Extension)" />
    <AndroidResource Include="$(OriginalAppRoot)Platforms/Android/Resources/**" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidManifestOverlay Include="$(OriginalAppRoot)Platforms/Android/ReleaseManifest.xml" />
    <!-- Explicitly opt in only this fictitious caller for code-address sampling; never the shipping app. -->
    <AndroidManifestOverlay Include="SamplingManifest.xml" Condition="'$(EnableCodeSampling)' == 'true'" />
    <MauiIcon Include="$(OriginalAppRoot)Resources/AppIcon/appicon.svg" ForegroundFile="$(OriginalAppRoot)Resources/AppIcon/appiconfg.svg" Color="#F4F6F8" />
    <MauiSplashScreen Include="$(OriginalAppRoot)Resources/Splash/splash.svg" Color="#F4F6F8" BaseSize="128,128" />
    <MauiImage Include="$(OriginalAppRoot)Resources/Images/*" />
    <MauiFont Include="$(OriginalAppRoot)Resources/Fonts/*.ttf" />
    <MauiAsset Include="$(OriginalAppRoot)Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Authentication.Maui/Vafadar.Authentication.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup/Vafadar.Backup.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup.GoogleDrive/Vafadar.Backup.GoogleDrive.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Backup.OneDrive/Vafadar.Backup.OneDrive.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Documents.Maui/Vafadar.Documents.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Libraries/Vafadar.Maui/Vafadar.Maui.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Core/Vafadar.Zanance.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Data/Vafadar.Zanance.Data.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Apps/Zanance/Vafadar.Zanance.Reports/Vafadar.Zanance.Reports.csproj" />
    <PackageReference Include="Vafadar.Native.SqlCipher.Android" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Syncfusion.Maui.Charts" />
    <PackageReference Include="Syncfusion.Maui.Inputs" />
    <PackageReference Include="Syncfusion.Maui.ProgressBar" />
    <PackageReference Include="Plugin.LocalNotification" />
    <AppSecret Include="MicrosoftEntraClientId" Value="" />
    <AppSecret Include="GoogleOAuthClientIdAndroid" Value="" />
    <AppSecret Include="GoogleOAuthClientIdIos" Value="" />
    <AppSecret Include="GoogleOAuthClientIdWindows" Value="" />
  </ItemGroup>
  <Target Name="SelectPatchedCoreRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Condition="'%(FrameworkReference.Identity)' == 'Microsoft.NETCore.App'">
        <RuntimeFrameworkVersion>$(VafadarSecurityRuntimeVersion)</RuntimeFrameworkVersion>
      </FrameworkReference>
    </ItemGroup>
  </Target>
  <Target Name="PrepareAndroidCipherDependency" BeforeTargets="_GenerateRestoreGraphProjectEntry">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepoRoot)eng/native/sqlcipher/Ensure-AndroidPackage.ps1&quot;" />
  </Target>
  <Import Project="$(RepoRoot)eng/AndroidAotRuntime.targets" />
</Project>

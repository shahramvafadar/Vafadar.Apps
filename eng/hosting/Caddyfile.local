{
	admin off
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}
https://localhost:8443, https://api.zanance.vafadar.pro:8443 {
	tls internal
	request_body {
		max_size 8MB
	}
	reverse_proxy https://api:8443 {
		header_up Host {$ZANANCE_PROXY_AUTHORITY:localhost:14543}
		transport http {
			tls_trust_pool file /trust/authority.crt
			tls_server_name api
		}
	}
	log {
		output discard
	}
}

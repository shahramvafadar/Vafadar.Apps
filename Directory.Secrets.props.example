<Project>

  <!--
    Local development secrets.

    1. Copy this file to "Directory.Secrets.props" in the same folder (the repository root).
    2. Fill in the values.

    Directory.Secrets.props is git-ignored and must never be committed.
    In CI, the same names are provided as environment variables from GitHub Actions secrets.
    See docs/guides/secrets-and-configuration.md.
  -->

  <PropertyGroup>
    <!-- Syncfusion Essential Studio license key (https://www.syncfusion.com/account/downloads). -->
    <SyncfusionLicenseKey></SyncfusionLicenseKey>

    <!-- Optional OAuth clients for cloud backup (D-35). Empty = no cloud backup and an offline release build.
         See docs/guides/secrets-and-configuration.md. GoogleOAuthClientIdIos is reserved for the iOS release. -->
    <GoogleOAuthClientIdAndroid></GoogleOAuthClientIdAndroid>
    <GoogleOAuthClientIdIos></GoogleOAuthClientIdIos>
    <MicrosoftEntraClientId></MicrosoftEntraClientId>
  </PropertyGroup>

</Project>
